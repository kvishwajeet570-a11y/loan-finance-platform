"use client";

import { useState } from "react";
import Link from "next/link";
import api from "@/lib/api";
import {
  ArrowRight,
  ArrowLeft,
  Eye,
  EyeOff,
  UserRound,
  UsersRound,
  ShieldCheck,
  Mail,
  Phone,
  LockKeyhole,
  MapPin,
  Building2,
  Home,
  KeyRound,
  CheckCircle2,
  BriefcaseBusiness,
  Headphones,
  Zap,
  Menu,
  X,
  Sparkles,
  BadgeCheck,
  CircleCheck,
} from "lucide-react";

type Role = "CUSTOMER" | "DSA" | "SUPER_ADMIN";

type AuthPageProps = {
  initialMode: "login" | "register";
};

const roles = [
  {
    id: "CUSTOMER" as Role,
    title: "Customer",
    subtitle: "Loan Applicants",
    icon: UserRound,
    accent: "blue",
  },
  {
    id: "DSA" as Role,
    title: "DSA Partner",
    subtitle: "Business Partners",
    icon: UsersRound,
    accent: "emerald",
  },
  {
    id: "SUPER_ADMIN" as Role,
    title: "Super Admin",
    subtitle: "Authorized Access",
    icon: ShieldCheck,
    accent: "slate",
  },
];

export default function AuthPage({ initialMode }: AuthPageProps) {
  const [mode, setMode] = useState<"login" | "register">(initialMode);
  const [role, setRole] = useState<Role>("CUSTOMER");
  const [showPassword, setShowPassword] = useState(false);
  const [showConfirmPassword, setShowConfirmPassword] = useState(false);

  // Strong password states
  const [password, setPassword] = useState("");
  const [confirmPassword, setConfirmPassword] = useState("");

  const passwordRules = {
    length: password.length >= 8,
    uppercase: /[A-Z]/.test(password),
    lowercase: /[a-z]/.test(password),
    number: /[0-9]/.test(password),
    special: /[^A-Za-z0-9]/.test(password),
    noSpaces: password.length > 0 && !/\s/.test(password),
  };

  const passwordScore = Object.values(passwordRules).filter(Boolean).length;

  const passwordStrength =
    password.length === 0
      ? ""
      : passwordScore <= 2
        ? "Weak"
        : passwordScore <= 4
          ? "Medium"
          : "Strong";

  const isStrongPassword = passwordScore === 6;
  const [mobileMenu, setMobileMenu] = useState(false);
  const [message, setMessage] = useState("");

  // Registration email + OTP verification states
  const [email, setEmail] = useState("");
  const [otp, setOtp] = useState("");
  const [otpSent, setOtpSent] = useState(false);
  const [otpVerified, setOtpVerified] = useState(false);
  const [otpLoading, setOtpLoading] = useState(false);

  // Forgot Password states
  const [forgotMode, setForgotMode] = useState(false);
  const [forgotOtpSent, setForgotOtpSent] = useState(false);
  const [forgotOtp, setForgotOtp] = useState("");
  const [forgotPassword, setForgotPassword] = useState("");
  const [forgotConfirmPassword, setForgotConfirmPassword] = useState("");
  const [forgotLoading, setForgotLoading] = useState(false);

  const selectedRole = roles.find((item) => item.id === role)!;

  const selectRole = (newRole: Role) => {
    setRole(newRole);
    setMessage("");

    if (newRole === "SUPER_ADMIN" && mode === "register") {
      setMode("login");
    }
  };

  const switchMode = (newMode: "login" | "register") => {
    if (role === "SUPER_ADMIN" && newMode === "register") return;

    setMode(newMode);
    setMessage("");
  };

  const handleSendOtp = async () => {
    const normalizedEmail = String(email || "").trim().toLowerCase();

    if (!normalizedEmail || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(normalizedEmail)) {
      setMessage("Please enter a valid email address.");
      return;
    }

    try {
      setOtpLoading(true);
      setMessage("");

      const response = await api.post("/auth/send-otp", {
        email: normalizedEmail,
      });

      if (response.data?.success) {
        setOtp("");
        setOtpSent(true);
        setOtpVerified(false);
        setMessage("OTP sent successfully. Please check your email.");
      } else {
        setMessage(response.data?.message || "Unable to send OTP.");
      }
    } catch (error: any) {
      console.error("SEND OTP ERROR:", error);
      setOtpSent(false);
      setOtpVerified(false);

      const serverMessage =
        error?.response?.data?.message ||
        error?.message ||
        "Unable to send OTP. Please try again.";

      setMessage(serverMessage);
    } finally {
      setOtpLoading(false);
    }
  };
  const handleVerifyOtp = async () => {
    const normalizedEmail = email.trim().toLowerCase();

    if (!normalizedEmail) {
      setMessage("Please enter your email address.");
      return;
    }

    if (otp.length !== 6) {
      setMessage("Please enter the 6-digit OTP.");
      return;
    }

    try {
      setOtpLoading(true);
      setMessage("");

      await api.post("/auth/verify-otp", {
        email: normalizedEmail,
        otp,
      });

      setOtpVerified(true);
      setMessage("Email verified successfully.");
    } catch (error: any) {
      const apiMessage =
        error?.response?.data?.message ||
        error?.response?.data?.error ||
        "Invalid or expired OTP.";

      setMessage(apiMessage);
      setOtpVerified(false);
    } finally {
      setOtpLoading(false);
    }
  };

  const handleForgotPassword = async () => {
    const normalizedEmail = email.trim().toLowerCase();

    if (!normalizedEmail || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(normalizedEmail)) {
      setMessage("Please enter a valid email address.");
      return;
    }

    try {
      setForgotLoading(true);
      setMessage("");

      const response = await api.post("/auth/forgot-password", {
        email: normalizedEmail,
      });

      if (response.data?.success) {
        setForgotOtpSent(true);
        setForgotOtp("");
        setMessage("OTP sent successfully. Please check your email.");
      } else {
        setMessage(response.data?.message || "Unable to send OTP.");
      }
    } catch (error: any) {
      setMessage(
        error?.response?.data?.message ||
        error?.message ||
        "Unable to send OTP. Please try again."
      );
    } finally {
      setForgotLoading(false);
    }
  };

  const handleResetPassword = async () => {
    const normalizedEmail = email.trim().toLowerCase();

    if (!normalizedEmail) {
      setMessage("Please enter your email address.");
      return;
    }

    if (!/^\d{6}$/.test(forgotOtp)) {
      setMessage("Please enter the 6-digit OTP.");
      return;
    }

    if (forgotPassword.length < 8) {
      setMessage("Password must be at least 8 characters.");
      return;
    }

    if (forgotPassword !== forgotConfirmPassword) {
      setMessage("Passwords do not match.");
      return;
    }

    try {
      setForgotLoading(true);
      setMessage("");

      const response = await api.post("/auth/reset-password", {
        email: normalizedEmail,
        otp: forgotOtp,
        password: forgotPassword,
        confirmPassword: forgotConfirmPassword,
      });

      if (response.data?.success) {
        setMessage("Password changed successfully. You can now login.");

        setTimeout(() => {
          setForgotMode(false);
          setForgotOtpSent(false);
          setForgotOtp("");
          setForgotPassword("");
          setForgotConfirmPassword("");
          setMessage("");
        }, 1500);
      } else {
        setMessage(response.data?.message || "Unable to reset password.");
      }
    } catch (error: any) {
      setMessage(
        error?.response?.data?.message ||
        error?.message ||
        "Unable to reset password. Please try again."
      );
    } finally {
      setForgotLoading(false);
    }
  };

  const handleBackToLogin = () => {
    setForgotMode(false);
    setForgotOtpSent(false);
    setForgotOtp("");
    setForgotPassword("");
    setForgotConfirmPassword("");
    setMessage("");
  };

  const handleSubmit = (e: React.FormEvent<HTMLFormElement>) => {
    e.preventDefault();

    if (mode === "register" && role !== "SUPER_ADMIN") {
      if (!isStrongPassword) {
        setMessage(
          "Please create a strong password with 8+ characters, uppercase, lowercase, number and special character."
        );
        return;
      }

      if (password !== confirmPassword) {
        setMessage("Passwords do not match.");
        return;
      }
    }
    if (mode === "register" && role !== "SUPER_ADMIN" && !otpVerified) {
      setMessage("Please verify your email with OTP before creating your account.");
      return;
    }

    setMessage(
      mode === "login"
        ? "Login interface is ready. Authentication API will be connected next."
        : `${selectedRole.title} registration interface is ready. Registration API will be connected next.`
    );
  };

  return (
    <main className="min-h-screen overflow-x-hidden bg-[#f4f8ff] text-[#06295c]">
      {/* Decorative background */}
      <div className="pointer-events-none fixed inset-0 overflow-hidden">
        <div className="absolute -left-40 top-20 h-[420px] w-[420px] rounded-full bg-blue-200/30 blur-3xl" />
        <div className="absolute -right-40 top-[35%] h-[500px] w-[500px] rounded-full bg-cyan-200/25 blur-3xl" />
        <div className="absolute bottom-0 left-[35%] h-[300px] w-[400px] rounded-full bg-indigo-100/30 blur-3xl" />
      </div>

      {/* Header */}
      <header className="relative z-50 border-b border-blue-100/80 bg-white/90 backdrop-blur-xl">
        <div className="mx-auto flex h-[78px] max-w-[1450px] items-center justify-between px-5 sm:px-8">
          <Link href="/" className="group flex items-center gap-3">
            <div className="relative flex h-11 w-11 items-center justify-center rounded-[14px] bg-gradient-to-br from-blue-500 via-blue-600 to-indigo-700 text-white shadow-lg shadow-blue-200 transition group-hover:scale-105">
              <Building2 size={23} strokeWidth={2.4} />
              <span className="absolute -right-1 -top-1 h-2.5 w-2.5 rounded-full border-2 border-white bg-cyan-400" />
            </div>

            <div>
              <div className="text-[19px] font-black leading-tight tracking-[-0.02em] text-[#06295c]">
                India Loan Finance
              </div>
              <div className="mt-0.5 text-[9px] font-bold uppercase tracking-[0.18em] text-blue-500">
                Your Financial Partner
              </div>
            </div>
          </Link>

          <div className="hidden items-center gap-3 sm:flex">
            <Link
              href="/"
              className="px-4 py-2 text-sm font-bold text-slate-500 transition hover:text-blue-600"
            >
              Home
            </Link>

            <Link
              href="/"
              className="inline-flex items-center gap-2 rounded-full border border-blue-100 bg-white px-4 py-2.5 text-sm font-bold text-[#06295c] shadow-sm transition hover:-translate-y-0.5 hover:border-blue-200 hover:bg-blue-50"
            >
              <ArrowLeft size={15} />
              Back to Home
            </Link>
          </div>

          <button
            type="button"
            onClick={() => setMobileMenu(!mobileMenu)}
            className="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600 sm:hidden"
          >
            {mobileMenu ? <X size={20} /> : <Menu size={20} />}
          </button>
        </div>

        {mobileMenu && (
          <div className="border-t border-blue-100 bg-white px-5 py-4 sm:hidden">
            <Link
              href="/"
              className="flex items-center gap-2 text-sm font-bold text-slate-700"
            >
              <ArrowLeft size={16} />
              Back to Home
            </Link>
          </div>
        )}
      </header>

      {/* Main */}
      <section className="relative z-10 px-4 py-8 sm:px-6 sm:py-11">
        <div className="mx-auto max-w-[1280px]">
          {/* Heading */}
          <div className="mx-auto mb-8 max-w-3xl text-center">
            <div className="mb-4 inline-flex items-center gap-2 rounded-full border border-blue-100 bg-white px-4 py-2 text-[11px] font-extrabold uppercase tracking-[0.14em] text-blue-600 shadow-sm">
              <Sparkles size={14} />
              Secure Account Portal
            </div>

            <h1 className="text-3xl font-black tracking-[-0.035em] text-[#06295c] sm:text-4xl lg:text-[46px]">
              {mode === "login" ? (
                <>
                  Welcome <span className="text-blue-600">Back</span>
                </>
              ) : (
                <>
                  Create Your <span className="text-blue-600">Account</span>
                </>
              )}
            </h1>

            <p className="mx-auto mt-3 max-w-2xl text-sm leading-6 text-slate-500 sm:text-base">
              {mode === "login"
                ? "Login securely and continue your financial journey with India Loan Finance."
                : "Choose your account type and get started with India Loan Finance."}
            </p>
          </div>

          {/* Account type selector */}
          <div className="mx-auto mb-7 grid max-w-[1060px] grid-cols-1 gap-3 md:grid-cols-3">
            {roles.map((item) => {
              const Icon = item.icon;
              const active = role === item.id;

              const activeClass =
                item.accent === "emerald"
                  ? "border-emerald-400 bg-gradient-to-br from-emerald-500 to-teal-600 text-white shadow-[0_14px_35px_rgba(16,185,129,0.20)]"
                  : item.accent === "slate"
                    ? "border-slate-700 bg-gradient-to-br from-slate-700 to-slate-900 text-white shadow-[0_14px_35px_rgba(15,23,42,0.20)]"
                    : "border-blue-500 bg-gradient-to-br from-blue-500 to-indigo-700 text-white shadow-[0_14px_35px_rgba(37,99,235,0.22)]";

              return (
                <button
                  key={item.id}
                  type="button"
                  onClick={() => selectRole(item.id)}
                  className={`group relative overflow-hidden rounded-[20px] border p-4 text-left transition-all duration-300 ${
                    active
                      ? activeClass
                      : "border-blue-100 bg-white text-[#06295c] shadow-[0_7px_25px_rgba(20,70,140,0.06)] hover:-translate-y-1 hover:border-blue-200 hover:shadow-[0_14px_35px_rgba(20,70,140,0.12)]"
                  }`}
                >
                  {active && (
                    <div className="absolute -right-8 -top-8 h-24 w-24 rounded-full bg-white/10 blur-2xl" />
                  )}

                  <div className="relative flex items-center gap-3">
                    <div
                      className={`flex h-12 w-12 shrink-0 items-center justify-center rounded-[15px] ${
                        active
                          ? "bg-white/15 text-white"
                          : "bg-blue-50 text-blue-600"
                      }`}
                    >
                      <Icon size={23} strokeWidth={2.2} />
                    </div>

                    <div>
                      <div className="text-sm font-black">{item.title}</div>
                      <div
                        className={`mt-1 text-[11px] ${
                          active ? "text-white/75" : "text-slate-500"
                        }`}
                      >
                        {item.subtitle}
                      </div>
                    </div>

                    {active && (
                      <CircleCheck
                        className="ml-auto"
                        size={20}
                        strokeWidth={2.4}
                      />
                    )}
                  </div>
                </button>
              );
            })}
          </div>

          {/* Main Card */}
          <div className="mx-auto overflow-hidden rounded-[32px] border border-white bg-white/90 shadow-[0_30px_90px_rgba(21,72,140,0.14)] backdrop-blur-xl lg:grid lg:grid-cols-[1.08fr_0.92fr]">
            {/* Form */}
            <div className="p-6 sm:p-9 lg:p-12">
              {/* Login / Register tabs */}
              <div className="mb-8 flex rounded-2xl bg-slate-100 p-1.5">
                <button
                  type="button"
                  onClick={() => switchMode("login")}
                  className={`flex-1 rounded-xl py-3 text-sm font-extrabold transition ${
                    mode === "login"
                      ? "bg-white text-blue-600 shadow-sm"
                      : "text-slate-500 hover:text-slate-700"
                  }`}
                >
                  Login
                </button>

                <button
                  type="button"
                  onClick={() => switchMode("register")}
                  disabled={role === "SUPER_ADMIN"}
                  className={`flex-1 rounded-xl py-3 text-sm font-extrabold transition ${
                    mode === "register"
                      ? role === "DSA"
                        ? "bg-emerald-500 text-white shadow-sm"
                        : "bg-blue-600 text-white shadow-sm"
                      : "text-slate-500 hover:text-slate-700"
                  } disabled:cursor-not-allowed disabled:opacity-40`}
                >
                  Create Account
                </button>
              </div>

              {/* Form title */}
              <div className="mb-7 flex items-start justify-between">
                <div>
                  <div className="text-[25px] font-black tracking-tight text-[#06295c]">
                    {mode === "login"
                      ? `${selectedRole.title} Login`
                      : `${selectedRole.title} Registration`}
                  </div>

                  <p className="mt-1.5 text-sm text-slate-500">
                    {mode === "login"
                      ? "Enter your credentials to access your account."
                      : "Enter your details to create your account."}
                  </p>
                </div>

                <div
                  className={`hidden h-12 w-12 items-center justify-center rounded-2xl sm:flex ${
                    role === "DSA"
                      ? "bg-emerald-50 text-emerald-600"
                      : role === "SUPER_ADMIN"
                        ? "bg-slate-100 text-slate-700"
                        : "bg-blue-50 text-blue-600"
                  }`}
                >
                  <selectedRole.icon size={23} />
                </div>
              </div>

              {/* LOGIN */}
              {mode === "login" && !forgotMode && (
                <form onSubmit={handleSubmit} className="space-y-5">
                  <Field
                    label="Mobile Number or Email"
                    placeholder="Enter mobile number or email"
                    icon={UserRound}
                  />

                  <div>
                    <div className="mb-2 flex items-center justify-between">
                      <label className="text-sm font-extrabold text-[#06295c]">
                        Password
                      </label>

                      <button
                        type="button"
                        onClick={() => {
                          setForgotMode(true);
                          setMessage("");
                          setEmail("");
                          setForgotOtpSent(false);
                        }}
                        className="text-xs font-extrabold text-blue-600 hover:text-blue-700"
                      >
                        Forgot Password?
                      </button>
                    </div>

                    <PasswordInput
                      placeholder="Enter your password"
                      show={showPassword}
                      setShow={setShowPassword}
                    />
                  </div>

                  <label className="flex cursor-pointer items-center gap-2 text-xs font-semibold text-slate-500">
                    <input
                      type="checkbox"
                      className="h-4 w-4 rounded border-slate-300 text-blue-600"
                    />
                    Remember me on this device
                  </label>

                  {message && <Message text={message} />}

                  <button
                    type="submit"
                    className={`group flex h-14 w-full items-center justify-center gap-2 rounded-xl text-sm font-black text-white shadow-lg transition hover:-translate-y-0.5 ${
                      role === "DSA"
                        ? "bg-gradient-to-r from-emerald-500 to-teal-600 shadow-emerald-100 hover:shadow-emerald-200"
                        : role === "SUPER_ADMIN"
                          ? "bg-gradient-to-r from-slate-700 to-slate-900 shadow-slate-200"
                          : "bg-gradient-to-r from-blue-600 to-indigo-600 shadow-blue-200"
                    }`}
                  >
                    Login Securely
                    <ArrowRight
                      size={18}
                      className="transition group-hover:translate-x-1"
                    />
                  </button>

                  {role !== "SUPER_ADMIN" && (
                    <p className="text-center text-sm text-slate-500">
                      Don't have an account?{" "}
                      <button
                        type="button"
                        onClick={() => switchMode("register")}
                        className={`font-black ${
                          role === "DSA"
                            ? "text-emerald-600"
                            : "text-blue-600"
                        }`}
                      >
                        Create Account
                      </button>
                    </p>
                  )}
                </form>
              )}

              {/* CUSTOMER REGISTER */}
              {mode === "register" && role === "CUSTOMER" && (
                <form onSubmit={handleSubmit} className="space-y-4">
                  <div className="grid gap-4 sm:grid-cols-2">
                    <Field
                      label="Full Name"
                      placeholder="Enter your full name"
                      icon={UserRound}
                    />

                    <Field
                      label="Mobile Number"
                      placeholder="Enter mobile number"
                      icon={Phone}
                    />
                  </div>

                  <Field
                    label="Email Address"
                    placeholder="Enter your email"
                    icon={Mail}
                    type="email"
                    name="email"
                    value={email}
                    onChange={(e) => {
                      setEmail(e.target.value);
                      setOtpSent(false);
                      setOtpVerified(false);
                    }}
                  />

                  <div className="space-y-3">
                    <button
                      type="button"
                      onClick={handleSendOtp}
                      disabled={otpLoading}
                      className="h-11 w-full rounded-xl bg-blue-600 px-5 text-sm font-extrabold text-white shadow-lg shadow-blue-200 transition hover:bg-blue-700 disabled:cursor-not-allowed disabled:opacity-60"
                    >
                      {otpLoading ? "Sending OTP..." : "SEND OTP"}
                    </button>

                    {otpSent && (
                      <div className="space-y-3 rounded-xl border border-blue-100 bg-blue-50/70 p-4">
                        <label className="block text-sm font-extrabold text-[#06295c]">
                          OTP Verification
                        </label>

                        <div className="flex gap-3">
                          <input
                            type="text"
                            inputMode="numeric"
                            maxLength={6}
                            value={otp}
                            onChange={(e) =>
                              setOtp(e.target.value.replace(/\D/g, ""))
                            }
                            placeholder="Enter 6-digit OTP"
                            className="h-12 min-w-0 flex-1 rounded-xl border border-slate-200 bg-white px-4 text-sm font-bold text-slate-900 outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-100"
                          />

                          <button
                            type="button"
                            onClick={handleVerifyOtp}
                            disabled={otpLoading || otp.length !== 6}
                            className="h-12 rounded-xl bg-emerald-600 px-5 text-sm font-extrabold text-white shadow-lg shadow-emerald-100 transition hover:bg-emerald-700 disabled:cursor-not-allowed disabled:opacity-60"
                          >
                            {otpLoading ? "Verifying..." : "VERIFY OTP"}
                          </button>
                        </div>

                        {otpVerified && (
                          <div className="flex items-center gap-2 text-sm font-extrabold text-emerald-600">
                            <CheckCircle2 size={18} />
                            Email Verified Successfully
                          </div>
                        )}
                      </div>
                    )}
                  </div>

                  <div className="grid gap-4 sm:grid-cols-2">
                    <PasswordInputField
                      label="Password"
                      placeholder="Create password"
                      show={showPassword}
                      setShow={setShowPassword}
                      value={password}
                      onChange={setPassword}
                      showRequirements={true}
                    />

                    <PasswordInputField
                      label="Confirm Password"
                      placeholder="Confirm password"
                      show={showConfirmPassword}
                      setShow={setShowConfirmPassword}
                      value={confirmPassword}
                      onChange={setConfirmPassword}
                    />
                  </div>

                  <Consent color="blue" />

                  {message && <Message text={message} />}

                  <SubmitButton
                    label="Create Customer Account"
                    color="blue"
                  />

                  <LoginSwitch onClick={() => switchMode("login")} />
                </form>
              )}

              {/* DSA REGISTER */}
              {mode === "register" && role === "DSA" && (
                <form onSubmit={handleSubmit} className="space-y-4">
                  <div className="grid gap-4 sm:grid-cols-2">
                    <Field
                      label="First Name"
                      placeholder="Enter first name"
                      icon={UserRound}
                    />

                    <Field
                      label="Last Name"
                      placeholder="Enter last name"
                      icon={UserRound}
                    />
                  </div>

                  <Field
                    label="Email Address"
                    placeholder="Enter your email"
                    icon={Mail}
                    type="email"
                    name="email"
                    value={email}
                    onChange={(e) => {
                      setEmail(e.target.value);
                      setOtpSent(false);
                      setOtpVerified(false);
                    }}
                  />

                  <div className="space-y-3">
                    <button
                      type="button"
                      onClick={handleSendOtp}
                      disabled={otpLoading}
                      className="h-11 w-full rounded-xl bg-blue-600 px-5 text-sm font-extrabold text-white shadow-lg shadow-blue-200 transition hover:bg-blue-700 disabled:cursor-not-allowed disabled:opacity-60"
                    >
                      {otpLoading ? "Sending OTP..." : "SEND OTP"}
                    </button>

                    {otpSent && (
                      <div className="space-y-3 rounded-xl border border-blue-100 bg-blue-50/70 p-4">
                        <label className="block text-sm font-extrabold text-[#06295c]">
