function PasswordInputField({
  label,
  placeholder,
  show,
  setShow,
  value,
  onChange,
  showRequirements = false,
}: {
  label: string;
  placeholder: string;
  show: boolean;
  setShow: (value: boolean) => void;
  value?: string;
  onChange?: (value: string) => void;
  showRequirements?: boolean;
}) {
  const currentPassword = value || "";

  const rules = {
    length: currentPassword.length >= 8,
    uppercase: /[A-Z]/.test(currentPassword),
    lowercase: /[a-z]/.test(currentPassword),
    number: /[0-9]/.test(currentPassword),
    special: /[^A-Za-z0-9]/.test(currentPassword),
    noSpaces: currentPassword.length > 0 && !/\s/.test(currentPassword),
  };

  const score = Object.values(rules).filter(Boolean).length;

  const strength =
    currentPassword.length === 0
      ? ""
      : score <= 2
        ? "Weak"
        : score <= 4
          ? "Medium"
          : "Strong";

  return (
    <div>
      <label className="mb-2 block text-sm font-extrabold text-[#06295c]">
        {label} <span className="text-red-500">*</span>
      </label>

      <PasswordInput
        placeholder={placeholder}
        show={show}
        setShow={setShow}
        value={value}
        onChange={onChange}
      />

      {showRequirements && (
        <div className="mt-3 overflow-hidden rounded-[22px] border border-blue-100 bg-white shadow-[0_12px_35px_rgba(30,90,180,0.12)]">

          {/* HEADER */}
          <div className="flex items-center justify-between gap-3 bg-gradient-to-r from-blue-50 via-white to-indigo-50 px-4 py-4">

            <div className="flex items-center gap-3">

              <div className="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-blue-600 to-indigo-600 shadow-lg">
                <ShieldCheck className="h-6 w-6 text-white" />
              </div>

              <div>
                <p className="text-[13px] font-black text-[#06295c]">
                  Password Requirements
                </p>

                <p className="mt-0.5 text-[9px] font-medium text-slate-500">
                  Create a strong password for better account security
                </p>
              </div>

            </div>

            {strength && (
              <div
                className={`flex items-center gap-1.5 rounded-full px-3 py-2 text-[9px] font-black uppercase tracking-wide ${
                  strength === "Strong"
                    ? "bg-emerald-100 text-emerald-700 ring-1 ring-emerald-200"
                    : strength === "Medium"
                      ? "bg-amber-100 text-amber-700 ring-1 ring-amber-200"
                      : "bg-red-100 text-red-600 ring-1 ring-red-200"
                }`}
              >
                <CircleCheck className="h-3.5 w-3.5" />
                {strength}
              </div>
            )}

          </div>


          {/* STRENGTH */}
          <div className="border-t border-blue-50 bg-gradient-to-b from-white to-blue-50/40 px-4 py-3">

            <div className="mb-2 flex items-center justify-between">

              <div className="flex items-center gap-2">

                <div className="flex h-7 w-7 items-center justify-center rounded-lg bg-blue-100">
                  <Zap className="h-3.5 w-3.5 text-blue-600" />
                </div>

                <div>
                  <p className="text-[10px] font-black text-[#06295c]">
                    Password Strength
                  </p>

                  <p className="text-[8px] font-medium text-slate-400">
                    Complete all security checks
                  </p>
                </div>

              </div>

              <span className="text-[12px] font-black text-[#06295c]">
                {score}/6
              </span>

            </div>


            <div className="flex gap-1.5">

              {[1, 2, 3, 4, 5, 6].map((level) => (
                <div
                  key={level}
                  className={`h-2 flex-1 rounded-full transition-all duration-300 ${
                    level <= score
                      ? strength === "Strong"
                        ? "bg-emerald-500"
                        : strength === "Medium"
                          ? "bg-amber-400"
                          : "bg-red-400"
                      : "bg-slate-200"
                  }`}
                />
              ))}

            </div>

          </div>


          {/* REQUIREMENTS */}
          <div className="px-4 pb-4 pt-3">

            <div className="mb-3 flex items-center justify-between">

              <p className="text-[10px] font-black uppercase tracking-wide text-[#06295c]">
                Security Checklist
              </p>

              <span className="rounded-full bg-blue-50 px-2.5 py-1 text-[8px] font-black text-blue-600">
                6 CHECKS
              </span>

            </div>


            {/* 3 x 2 */}
            <div className="grid grid-cols-1 gap-2.5 sm:grid-cols-3">

              <PasswordRequirementCard
                ok={rules.length}
                icon="Aa"
                title="8+ Characters"
                description="Use at least 8 characters. 12+ characters are recommended."
                iconClass="bg-blue-100 text-blue-600"
              />

              <PasswordRequirementCard
                ok={rules.uppercase}
                icon="A"
                title="Uppercase Letter"
                description="Include at least one capital letter from A to Z."
                iconClass="bg-violet-100 text-violet-600"
              />

              <PasswordRequirementCard
                ok={rules.lowercase}
                icon="a"
                title="Lowercase Letter"
                description="Include at least one lowercase letter from a to z."
                iconClass="bg-pink-100 text-pink-600"
              />

              <PasswordRequirementCard
                ok={rules.number}
                icon="123"
                title="One Number"
                description="Include at least one numeric digit from 0 to 9."
                iconClass="bg-orange-100 text-orange-600"
              />

              <PasswordRequirementCard
                ok={rules.special}
                icon="@"
                title="Special Character"
                description="Use a symbol such as @, #, $, %, !, & or *."
                iconClass="bg-emerald-100 text-emerald-600"
              />

              <PasswordRequirementCard
                ok={rules.noSpaces}
                icon="✓"
                title="No Spaces"
                description="Your password should not contain spaces or blank characters."
                iconClass="bg-rose-100 text-rose-600"
              />

            </div>

          </div>


          {/* SECURITY TIP */}
          <div className="mx-4 mb-4 rounded-2xl border border-blue-100 bg-gradient-to-r from-blue-50 via-indigo-50 to-blue-50 p-3">

            <div className="flex items-start gap-3">

              <div className="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-white shadow-sm ring-1 ring-blue-100">
                <span className="text-lg">💡</span>
              </div>

              <div className="min-w-0">

                <p className="text-[10px] font-black text-[#06295c]">
                  Security Tip
                </p>

                <p className="mt-1 text-[8.5px] font-medium leading-relaxed text-slate-500">
                  Never use your name, mobile number, email address, date of birth
                  or common passwords. Use a unique password for your account.
                </p>

              </div>

            </div>

          </div>


          {/* RECOMMENDED */}
          <div className="flex items-center justify-between border-t border-slate-100 bg-slate-50/80 px-4 py-3">

            <div className="flex items-center gap-2">

              <BadgeCheck className="h-5 w-5 text-blue-600" />

              <div>
                <p className="text-[8px] font-black uppercase tracking-wide text-slate-400">
                  Recommended
                </p>

                <p className="text-[10px] font-black text-[#06295c]">
                  12+ characters
                </p>
              </div>

            </div>

            <div className="text-right">

              <p className="text-[8px] font-black uppercase tracking-wide text-slate-400">
                Example
              </p>

              <p className="text-[10px] font-black text-blue-600">
                Raj@2026Loan!
              </p>

              <p className="text-[7px] font-medium text-slate-400">
                Don't use this exact password
              </p>

            </div>

          </div>

        </div>
      )}
    </div>
  );
}

