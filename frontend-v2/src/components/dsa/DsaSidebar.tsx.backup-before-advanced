"use client";

import Link from "next/link";
import { usePathname, useRouter } from "next/navigation";

type Props = {
  collapsed: boolean;
  onToggle: () => void;
};

const menu = [
  {
    section: "OVERVIEW",
    items: [
      ["Dashboard", "/dsa/dashboard", "⌂"],
    ],
  },
  {
    section: "BUSINESS",
    items: [
      ["Leads", "/dsa/leads", "◈"],
      ["Customers", "/dsa/customers", "♙"],
      ["Loan Applications", "/dsa/loan-applications", "▣"],
      ["KYC", "/dsa/kyc", "✓"],
    ],
  },
  {
    section: "FINANCE",
    items: [
      ["Commission", "/dsa/commission", "₹"],
      ["Wallet", "/dsa/wallet", "◉"],
      ["Transactions", "/dsa/transactions", "↕"],
      ["Reports", "/dsa/reports", "▤"],
    ],
  },
  {
    section: "GROWTH",
    items: [
      ["Achievements", "/dsa/achievements", "★"],
      ["Training", "/dsa/training", "▶"],
    ],
  },
  {
    section: "ACCOUNT",
    items: [
      ["Notifications", "/dsa/notifications", "♢"],
      ["Support", "/dsa/support", "?"],
      ["Profile", "/dsa/profile", "●"],
    ],
  },
];

export default function DsaSidebar({
  collapsed,
  onToggle,
}: Props) {
  const pathname = usePathname();
  const router = useRouter();

  const logout = () => {
    localStorage.removeItem("loan_finance_token");
    localStorage.removeItem("loan_finance_user");
    router.push("/login");
  };

  let user: {
    name?: string;
    email?: string;
  } = {};

  if (typeof window !== "undefined") {
    try {
      user = JSON.parse(
        localStorage.getItem("loan_finance_user") || "{}"
      );
    } catch {
      user = {};
    }
  }

  const name = user.name || "DSA Agent";
  const email = user.email || "dsa@loanfinance.com";

  return (
    <aside
      className={`fixed left-0 top-0 z-50 hidden h-screen border-r border-slate-200 bg-white shadow-sm transition-all duration-300 lg:flex lg:flex-col ${
        collapsed ? "w-[82px]" : "w-[270px]"
      }`}
    >
      {/* Brand */}
      <div className="flex h-[76px] items-center border-b border-slate-100 px-5">
        <div className="flex min-w-0 items-center gap-3">
          <div className="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-blue-600 to-cyan-500 text-lg font-black text-white shadow-md">
            D
          </div>

          {!collapsed && (
            <div className="min-w-0">
              <p className="truncate text-base font-extrabold text-slate-900">
                DSA FinCorp
              </p>
              <p className="text-[10px] font-bold uppercase tracking-widest text-blue-600">
                Grow Together
              </p>
            </div>
          )}
        </div>

        <button
          onClick={onToggle}
          className={`ml-auto hidden h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-slate-50 text-slate-500 hover:bg-blue-50 hover:text-blue-600 ${
            collapsed ? "lg:hidden" : "lg:flex"
          }`}
          aria-label="Collapse sidebar"
        >
          ‹
        </button>
      </div>

      {/* Collapsed expand button */}
      {collapsed && (
        <button
          onClick={onToggle}
          className="mx-auto mt-4 flex h-9 w-9 items-center justify-center rounded-xl bg-blue-50 font-bold text-blue-600 hover:bg-blue-100"
          aria-label="Expand sidebar"
        >
          ›
        </button>
      )}

      {/* Navigation */}
      <nav className="flex-1 overflow-y-auto px-3 py-5">
        {menu.map((group) => (
          <div key={group.section} className="mb-5">
            {!collapsed && (
              <p className="mb-2 px-3 text-[10px] font-extrabold tracking-[0.18em] text-slate-400">
                {group.section}
              </p>
            )}

            <div className="space-y-1">
              {group.items.map(([label, href, icon]) => {
                const active =
                  pathname === href ||
                  (href !== "/dsa/dashboard" &&
                    pathname.startsWith(href));

                return (
                  <Link
                    key={href}
                    href={href}
                    title={collapsed ? label : undefined}
                    className={`flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold transition ${
                      active
                        ? "bg-blue-600 text-white shadow-md shadow-blue-200"
                        : "text-slate-600 hover:bg-blue-50 hover:text-blue-700"
                    } ${collapsed ? "justify-center" : ""}`}
                  >
                    <span className="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg text-sm">
                      {icon}
                    </span>

                    {!collapsed && <span>{label}</span>}
                  </Link>
                );
              })}
            </div>
          </div>
        ))}
      </nav>

      {/* User */}
      <div className="border-t border-slate-100 p-3">
        {!collapsed && (
          <div className="mb-2 rounded-2xl bg-slate-50 p-3">
            <p className="truncate text-sm font-bold text-slate-800">
              {name}
            </p>
            <p className="mt-0.5 truncate text-[11px] text-slate-400">
              {email}
            </p>
            <div className="mt-2 flex items-center gap-1.5">
              <span className="h-2 w-2 rounded-full bg-emerald-500" />
              <span className="text-[10px] font-bold text-emerald-600">
                ACTIVE DSA
              </span>
            </div>
          </div>
        )}

        <button
          onClick={logout}
          title={collapsed ? "Logout" : undefined}
          className={`flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-red-500 hover:bg-red-50 ${
            collapsed ? "justify-center" : ""
          }`}
        >
          <span>↪</span>
          {!collapsed && <span>Logout</span>}
        </button>
      </div>
    </aside>
  );
}
