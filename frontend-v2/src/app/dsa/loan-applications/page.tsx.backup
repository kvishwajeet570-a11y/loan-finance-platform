"use client";

import { useEffect, useMemo, useState } from "react";
import DsaShell from "@/components/dsa/DsaShell";

const API = process.env.NEXT_PUBLIC_API_URL || "http://localhost:5000/api";

type Loan = {
  id: string;
  userId?: string;
  fullName?: string;
  email?: string;
  phone?: string;
  loanType?: string;
  amount?: number;
  status?: string;
  city?: string;
  state?: string;
  createdAt?: string;
};

const money = (v: number) => `?${Number(v || 0).toLocaleString("en-IN")}`;

function statusClass(status = "") {
  const s = status.toUpperCase();
  if (s === "APPROVED") return "border-emerald-200 bg-emerald-50 text-emerald-700";
  if (s === "PENDING") return "border-amber-200 bg-amber-50 text-amber-700";
  if (s === "REJECTED") return "border-red-200 bg-red-50 text-red-700";
  return "border-slate-200 bg-slate-100 text-slate-600";
}

export default function DsaLoanApplicationsPage() {
  const [loans, setLoans] = useState<Loan[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [search, setSearch] = useState("");
  const [status, setStatus] = useState("ALL");
  const [product, setProduct] = useState("ALL");
  const [selectedLoan, setSelectedLoan] = useState<Loan | null>(null);
  const [activeTab, setActiveTab] = useState("overview");

  async function loadLoans() {
    try {
      setLoading(true);
      setError("");

      const user = JSON.parse(localStorage.getItem("loan_finance_user") || "{}");
      if (!user?.id) throw new Error("DSA login session not found.");

      const token = localStorage.getItem("loan_finance_token");

      const res = await fetch(`${API}/dsa/${user.id}/loans`, {
        headers: token ? { Authorization: `Bearer ${token}` } : {},
      });

      const json = await res.json();

      if (!res.ok || json.success === false) {
        throw new Error(json.message || "Unable to load loan applications.");
      }

      const rows = Array.isArray(json.data)
        ? json.data
        : Array.isArray(json.loans)
        ? json.loans
        : [];

      setLoans(rows);
    } catch (e: any) {
      setError(e?.message || "Unable to load loan applications.");
      setLoans([]);
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    loadLoans();
  }, []);

  const products = useMemo(
    () => Array.from(new Set(loans.map((x) => x.loanType).filter(Boolean) as string[])),
    [loans]
  );

  const filtered = useMemo(() => {
    const q = search.trim().toLowerCase();

    return loans.filter((loan) => {
      const text = [
        loan.fullName,
        loan.email,
        loan.phone,
        loan.loanType,
        loan.city,
        loan.state,
        loan.id,
      ]
        .filter(Boolean)
        .join(" ")
        .toLowerCase();

      return (
        (!q || text.includes(q)) &&
        (status === "ALL" ||
          String(loan.status || "").toUpperCase() === status) &&
        (product === "ALL" || loan.loanType === product)
      );
    });
  }, [loans, search, status, product]);

  const stats = useMemo(() => {
    const approved = loans.filter(
      (x) => String(x.status).toUpperCase() === "APPROVED"
    ).length;
    const pending = loans.filter(
      (x) => String(x.status).toUpperCase() === "PENDING"
    ).length;
    const rejected = loans.filter(
      (x) => String(x.status).toUpperCase() === "REJECTED"
    ).length;

    return {
      total: loans.length,
      approved,
      pending,
      rejected,
      value: loans.reduce((sum, x) => sum + Number(x.amount || 0), 0),
      approvedValue: loans
        .filter((x) => String(x.status).toUpperCase() === "APPROVED")
        .reduce((sum, x) => sum + Number(x.amount || 0), 0),
    };
  }, [loans]);

  return (
    <DsaShell>
      <div className="min-h-screen bg-[#f4f7fb]">
        <style jsx global>{`
          .loan-premium {
            background:
              radial-gradient(circle at 90% 8%, rgba(37,99,235,.09), transparent 24%),
              radial-gradient(circle at 5% 35%, rgba(14,165,233,.07), transparent 22%),
              #f4f7fb;
          }
          .loan-card {
            box-shadow: 0 8px 30px rgba(15,23,42,.055), 0 1px 2px rgba(15,23,42,.04);
          }
          .loan-row { transition: all .18s ease; }
          .loan-row:hover { background:#f8fbff; }
        `}</style>

        <header className="sticky top-0 z-30 border-b border-slate-200/80 bg-white/95 px-5 py-4 backdrop-blur-xl md:px-8 xl:px-10">
          <div className="mx-auto flex max-w-[1850px] items-center">
            <div className="relative hidden max-w-xl flex-1 md:block">
              <span className="absolute left-4 top-1/2 -translate-y-1/2 text-xl text-slate-400">?</span>
              <input
                value={search}
                onChange={(e) => setSearch(e.target.value)}
                placeholder="Search applications, customers, loan products..."
                className="w-full rounded-[22px] border border-slate-200 bg-[#f4f8fc] py-3.5 pl-12 pr-4 text-base font-medium outline-none focus:border-blue-400 focus:bg-white"
              />
            </div>
            <div className="ml-auto flex items-center gap-3">
              <span className="hidden text-xs font-bold uppercase tracking-wider text-slate-400 lg:block">
                DSA FinCorp • Partner Portal
              </span>
              <div className="flex h-11 w-11 items-center justify-center rounded-full border border-slate-200 bg-white shadow-sm">??</div>
            </div>
          </div>
        </header>

        <main className="loan-premium mx-auto min-h-[calc(100vh-73px)] max-w-[1850px] p-5 md:p-8 xl:p-10">
          <div className="mb-6">
            <div className="mb-3 flex items-center gap-2 text-sm font-semibold text-slate-500">
              <span className="text-blue-600">¦</span>
              Dashboard <span>›</span>
              <span className="text-slate-900">Loan Applications</span>
            </div>

            <div className="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
              <div className="flex items-center gap-5">
                <div className="flex h-16 w-16 items-center justify-center rounded-[22px] bg-gradient-to-br from-blue-600 to-cyan-500 text-3xl text-white shadow-lg shadow-blue-500/25">
                  ?
                </div>
                <div>
                  <h1 className="text-4xl font-black tracking-tight text-slate-950 md:text-5xl">
                    Loan Applications
                  </h1>
                  <p className="mt-1 text-base font-medium text-slate-500">
                    Track your assigned applications and loan pipeline.
                  </p>
                </div>
              </div>

              <div className="rounded-[22px] border border-blue-200 bg-gradient-to-r from-blue-700 to-cyan-500 px-6 py-4 text-white shadow-xl">
                <p className="text-xs font-bold uppercase tracking-widest text-cyan-100">
                  Total Portfolio
                </p>
                <p className="mt-1 text-2xl font-black">{money(stats.value)}</p>
              </div>
            </div>
          </div>

          <section className="grid gap-5 sm:grid-cols-2 xl:grid-cols-5">
            {[
              ["Total Applications", stats.total, "?", "from-blue-500 to-cyan-500"],
              ["Approved", stats.approved, "?", "from-emerald-500 to-green-600"],
              ["Pending", stats.pending, "?", "from-amber-400 to-orange-500"],
              ["Rejected", stats.rejected, "×", "from-red-500 to-rose-600"],
              ["Approved Value", money(stats.approvedValue), "?", "from-violet-500 to-purple-600"],
            ].map(([title, value, icon, gradient]) => (
              <div key={String(title)} className="loan-card rounded-3xl border border-slate-200/80 bg-white p-6">
                <div className={`flex h-14 w-14 items-center justify-center rounded-[22px] bg-gradient-to-br ${gradient} text-2xl font-black text-white shadow-lg`}>
                  {icon}
                </div>
                <p className="mt-5 text-sm font-bold text-slate-500">{title}</p>
                <p className="mt-1 text-4xl font-black text-slate-950">{value}</p>
                <p className="mt-2 text-xs font-semibold text-slate-400">Live backend data</p>
              </div>
            ))}
          </section>

          <section className="loan-card mt-6 rounded-3xl border border-slate-200/80 bg-white p-4 md:p-5">
            <div className="flex flex-col gap-3 xl:flex-row">
              <div className="relative flex-1">
                <span className="absolute left-4 top-1/2 -translate-y-1/2 text-xl text-slate-400">?</span>
                <input
                  value={search}
                  onChange={(e) => setSearch(e.target.value)}
                  placeholder="Search by customer, phone, email, location..."
                  className="w-full rounded-[22px] border border-slate-200 bg-[#f4f8fc] py-3.5 pl-11 pr-4 text-base font-medium outline-none focus:border-blue-400 focus:bg-white"
                />
              </div>

              <select value={status} onChange={(e) => setStatus(e.target.value)} className="min-w-[180px] cursor-pointer rounded-[18px] border-2 border-slate-200 bg-white px-5 py-3.5 text-sm font-black text-slate-800 shadow-sm outline-none transition hover:border-blue-400 hover:shadow-md focus:border-blue-500 focus:ring-4 focus:ring-blue-100">
                <option value="ALL">All Status</option>
                <option value="PENDING">Pending</option>
                <option value="APPROVED">Approved</option>
                <option value="REJECTED">Rejected</option>
              </select>

              <select value={product} onChange={(e) => setProduct(e.target.value)} className="min-w-[180px] cursor-pointer rounded-[18px] border-2 border-slate-200 bg-white px-5 py-3.5 text-sm font-black text-slate-800 shadow-sm outline-none transition hover:border-blue-400 hover:shadow-md focus:border-blue-500 focus:ring-4 focus:ring-blue-100">
                <option value="ALL">All Loan Products</option>
                {products.map((x) => <option key={x} value={x}>{x}</option>)}
              </select>

              <button onClick={loadLoans} className="rounded-[22px] bg-gradient-to-r from-blue-600 to-cyan-500 px-6 py-3.5 text-sm font-black text-white shadow-lg shadow-blue-500/20">
                ? Refresh
              </button>
            </div>
          </section>

          <section className="loan-card mt-6 overflow-hidden rounded-3xl border border-slate-200/80 bg-white">
            <div className="flex flex-col gap-3 border-b border-slate-200 px-6 py-6 md:flex-row md:items-center md:justify-between">
              <div>
                <div className="flex items-center gap-3">
                  <span className="text-2xl text-blue-600">?</span>
                  <h2 className="text-2xl font-black text-slate-950">Application Pipeline</h2>
                </div>
                <p className="mt-1 text-base font-medium text-slate-500">
                  {filtered.length} applications from your assigned loan portfolio
                </p>
              </div>
              <span className="rounded-full border border-emerald-200 bg-emerald-50 px-4 py-2 text-xs font-black text-emerald-700">
                ? LIVE DATA
              </span>
            </div>

            {loading ? (
              <div className="flex min-h-[350px] items-center justify-center">
                <div className="text-center">
                  <div className="mx-auto h-10 w-10 animate-spin rounded-full border-4 border-blue-100 border-t-blue-600" />
                  <p className="mt-4 font-bold text-slate-500">Loading live applications...</p>
                </div>
              </div>
            ) : error ? (
              <div className="m-6 rounded-[22px] border border-red-200 bg-red-50 p-6 text-red-700">
                <p className="font-black">Unable to load applications</p>
                <p className="mt-1 text-sm">{error}</p>
              </div>
            ) : filtered.length === 0 ? (
              <div className="flex min-h-[350px] flex-col items-center justify-center text-center">
                <div className="text-6xl">?</div>
                <h3 className="mt-4 text-xl font-black text-slate-800">No applications found</h3>
                <p className="mt-1 text-sm text-slate-500">
                  No assigned loan applications match your current filters.
                </p>
              </div>
            ) : (
              <div className="overflow-x-auto">
                <table className="w-full min-w-[1250px]">
                  <thead className="bg-gradient-to-r from-blue-50 to-cyan-50">
                    <tr className="text-left text-xs font-black uppercase tracking-wider text-blue-900">
                      <th className="px-6 py-4">Application</th>
                      <th className="px-6 py-4">Customer</th>
                      <th className="px-6 py-4">Loan Product</th>
                      <th className="px-6 py-4">Amount</th>
                      <th className="px-6 py-4">Location</th>
                      <th className="px-6 py-4">Status</th>
                      <th className="px-6 py-4">Created</th>
                      <th className="px-6 py-4">Action</th>
                    </tr>
                  </thead>

                  <tbody className="divide-y divide-slate-100">
                    {filtered.map((loan) => (
                      <tr key={loan.id} className="loan-row">
                        <td className="px-6 py-5">
                          <p className="font-black text-slate-900">{loan.id}</p>
                          <p className="mt-1 text-xs font-semibold text-slate-400">
                            {loan.userId || "Application Record"}
                          </p>
                        </td>

                        <td className="px-6 py-5">
                          <div className="flex items-center gap-3">
                            <div className="flex h-11 w-11 items-center justify-center rounded-full bg-gradient-to-br from-blue-100 to-cyan-100 font-black text-blue-700">
                              {(loan.fullName || "C").charAt(0).toUpperCase()}
                            </div>
                            <div>
                              <p className="font-black text-slate-900">{loan.fullName || "Unnamed Customer"}</p>
                              <p className="text-xs text-slate-400">{loan.phone || loan.email || "—"}</p>
                            </div>
                          </div>
                        </td>

                        <td className="px-6 py-5 text-sm font-bold text-slate-700">
                          {loan.loanType || "—"}
                        </td>

                        <td className="px-6 py-5 text-sm font-black text-slate-900">
                          {money(Number(loan.amount || 0))}
                        </td>

                        <td className="px-6 py-5 text-sm font-semibold text-slate-600">
                          {[loan.city, loan.state].filter(Boolean).join(", ") || "—"}
                        </td>

                        <td className="px-6 py-5">
                          <span className={`inline-flex rounded-full border px-3 py-1.5 text-xs font-black ${statusClass(loan.status)}`}>
                            {loan.status || "UNKNOWN"}
                          </span>
                        </td>

                        <td className="px-6 py-5 text-sm font-semibold text-slate-500">
                          {loan.createdAt
                            ? new Date(loan.createdAt).toLocaleDateString("en-IN", {
                                day: "2-digit",
                                month: "short",
                                year: "numeric",
                              })
                            : "—"}
                        </td>

                        <td className="px-6 py-5">
                          <button className="rounded-xl border border-blue-200 bg-blue-50 px-4 py-2 text-xs font-black text-blue-700">
                            View
                          </button>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </section>

          {selectedLoan && (
            <div
              className="fixed inset-0 z-[100] flex items-center justify-center bg-slate-950/60 p-4 backdrop-blur-md"
              onClick={() => setSelectedLoan(null)}
            >
              <div
                className="w-full max-w-4xl overflow-hidden rounded-[28px] border border-white/20 bg-white shadow-2xl"
                onClick={(e) => e.stopPropagation()}
              >
                <div className="bg-gradient-to-r from-blue-700 via-blue-600 to-cyan-500 px-6 py-6 text-white">
                  <div className="flex items-start justify-between gap-4">
                    <div>
                      <p className="text-xs font-black uppercase tracking-[0.2em] text-cyan-100">
                        Application Details
                      </p>
                      <h2 className="mt-1 text-2xl font-black">
                        {selectedLoan.fullName || "Unnamed Customer"}
                      </h2>
                      <p className="mt-1 text-sm text-blue-100">
                        {selectedLoan.id}
                      </p>
                    </div>

                    <button
                      onClick={() => setSelectedLoan(null)}
                      className="flex h-10 w-10 items-center justify-center rounded-full bg-white/15 text-xl font-black transition hover:bg-white/25"
                    >
                      ×
                    </button>
                  </div>

                  <div className="mt-5 flex flex-wrap gap-2">
                    {["overview", "customer", "loan"].map((tab) => (
                      <button
                        key={tab}
                        onClick={() => setActiveTab(tab)}
                        className={`rounded-full px-5 py-2 text-xs font-black uppercase tracking-wide transition ${
                          activeTab === tab
                            ? "bg-white text-blue-700 shadow-lg"
                            : "bg-white/15 text-white hover:bg-white/25"
                        }`}
                      >
                        {tab === "overview"
                          ? "Overview"
                          : tab === "customer"
                          ? "Customer"
                          : "Loan Details"}
                      </button>
                    ))}
                  </div>
                </div>

                <div className="max-h-[65vh] overflow-y-auto p-6">
                  {activeTab === "overview" && (
                    <div className="grid gap-4 md:grid-cols-2">
                      <div className="rounded-2xl border border-blue-100 bg-blue-50/70 p-5">
                        <p className="text-xs font-bold uppercase tracking-wider text-slate-400">
                          Application ID
                        </p>
                        <p className="mt-2 break-all font-black text-slate-900">
                          {selectedLoan.id}
                        </p>
                      </div>

                      <div className="rounded-2xl border border-emerald-100 bg-emerald-50/70 p-5">
                        <p className="text-xs font-bold uppercase tracking-wider text-slate-400">
                          Status
                        </p>
                        <span
                          className={`mt-2 inline-flex rounded-full border px-4 py-2 text-xs font-black ${statusClass(
                            selectedLoan.status
                          )}`}
                        >
                          {selectedLoan.status || "UNKNOWN"}
                        </span>
                      </div>

                      <div className="rounded-2xl border border-slate-200 bg-slate-50 p-5">
                        <p className="text-xs font-bold uppercase tracking-wider text-slate-400">
                          Loan Product
                        </p>
                        <p className="mt-2 text-lg font-black text-slate-900">
                          {selectedLoan.loanType || "—"}
                        </p>
                      </div>

                      <div className="rounded-2xl border border-violet-100 bg-violet-50/70 p-5">
                        <p className="text-xs font-bold uppercase tracking-wider text-slate-400">
                          Requested Amount
                        </p>
                        <p className="mt-2 text-2xl font-black text-slate-900">
                          {money(Number(selectedLoan.amount || 0))}
                        </p>
                      </div>

                      <div className="rounded-2xl border border-slate-200 bg-white p-5 md:col-span-2">
                        <p className="text-xs font-bold uppercase tracking-wider text-slate-400">
                          Created
                        </p>
                        <p className="mt-2 font-black text-slate-900">
                          {selectedLoan.createdAt
                            ? new Date(selectedLoan.createdAt).toLocaleString(
                                "en-IN"
                              )
                            : "—"}
                        </p>
                      </div>
                    </div>
                  )}

                  {activeTab === "customer" && (
                    <div className="grid gap-4 md:grid-cols-2">
                      <div className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                        <p className="text-xs font-bold uppercase tracking-wider text-slate-400">
                          Customer Name
                        </p>
                        <p className="mt-2 text-lg font-black text-slate-900">
                          {selectedLoan.fullName || "—"}
                        </p>
                      </div>

                      <div className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                        <p className="text-xs font-bold uppercase tracking-wider text-slate-400">
                          Phone
                        </p>
                        <p className="mt-2 text-lg font-black text-slate-900">
                          {selectedLoan.phone || "—"}
                        </p>
                      </div>

                      <div className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                        <p className="text-xs font-bold uppercase tracking-wider text-slate-400">
                          Email
                        </p>
                        <p className="mt-2 break-all font-black text-slate-900">
                          {selectedLoan.email || "—"}
                        </p>
                      </div>

                      <div className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                        <p className="text-xs font-bold uppercase tracking-wider text-slate-400">
                          Location
                        </p>
                        <p className="mt-2 font-black text-slate-900">
                          {[selectedLoan.city, selectedLoan.state]
                            .filter(Boolean)
                            .join(", ") || "—"}
                        </p>
                      </div>
                    </div>
                  )}

                  {activeTab === "loan" && (
                    <div className="space-y-4">
                      <div className="rounded-2xl border border-blue-100 bg-gradient-to-br from-blue-50 to-cyan-50 p-6">
                        <p className="text-xs font-bold uppercase tracking-wider text-slate-400">
                          Loan Product
                        </p>
                        <p className="mt-2 text-2xl font-black text-slate-900">
                          {selectedLoan.loanType || "—"}
                        </p>
                      </div>

                      <div className="grid gap-4 md:grid-cols-2">
                        <div className="rounded-2xl border border-slate-200 bg-white p-5">
                          <p className="text-xs font-bold uppercase tracking-wider text-slate-400">
                            Loan Amount
                          </p>
                          <p className="mt-2 text-2xl font-black text-slate-900">
                            {money(Number(selectedLoan.amount || 0))}
                          </p>
                        </div>

                        <div className="rounded-2xl border border-slate-200 bg-white p-5">
                          <p className="text-xs font-bold uppercase tracking-wider text-slate-400">
                            Application Status
                          </p>
                          <span
                            className={`mt-2 inline-flex rounded-full border px-4 py-2 text-xs font-black ${statusClass(
                              selectedLoan.status
                            )}`}
                          >
                            {selectedLoan.status || "UNKNOWN"}
                          </span>
                        </div>
                      </div>

                      <div className="rounded-2xl border border-slate-200 bg-slate-50 p-5">
                        <p className="text-xs font-bold uppercase tracking-wider text-slate-400">
                          User ID
                        </p>
                        <p className="mt-2 break-all font-bold text-slate-700">
                          {selectedLoan.userId || "—"}
                        </p>
                      </div>
                    </div>
                  )}
                </div>

                <div className="flex justify-end border-t border-slate-200 bg-slate-50 px-6 py-4">
                  <button
                    onClick={() => setSelectedLoan(null)}
                    className="rounded-xl bg-gradient-to-r from-blue-600 to-cyan-500 px-6 py-3 text-sm font-black text-white shadow-lg shadow-blue-500/20 transition hover:-translate-y-0.5"
                  >
                    Close Details
                  </button>
                </div>
              </div>
            </div>
          )}
          <footer className="py-7 text-center text-xs font-semibold text-slate-400">
            DSA FinCorp • Loan Application Management • Live Backend Data
          </footer>
        </main>
      </div>
    </DsaShell>
  );
}





