"use client";
import {useEffect,useMemo,useState} from "react";
import Link from "next/link";
import DsaShell from "@/components/dsa/DsaShell";

const API=process.env.NEXT_PUBLIC_API_URL||"http://localhost:5000/api";

const money=(n:number)=>`₹${Number(n||0).toLocaleString("en-IN")}`;
const compact=(n:number)=>{n=Number(n||0);return n>=10000000?`₹${(n/1e7).toFixed(1)}Cr`:n>=100000?`₹${(n/1e5).toFixed(1)}L`:n>=1000?`₹${(n/1e3).toFixed(1)}K`:money(n)};

export default function DsaDashboard(){
 const [d,setD]=useState<any>(null),[u,setU]=useState<any>(null),[err,setErr]=useState(""),[loading,setLoading]=useState(true);

 useEffect(()=>{(async()=>{
  try{
   const raw=localStorage.getItem("loan_finance_user"); if(!raw)throw Error("DSA session not found.");
   const user=JSON.parse(raw);setU(user);
   const token=localStorage.getItem("loan_finance_token");
   const r=await fetch(`${API}/dsa/dashboard/${user.id}`,{cache:"no-store",headers:token?{Authorization:`Bearer ${token}`}:{}})
   const j=await r.json();if(!r.ok||!j.success)throw Error(j.message||"Dashboard API failed.");
   setD(j.data);
  }catch(e:any){setErr(e.message||"Unable to load dashboard.")}finally{setLoading(false)}
 })()},[]);

 const max=Math.max(...(d?.monthlyTrend||[]).map((x:any)=>x.applications),1);
 const ptotal=(d?.loanProducts||[]).reduce((a:number,x:any)=>a+x.value,0);

 return <DsaShell>
  <div className="min-h-screen bg-[#f3f7fd] text-[#071a3d]">

   {/* TOP BAR */}
   <header className="sticky top-0 z-40 flex h-[72px] items-center justify-between border-b border-slate-200 bg-white/90 px-5 backdrop-blur-xl md:px-8">
    <div className="hidden h-11 w-[430px] items-center gap-3 rounded-xl bg-[#f0f5fc] px-4 md:flex">
     <span className="text-xl text-blue-500">⌕</span><span className="text-xs text-slate-400">Search applications, customers, products...</span>
    </div>
    <div className="flex items-center gap-4 ml-auto">
     <Link href="/dsa/notifications" className="relative text-xl">♧
      {!!d?.unreadNotifications&&<b className="absolute -right-2 -top-2 rounded-full bg-red-500 px-1.5 py-0.5 text-[8px] text-white">{d.unreadNotifications}</b>}
     </Link>
     <div className="h-8 w-px bg-slate-200"/>
     <div className="flex items-center gap-3">
      <div className="flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-blue-600 to-cyan-400 font-black text-white">{String(u?.name||"D")[0].toUpperCase()}</div>
      <div className="hidden md:block"><p className="text-xs font-black">{u?.name||"DSA Agent"}</p><p className="text-[9px] text-slate-400">DSA Partner</p></div>
      <span className="h-2 w-2 rounded-full bg-emerald-500"/>
     </div>
    </div>
   </header>

   <main className="space-y-5 p-4 md:p-6">

    {/* HERO */}
    <section className="relative min-h-[225px] overflow-hidden rounded-[25px] bg-gradient-to-r from-[#020e27] via-[#06275b] to-[#0877c9] p-7 text-white shadow-xl md:p-9">
     <div className="absolute inset-0 bg-[radial-gradient(circle_at_80%_50%,rgba(34,211,238,.25),transparent_28%)]"/>
     <div className="absolute right-10 top-5 h-44 w-44 rounded-full border border-cyan-300/10"/>
     <div className="relative max-w-2xl">
      <p className="text-4xl font-black leading-none md:text-5xl">Together<br/><span className="text-cyan-300">We Grow</span></p>
      <p className="mt-4 text-xs text-blue-100 md:text-sm">Your Effort&nbsp; | &nbsp;Our Support&nbsp; | &nbsp;Bigger Opportunities</p>
      <p className="mt-4 text-xs font-semibold text-cyan-100">Financial Freedom for a Brighter Tomorrow</p>
      <div className="mt-5 flex gap-3">
       <Link href="/dsa/leads" className="rounded-xl bg-blue-600 px-5 py-3 text-[10px] font-black shadow-lg">Apply Now →</Link>
       <Link href="/dsa/training" className="rounded-xl border border-white/20 bg-white/10 px-5 py-3 text-[10px] font-black">Explore Resources</Link>
      </div>
     </div>
     <div className="absolute bottom-7 right-8 hidden gap-3 lg:flex">
      {["◫ More Products","♧ Higher Commission","◉ Dedicated Support","↗ Growth with Us"].map(x=><div key={x} className="rounded-xl border border-white/10 bg-white/10 px-4 py-3 text-center text-[9px] font-bold backdrop-blur">{x}</div>)}
     </div>
    </section>

    {err&&<div className="rounded-xl border border-red-200 bg-red-50 p-4 text-xs font-bold text-red-700">{err}</div>}

    {/* KPI */}
    <section className="grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
     {[
      ["Total Applications",d?.summary.totalLeads||0,"▣","blue"],
      ["Approved",d?.summary.approvedLoans||0,"✓","green"],
      ["In Progress",d?.summary.pendingLoans||0,"⌛","orange"],
      ["Rejected",d?.summary.rejectedLoans||0,"×","red"],
      ["Total Commission",money(d?.summary.totalEarnings||0),"₹","cyan"]
     ].map(([t,v,i,c]:any)=><div key={t} className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
       <div className={`flex h-11 w-11 items-center justify-center rounded-full bg-${c}-50 text-lg font-black text-${c}-600`}>{i}</div>
       <p className="mt-4 text-[10px] font-bold text-slate-400">{t}</p>
       <p className="mt-1 text-2xl font-black">{loading?"—":v}</p>
       <p className="mt-1 text-[9px] text-slate-400">{t==="Approved"?"Success Rate":t==="Rejected"?"Improve & Reapply":"Live Account Data"}</p>
     </div>)}
    </section>

    {/* CHART ROW */}
    <section className="grid gap-5 xl:grid-cols-12">

     <div className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm xl:col-span-7">
      <div className="flex items-center justify-between"><div><h2 className="text-lg font-black">Loan Applications</h2><p className="text-[10px] text-slate-400">Real application activity</p></div><span className="rounded-lg border px-3 py-2 text-[9px] font-bold">Recent</span></div>
      <div className="mt-6 flex h-[245px] items-end gap-2 border-b border-slate-100">
       {(d?.monthlyTrend||[]).map((x:any)=><div key={x.month} className="flex h-full flex-1 flex-col items-center justify-end">
        <span className="mb-2 text-[8px] font-black text-slate-500">{x.applications}</span>
        <div className="w-[58%] max-w-10 rounded-t-xl bg-gradient-to-t from-blue-700 to-cyan-400 shadow-lg shadow-blue-100" style={{height:`${x.applications?Math.max(x.applications/max*100,7):2}%`}}/>
        <span className="mt-3 text-[8px] font-bold text-slate-400">{x.month}</span>
       </div>)}
      </div>
      <div className="mt-5 flex gap-5 text-[9px] font-bold text-slate-400">
       <span><i className="mr-1 inline-block h-2 w-2 rounded-full bg-blue-600"/>Applications</span>
       <span><i className="mr-1 inline-block h-2 w-2 rounded-full bg-emerald-400"/>Approved</span>
       <span><i className="mr-1 inline-block h-2 w-2 rounded-full bg-amber-400"/>Pending</span>
       <span><i className="mr-1 inline-block h-2 w-2 rounded-full bg-red-400"/>Rejected</span>
      </div>
     </div>

     <div className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm xl:col-span-3">
      <h2 className="text-lg font-black">Product Distribution</h2><p className="text-[10px] text-slate-400">Actual loan products</p>
      {d?.loanProducts?.length?<div className="mt-6 space-y-4">{d.loanProducts.map((x:any)=>{let pct=ptotal?(x.value/ptotal)*100:0;return <div key={x.name}><div className="flex justify-between text-[10px] font-bold"><span>{x.name}</span><span className="text-blue-600">{x.value}</span></div><div className="mt-2 h-2 rounded-full bg-slate-100"><div className="h-full rounded-full bg-gradient-to-r from-blue-600 to-cyan-400" style={{width:`${pct}%`}}/></div><p className="mt-1 text-[8px] text-slate-400">{money(x.amount)}</p></div>})}</div>:<div className="mt-8 rounded-xl bg-slate-50 p-10 text-center text-[10px] text-slate-400">No product data available.</div>}
     </div>

     <div className="space-y-5 xl:col-span-2">
      <div className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
       <p className="text-[9px] font-black text-amber-500">YOUR RANK</p>
       <div className="mt-3 text-3xl">🏆</div>
       <p className="mt-2 text-sm font-black">{d?.rank?`Rank #${d.rank}`:"—"}</p>
       <p className="mt-1 text-[9px] text-slate-400">Based on approved commission</p>
      </div>
      <div className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
       <p className="text-[9px] font-black text-emerald-500">WALLET BALANCE</p>
       <p className="mt-2 text-2xl font-black">{d?.wallet?money(d.wallet.balance):"—"}</p>
       <Link href="/dsa/wallet" className="mt-4 block rounded-lg bg-blue-600 py-2 text-center text-[9px] font-black text-white">OPEN WALLET</Link>
      </div>
     </div>
    </section>

    {/* RECENT + REFERRAL + SUPPORT */}
    <section className="grid gap-5 xl:grid-cols-12">

     <div className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm xl:col-span-7">
      <div className="flex items-center justify-between"><div><h2 className="text-lg font-black">Recent Applications</h2><p className="text-[10px] text-slate-400">Latest assigned records</p></div><Link href="/dsa/loan-applications" className="text-[10px] font-black text-blue-600">View All →</Link></div>
      {d?.recentApplications?.length?<div className="mt-5 overflow-x-auto"><table className="w-full min-w-[650px] text-left"><thead><tr className="border-b text-[8px] font-black uppercase text-slate-400"><th className="p-3">#</th><th className="p-3">Customer</th><th className="p-3">Loan Type</th><th className="p-3">Amount</th><th className="p-3">Status</th><th className="p-3">Date</th></tr></thead><tbody>{d.recentApplications.map((x:any,i:number)=><tr key={x.id} className="border-b border-slate-50 text-[10px] hover:bg-slate-50"><td className="p-3">{i+1}</td><td className="p-3 font-black">{x.fullName}</td><td className="p-3">{x.loanType}</td><td className="p-3 font-bold">{money(x.amount)}</td><td className="p-3"><span className={`rounded-full border px-2 py-1 text-[8px] font-black ${String(x.status).toUpperCase()==="APPROVED"?"border-emerald-100 bg-emerald-50 text-emerald-600":String(x.status).toUpperCase()==="REJECTED"?"border-red-100 bg-red-50 text-red-600":"border-amber-100 bg-amber-50 text-amber-600"}`}>{x.status}</span></td><td className="p-3 text-slate-400">{new Date(x.createdAt).toLocaleDateString("en-IN")}</td></tr>)}</tbody></table></div>:<div className="mt-5 rounded-xl bg-slate-50 p-12 text-center text-[10px] text-slate-400">No applications assigned yet.</div>}
     </div>

     <Link href="/dsa/referrals" className="rounded-2xl border border-blue-100 bg-gradient-to-br from-blue-50 to-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg xl:col-span-3">
      <p className="text-[9px] font-black text-blue-500">GROW YOUR NETWORK</p><h2 className="mt-1 text-xl font-black">Refer & Earn</h2><p className="mt-4 text-xs leading-6 text-slate-500">Refer DSA partners and grow your financial network.</p><div className="mt-7 flex h-14 w-14 items-center justify-center rounded-xl bg-blue-600 text-2xl text-white">↗</div><p className="mt-5 text-[10px] font-black text-blue-600">OPEN REFERRALS →</p>
     </Link>

     <Link href="/dsa/support" className="rounded-2xl border border-emerald-100 bg-gradient-to-br from-emerald-50 to-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg xl:col-span-2">
      <p className="text-[9px] font-black text-emerald-500">PARTNER CARE</p><h2 className="mt-1 text-xl font-black">Help & Support</h2><p className="mt-4 text-[10px] leading-5 text-slate-500">We're here to help you with your DSA account.</p><div className="mt-5 flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-500 text-xl text-white">?</div><p className="mt-4 text-[9px] font-black text-emerald-600">CONTACT SUPPORT →</p>
     </Link>
    </section>

    <footer className="pb-5 text-center text-[8px] font-bold tracking-wider text-slate-400">© DSA FinCorp • Secure Partner Workspace • Live Database</footer>
   </main>
  </div>
 </DsaShell>
}
