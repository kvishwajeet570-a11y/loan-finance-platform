                  <p className="mt-1 font-black text-slate-900">
                    {selected.processing}
                  </p>
                </div>
              </div>

              <div className="rounded-2xl border border-amber-100 bg-amber-50 p-4 text-xs leading-6 text-amber-800">
                Rates, eligibility, sanctioned amount, tenure, charges and
                final approval are subject to the applicable lender policy
                and customer profile.
              </div>

              <Link
                href={`/dsa/apply-loan?company=${encodeURIComponent(
                  selected.company
