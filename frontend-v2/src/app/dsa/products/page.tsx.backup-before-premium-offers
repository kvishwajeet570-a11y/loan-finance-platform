                <div className="border-b border-slate-100 p-5">

                  <div className="flex items-start justify-between gap-3">
                    <div className="flex items-center gap-3">
                      <div className="flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-br from-blue-700 to-cyan-500 text-sm font-black text-white shadow-lg">
                        {loan.initials}
                      </div>

                      <div>
                        <p className="text-xs font-bold text-slate-400">
                          {loan.company}
                        </p>
                        <h3 className="font-black text-slate-900">
                          {loan.name}
                        </h3>
                      </div>
                    </div>

                    <span className="rounded-full bg-blue-50 px-3 py-1 text-[10px] font-black text-blue-700">
                      {loan.badge}
                    </span>
                  </div>

                  <div className="mt-5 grid grid-cols-2 gap-3">
                    <div className="rounded-2xl bg-slate-50 p-4">
                      <p className="text-[10px] font-bold uppercase tracking-wider text-slate-400">
                        Loan Amount
                      </p>
                      <p className="mt-1 text-sm font-black text-slate-900">
                        {loan.amount}
                      </p>
                    </div>

                    <div className="rounded-2xl bg-slate-50 p-4">
                      <p className="text-[10px] font-bold uppercase tracking-wider text-slate-400">
                        Interest
                      </p>
                      <p className="mt-1 text-sm font-black text-slate-900">
