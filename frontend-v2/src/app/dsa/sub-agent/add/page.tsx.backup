"use client";

import { FormEvent, ReactNode, useState } from "react";
import DsaShell from "@/components/dsa/DsaShell";
import SubAgentHeroBanner from "@/components/dsa/SubAgentHeroBanner";

const API =
  process.env.NEXT_PUBLIC_API_URL || "http://localhost:5000/api";

type FieldProps = {
  label: string;
  placeholder: string;
  value: string;
  onChange: (value: string) => void;
  type?: string;
  inputMode?: "text" | "numeric" | "email" | "tel" | "url" | "search";
  icon: ReactNode;
  required?: boolean;
  right?: ReactNode;
};

function Field({
  label,
  placeholder,
  value,
  onChange,
  type = "text",
  inputMode,
  icon,
  required,
  right,
}: FieldProps) {
  return (
    <div>
      <label className="mb-2 block text-[13px] font-bold text-slate-800">
        {label}
        {required && <span className="ml-1 text-red-500">*</span>}
      </label>

      <div className="flex min-h-[50px] overflow-hidden rounded-xl border border-slate-200 bg-white transition-all duration-200 focus-within:border-blue-500 focus-within:ring-4 focus-within:ring-blue-500/10">
        <div className="flex w-[58px] shrink-0 items-center justify-center bg-blue-50 text-blue-600">
          {icon}
        </div>

        <input
          value={value}
          onChange={(e) => onChange(e.target.value)}
          className="min-w-0 flex-1 bg-transparent px-4 text-[14px] font-medium text-slate-800 outline-none placeholder:text-slate-400"
          placeholder={placeholder}
          type={type}
          inputMode={inputMode}
          autoComplete="off"
        />

        {right && (
          <div className="flex items-center px-4">
            {right}
          </div>
        )}
      </div>
    </div>
  );
}

function SvgIcon({
  children,
  size = 21,
}: {
  children: ReactNode;
  size?: number;
}) {
  return (
    <svg
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      strokeWidth="2"
      strokeLinecap="round"
      strokeLinejoin="round"
      aria-hidden="true"
    >
      {children}
    </svg>
  );
}

function InfoCard({
  title,
  icon,
  children,
  className,
}: {
  title: string;
  icon: ReactNode;
  children: ReactNode;
  className: string;
}) {
  return (
    <div className={`rounded-2xl p-4 shadow-sm ${className}`}>
      <div className="mb-5 flex items-center gap-3">
        <div className="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white text-blue-600 shadow-sm">
          {icon}
        </div>

        <h3 className="text-[17px] font-extrabold text-[#071b49]">
          {title}
        </h3>
      </div>

      <div className="space-y-3">{children}</div>
    </div>
  );
}

function Benefit({
  icon,
  title,
  subtitle,
  background,
}: {
  icon: ReactNode;
  title: string;
  subtitle: string;
  background: string;
}) {
  return (
    <div className="flex items-center gap-3 rounded-xl bg-white/10 p-3 backdrop-blur-sm">
      <div
        className={`flex h-11 w-11 shrink-0 items-center justify-center rounded-xl text-white shadow-lg ${background}`}
      >
        {icon}
      </div>

      <div>
        <div className="text-[13px] font-extrabold text-white">
          {title}
        </div>
        <div className="text-[11px] font-medium text-blue-100">
          {subtitle}
        </div>
      </div>
    </div>
  );
}

export default function AddSubAgentPage() {
  const [form, setForm] = useState({
    name: "",
    phoneNo: "",
    email: "",
    password: "",
    city: "",
    state: "",
    pincode: "",
  });

  const [loading, setLoading] = useState(false);
  const [message, setMessage] = useState("");
  const [error, setError] = useState("");
  const [showPassword, setShowPassword] = useState(false);

  const updateField = (field: string, value: string) => {
    setForm((prev) => ({
      ...prev,
      [field]: value,
    }));

    setMessage("");
    setError("");
  };

  const handleSubmit = async (e: FormEvent) => {
    e.preventDefault();
    setMessage("");
    setError("");

    if (
      !form.name ||
      !form.phoneNo ||
      !form.email ||
      !form.password
    ) {
      setError(
        "Name, mobile, email and password are required."
      );
      return;
    }

    if (!/^\d{10}$/.test(form.phoneNo)) {
      setError("Please enter a valid 10 digit mobile number.");
      return;
    }

    if (!/^\d{6}$/.test(form.pincode)) {
      setError("Please enter a valid 6 digit pincode.");
      return;
    }

    try {
      setLoading(true);

      const token =
        localStorage.getItem("loan_finance_token") || "";

      const rawUser =
        localStorage.getItem("loan_finance_user") || "";

      let user: any = null;

      try {
        user = rawUser ? JSON.parse(rawUser) : null;
      } catch {
        user = null;
      }

      const dsaId =
        user?.id ||
        user?.userId ||
        user?.dsaId ||
        "";

      if (!dsaId) {
        setError(
          "DSA session not found. Please login again."
        );
        return;
      }

      const response = await fetch(`${API}/sub-agent`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          ...(token
            ? {
                Authorization: `Bearer ${token}`,
              }
            : {}),
        },
        body: JSON.stringify({
          dsaId,
          ...form,
        }),
      });

      const result = await response.json();

      if (!response.ok || !result?.success) {
        throw new Error(
          result?.message ||
            "Failed to create Sub Agent."
        );
      }

      setMessage(
        "Sub Agent created successfully."
      );

      setForm({
        name: "",
        phoneNo: "",
        email: "",
        password: "",
        city: "",
        state: "",
        pincode: "",
      });
    } catch (err: any) {
      setError(
        err?.message ||
          "Something went wrong."
      );
    } finally {
      setLoading(false);
    }
  };

  return (
    <DsaShell>
      <SubAgentHeroBanner />
<div className="min-w-0 space-y-4">

        {/* BREADCRUMB */}
        <div className="flex flex-wrap items-center gap-2 px-1 text-[13px] text-slate-500">
          <SvgIcon size={16}>
            <path d="m3 10 9-7 9 7" />
            <path d="M5 9v11h14V9" />
            <path d="M9 20v-6h6v6" />
          </SvgIcon>

          <span>/</span>
          <span>Sub Agent</span>
          <span>/</span>
          <span className="font-semibold text-[#071b49]">
            Add New Sub Agent
          </span>
        </div>

        {/* HERO BANNER */}
        <section className="relative overflow-hidden rounded-2xl bg-gradient-to-r from-[#071b49] via-[#0b3fae] to-[#155eef] px-6 py-7 text-white shadow-lg lg:px-8 lg:py-8">

          <div className="absolute -right-24 -top-32 h-80 w-80 rounded-full bg-cyan-400/20 blur-3xl" />
          <div className="absolute -bottom-32 left-[40%] h-72 w-72 rounded-full bg-blue-300/10 blur-3xl" />

          <div className="relative grid items-center gap-7 xl:grid-cols-[1.15fr_.85fr]">

            <div>
              <h1 className="text-3xl font-extrabold tracking-tight sm:text-4xl">
                Add New{" "}
                <span className="text-[#f5b82e]">
                  Sub Agent
                </span>
              </h1>

              <p className="mt-3 max-w-[610px] text-[15px] leading-7 text-blue-100 sm:text-base">
                Register a new Sub Agent under your DSA account and
                grow your business together.
              </p>

              <div className="mt-6 grid gap-3 sm:grid-cols-3">

                <Benefit
                  title="Expand"
                  subtitle="Your Team"
                  background="bg-emerald-500"
                  icon={
                    <SvgIcon size={22}>
                      <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                      <circle cx="9" cy="7" r="4" />
                      <path d="M19 8v6M16 11h6" />
                    </SvgIcon>
                  }
                />

                <Benefit
                  title="Increase"
                  subtitle="Your Business"
                  background="bg-blue-500"
                  icon={
                    <SvgIcon size={22}>
                      <path d="M4 19V5" />
                      <path d="M4 19h17" />
                      <path d="m7 15 4-4 3 2 5-6" />
                    </SvgIcon>
                  }
                />

                <Benefit
                  title="Earn Higher"
                  subtitle="Commission"
                  background="bg-[#f5b82e]"
                  icon={
                    <span className="text-[21px] font-black">
                      ₹
                    </span>
                  }
                />

              </div>
            </div>

            {/* HERO TEAM VISUAL */}
            <div className="hidden justify-center xl:flex">
              <div className="relative h-[185px] w-[350px] overflow-hidden rounded-3xl border border-white/20 bg-white/10 p-4 backdrop-blur-md">

                <div className="absolute right-5 top-4 flex h-11 w-11 items-center justify-center rounded-full bg-[#f5b82e] text-xl font-black text-white shadow-lg">
                  ₹
                </div>

                <div className="absolute left-1/2 top-3 flex h-[62px] w-[62px] -translate-x-1/2 items-center justify-center rounded-full border-4 border-white/40 bg-white text-lg font-black text-[#155eef] shadow-xl">
                  D
                </div>

                <div className="absolute left-1/2 top-[65px] h-[30px] w-px bg-white/40" />

                <div className="absolute bottom-4 left-4 right-4 grid grid-cols-3 gap-3">
                  {["A", "B", "C"].map((item) => (
                    <div
                      key={item}
                      className="rounded-xl bg-white/15 p-2 text-center backdrop-blur"
                    >
                      <div className="mx-auto flex h-9 w-9 items-center justify-center rounded-full bg-white text-sm font-black text-[#155eef]">
                        {item}
                      </div>

                      <div className="mt-1 text-[9px] font-semibold text-white">
                        Sub Agent
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>

          </div>
        </section>

        {/* MAIN CONTENT */}
        <div className="grid gap-4 xl:grid-cols-[minmax(0,1fr)_305px]">

          {/* REGISTRATION */}
          <form
            onSubmit={handleSubmit}
            className="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm lg:p-5"
          >

            <div className="mb-4 flex items-center gap-3">

              <div className="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-blue-50 text-blue-600">
                <SvgIcon size={28}>
                  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                  <circle cx="9" cy="7" r="4" />
                  <path d="M19 8v6M16 11h6" />
                </SvgIcon>
              </div>

              <div>
                <h2 className="text-lg font-extrabold text-[#071b49] sm:text-2xl">
                  Sub Agent Registration
                </h2>

                <p className="mt-0.5 text-xs text-slate-500">
                  Fill in the details below to create a new Sub Agent.
                </p>
              </div>

            </div>

            {message && (
              <div className="mb-5 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-700">
                {message}
              </div>
            )}

            {error && (
              <div className="mb-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-700">
                {error}
              </div>
            )}

            <div className="grid gap-3.5 md:grid-cols-2">

              <Field
                label="Full Name"
                required
                placeholder="Enter full name"
                value={form.name}
                onChange={(value) =>
                  updateField("name", value)
                }
                icon={
                  <SvgIcon>
                    <circle cx="12" cy="7" r="4" />
                    <path d="M5.5 21a6.5 6.5 0 0 1 13 0" />
                  </SvgIcon>
                }
              />

              <Field
                label="Mobile Number"
                required
                placeholder="Enter 10 digit mobile number"
                value={form.phoneNo}
                inputMode="numeric"
                onChange={(value) =>
                  updateField(
                    "phoneNo",
                    value.replace(/\D/g, "").slice(0, 10)
                  )
                }
                icon={
                  <SvgIcon>
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.33 1.78.62 2.63a2 2 0 0 1-.45 2.11L8 9.73a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.85.29 1.73.5 2.63.62A2 2 0 0 1 22 16.92z" />
                  </SvgIcon>
                }
              />

              <Field
                label="Email Address"
                required
                type="email"
                placeholder="Enter email address"
                value={form.email}
                onChange={(value) =>
                  updateField("email", value)
                }
                icon={
                  <SvgIcon>
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <path d="m3 7 9 6 9-6" />
                  </SvgIcon>
                }
              />

              <Field
                label="Password"
                required
                type={showPassword ? "text" : "password"}
                placeholder="Enter password"
                value={form.password}
                onChange={(value) =>
                  updateField("password", value)
                }
                icon={
                  <SvgIcon>
                    <rect x="4" y="10" width="16" height="11" rx="2" />
                    <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                  </SvgIcon>
                }
                right={
                  <button
                    type="button"
                    onClick={() =>
                      setShowPassword((prev) => !prev)
                    }
                    className="text-blue-600"
                    aria-label={
                      showPassword
                        ? "Hide password"
                        : "Show password"
                    }
                  >
                    <SvgIcon size={20}>
                      {showPassword ? (
                        <>
                          <path d="m3 3 18 18" />
                          <path d="M10.6 10.6a2 2 0 0 0 2.8 2.8" />
                          <path d="M9.9 4.24A10.8 10.8 0 0 1 12 4c6.5 0 10 8 10 8a18.5 18.5 0 0 1-3.1 4.3" />
                          <path d="M6.6 6.6C3.5 8.6 2 12 2 12s3.5 8 10 8a10.8 10.8 0 0 0 4.1-.8" />
                        </>
                      ) : (
                        <>
                          <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />
                          <circle cx="12" cy="12" r="3" />
                        </>
                      )}
                    </SvgIcon>
                  </button>
                }
              />

              <Field
                label="City"
                required
                placeholder="Enter city"
                value={form.city}
                onChange={(value) =>
                  updateField("city", value)
                }
                icon={
                  <SvgIcon>
                    <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" />
                    <circle cx="12" cy="10" r="2.5" />
                  </SvgIcon>
                }
              />

              <Field
                label="State"
                required
                placeholder="Enter state"
                value={form.state}
                onChange={(value) =>
                  updateField("state", value)
                }
                icon={
                  <SvgIcon>
                    <path d="M4 20V8l8-5 8 5v12" />
                    <path d="M8 20v-5h8v5" />
                    <path d="M9 9h.01M15 9h.01" />
                  </SvgIcon>
                }
              />

              <div className="md:col-span-2">
                <Field
                  label="Pincode"
                  required
                  placeholder="Enter 6 digit pincode"
                  value={form.pincode}
                  inputMode="numeric"
                  onChange={(value) =>
                    updateField(
                      "pincode",
                      value.replace(/\D/g, "").slice(0, 6)
                    )
                  }
                  icon={
                    <SvgIcon>
                      <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" />
                      <circle cx="12" cy="10" r="2.5" />
                    </SvgIcon>
                  }
                />
              </div>

            </div>

            <button
              type="submit"
              disabled={loading}
              className="mt-7 flex min-h-[50px] w-full items-center justify-center gap-3 rounded-xl bg-gradient-to-r from-[#155eef] via-[#0ea5e9] to-[#10b981] px-6 text-[16px] font-extrabold text-white shadow-lg shadow-blue-200 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-xl disabled:cursor-not-allowed disabled:opacity-60"
            >
              {loading ? (
                <>
                  <span className="h-5 w-5 animate-spin rounded-full border-2 border-white border-t-transparent" />
                  Creating Sub Agent...
                </>
              ) : (
                <>
                  <SvgIcon size={21}>
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M19 8v6M16 11h6" />
                  </SvgIcon>
                  Add Sub Agent
                </>
              )}
            </button>

          </form>

          {/* RIGHT SIDE CARDS */}
          <aside className="space-y-4">

            <InfoCard
              title="Why Add Sub Agent?"
              className="bg-emerald-50"
              icon={
                <SvgIcon size={22}>
                  <path d="M8 21h8" />
                  <path d="M12 17v4" />
                  <path d="M7 4h10v5a5 5 0 0 1-10 0V4Z" />
                  <path d="M7 7H3v1a4 4 0 0 0 4 4M17 7h4v1a4 4 0 0 1-4 4" />
                </SvgIcon>
              }
            >
              {[
                "Increase your business network",
                "Earn higher commission",
                "Manage your team easily",
                "Track performance in real-time",
              ].map((item) => (
                <div
                  key={item}
                  className="flex items-start gap-3 text-[13px] text-slate-700"
                >
                  <span className="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500 text-xs font-bold text-white">
                    ✓
                  </span>
                  <span>{item}</span>
                </div>
              ))}
            </InfoCard>

            <InfoCard
              title="Important Note"
              className="bg-amber-50"
              icon={
                <SvgIcon size={22}>
                  <path d="M9 18h6" />
                  <path d="M10 22h4" />
                  <path d="M8.5 14.5A6 6 0 1 1 15.5 14" />
                  <path d="M12 2v2M4.9 4.9l1.4 1.4M19.1 4.9l-1.4 1.4" />
                </SvgIcon>
              }
            >
              {[
                "Sub Agent will be created under your DSA account.",
                "They can apply for available loan products.",
                "You can track their applications, business and commission.",
              ].map((item, index) => (
                <div
                  key={item}
                  className="flex items-start gap-3 text-[13px] text-slate-700"
                >
                  <span className="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#f5b82e] text-xs font-bold text-white">
                    {index + 1}
                  </span>
                  <span>{item}</span>
                </div>
              ))}
            </InfoCard>

            <InfoCard
              title="Need Help?"
              className="bg-blue-50"
              icon={
                <SvgIcon size={22}>
                  <path d="M4 14a8 8 0 0 1 16 0" />
                  <path d="M4 14v4a2 2 0 0 0 2 2h2v-6H4Z" />
                  <path d="M20 14v4a2 2 0 0 1-2 2h-2v-6h4Z" />
                  <path d="M16 20h2" />
                </SvgIcon>
              }
            >
              <p className="text-[13px] leading-6 text-slate-600">
                Contact our support team for any assistance.
              </p>

              <button
                type="button"
                className="mt-1 w-full rounded-xl border-2 border-blue-600 bg-white px-4 py-3 text-[13px] font-bold text-blue-600 transition hover:bg-blue-600 hover:text-white"
              >
                Contact Support
              </button>
            </InfoCard>

          </aside>
        </div>
      </div>
    </DsaShell>
  );
}




