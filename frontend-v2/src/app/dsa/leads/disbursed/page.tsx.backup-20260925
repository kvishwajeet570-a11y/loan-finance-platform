  const filteredLeads = useMemo(() => {
    const q = search.trim().toLowerCase();

    return leads.filter((lead) => {
      const searchMatch =
        !q ||
        [
          lead.id,
          lead.fullName,
          lead.phone,
          lead.email,
          lead.loanType,
          lead.companyName,
          lead.city,
          lead.state,
