          .filter(Boolean)
          .some((value) =>
            String(value).toLowerCase().includes(q)
          );

      const typeMatch =
        loanType === "ALL" ||
        String(lead.loanType || "") === loanType;

      const lenderMatch =
        lender === "ALL" ||
        String(lead.companyName || "") === lender;

      let dateMatch = true;

      if (dateRange !== "ALL" && lead.createdAt) {
        const created = new Date(lead.createdAt);
        const now = new Date();

        if (dateRange === "TODAY") {
          dateMatch =
            created.toDateString() === now.toDateString();
        }

        if (dateRange === "7") {
          dateMatch =
            now.getTime() - created.getTime() <=
            7 * 24 * 60 * 60 * 1000;
        }

        if (dateRange === "30") {
          dateMatch =
            now.getTime() - created.getTime() <=
            30 * 24 * 60 * 60 * 1000;
        }
      }

      return (
        searchMatch &&
        typeMatch &&
        lenderMatch &&
        dateMatch
      );
    });
