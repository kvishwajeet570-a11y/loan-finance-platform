"use client";

import { useEffect, useMemo, useState } from "react";
import DsaShell from "@/components/dsa/DsaShell";
import {
  Search,
  RefreshCw,
  Eye,
  Phone,
  MessageCircle,
  ChevronLeft,
  ChevronRight,
  Users,
  CheckCircle2,
  Clock3,
  XCircle,
  IndianRupee,
  CalendarDays,
  BriefcaseBusiness,
  Download,
  X,
  SlidersHorizontal,
} from "lucide-react";

const API =
  process.env.NEXT_PUBLIC_API_URL || "http://localhost:5000/api";

type Lead = {
  id: string;
  fullName?: string;
  phone?: string;
  email?: string;
  loanType?: string;
  amount?: number;
  status?: string;
  createdAt?: string;
  updatedAt?: string;
  city?: string;
  state?: string;
  panNo?: string;
  purpose?: string;
  assignedTo?: string;
};

function money(value: number) {
  return `${String.fromCharCode(0x20b9)}${Number(
    value || 0
  ).toLocaleString("en-IN")}`;
}

function formatDate(value?: string) {
  if (!value) return "—";

  const d = new Date(value);

  if (Number.isNaN(d.getTime())) return "—";

  return d.toLocaleString("en-IN", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  });
}

function normalizeStatus(status?: string) {
  return String(status || "PENDING")
    .replaceAll("_", " ")
    .trim();
}

function statusClass(status?: string) {
  const s = String(status || "").toUpperCase();

  if (
    s.includes("APPROVED") ||
    s.includes("DISBURSED") ||
    s.includes("SUCCESS")
  ) {
    return "border-emerald-200 bg-emerald-50 text-emerald-700";
  }

  if (
    s.includes("REJECT") ||
    s.includes("CANCEL")
  ) {
    return "border-red-200 bg-red-50 text-red-600";
  }

  if (
    s.includes("QUERY") ||
    s.includes("DOCUMENT")
  ) {
    return "border-orange-200 bg-orange-50 text-orange-700";
  }

  return "border-blue-200 bg-blue-50 text-blue-700";
}

export default function DsaLeadsPage() {
  const [leads, setLeads] = useState<Lead[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  const [search, setSearch] = useState("");
  const [status, setStatus] = useState("ALL");
  const [loanType, setLoanType] = useState("ALL");
  const [pageSize, setPageSize] = useState(10);
  const [page, setPage] = useState(1);

  const [selectedLead, setSelectedLead] =
    useState<Lead | null>(null);

  const getLeads = async () => {
    setLoading(true);
    setError("");

    try {
      const raw = localStorage.getItem("loan_finance_user");

      if (!raw) {
        throw new Error("DSA login session not found.");
      }

      const user = JSON.parse(raw);

      if (!user?.id) {
        throw new Error("Invalid DSA user session.");
      }

      const token = localStorage.getItem("loan_finance_token");

      const res = await fetch(
        `${API}/dsa/${user.id}/loans`,
        {
          cache: "no-store",
          headers: token
            ? {
                Authorization: `Bearer ${token}`,
              }
            : {},
        }
      );

      const data = await res.json().catch(() => ({}));

      if (!res.ok) {
        throw new Error(
          data?.message || "Unable to load leads."
        );
      }

      const rawLeads =
        Array.isArray(data?.data)
          ? data.data
          : data?.data?.loans ||
            data?.data?.leads ||
            data?.loans ||
            data?.leads ||
            [];

      setLeads(
        Array.isArray(rawLeads)
          ? rawLeads
          : []
      );
    } catch (err: any) {
      setError(
        err?.message ||
          "Unable to load real lead data."
      );
      setLeads([]);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    getLeads();
  }, []);

  const loanTypes = useMemo(() => {
    return Array.from(
      new Set(
        leads
          .map((x) => x.loanType)
          .filter(Boolean)
          .map(String)
      )
    );
  }, [leads]);

  const filtered = useMemo(() => {
    const q = search.trim().toLowerCase();

    return leads.filter((lead) => {
      const matchesSearch =
        !q ||
        [
          lead.fullName,
          lead.phone,
          lead.email,
          lead.loanType,
          lead.city,
          lead.state,
          lead.id,
          lead.panNo,
        ]
          .filter(Boolean)
          .some((v) =>
            String(v)
              .toLowerCase()
              .includes(q)
          );

      const matchesStatus =
        status === "ALL" ||
        String(lead.status || "")
          .toUpperCase()
          .includes(status);

      const matchesLoan =
        loanType === "ALL" ||
        String(lead.loanType || "") === loanType;

      return (
        matchesSearch &&
        matchesStatus &&
        matchesLoan
      );
    });
  }, [leads, search, status, loanType]);

  const totalPages = Math.max(
    1,
    Math.ceil(filtered.length / pageSize)
  );

  useEffect(() => {
    if (page > totalPages) {
      setPage(totalPages);
    }
  }, [page, totalPages]);

  const visibleLeads = filtered.slice(
    (page - 1) * pageSize,
    page * pageSize
  );

  const stats = useMemo(() => {
    const total = leads.length;

    const approved = leads.filter((x) =>
      String(x.status || "")
        .toUpperCase()
        .includes("APPROVED")
    ).length;

    const rejected = leads.filter((x) =>
      String(x.status || "")
        .toUpperCase()
        .includes("REJECT")
    ).length;

    const inProcess = leads.filter((x) => {
      const s = String(x.status || "").toUpperCase();

      return (
        !s.includes("APPROVED") &&
        !s.includes("REJECT") &&
        !s.includes("DISBURSED")
      );
    }).length;

    const amount = leads.reduce(
      (sum, x) =>
        sum + Number(x.amount || 0),
      0
    );

    return {
      total,
      approved,
      rejected,
      inProcess,
      amount,
    };
  }, [leads]);

  const exportCSV = () => {
    const rows = filtered.map((x) => ({
      ID: x.id,
      Customer: x.fullName || "",
      Phone: x.phone || "",
      Email: x.email || "",
      "Loan Type": x.loanType || "",
      Amount: x.amount || 0,
      Status: x.status || "",
      City: x.city || "",
      State: x.state || "",
      Created: x.createdAt || "",
    }));

    const headers = Object.keys(
      rows[0] || {
        ID: "",
        Customer: "",
        Phone: "",
        Email: "",
        "Loan Type": "",
        Amount: "",
        Status: "",
        City: "",
        State: "",
        Created: "",
      }
    );

    const csv = [
      headers.join(","),
      ...rows.map((row) =>
        headers
          .map((key) =>
            `"${String(
              (row as any)[key] ?? ""
            ).replaceAll('"', '""')}"`
          )
          .join(",")
      ),
    ].join("\n");

    const blob = new Blob([csv], {
      type: "text/csv;charset=utf-8;",
    });

    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");

    a.href = url;
    a.download = "dsa-real-leads.csv";
    a.click();

    URL.revokeObjectURL(url);
  };

  return (
    <DsaShell>
      <div className="min-h-screen bg-slate-50">

        {/* HEADER */}
        <div className="border-b bg-white">
          <div className="mx-auto flex max-w-[1600px] items-center gap-4 px-4 py-4 lg:px-7">

            <div className="flex h-11 w-11 items-center justify-center rounded-xl bg-indigo-700 text-white">
              <Users size={22} />
            </div>

            <div className="min-w-0 flex-1">
              <div className="text-xs font-bold uppercase tracking-[0.18em] text-indigo-600">
                Leads Management
              </div>

              <h1 className="text-2xl font-black tracking-tight text-slate-900">
                My Leads
              </h1>

              <p className="hidden text-sm text-slate-500 sm:block">
                Manage your assigned loan leads using live backend data.
              </p>
            </div>

            <button
              onClick={getLeads}
              disabled={loading}
              className="flex h-10 items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 text-sm font-bold text-slate-700 shadow-sm transition hover:border-indigo-300 hover:text-indigo-700 disabled:opacity-50"
            >
              <RefreshCw
                size={16}
                className={loading ? "animate-spin" : ""}
              />
              <span className="hidden sm:inline">
                Refresh
              </span>
            </button>

            <button
              onClick={exportCSV}
              className="flex h-10 items-center gap-2 rounded-xl bg-indigo-600 px-4 text-sm font-bold text-white shadow-lg shadow-indigo-600/20 transition hover:bg-indigo-700"
            >
              <Download size={16} />
              <span className="hidden sm:inline">
                Export
              </span>
            </button>
          </div>
        </div>

        <main className="mx-auto max-w-[1600px] space-y-5 px-4 py-6 lg:px-7">

          {/* HERO */}
          <section className="relative overflow-hidden rounded-3xl bg-gradient-to-r from-[#17104d] via-[#312078] to-[#5b21b6] p-6 text-white shadow-xl lg:p-8">

            <div className="relative z-10 max-w-2xl">
              <div className="mb-2 text-xs font-black uppercase tracking-[0.2em] text-violet-200">
                DSA FinCorp
              </div>

              <h2 className="text-3xl font-black tracking-tight lg:text-4xl">
                My Leads
              </h2>

              <p className="mt-2 text-sm text-violet-100 lg:text-base">
                Track, follow up and manage your real loan leads.
              </p>
            </div>

            <div className="absolute -right-20 -top-32 h-80 w-80 rounded-full bg-violet-400/20 blur-3xl" />
            <div className="absolute -bottom-32 right-40 h-72 w-72 rounded-full bg-blue-400/20 blur-3xl" />
          </section>

          {/* STATS */}
          <section className="grid grid-cols-2 gap-3 lg:grid-cols-5">

            <StatCard
              title="Total Leads"
              value={stats.total}
              icon={<Users size={21} />}
              iconClass="bg-blue-50 text-blue-600"
            />

            <StatCard
              title="In Process"
              value={stats.inProcess}
              icon={<Clock3 size={21} />}
              iconClass="bg-orange-50 text-orange-600"
            />

            <StatCard
              title="Approved"
              value={stats.approved}
              icon={<CheckCircle2 size={21} />}
              iconClass="bg-emerald-50 text-emerald-600"
            />

            <StatCard
              title="Rejected"
              value={stats.rejected}
              icon={<XCircle size={21} />}
              iconClass="bg-red-50 text-red-600"
            />

            <StatCard
              title="Total Loan Amount"
              value={money(stats.amount)}
              icon={<IndianRupee size={21} />}
              iconClass="bg-violet-50 text-violet-600"
              wide
            />

          </section>

          {/* FILTER CARD */}
          <section className="rounded-3xl border border-slate-200 bg-white p-4 shadow-sm lg:p-5">

            <div className="mb-4 flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">

              <div>
                <div className="flex items-center gap-2 text-base font-black text-slate-900">
                  <SlidersHorizontal size={18} className="text-indigo-600" />
                  Lead Filters
                </div>

                <p className="mt-1 text-xs text-slate-500">
                  Search and filter the live records assigned to you.
                </p>
              </div>

              <div className="flex items-center gap-2 text-xs font-semibold text-slate-500">
                Showing {filtered.length} of {leads.length} records
              </div>

            </div>

            <div className="grid gap-3 lg:grid-cols-[1.6fr_0.8fr_0.9fr_auto]">

              <div className="relative">
                <Search
                  size={18}
                  className="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"
                />

                <input
                  value={search}
                  onChange={(e) => {
                    setSearch(e.target.value);
                    setPage(1);
                  }}
                  placeholder="Search name, phone, city, loan type or ID..."
                  className="h-12 w-full rounded-xl border border-slate-200 bg-slate-50 pl-11 pr-4 text-sm font-medium outline-none transition focus:border-indigo-500 focus:bg-white focus:ring-4 focus:ring-indigo-100"
                />
              </div>

              <select
                value={status}
                onChange={(e) => {
                  setStatus(e.target.value);
                  setPage(1);
                }}
                className="h-12 rounded-xl border border-slate-200 bg-slate-50 px-4 text-sm font-bold text-slate-700 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100"
              >
                <option value="ALL">All Status</option>
                <option value="PENDING">Pending</option>
                <option value="APPROVED">Approved</option>
                <option value="REJECTED">Rejected</option>
                <option value="DISBURSED">Disbursed</option>
              </select>

              <select
                value={loanType}
                onChange={(e) => {
                  setLoanType(e.target.value);
                  setPage(1);
                }}
                className="h-12 rounded-xl border border-slate-200 bg-slate-50 px-4 text-sm font-bold text-slate-700 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100"
              >
                <option value="ALL">All Loan Types</option>

                {loanTypes.map((type) => (
                  <option key={type} value={type}>
                    {type}
                  </option>
                ))}
              </select>

              <button
                onClick={() => {
                  setSearch("");
                  setStatus("ALL");
                  setLoanType("ALL");
                  setPage(1);
                }}
                className="h-12 rounded-xl border border-slate-200 bg-white px-5 text-sm font-black text-slate-700 transition hover:border-indigo-300 hover:text-indigo-700"
              >
                Reset
              </button>

            </div>
          </section>

          {/* ERROR */}
          {error && (
            <div className="rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-sm font-semibold text-red-700">
              {error}
            </div>
          )}

          {/* TABLE */}
          <section className="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">

            <div className="flex flex-col gap-3 border-b border-slate-100 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">

              <div className="flex items-center gap-3">
                <h3 className="text-lg font-black text-slate-900">
                  Lead Records
                </h3>

                <span className="rounded-full bg-indigo-50 px-3 py-1 text-xs font-black text-indigo-700">
                  {filtered.length}
                </span>
              </div>

              <div className="flex items-center gap-2 text-sm">
                <span className="font-semibold text-slate-500">
                  Show
                </span>

                <select
                  value={pageSize}
                  onChange={(e) => {
                    setPageSize(Number(e.target.value));
                    setPage(1);
                  }}
                  className="rounded-lg border border-slate-200 bg-white px-3 py-2 font-bold outline-none focus:border-indigo-500"
                >
                  <option value={10}>10</option>
                  <option value={25}>25</option>
                  <option value={50}>50</option>
                  <option value={100}>100</option>
                </select>

                <span className="font-semibold text-slate-500">
                  entries
                </span>
              </div>
            </div>

            {loading ? (
              <div className="flex min-h-[420px] items-center justify-center">
                <div className="text-center">
                  <RefreshCw
                    size={34}
                    className="mx-auto animate-spin text-indigo-600"
                  />

                  <p className="mt-3 text-sm font-bold text-slate-600">
                    Loading real leads...
                  </p>
                </div>
              </div>
            ) : visibleLeads.length === 0 ? (
              <div className="flex min-h-[420px] flex-col items-center justify-center px-6 text-center">
                <div className="flex h-16 w-16 items-center justify-center rounded-2xl bg-slate-100 text-slate-400">
                  <Users size={30} />
                </div>

                <h3 className="mt-4 text-lg font-black text-slate-900">
                  No leads found
                </h3>

                <p className="mt-1 max-w-md text-sm text-slate-500">
                  No matching records were returned from the backend for this DSA.
                </p>
              </div>
            ) : (
              <>
                {/* DESKTOP */}
                <div className="hidden overflow-x-auto lg:block">

                  <table className="w-full min-w-[1200px] border-collapse">

                    <thead>
                      <tr className="bg-gradient-to-r from-[#24115d] to-[#42208f] text-left text-[11px] font-black uppercase tracking-wider text-white">
                        <th className="px-4 py-4">#</th>
                        <th className="px-4 py-4">Actions</th>
                        <th className="px-4 py-4">Status</th>
                        <th className="px-4 py-4">
                          Last Updated / Lead Date
                        </th>
                        <th className="px-4 py-4">Customer</th>
                        <th className="px-4 py-4">Product</th>
                        <th className="px-4 py-4">Amount</th>
                        <th className="px-4 py-4">Location</th>
                      </tr>
                    </thead>

                    <tbody>
                      {visibleLeads.map((lead, index) => {
                        const number =
                          (page - 1) * pageSize +
                          index +
                          1;

                        return (
                          <tr
                            key={lead.id}
                            className="border-b border-slate-100 transition hover:bg-indigo-50/40"
                          >
                            <td className="px-4 py-4 text-sm font-bold text-slate-500">
                              {number}
                            </td>

                            <td className="px-4 py-4">
                              <div className="flex items-center gap-2">
                                <button
                                  onClick={() =>
                                    setSelectedLead(lead)
                                  }
                                  className="rounded-full bg-violet-600 px-4 py-2 text-xs font-black text-white shadow-sm transition hover:bg-violet-700"
                                >
                                  View
                                </button>

                                {lead.phone && (
                                  <a
                                    href={`tel:${lead.phone}`}
                                    className="rounded-full bg-emerald-500 px-3 py-2 text-xs font-black text-white transition hover:bg-emerald-600"
                                  >
                                    Call
                                  </a>
                                )}
                              </div>
                            </td>

                            <td className="px-4 py-4">
                              <span
                                className={`inline-flex rounded-full border px-3 py-1.5 text-xs font-black ${statusClass(
                                  lead.status
                                )}`}
                              >
                                {normalizeStatus(
                                  lead.status
                                )}
                              </span>
                            </td>

                            <td className="px-4 py-4">
                              <div className="space-y-1 text-xs font-semibold text-slate-600">
                                <div className="flex items-center gap-1.5">
                                  <CalendarDays
                                    size={13}
                                    className="text-indigo-500"
                                  />
                                  {formatDate(
                                    lead.updatedAt ||
                                      lead.createdAt
                                  )}
                                </div>

                                <div className="text-[11px] text-slate-400">
                                  Lead:{" "}
                                  {formatDate(
                                    lead.createdAt
                                  )}
                                </div>
                              </div>
                            </td>

                            <td className="px-4 py-4">
                              <div className="font-bold text-slate-900">
                                {lead.fullName || "—"}
                              </div>

                              {lead.phone && (
                                <div className="mt-1 text-xs text-slate-500">
                                  {lead.phone}
                                </div>
                              )}
                            </td>

                            <td className="px-4 py-4">
                              <span className="font-bold text-orange-600">
                                {lead.loanType || "—"}
                              </span>
                            </td>

                            <td className="px-4 py-4 text-sm font-black text-slate-800">
                              {money(
                                Number(lead.amount || 0)
                              )}
                            </td>

                            <td className="px-4 py-4 text-xs font-semibold text-slate-500">
                              {[lead.city, lead.state]
                                .filter(Boolean)
                                .join(", ") || "—"}
                            </td>
                          </tr>
                        );
                      })}
                    </tbody>

                  </table>
                </div>

                {/* MOBILE */}
                <div className="divide-y divide-slate-100 lg:hidden">
                  {visibleLeads.map((lead, index) => (
                    <div
                      key={lead.id}
                      className="p-4"
                    >
                      <div className="flex items-start justify-between gap-3">

                        <div className="min-w-0">
                          <div className="text-xs font-bold text-slate-400">
                            #
                            {(page - 1) *
                              pageSize +
                              index +
                              1}
                          </div>

                          <div className="mt-1 truncate text-base font-black text-slate-900">
                            {lead.fullName || "—"}
                          </div>

                          <div className="mt-1 text-xs text-slate-500">
                            {lead.phone || "No phone"}
                          </div>
                        </div>

                        <span
                          className={`shrink-0 rounded-full border px-3 py-1.5 text-[11px] font-black ${statusClass(
                            lead.status
                          )}`}
                        >
                          {normalizeStatus(
                            lead.status
                          )}
                        </span>
                      </div>

                      <div className="mt-4 grid grid-cols-2 gap-3 rounded-2xl bg-slate-50 p-3">

                        <div>
                          <div className="text-[10px] font-bold uppercase text-slate-400">
                            Product
                          </div>

                          <div className="mt-1 text-xs font-black text-orange-600">
                            {lead.loanType || "—"}
                          </div>
                        </div>

                        <div>
                          <div className="text-[10px] font-bold uppercase text-slate-400">
                            Amount
                          </div>

                          <div className="mt-1 text-xs font-black text-slate-900">
                            {money(
                              Number(lead.amount || 0)
                            )}
                          </div>
                        </div>

                        <div>
                          <div className="text-[10px] font-bold uppercase text-slate-400">
                            Lead Date
                          </div>

                          <div className="mt-1 text-xs font-semibold text-slate-600">
                            {formatDate(
                              lead.createdAt
                            )}
                          </div>
                        </div>

                        <div>
                          <div className="text-[10px] font-bold uppercase text-slate-400">
                            Location
                          </div>

                          <div className="mt-1 truncate text-xs font-semibold text-slate-600">
                            {[lead.city, lead.state]
                              .filter(Boolean)
                              .join(", ") || "—"}
                          </div>
                        </div>

                      </div>

                      <div className="mt-3 flex gap-2">

                        <button
                          onClick={() =>
                            setSelectedLead(lead)
                          }
                          className="flex flex-1 items-center justify-center gap-2 rounded-xl bg-violet-600 py-2.5 text-xs font-black text-white"
                        >
                          <Eye size={15} />
                          View
                        </button>

                        {lead.phone && (
                          <>
                            <a
                              href={`tel:${lead.phone}`}
                              className="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-500 text-white"
                            >
                              <Phone size={16} />
                            </a>

                            <a
                              href={`https://wa.me/91${String(
                                lead.phone
                              ).replace(/\D/g, "")}`}
                              target="_blank"
                              rel="noreferrer"
                              className="flex h-10 w-10 items-center justify-center rounded-xl bg-green-600 text-white"
                            >
                              <MessageCircle size={17} />
                            </a>
                          </>
                        )}

                      </div>
                    </div>
                  ))}
                </div>
              </>
            )}

            {/* PAGINATION */}
            {!loading && filtered.length > 0 && (
              <div className="flex flex-col gap-3 border-t border-slate-100 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">

                <div className="text-xs font-semibold text-slate-500">
                  Showing{" "}
                  {(page - 1) * pageSize + 1}{" "}
                  to{" "}
                  {Math.min(
                    page * pageSize,
                    filtered.length
                  )}{" "}
                  of {filtered.length} entries
                </div>

                <div className="flex items-center gap-1">

                  <button
                    disabled={page <= 1}
                    onClick={() =>
                      setPage((p) =>
                        Math.max(1, p - 1)
                      )
                    }
                    className="flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-600 disabled:opacity-40"
                  >
                    <ChevronLeft size={17} />
                  </button>

                  {Array.from(
                    { length: Math.min(totalPages, 5) },
                    (_, i) => i + 1
                  ).map((p) => (
                    <button
                      key={p}
                      onClick={() => setPage(p)}
                      className={`h-9 min-w-9 rounded-lg px-3 text-xs font-black ${
                        page === p
                          ? "bg-indigo-600 text-white shadow-lg shadow-indigo-600/20"
                          : "border border-slate-200 bg-white text-slate-600 hover:border-indigo-300"
                      }`}
                    >
                      {p}
                    </button>
                  ))}

                  <button
                    disabled={page >= totalPages}
                    onClick={() =>
                      setPage((p) =>
                        Math.min(totalPages, p + 1)
                      )
                    }
                    className="flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-600 disabled:opacity-40"
                  >
                    <ChevronRight size={17} />
                  </button>

                </div>
              </div>
            )}

          </section>
        </main>

        {/* VIEW MODAL */}
        {selectedLead && (
          <div
            className="fixed inset-0 z-[9999] flex items-center justify-center bg-slate-950/70 p-4 backdrop-blur-sm"
            onClick={() => setSelectedLead(null)}
          >
            <div
              onClick={(e) =>
                e.stopPropagation()
              }
              className="w-full max-w-2xl overflow-hidden rounded-3xl bg-white shadow-2xl"
            >

              <div className="bg-gradient-to-r from-[#24115d] to-[#5b21b6] px-6 py-5 text-white">

                <div className="flex items-center justify-between">
                  <div>
                    <div className="text-xs font-bold uppercase tracking-wider text-violet-200">
                      Lead Details
                    </div>

                    <h3 className="mt-1 text-xl font-black">
                      {selectedLead.fullName || "Lead"}
                    </h3>
                  </div>

                  <button
                    onClick={() =>
                      setSelectedLead(null)
                    }
                    className="flex h-10 w-10 items-center justify-center rounded-full bg-white/15 text-white hover:bg-white/25"
                  >
                    <X size={20} />
                  </button>
                </div>

              </div>

              <div className="grid gap-4 p-6 sm:grid-cols-2">

                <Detail
                  label="Customer Name"
                  value={
                    selectedLead.fullName
                  }
                />

                <Detail
                  label="Phone"
                  value={
                    selectedLead.phone
                  }
                />

                <Detail
                  label="Email"
                  value={
                    selectedLead.email
                  }
                />

                <Detail
                  label="Loan Type"
                  value={
                    selectedLead.loanType
                  }
                />

                <Detail
                  label="Loan Amount"
                  value={money(
                    Number(
                      selectedLead.amount || 0
                    )
                  )}
                />

                <Detail
                  label="Status"
                  value={normalizeStatus(
                    selectedLead.status
                  )}
                />

                <Detail
                  label="City"
                  value={selectedLead.city}
                />

                <Detail
                  label="State"
                  value={selectedLead.state}
                />

                <Detail
                  label="PAN"
                  value={selectedLead.panNo}
                />

                <Detail
                  label="Purpose"
                  value={selectedLead.purpose}
                />

                <Detail
                  label="Created"
                  value={formatDate(
                    selectedLead.createdAt
                  )}
                />

                <Detail
                  label="Last Updated"
                  value={formatDate(
                    selectedLead.updatedAt ||
                      selectedLead.createdAt
                  )}
                />

              </div>

              <div className="flex flex-wrap gap-3 border-t border-slate-100 bg-slate-50 px-6 py-4">

                {selectedLead.phone && (
                  <>
                    <a
                      href={`tel:${selectedLead.phone}`}
                      className="flex items-center gap-2 rounded-xl bg-emerald-500 px-5 py-3 text-sm font-black text-white"
                    >
                      <Phone size={16} />
                      Call Customer
                    </a>

                    <a
                      href={`https://wa.me/91${String(
                        selectedLead.phone
                      ).replace(/\D/g, "")}`}
                      target="_blank"
                      rel="noreferrer"
                      className="flex items-center gap-2 rounded-xl bg-green-600 px-5 py-3 text-sm font-black text-white"
                    >
                      <MessageCircle size={16} />
                      WhatsApp
                    </a>
                  </>
                )}

              </div>

            </div>
          </div>
        )}

      </div>
    </DsaShell>
  );
}

function StatCard({
  title,
  value,
  icon,
  iconClass,
  wide,
}: {
  title: string;
  value: string | number;
  icon: React.ReactNode;
  iconClass: string;
  wide?: boolean;
}) {
  return (
    <div
      className={`rounded-2xl border border-slate-200 bg-white p-4 shadow-sm ${
        wide ? "col-span-2 lg:col-span-1" : ""
      }`}
    >
      <div className="flex items-center gap-3">
        <div
          className={`flex h-11 w-11 shrink-0 items-center justify-center rounded-xl ${iconClass}`}
        >
          {icon}
        </div>

        <div className="min-w-0">
          <div className="truncate text-xs font-bold text-slate-500">
            {title}
          </div>

          <div className="mt-1 truncate text-xl font-black text-slate-900">
            {value}
          </div>
        </div>
      </div>
    </div>
  );
}

function Detail({
  label,
  value,
}: {
  label: string;
  value?: string | number;
}) {
  return (
    <div className="rounded-2xl border border-slate-100 bg-slate-50 p-4">
      <div className="text-[10px] font-black uppercase tracking-wider text-slate-400">
        {label}
      </div>

      <div className="mt-1 break-words text-sm font-bold text-slate-800">
        {value || "—"}
      </div>
    </div>
  );
}

