                  Real LoanApplication records assigned to this DSA
                </p>
              </div>

              <div className="flex items-center gap-2 text-xs font-bold text-slate-500">
                Show

                <select
                  value={pageSize}
                  onChange={(e) => {
                    setPageSize(
                      Number(
                        e.target.value
                      )
                    );
                    setPage(1);
                  }}
                  className="rounded-lg border border-slate-200 bg-white px-2 py-1.5 font-black text-slate-700 outline-none"
                >
                  <option value={10}>
                    10
                  </option>
                  <option value={25}>
                    25
                  </option>
                  <option value={50}>
                    50
                  </option>
                  <option value={100}>
                    100
                  </option>
                </select>

                entries
              </div>

            </div>

            {loading ? (
              <div className="flex min-h-[380px] flex-col items-center justify-center">
                <RefreshCw
                  size={30}
                  className="animate-spin text-indigo-600"
                />

                <p className="mt-3 text-sm font-black text-slate-600">
                  Loading real leads...
                </p>
              </div>
            ) : currentLeads.length === 0 ? (
              <div className="flex min-h-[380px] flex-col items-center justify-center px-5 text-center">

                <div className="flex h-16 w-16 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-500">
                  <Users size={29} />
                </div>

                <h3 className="mt-4 text-lg font-black text-slate-900">
                  No leads found
                </h3>

                <p className="mt-1 max-w-md text-xs font-medium text-slate-500">
                  {leads.length === 0
                    ? "No LoanApplication records are currently assigned to this DSA."
                    : "No real records match the selected filters."}
                </p>

                {leads.length > 0 && (
                  <button
                    onClick={resetFilter}
                    className="mt-4 rounded-xl bg-indigo-600 px-5 py-2.5 text-xs font-black text-white"
                  >
                    Reset Filters
                  </button>
                )}

              </div>
            ) : (
              <>
                {/* DESKTOP TABLE */}
                <div className="hidden overflow-x-auto lg:block">

                  <table className="w-full min-w-[1200px]">

                    <thead>
                      <tr className="bg-gradient-to-r from-[#24115d] to-[#43218f] text-left text-[10px] font-black uppercase tracking-wider text-white">

                        <th className="px-4 py-4">
                          #
                        </th>

                        <th className="px-4 py-4">
                          Action
                        </th>

                        <th className="px-4 py-4">
                          Status
                        </th>

                        <th className="px-4 py-4">
                          Lead Date
                        </th>

                        <th className="px-4 py-4">
                          Customer
                        </th>

                        <th className="px-4 py-4">
                          Product
                        </th>

                        <th className="px-4 py-4">
                          Amount
                        </th>

                        <th className="px-4 py-4">
                          Location
                        </th>

                      </tr>
                    </thead>

                    <tbody>
                      {currentLeads.map(
                        (lead, index) => (
                          <tr
                            key={lead.id}
                            className="border-b border-slate-100 transition hover:bg-indigo-50/40"
                          >

                            <td className="px-4 py-4 text-sm font-black text-slate-400">
                              {(page - 1) *
                                pageSize +
                                index +
                                1}
                            </td>

                            <td className="px-4 py-4">
                              <div className="flex items-center gap-2">

                                <button
                                  onClick={() =>
                                    setSelectedLead(
                                      lead
                                    )
                                  }
                                  className="rounded-full bg-violet-600 px-4 py-2 text-[11px] font-black text-white shadow-sm hover:bg-violet-700"
                                >
                                  View
                                </button>

                                {lead.phone && (
                                  <a
                                    href={`tel:${lead.phone}`}
                                    className="flex h-8 w-8 items-center justify-center rounded-full bg-emerald-500 text-white hover:bg-emerald-600"
                                    title="Call"
                                  >
                                    <Phone
                                      size={14}
                                    />
                                  </a>
                                )}

                              </div>
                            </td>

                            <td className="px-4 py-4">
                              <span
                                className={`inline-flex rounded-full border px-3 py-1.5 text-[10px] font-black ${statusClass(
                                  lead.status
                                )}`}
                              >
                                {normalizeStatus(
                                  lead.status
                                )}
                              </span>
                            </td>

                            <td className="px-4 py-4">

                              <div className="flex items-center gap-2 text-xs font-bold text-slate-600">
                                <CalendarDays
                                  size={14}
                                  className="text-indigo-500"
                                />

                                {formatDate(
                                  lead.createdAt
                                )}
                              </div>

                              <div className="mt-1 text-[10px] font-medium text-slate-400">
                                Updated{" "}
                                {formatDateTime(
                                  lead.updatedAt
                                )}
                              </div>

                            </td>

                            <td className="px-4 py-4">

                              <div className="text-sm font-black text-slate-900">
                                {lead.fullName ||
                                  "—"}
                              </div>

                              <div className="mt-1 text-[11px] font-semibold text-slate-500">
                                {lead.phone ||
                                  "No phone"}
                              </div>

                            </td>

                            <td className="px-4 py-4">
                              <span className="text-xs font-black text-orange-600">
                                {lead.loanType ||
                                  "—"}
                              </span>
                            </td>

                            <td className="px-4 py-4 text-sm font-black text-slate-800">
                              {money(
                                lead.amount
                              )}
                            </td>

                            <td className="px-4 py-4">

                              <div className="flex items-center gap-1.5 text-xs font-semibold text-slate-500">
                                <MapPin
                                  size={13}
                                  className="text-indigo-500"
                                />

                                {[
                                  lead.city,
                                  lead.state,
                                ]
                                  .filter(
                                    Boolean
                                  )
                                  .join(
                                    ", "
                                  ) || "—"}
                              </div>

                            </td>

                          </tr>
                        )
                      )}
                    </tbody>

                  </table>
                </div>

                {/* MOBILE */}
                <div className="divide-y divide-slate-100 lg:hidden">

                  {currentLeads.map(
                    (lead, index) => (
                      <div
                        key={lead.id}
                        className="p-4"
                      >

                        <div className="flex items-start justify-between gap-3">

                          <div>
                            <div className="text-[10px] font-black text-slate-400">
                              #
                              {(page - 1) *
                                pageSize +
                                index +
                                1}
                            </div>

                            <div className="mt-1 text-base font-black text-slate-900">
                              {lead.fullName ||
                                "—"}
                            </div>

                            <div className="mt-1 text-xs font-semibold text-slate-500">
                              {lead.phone ||
                                "No phone"}
                            </div>
                          </div>

                          <span
                            className={`rounded-full border px-3 py-1.5 text-[10px] font-black ${statusClass(
                              lead.status
                            )}`}
                          >
                            {normalizeStatus(
                              lead.status
                            )}
                          </span>

                        </div>

                        <div className="mt-4 grid grid-cols-2 gap-3 rounded-2xl bg-slate-50 p-3">

                          <MobileInfo
                            label="Product"
                            value={
                              lead.loanType
                            }
                          />

                          <MobileInfo
                            label="Amount"
                            value={money(
                              lead.amount
                            )}
                          />

                          <MobileInfo
                            label="Lead Date"
                            value={formatDate(
                              lead.createdAt
                            )}
                          />

                          <MobileInfo
                            label="Location"
                            value={
                              [
                                lead.city,
                                lead.state,
                              ]
                                .filter(
                                  Boolean
                                )
                                .join(
                                  ", "
                                ) || "—"
                            }
                          />

                        </div>

                        <div className="mt-3 flex gap-2">

                          <button
                            onClick={() =>
                              setSelectedLead(
                                lead
                              )
                            }
                            className="flex flex-1 items-center justify-center gap-2 rounded-xl bg-violet-600 py-2.5 text-xs font-black text-white"
                          >
                            <Eye size={15} />
                            View
                          </button>

                          {lead.phone && (
                            <>
                              <a
                                href={`tel:${lead.phone}`}
                                className="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-500 text-white"
                              >
                                <Phone
                                  size={16}
                                />
                              </a>

                              <a
                                href={`https://wa.me/91${String(
                                  lead.phone
                                ).replace(
                                  /\D/g,
                                  ""
                                )}`}
                                target="_blank"
                                rel="noreferrer"
                                className="flex h-10 w-10 items-center justify-center rounded-xl bg-green-600 text-white"
                              >
                                <MessageCircle
                                  size={17}
                                />
                              </a>
                            </>
                          )}

                        </div>

                      </div>
                    )
                  )}

                </div>
              </>
            )}

            {/* PAGINATION */}
            {!loading &&
              filteredLeads.length > 0 && (
                <div className="flex flex-col gap-3 border-t border-slate-100 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">

                  <div className="text-[11px] font-semibold text-slate-500">
                    Showing{" "}
                    {(page - 1) *
                      pageSize +
                      1}{" "}
                    to{" "}
                    {Math.min(
                      page * pageSize,
                      filteredLeads.length
                    )}{" "}
                    of{" "}
                    {filteredLeads.length}
                  </div>

                  <div className="flex items-center gap-1">

                    <button
                      disabled={page <= 1}
                      onClick={() =>
                        setPage(
                          (p) =>
                            Math.max(
                              1,
                              p - 1
                            )
                        )
                      }
                      className="flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white disabled:opacity-40"
                    >
                      <ChevronLeft
                        size={17}
                      />
                    </button>

                    {Array.from(
                      {
                        length: Math.min(
                          totalPages,
                          5
                        ),
                      },
                      (_, i) =>
                        i + 1
                    ).map(
                      (number) => (
                        <button
                          key={number}
                          onClick={() =>
                            setPage(
                              number
                            )
                          }
                          className={`h-9 min-w-9 rounded-lg px-3 text-xs font-black ${
                            page === number
                              ? "bg-indigo-600 text-white"
                              : "border border-slate-200 bg-white text-slate-600"
                          }`}
                        >
                          {number}
                        </button>
                      )
                    )}

                    <button
                      disabled={
                        page >=
                        totalPages
                      }
                      onClick={() =>
                        setPage(
                          (p) =>
                            Math.min(
                              totalPages,
                              p + 1
                            )
                        )
                      }
                      className="flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white disabled:opacity-40"
                    >
                      <ChevronRight
                        size={17}
                      />
                    </button>

                  </div>
                </div>
              )}

          </section>
        </main>

        {/* DETAIL MODAL */}
        {selectedLead && (
          <div
            className="fixed inset-0 z-[9999] flex items-center justify-center bg-slate-950/70 p-4 backdrop-blur-sm"
            onClick={() =>
              setSelectedLead(null)
            }
          >

            <div
              onClick={(e) =>
                e.stopPropagation()
              }
              className="w-full max-w-2xl overflow-hidden rounded-3xl bg-white shadow-2xl"
            >

              <div className="bg-gradient-to-r from-[#291766] to-[#6427c7] px-6 py-5 text-white">

                <div className="flex items-center justify-between">

                  <div>
                    <div className="text-[10px] font-black uppercase tracking-[0.2em] text-violet-200">
                      Real Lead
                    </div>

                    <h3 className="mt-1 text-xl font-black">
                      {selectedLead.fullName ||
                        "Customer"}
                    </h3>
                  </div>

                  <button
                    onClick={() =>
                      setSelectedLead(
                        null
                      )
                    }
                    className="flex h-10 w-10 items-center justify-center rounded-full bg-white/15 hover:bg-white/25"
                  >
                    <X size={19} />
                  </button>

                </div>

              </div>

              <div className="grid gap-3 p-6 sm:grid-cols-2">

                <Detail
                  label="Customer"
                  value={
                    selectedLead.fullName
                  }
                />

                <Detail
                  label="Phone"
                  value={
                    selectedLead.phone
                  }
                />

                <Detail
                  label="Email"
                  value={
                    selectedLead.email
                  }
                />

                <Detail
                  label="Loan Type"
                  value={
                    selectedLead.loanType
                  }
                />

                <Detail
                  label="Amount"
                  value={money(
                    selectedLead.amount
                  )}
                />

                <Detail
                  label="Status"
                  value={normalizeStatus(
                    selectedLead.status
                  )}
                />

                <Detail
                  label="City"
                  value={
                    selectedLead.city
                  }
                />

                <Detail
                  label="State"
                  value={
                    selectedLead.state
                  }
                />

                <Detail
                  label="PAN"
                  value={
                    selectedLead.panNo
                  }
                />

                <Detail
                  label="Purpose"
                  value={
                    selectedLead.purpose
                  }
                />

                <Detail
                  label="Employment"
                  value={
                    selectedLead.employmentType
                  }
                />

                <Detail
                  label="Company"
                  value={
                    selectedLead.companyName
                  }
                />

                <Detail
                  label="Monthly Income"
                  value={
                    selectedLead.monthlyIncome
                      ? money(
                          selectedLead.monthlyIncome
                        )
                      : undefined
                  }
                />

                <Detail
                  label="Created"
                  value={formatDateTime(
                    selectedLead.createdAt
                  )}
                />

              </div>

              <div className="flex gap-2 border-t border-slate-100 bg-slate-50 px-6 py-4">

                {selectedLead.phone && (
                  <>
                    <a
                      href={`tel:${selectedLead.phone}`}
                      className="flex items-center gap-2 rounded-xl bg-emerald-500 px-5 py-3 text-xs font-black text-white"
                    >
                      <Phone size={15} />
                      Call
                    </a>

                    <a
                      href={`https://wa.me/91${String(
                        selectedLead.phone
                      ).replace(
                        /\D/g,
                        ""
                      )}`}
                      target="_blank"
                      rel="noreferrer"
                      className="flex items-center gap-2 rounded-xl bg-green-600 px-5 py-3 text-xs font-black text-white"
                    >
                      <MessageCircle
                        size={15}
                      />
                      WhatsApp
                    </a>
                  </>
                )}

              </div>

            </div>
          </div>
        )}

      </div>
    </DsaShell>
  );
}

function FilterField({
  label,
  children,
}: {
  label: string;
  children: any;
}) {
  return (
    <div>
      <label className="mb-2 block text-xs font-black text-slate-700">
        {label}
      </label>

      {children}
    </div>
  );
}

function Summary({
  label,
  value,
  icon,
  className,
}: {
  label: string;
  value: string | number;
  icon: any;
  className: string;
}) {
  return (
    <div className="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">

      <div className="flex items-center gap-3">

        <div
          className={`flex h-10 w-10 items-center justify-center rounded-xl ${className}`}
        >
          {icon}
        </div>

        <div className="min-w-0">
          <div className="text-[10px] font-bold text-slate-500">
            {label}
          </div>

          <div className="mt-1 truncate text-lg font-black text-slate-950">
            {value}
          </div>
        </div>

      </div>
    </div>
  );
}

function MobileInfo({
  label,
  value,
}: {
  label: string;
  value?: string;
}) {
  return (
    <div>
      <div className="text-[9px] font-black uppercase tracking-wider text-slate-400">
        {label}
      </div>

      <div className="mt-1 truncate text-xs font-bold text-slate-700">
        {value || "—"}
      </div>
    </div>
  );
}

function Detail({
  label,
  value,
}: {
  label: string;
  value?: string | number;
}) {
  return (
    <div className="rounded-2xl border border-slate-100 bg-slate-50 p-4">
      <div className="text-[9px] font-black uppercase tracking-wider text-slate-400">
        {label}
      </div>

      <div className="mt-1 break-words text-sm font-bold text-slate-800">
        {value || "—"}
      </div>
    </div>
  );
}
