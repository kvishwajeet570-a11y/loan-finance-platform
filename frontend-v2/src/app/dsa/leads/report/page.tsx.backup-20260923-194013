          <div className="mx-auto flex max-w-[1600px] items-center gap-4 px-4 py-4 lg:px-7">

            <div className="flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-indigo-600 to-violet-600 text-white shadow-lg shadow-indigo-500/20">
              <Filter size={21} />
            </div>

            <div className="min-w-0 flex-1">
              <div className="text-[10px] font-black uppercase tracking-[0.22em] text-indigo-600">
                Business Reports
              </div>

              <h1 className="text-2xl font-black tracking-tight text-slate-950">
                Leads Report & Filter
              </h1>

              <p className="text-xs font-medium text-slate-500">
                Filter and analyse your real assigned loan leads.
              </p>
            </div>

            <button
              onClick={loadRealLeads}
              disabled={loading}
              className="flex h-10 items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 text-xs font-black text-slate-700 shadow-sm hover:border-indigo-300 hover:text-indigo-700 disabled:opacity-50"
            >
              <RefreshCw
                size={15}
                className={
                  loading
                    ? "animate-spin"
                    : ""
                }
              />
              Refresh
            </button>

          </div>
        </header>

        <main className="mx-auto max-w-[1600px] space-y-5 px-4 py-5 lg:px-7">

          {/* FILTER CARD */}
          <section className="overflow-hidden rounded-[26px] border border-slate-200 bg-white shadow-sm">

            <div className="flex items-center justify-between bg-gradient-to-r from-[#291766] via-[#3c2780] to-[#5234a5] px-6 py-6 text-white">

              <div className="flex items-center gap-4">

                <div className="flex h-12 w-12 items-center justify-center rounded-2xl bg-white text-indigo-600 shadow-lg">
                  <Filter size={23} />
                </div>

                <div>
                  <h2 className="text-xl font-black">
                    Leads Report Filter
                  </h2>

                  <p className="mt-1 text-xs font-medium text-indigo-100">
                    Use the filters below to view your real leads
                  </p>
                </div>

              </div>

              <div className="hidden h-10 w-10 items-center justify-center rounded-full bg-white text-indigo-600 sm:flex">
                <ChevronDown size={19} />
              </div>

            </div>

            <div className="grid gap-x-6 gap-y-5 p-6 lg:grid-cols-2">

              {/* STATUS */}
              <FilterField label="Status">
                <select
                  value={status}
                  onChange={(e) =>
                    setStatus(
                      e.target.value
                    )
                  }
                  className="filter-select"
                >
                  <option value="ALL">
                    All
                  </option>
                  <option value="PENDING">
                    Pending
                  </option>
                  <option value="PROCESS">
                    In Process
                  </option>
                  <option value="APPROVED">
                    Approved
                  </option>
                  <option value="REJECT">
                    Rejected
                  </option>
                  <option value="DISBURSED">
                    Disbursed
                  </option>
                </select>
              </FilterField>

              {/* LOAN TYPE */}
              <FilterField label="Loan Type">
                <select
                  value={loanType}
                  onChange={(e) =>
                    setLoanType(
                      e.target.value
                    )
                  }
                  className="filter-select"
                >
                  <option value="ALL">
                    All
                  </option>

                  {loanTypes.map(
                    (type) => (
                      <option
                        key={type}
                        value={type}
                      >
                        {type}
                      </option>
                    )
                  )}
                </select>
              </FilterField>

              {/* SHOW LEAD */}
              <FilterField label="Show Lead">
                <select
                  value={showLead}
                  onChange={(e) =>
                    setShowLead(
                      e.target.value
                    )
                  }
                  className="filter-select"
                >
                  <option value="ALL">
                    All
                  </option>
                  <option value="ACTIVE">
                    Active Leads
                  </option>
                  <option value="WITH_AMOUNT">
                    Leads With Loan Amount
                  </option>
                  <option value="WITHOUT_AMOUNT">
                    Leads Without Loan Amount
                  </option>
                </select>
              </FilterField>

              {/* START DATE */}
              <FilterField label="Start Date">
                <div className="relative">
                  <CalendarDays
                    size={17}
                    className="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-indigo-500"
                  />

                  <input
                    type="date"
                    value={startDate}
                    onChange={(e) =>
                      setStartDate(
                        e.target.value
                      )
                    }
                    className="h-12 w-full rounded-xl border border-slate-200 bg-white pl-11 pr-4 text-sm font-semibold text-slate-700 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100"
                  />
                </div>
              </FilterField>

              {/* END DATE */}
              <FilterField label="End Date">
                <div className="relative">
                  <CalendarDays
                    size={17}
                    className="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-indigo-500"
                  />

                  <input
                    type="date"
                    value={endDate}
                    onChange={(e) =>
                      setEndDate(
                        e.target.value
                      )
                    }
                    className="h-12 w-full rounded-xl border border-slate-200 bg-white pl-11 pr-4 text-sm font-semibold text-slate-700 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100"
                  />
                </div>
              </FilterField>

              {/* SEARCH */}
              <FilterField label="Search Lead">
                <div className="relative">
                  <Search
                    size={17}
                    className="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-indigo-500"
                  />

                  <input
                    value={search}
                    onChange={(e) =>
                      setSearch(
                        e.target.value
                      )
                    }
                    placeholder="Name, phone, city, loan type or ID..."
                    className="h-12 w-full rounded-xl border border-slate-200 bg-white pl-11 pr-4 text-sm font-semibold text-slate-700 outline-none placeholder:text-slate-400 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100"
                  />
                </div>
              </FilterField>

            </div>

            <div className="flex flex-col gap-3 border-t border-slate-100 bg-slate-50 px-6 py-4 sm:flex-row">

              <button
                onClick={applyFilter}
                className="flex h-12 items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-indigo-600 to-violet-600 px-7 text-sm font-black text-white shadow-lg shadow-indigo-500/20 hover:-translate-y-0.5"
              >
                <Filter size={17} />
                Apply Filter
              </button>

              <button
                onClick={resetFilter}
                className="flex h-12 items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-7 text-sm font-black text-slate-700 hover:border-indigo-300 hover:text-indigo-700"
              >
                <RotateCcw size={16} />
                Reset
              </button>

            </div>

          </section>

          {/* ERROR */}
          {error && (
            <div className="rounded-2xl border border-red-200 bg-red-50 px-5 py-4">
              <div className="text-sm font-black text-red-700">
                Unable to load Leads
              </div>

              <div className="mt-1 text-xs font-semibold text-red-600">
                {error}
              </div>
            </div>
          )}

          {/* REAL SUMMARY */}
          {!error && (
            <section className="grid grid-cols-2 gap-3 lg:grid-cols-5">

              <Summary
                label="Filtered Leads"
                value={stats.total}
                icon={
                  <Users size={18} />
                }
                className="bg-indigo-50 text-indigo-600"
              />

              <Summary
                label="In Process"
                value={stats.pending}
                icon={
                  <Clock3 size={18} />
                }
                className="bg-orange-50 text-orange-600"
              />

              <Summary
                label="Approved"
                value={stats.approved}
                icon={
                  <CheckCircle2 size={18} />
                }
                className="bg-emerald-50 text-emerald-600"
              />

              <Summary
                label="Rejected"
                value={stats.rejected}
                icon={
                  <XCircle size={18} />
                }
