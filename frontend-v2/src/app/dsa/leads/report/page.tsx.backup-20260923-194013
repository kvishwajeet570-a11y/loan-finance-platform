"use client";

import { useEffect, useMemo, useState } from "react";
import DsaShell from "@/components/dsa/DsaShell";
import {
  Filter,
  ChevronDown,
  CalendarDays,
  RotateCcw,
  Search,
  Eye,
  Phone,
  MessageCircle,
  ChevronLeft,
  ChevronRight,
  Users,
  IndianRupee,
  CheckCircle2,
  Clock3,
  XCircle,
  X,
  RefreshCw,
  MapPin,
} from "lucide-react";

const API = (
  process.env.NEXT_PUBLIC_API_URL ||
  "http://localhost:5000/api"
).replace(/\/$/, "");

type Lead = {
  id: string;
  fullName?: string;
  phone?: string;
  email?: string;
  loanType?: string;
  amount?: number | string;
  status?: string;
  createdAt?: string;
  updatedAt?: string;
  city?: string;
  state?: string;
  panNo?: string;
  purpose?: string;
  employmentType?: string;
  companyName?: string;
  monthlyIncome?: number | string;
};

function money(value: unknown) {
  const amount = Number(value || 0);

  return `${String.fromCharCode(0x20b9)}${amount.toLocaleString(
    "en-IN",
    {
      maximumFractionDigits: 0,
    }
  )}`;
}

function formatDate(value?: string) {
  if (!value) return "—";

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) return "—";

  return date.toLocaleDateString("en-IN", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
  });
}

function formatDateTime(value?: string) {
  if (!value) return "—";

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) return "—";

  return date.toLocaleString("en-IN", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  });
}

function dateKey(value?: string) {
  if (!value) return "";

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) return "";

  const year = date.getFullYear();
  const month = String(
    date.getMonth() + 1
  ).padStart(2, "0");
  const day = String(
    date.getDate()
  ).padStart(2, "0");

  return `${year}-${month}-${day}`;
}

function normalizeStatus(value?: string) {
  return String(value || "PENDING")
    .replaceAll("_", " ")
    .trim();
}

function statusClass(value?: string) {
  const status = String(value || "").toUpperCase();

  if (
    status.includes("APPROVED") ||
    status.includes("DISBURSED") ||
    status.includes("SUCCESS")
  ) {
    return "border-emerald-200 bg-emerald-50 text-emerald-700";
  }

  if (
    status.includes("REJECT")
  ) {
    return "border-red-200 bg-red-50 text-red-600";
  }

  if (
    status.includes("QUERY") ||
    status.includes("DOCUMENT")
  ) {
    return "border-orange-200 bg-orange-50 text-orange-700";
  }

  if (
    status.includes("PROCESS") ||
    status.includes("PENDING")
  ) {
    return "border-blue-200 bg-blue-50 text-blue-700";
  }

  return "border-slate-200 bg-slate-50 text-slate-600";
}

export default function LeadsReportPage() {
  const [leads, setLeads] = useState<Lead[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  const [status, setStatus] = useState("ALL");
  const [loanType, setLoanType] = useState("ALL");
  const [showLead, setShowLead] = useState("ALL");

  const [startDate, setStartDate] = useState("");
  const [endDate, setEndDate] = useState("");

  const [search, setSearch] = useState("");
  const [applied, setApplied] = useState(true);

  const [page, setPage] = useState(1);
  const [pageSize, setPageSize] = useState(10);

  const [selectedLead, setSelectedLead] =
    useState<Lead | null>(null);

  async function loadRealLeads() {
    setLoading(true);
    setError("");

    try {
      const storedUser =
        localStorage.getItem(
          "loan_finance_user"
        );

      const token =
        localStorage.getItem(
          "loan_finance_token"
        ) || "";

      if (!storedUser) {
        throw new Error(
          "DSA login session not found. Please login again."
        );
      }

      let user: any;

      try {
        user = JSON.parse(storedUser);
      } catch {
        throw new Error(
          "Invalid DSA login session."
        );
      }

      if (!user?.id) {
        throw new Error(
          "DSA user ID is missing from the login session."
        );
      }

      const endpoint =
        `${API}/dsa/${encodeURIComponent(
          user.id
        )}/loans`;

      const response = await fetch(
        endpoint,
        {
          method: "GET",
          cache: "no-store",
          headers: {
            Accept:
              "application/json",
            ...(token
              ? {
                  Authorization:
                    `Bearer ${token}`,
                }
              : {}),
          },
        }
      );

      const responseText =
        await response.text();

      let json: any = {};

      try {
        json = responseText
          ? JSON.parse(responseText)
          : {};
      } catch {
        throw new Error(
          `Backend returned invalid JSON. HTTP ${response.status}`
        );
      }

      if (!response.ok) {
        throw new Error(
          json?.message ||
            `Leads API failed. HTTP ${response.status}`
        );
      }

      if (json?.success === false) {
        throw new Error(
          json?.message ||
            "Backend rejected the Leads request."
        );
      }

      const rows =
        Array.isArray(json?.data)
          ? json.data
          : Array.isArray(
              json?.data?.loans
            )
          ? json.data.loans
          : Array.isArray(
              json?.data?.leads
            )
          ? json.data.leads
          : Array.isArray(json?.loans)
          ? json.loans
          : Array.isArray(json?.leads)
          ? json.leads
          : [];

      const realRows = rows.filter(
        (item: any) =>
          item &&
          typeof item === "object" &&
          item.id
      );

      setLeads(realRows);

      console.log(
        "[LEADS REPORT] Real records:",
        realRows.length
      );

      console.log(
        "[LEADS REPORT] API response:",
        json
      );
    } catch (err: any) {
      console.error(
        "[LEADS REPORT ERROR]",
        err
      );

      setLeads([]);

      setError(
        err?.message ||
          "Unable to load real leads."
      );
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    loadRealLeads();
  }, []);

  const loanTypes = useMemo(() => {
    return Array.from(
      new Set(
        leads
          .map((lead) => lead.loanType)
          .filter(Boolean)
          .map(String)
      )
    ).sort();
  }, [leads]);

  const filteredLeads = useMemo(() => {
    if (!applied) return [];

    const query =
      search.trim().toLowerCase();

    return leads.filter((lead) => {
      const leadStatus =
        String(
          lead.status || ""
        ).toUpperCase();

      const searchMatch =
        !query ||
        [
          lead.id,
          lead.fullName,
          lead.phone,
          lead.email,
          lead.loanType,
          lead.city,
          lead.state,
          lead.panNo,
          lead.companyName,
        ]
          .filter(Boolean)
          .some((value) =>
            String(value)
              .toLowerCase()
              .includes(query)
          );

      const statusMatch =
        status === "ALL" ||
        leadStatus.includes(
          status
        );

      const loanTypeMatch =
        loanType === "ALL" ||
        String(
          lead.loanType || ""
        ) === loanType;

      const amount =
        Number(lead.amount || 0);

      const showLeadMatch =
        showLead === "ALL"
          ? true
          : showLead === "WITH_AMOUNT"
          ? amount > 0
          : showLead === "WITHOUT_AMOUNT"
          ? amount <= 0
          : showLead === "ACTIVE"
          ? !leadStatus.includes(
              "REJECT"
            ) &&
            !leadStatus.includes(
              "DISBURSED"
            )
          : true;

      const created =
        dateKey(
          lead.createdAt
        );

      const startMatch =
        !startDate ||
        !created ||
        created >= startDate;

      const endMatch =
        !endDate ||
        !created ||
        created <= endDate;

      return (
        searchMatch &&
        statusMatch &&
        loanTypeMatch &&
        showLeadMatch &&
        startMatch &&
        endMatch
      );
    });
  }, [
    leads,
    applied,
    search,
    status,
    loanType,
    showLead,
    startDate,
    endDate,
  ]);

  const stats = useMemo(() => {
    const approved =
      filteredLeads.filter(
        (lead) =>
          String(
            lead.status || ""
          )
            .toUpperCase()
            .includes("APPROVED")
      ).length;

    const rejected =
      filteredLeads.filter(
        (lead) =>
          String(
            lead.status || ""
          )
            .toUpperCase()
            .includes("REJECT")
      ).length;

    const pending =
      filteredLeads.filter(
        (lead) => {
          const s =
            String(
              lead.status || ""
            ).toUpperCase();

          return (
            !s.includes(
              "APPROVED"
            ) &&
            !s.includes(
              "REJECT"
            ) &&
            !s.includes(
              "DISBURSED"
            )
          );
        }
      ).length;

    const amount =
      filteredLeads.reduce(
        (sum, lead) =>
          sum +
          Number(
            lead.amount || 0
          ),
        0
      );

    return {
      total: filteredLeads.length,
      approved,
      rejected,
      pending,
      amount,
    };
  }, [filteredLeads]);

  const totalPages =
    Math.max(
      1,
      Math.ceil(
        filteredLeads.length /
          pageSize
      )
    );

  useEffect(() => {
    if (page > totalPages) {
      setPage(totalPages);
    }
  }, [page, totalPages]);

  const currentLeads =
    filteredLeads.slice(
      (page - 1) *
        pageSize,
      page * pageSize
    );

  function applyFilter() {
    setApplied(true);
    setPage(1);
  }

  function resetFilter() {
    setStatus("ALL");
    setLoanType("ALL");
    setShowLead("ALL");
    setStartDate("");
    setEndDate("");
    setSearch("");
    setApplied(true);
    setPage(1);
  }

  return (
