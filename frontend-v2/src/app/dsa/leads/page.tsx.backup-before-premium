"use client";

import { useEffect, useMemo, useState } from "react";
import DsaShell from "@/components/dsa/DsaShell";

const API = process.env.NEXT_PUBLIC_API_URL || "http://localhost:5000/api";

type Lead = {
  id: string;
  fullName?: string;
  loanType?: string;
  amount?: number;
  status?: string;
  createdAt?: string;
  city?: string;
  state?: string;
  phone?: string;
  email?: string;
};

function money(value: number) {
  return `₹${Number(value || 0).toLocaleString("en-IN")}`;
}

function statusClass(status = "") {
  const s = status.toUpperCase();
  if (s === "APPROVED") return "bg-emerald-50 text-emerald-700 border-emerald-200";
  if (s === "REJECTED") return "bg-red-50 text-red-700 border-red-200";
  if (s === "PENDING") return "bg-amber-50 text-amber-700 border-amber-200";
  return "bg-slate-100 text-slate-600 border-slate-200";
}

export default function DsaLeadsPage() {
  const [leads, setLeads] = useState<Lead[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [search, setSearch] = useState("");
  const [status, setStatus] = useState("ALL");
  const [loanType, setLoanType] = useState("ALL");

  async function loadLeads() {
    try {
      setLoading(true);
      setError("");

      const user = JSON.parse(localStorage.getItem("loan_finance_user") || "{}");

      if (!user?.id) {
        throw new Error("DSA login session not found.");
      }

      const token = localStorage.getItem("loan_finance_token");

      const res = await fetch(`${API}/dsa/${user.id}/loans`, {
        headers: token
          ? { Authorization: `Bearer ${token}` }
          : {},
      });

      const json = await res.json();

      if (!res.ok || json.success === false) {
        throw new Error(json.message || "Unable to load leads.");
      }

      const rows = Array.isArray(json.data)
        ? json.data
        : Array.isArray(json.loans)
        ? json.loans
        : [];

      setLeads(rows);
    } catch (e: any) {
      setError(e?.message || "Unable to load leads.");
      setLeads([]);
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    loadLeads();
  }, []);

  const loanTypes = useMemo(
    () =>
      Array.from(
        new Set(
          leads
            .map((x) => x.loanType)
            .filter(Boolean)
            .map(String)
        )
      ),
    [leads]
  );

  const filtered = useMemo(() => {
    const q = search.trim().toLowerCase();

    return leads.filter((lead) => {
      const matchesSearch =
        !q ||
        [
          lead.fullName,
          lead.loanType,
          lead.city,
          lead.state,
          lead.phone,
          lead.email,
          lead.id,
        ]
          .filter(Boolean)
          .some((v) => String(v).toLowerCase().includes(q));

      const matchesStatus =
        status === "ALL" ||
        String(lead.status || "").toUpperCase() === status;

      const matchesLoan =
        loanType === "ALL" ||
        String(lead.loanType || "") === loanType;

      return matchesSearch && matchesStatus && matchesLoan;
    });
  }, [leads, search, status, loanType]);

  const stats = useMemo(() => {
    const total = leads.length;
    const approved = leads.filter(
      (x) => String(x.status).toUpperCase() === "APPROVED"
    ).length;
    const pending = leads.filter(
      (x) => String(x.status).toUpperCase() === "PENDING"
    ).length;
    const rejected = leads.filter(
      (x) => String(x.status).toUpperCase() === "REJECTED"
    ).length;
    const amount = leads.reduce(
      (sum, x) => sum + Number(x.amount || 0),
      0
    );

    return { total, approved, pending, rejected, amount };
  }, [leads]);

  return (
    <DsaShell>
      <div className="min-h-screen bg-[#f5f7fb]">
        <header className="border-b border-slate-200 bg-white px-5 py-5 md:px-8 xl:px-10">
          <div className="mx-auto flex max-w-[1850px] flex-col gap-4 xl:flex-row xl:items-center xl:justify-between">
            <div>
              <p className="text-sm font-bold uppercase tracking-[0.18em] text-blue-600">
                Business Management
              </p>
              <h1 className="mt-1 text-3xl font-black tracking-tight text-slate-900 md:text-4xl">
                Leads
              </h1>
              <p className="mt-1 text-base text-slate-500">
                Manage and track your assigned loan leads from live database data.
              </p>
            </div>

            <button
              onClick={loadLeads}
              className="rounded-xl bg-slate-900 px-5 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-blue-700"
            >
              ↻ Refresh Leads
            </button>
          </div>
        </header>

        <main className="mx-auto max-w-[1850px] p-5 md:p-8 xl:p-10">
          <section className="grid gap-5 sm:grid-cols-2 xl:grid-cols-5">
            {[
              ["Total Leads", stats.total, "👥", "text-blue-600"],
              ["Approved", stats.approved, "✓", "text-emerald-600"],
              ["Pending", stats.pending, "◷", "text-amber-600"],
              ["Rejected", stats.rejected, "×", "text-red-600"],
              ["Loan Value", money(stats.amount), "₹", "text-violet-600"],
            ].map(([label, value, icon, color]) => (
              <div
                key={String(label)}
                className="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"
              >
                <div className="flex items-start justify-between">
                  <p className="text-base font-semibold text-slate-500">
                    {label}
                  </p>
                  <span className={`text-2xl font-black ${color}`}>
                    {icon}
                  </span>
                </div>
                <p className="mt-4 text-3xl font-black text-slate-900">
                  {value}
                </p>
              </div>
            ))}
          </section>

          <section className="mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm md:p-6">
            <div className="flex flex-col gap-4 xl:flex-row">
              <div className="relative flex-1">
                <span className="absolute left-4 top-1/2 -translate-y-1/2 text-lg text-slate-400">
                  ⌕
                </span>
                <input
                  value={search}
                  onChange={(e) => setSearch(e.target.value)}
                  placeholder="Search customer, loan type, city, phone or email..."
                  className="w-full rounded-xl border border-slate-200 bg-slate-50 py-3.5 pl-11 pr-4 text-base outline-none transition focus:border-blue-400 focus:bg-white"
                />
              </div>

              <select
                value={status}
                onChange={(e) => setStatus(e.target.value)}
                className="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3.5 text-base font-semibold outline-none"
              >
                <option value="ALL">All Status</option>
                <option value="PENDING">Pending</option>
                <option value="APPROVED">Approved</option>
                <option value="REJECTED">Rejected</option>
              </select>

              <select
                value={loanType}
                onChange={(e) => setLoanType(e.target.value)}
                className="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3.5 text-base font-semibold outline-none"
              >
                <option value="ALL">All Loan Products</option>
                {loanTypes.map((type) => (
                  <option key={type} value={type}>
                    {type}
                  </option>
                ))}
              </select>
            </div>
          </section>

          <section className="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <div className="flex items-center justify-between border-b border-slate-200 px-6 py-5">
              <div>
                <h2 className="text-2xl font-black text-slate-900">
                  Assigned Leads
                </h2>
                <p className="mt-1 text-sm text-slate-500">
                  Showing {filtered.length} of {leads.length} real records
                </p>
              </div>
            </div>

            {loading ? (
              <div className="flex min-h-[300px] items-center justify-center text-base font-semibold text-slate-500">
                Loading live leads...
              </div>
            ) : error ? (
              <div className="m-6 rounded-xl border border-red-200 bg-red-50 p-5 text-red-700">
                <p className="font-bold">Unable to load leads</p>
                <p className="mt-1 text-sm">{error}</p>
              </div>
            ) : filtered.length === 0 ? (
              <div className="flex min-h-[300px] flex-col items-center justify-center px-6 text-center">
                <div className="text-5xl">📋</div>
                <h3 className="mt-4 text-xl font-black text-slate-800">
                  No leads found
                </h3>
                <p className="mt-1 text-sm text-slate-500">
                  No assigned loan applications match the current filters.
                </p>
              </div>
            ) : (
              <div className="overflow-x-auto">
                <table className="w-full min-w-[950px]">
                  <thead className="bg-slate-50">
                    <tr className="text-left text-xs font-black uppercase tracking-wider text-slate-500">
                      <th className="px-6 py-4">Customer</th>
                      <th className="px-6 py-4">Loan Product</th>
                      <th className="px-6 py-4">Amount</th>
                      <th className="px-6 py-4">Location</th>
                      <th className="px-6 py-4">Status</th>
                      <th className="px-6 py-4">Created</th>
                    </tr>
                  </thead>

                  <tbody className="divide-y divide-slate-100">
                    {filtered.map((lead) => (
                      <tr
                        key={lead.id}
                        className="transition hover:bg-blue-50/40"
                      >
                        <td className="px-6 py-5">
                          <div className="flex items-center gap-3">
                            <div className="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-blue-100 font-black text-blue-700">
                              {(lead.fullName || "L")
                                .charAt(0)
                                .toUpperCase()}
                            </div>
                            <div>
                              <p className="font-bold text-slate-900">
                                {lead.fullName || "Unnamed Customer"}
                              </p>
                              <p className="text-xs text-slate-400">
                                {lead.id}
                              </p>
                            </div>
                          </div>
                        </td>

                        <td className="px-6 py-5">
                          <span className="font-semibold text-slate-700">
                            {lead.loanType || "—"}
                          </span>
                        </td>

                        <td className="px-6 py-5 font-black text-slate-900">
                          {money(Number(lead.amount || 0))}
                        </td>

                        <td className="px-6 py-5 text-sm text-slate-600">
                          {[lead.city, lead.state]
                            .filter(Boolean)
                            .join(", ") || "—"}
                        </td>

                        <td className="px-6 py-5">
                          <span
                            className={`inline-flex rounded-full border px-3 py-1.5 text-xs font-black ${statusClass(
                              lead.status
                            )}`}
                          >
                            {lead.status || "UNKNOWN"}
                          </span>
                        </td>

                        <td className="px-6 py-5 text-sm font-semibold text-slate-500">
                          {lead.createdAt
                            ? new Date(lead.createdAt).toLocaleDateString(
                                "en-IN",
                                {
                                  day: "2-digit",
                                  month: "short",
                                  year: "numeric",
                                }
                              )
                            : "—"}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </section>
        </main>
      </div>
    </DsaShell>
  );
}
