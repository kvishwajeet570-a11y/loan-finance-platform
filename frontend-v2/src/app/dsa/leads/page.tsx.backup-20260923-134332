"use client";

import { useEffect, useMemo, useState } from "react";
import DsaShell from "@/components/dsa/DsaShell";
import {
  Search,
  SlidersHorizontal,
  RefreshCw,
  Eye,
  Phone,
  MessageCircle,
  ChevronLeft,
  ChevronRight,
  Users,
  CheckCircle2,
  Clock3,
  XCircle,
  IndianRupee,
  MapPin,
  CalendarDays,
  BriefcaseBusiness,
  ArrowUpRight,
  Download,
  X,
} from "lucide-react";

const API =
  process.env.NEXT_PUBLIC_API_URL || "http://localhost:5000/api";

type Lead = {
  id: string;
  fullName?: string;
  loanType?: string;
  amount?: number;
  status?: string;
  createdAt?: string;
  city?: string;
  state?: string;
  phone?: string;
  email?: string;
  panNo?: string;
  purpose?: string;
  assignedTo?: string;
};

const RUPEE = String.fromCharCode(0x20b9);

function money(value: number | undefined) {
  const amount = Number(value || 0);

  if (!amount) return `${RUPEE}0`;

  return `${RUPEE}${amount.toLocaleString("en-IN")}`;
}

function statusLabel(status = "") {
  const s = status.toUpperCase();

  if (s === "APPROVED") return "Approved";
  if (s === "REJECTED") return "Rejected";
  if (
    s === "IN_PROGRESS" ||
    s === "IN PROGRESS" ||
    s === "PROCESSING"
  ) {
    return "In Progress";
  }

  if (s === "PENDING") return "Pending";
  if (s === "DISBURSED") return "Disbursed";

  return status || "New";
}

function statusStyle(status = "") {
  const s = status.toUpperCase();

  if (s === "APPROVED" || s === "DISBURSED") {
    return "border-emerald-200 bg-emerald-50 text-emerald-700";
  }

  if (s === "REJECTED") {
    return "border-rose-200 bg-rose-50 text-rose-700";
  }

  if (
    s === "PENDING" ||
    s === "IN_PROGRESS" ||
    s === "IN PROGRESS" ||
    s === "PROCESSING"
  ) {
    return "border-amber-200 bg-amber-50 text-amber-700";
  }

  return "border-blue-200 bg-blue-50 text-blue-700";
}

function initials(name = "Lead") {
  return name
    .trim()
    .split(/\s+/)
    .slice(0, 2)
    .map((x) => x[0]?.toUpperCase())
    .join("") || "L";
}

function formatDate(value?: string) {
  if (!value) return "—";

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) return "—";

  return date.toLocaleDateString("en-IN", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  });
}

function formatTime(value?: string) {
  if (!value) return "";

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) return "";

  return date.toLocaleTimeString("en-IN", {
    hour: "2-digit",
    minute: "2-digit",
  });
}

export default function DsaLeadsPage() {
  const [leads, setLeads] = useState<Lead[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  const [search, setSearch] = useState("");
  const [status, setStatus] = useState("ALL");
  const [loanType, setLoanType] = useState("ALL");
  const [location, setLocation] = useState("ALL");

  const [page, setPage] = useState(1);
  const [pageSize, setPageSize] = useState(10);

  const [selectedLead, setSelectedLead] = useState<Lead | null>(null);

  async function loadLeads() {
    try {
      setLoading(true);
      setError("");

      const rawUser = localStorage.getItem("loan_finance_user");
      const user = JSON.parse(rawUser || "{}");

      if (!user?.id) {
        throw new Error("DSA login session not found.");
      }

      const token = localStorage.getItem("loan_finance_token");

      const res = await fetch(`${API}/dsa/${user.id}/loans`, {
        cache: "no-store",
        headers: token
          ? {
              Authorization: `Bearer ${token}`,
            }
          : {},
      });

      const json = await res.json();

      if (!res.ok || json.success === false) {
        throw new Error(json.message || "Unable to load leads.");
      }

      const rows = Array.isArray(json.data)
        ? json.data
        : Array.isArray(json.loans)
          ? json.loans
          : [];

      setLeads(rows);
      setPage(1);
    } catch (err: any) {
      setError(err?.message || "Unable to load leads.");
      setLeads([]);
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    loadLeads();
  }, []);

  const loanTypes = useMemo(() => {
    return Array.from(
      new Set(
        leads
          .map((lead) => String(lead.loanType || "").trim())
          .filter(Boolean)
      )
    ).sort();
  }, [leads]);

  const locations = useMemo(() => {
    return Array.from(
      new Set(
        leads
          .map((lead) =>
            [lead.city, lead.state].filter(Boolean).join(", ")
          )
          .filter(Boolean)
      )
    ).sort();
  }, [leads]);

  const stats = useMemo(() => {
    const approved = leads.filter(
      (x) =>
        String(x.status || "").toUpperCase() === "APPROVED"
    ).length;

    const rejected = leads.filter(
      (x) =>
        String(x.status || "").toUpperCase() === "REJECTED"
    ).length;

    const pending = leads.filter((x) => {
      const s = String(x.status || "").toUpperCase();

      return (
        s === "PENDING" ||
        s === "IN_PROGRESS" ||
        s === "IN PROGRESS" ||
        s === "PROCESSING"
      );
    }).length;

    const totalAmount = leads.reduce(
      (sum, lead) => sum + Number(lead.amount || 0),
      0
    );

    return {
      total: leads.length,
      approved,
      pending,
      rejected,
      totalAmount,
    };
  }, [leads]);

  const filtered = useMemo(() => {
    const q = search.trim().toLowerCase();

    return leads.filter((lead) => {
      const locationText = [
        lead.city,
        lead.state,
      ]
        .filter(Boolean)
        .join(", ");

      const matchesSearch =
        !q ||
        [
          lead.fullName,
          lead.phone,
          lead.email,
          lead.loanType,
          lead.city,
          lead.state,
          lead.id,
          lead.panNo,
        ]
          .filter(Boolean)
          .some((value) =>
            String(value).toLowerCase().includes(q)
          );

      const matchesStatus =
        status === "ALL" ||
        String(lead.status || "").toUpperCase() === status;

      const matchesLoan =
        loanType === "ALL" ||
        String(lead.loanType || "") === loanType;

      const matchesLocation =
        location === "ALL" ||
        locationText === location;

      return (
        matchesSearch &&
        matchesStatus &&
        matchesLoan &&
        matchesLocation
      );
    });
  }, [leads, search, status, loanType, location]);

  const totalPages = Math.max(
    1,
    Math.ceil(filtered.length / pageSize)
  );

  const currentPage = Math.min(page, totalPages);

  const paginated = useMemo(() => {
    const start = (currentPage - 1) * pageSize;

    return filtered.slice(start, start + pageSize);
  }, [filtered, currentPage, pageSize]);

  useEffect(() => {
    setPage(1);
  }, [search, status, loanType, location, pageSize]);

  function exportCSV() {
    if (!filtered.length) return;

    const headers = [
      "Lead ID",
      "Customer",
      "Phone",
      "Loan Type",
      "Amount",
      "City",
      "State",
      "Status",
      "Created At",
    ];

    const rows = filtered.map((lead) => [
      lead.id,
      lead.fullName || "",
      lead.phone || "",
      lead.loanType || "",
      Number(lead.amount || 0),
      lead.city || "",
      lead.state || "",
      statusLabel(lead.status),
      lead.createdAt || "",
    ]);

    const csv = [
      headers,
      ...rows,
    ]
      .map((row) =>
        row
          .map((cell) =>
            `"${String(cell).replace(/"/g, '""')}"`
          )
          .join(",")
      )
      .join("\n");

    const blob = new Blob([csv], {
      type: "text/csv;charset=utf-8;",
    });

    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");

    link.href = url;
    link.download = `dsa-leads-${new Date()
      .toISOString()
      .slice(0, 10)}.csv`;

    link.click();

    URL.revokeObjectURL(url);
  }

  return (
    <DsaShell>
      <div className="min-h-screen bg-slate-50">
        {/* HERO */}
        <section className="relative overflow-hidden bg-gradient-to-r from-[#071a45] via-[#0b3ca8] to-[#2563eb]">
          <div className="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-blue-400/20 blur-3xl" />
          <div className="absolute -bottom-32 left-1/3 h-80 w-80 rounded-full bg-indigo-400/20 blur-3xl" />

          <div className="relative mx-auto max-w-[1500px] px-5 py-7 md:px-8">
            <div className="flex flex-col justify-between gap-5 lg:flex-row lg:items-center">
              <div>
                <div className="mb-2 flex items-center gap-2 text-xs font-bold uppercase tracking-[0.22em] text-blue-200">
                  <Users size={15} />
                  DSA Lead Management
                </div>

                <h1 className="text-3xl font-black tracking-tight text-white md:text-4xl">
                  Leads
                  <span className="text-blue-300"> Management</span>
                </h1>

                <p className="mt-2 max-w-2xl text-sm text-blue-100/90">
                  Track, follow up and manage your real loan leads
                  from one professional workspace.
                </p>
              </div>

              <div className="flex items-center gap-3">
                <button
                  onClick={loadLeads}
                  disabled={loading}
                  className="inline-flex h-11 items-center gap-2 rounded-xl border border-white/20 bg-white/10 px-4 text-sm font-bold text-white backdrop-blur transition hover:bg-white/20 disabled:opacity-50"
                >
                  <RefreshCw
                    size={16}
                    className={loading ? "animate-spin" : ""}
                  />
                  Refresh
                </button>

                <button
                  onClick={exportCSV}
                  disabled={!filtered.length}
                  className="inline-flex h-11 items-center gap-2 rounded-xl bg-white px-4 text-sm font-black text-blue-700 shadow-lg transition hover:-translate-y-0.5 disabled:opacity-50"
                >
                  <Download size={16} />
                  Export
                </button>
              </div>
            </div>
          </div>
        </section>

        <main className="mx-auto max-w-[1500px] px-5 py-6 md:px-8">
          {/* STATS */}
          <div className="grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
            <StatCard
              title="Total Leads"
              value={stats.total.toLocaleString("en-IN")}
              icon={<Users size={21} />}
              iconClass="bg-blue-50 text-blue-600"
              accent="border-blue-100"
            />

            <StatCard
              title="Approved"
              value={stats.approved.toLocaleString("en-IN")}
              icon={<CheckCircle2 size={21} />}
              iconClass="bg-emerald-50 text-emerald-600"
              accent="border-emerald-100"
            />

            <StatCard
              title="Pending / Processing"
              value={stats.pending.toLocaleString("en-IN")}
              icon={<Clock3 size={21} />}
              iconClass="bg-amber-50 text-amber-600"
              accent="border-amber-100"
            />

            <StatCard
              title="Rejected"
              value={stats.rejected.toLocaleString("en-IN")}
              icon={<XCircle size={21} />}
              iconClass="bg-rose-50 text-rose-600"
              accent="border-rose-100"
            />

            <StatCard
              title="Total Loan Amount"
              value={money(stats.totalAmount)}
              icon={<IndianRupee size={21} />}
              iconClass="bg-violet-50 text-violet-600"
              accent="border-violet-100"
            />
          </div>

          {/* FILTER PANEL */}
          <section className="mt-6 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm md:p-5">
            <div className="mb-4 flex flex-col justify-between gap-3 lg:flex-row lg:items-center">
              <div>
                <h2 className="text-lg font-black text-slate-900">
                  Lead Pipeline
                </h2>
                <p className="text-xs text-slate-500">
                  Showing live records assigned to your DSA account.
                </p>
              </div>

              <div className="text-xs font-bold text-slate-500">
                {filtered.length} matching lead
                {filtered.length === 1 ? "" : "s"}
              </div>
            </div>

            <div className="grid gap-3 lg:grid-cols-[minmax(280px,1.7fr)_1fr_1fr_1fr_auto]">
              <div className="relative">
                <Search
                  size={17}
                  className="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"
                />

                <input
                  value={search}
                  onChange={(e) => setSearch(e.target.value)}
                  placeholder="Search name, phone, PAN, city, loan..."
                  className="h-12 w-full rounded-xl border border-slate-200 bg-slate-50 pl-11 pr-4 text-sm font-medium text-slate-800 outline-none transition focus:border-blue-400 focus:bg-white focus:ring-4 focus:ring-blue-100"
                />
              </div>

              <SelectBox
                value={loanType}
                onChange={setLoanType}
                options={loanTypes}
                placeholder="All Loan Types"
              />

              <SelectBox
                value={status}
                onChange={setStatus}
                options={[
                  "ALL",
                  "PENDING",
                  "IN_PROGRESS",
                  "APPROVED",
                  "REJECTED",
                  "DISBURSED",
                ]}
                placeholder="All Status"
                labels={{
                  ALL: "All Status",
                  IN_PROGRESS: "In Progress",
                }}
              />

              <SelectBox
                value={location}
                onChange={setLocation}
                options={locations}
                placeholder="All Locations"
              />

              <button
                onClick={() => {
                  setSearch("");
                  setStatus("ALL");
                  setLoanType("ALL");
                  setLocation("ALL");
                }}
                className="inline-flex h-12 items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-5 text-sm font-black text-slate-700 transition hover:border-blue-200 hover:bg-blue-50 hover:text-blue-700"
              >
                <SlidersHorizontal size={16} />
                Reset
              </button>
            </div>
          </section>

          {/* STATUS TABS */}
          <div className="mt-5 flex gap-2 overflow-x-auto pb-1">
            {[
              ["ALL", "All Leads", stats.total],
              ["PENDING", "Pending", leads.filter((x) => String(x.status || "").toUpperCase() === "PENDING").length],
              ["IN_PROGRESS", "In Progress", leads.filter((x) => ["IN_PROGRESS", "IN PROGRESS", "PROCESSING"].includes(String(x.status || "").toUpperCase())).length],
              ["APPROVED", "Approved", stats.approved],
              ["REJECTED", "Rejected", stats.rejected],
            ].map(([value, label, count]) => (
              <button
                key={String(value)}
                onClick={() => setStatus(String(value))}
                className={`whitespace-nowrap rounded-xl border px-4 py-2.5 text-xs font-black transition ${
                  status === value
                    ? "border-blue-600 bg-blue-600 text-white shadow-lg shadow-blue-500/20"
                    : "border-slate-200 bg-white text-slate-600 hover:border-blue-200 hover:text-blue-700"
                }`}
              >
                {label}
                <span
                  className={`ml-2 rounded-full px-2 py-0.5 text-[10px] ${
                    status === value
                      ? "bg-white/20 text-white"
                      : "bg-slate-100 text-slate-500"
                  }`}
                >
                  {count}
                </span>
              </button>
            ))}
          </div>

          {/* TABLE */}
          <section className="mt-4 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <div className="flex items-center justify-between border-b border-slate-100 px-5 py-4">
              <div>
                <h3 className="text-base font-black text-slate-900">
                  Your Leads
                </h3>
                <p className="mt-0.5 text-xs text-slate-400">
                  Real-time data from your loan applications.
                </p>
              </div>

              <div className="hidden items-center gap-2 md:flex">
                <div className="rounded-lg bg-slate-50 px-3 py-2 text-xs font-bold text-slate-500">
                  Page {currentPage} of {totalPages}
                </div>
              </div>
            </div>

            {error && (
              <div className="m-5 rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm font-bold text-rose-700">
                {error}
              </div>
            )}

            {loading ? (
              <div className="space-y-3 p-5">
                {Array.from({ length: 6 }).map((_, i) => (
                  <div
                    key={i}
                    className="h-16 animate-pulse rounded-xl bg-slate-100"
                  />
                ))}
              </div>
            ) : paginated.length === 0 ? (
              <div className="px-6 py-20 text-center">
                <div className="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-blue-50 text-blue-600">
                  <Users size={28} />
                </div>

                <h3 className="mt-4 text-lg font-black text-slate-900">
                  No leads found
                </h3>

                <p className="mt-1 text-sm text-slate-500">
                  Try changing your search or filters.
                </p>
              </div>
            ) : (
              <>
                <div className="hidden overflow-x-auto lg:block">
                  <table className="w-full min-w-[1100px]">
                    <thead>
                      <tr className="border-b border-slate-100 bg-slate-50/80 text-left">
                        <th className="px-5 py-3 text-[10px] font-black uppercase tracking-wider text-slate-400">
                          Customer
                        </th>
                        <th className="px-4 py-3 text-[10px] font-black uppercase tracking-wider text-slate-400">
                          Loan Type
                        </th>
                        <th className="px-4 py-3 text-[10px] font-black uppercase tracking-wider text-slate-400">
                          Amount
                        </th>
                        <th className="px-4 py-3 text-[10px] font-black uppercase tracking-wider text-slate-400">
                          Location
                        </th>
                        <th className="px-4 py-3 text-[10px] font-black uppercase tracking-wider text-slate-400">
                          Status
                        </th>
                        <th className="px-4 py-3 text-[10px] font-black uppercase tracking-wider text-slate-400">
                          Created
                        </th>
                        <th className="px-5 py-3 text-right text-[10px] font-black uppercase tracking-wider text-slate-400">
                          Actions
                        </th>
                      </tr>
                    </thead>

                    <tbody className="divide-y divide-slate-100">
                      {paginated.map((lead) => (
                        <tr
                          key={lead.id}
                          className="group transition hover:bg-blue-50/40"
                        >
                          <td className="px-5 py-4">
                            <div className="flex items-center gap-3">
                              <div className="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-blue-600 to-indigo-600 text-xs font-black text-white shadow-md shadow-blue-500/20">
                                {initials(lead.fullName)}
                              </div>

                              <div className="min-w-0">
                                <div className="truncate text-sm font-black text-slate-900">
                                  {lead.fullName || "Unnamed Lead"}
                                </div>

                                <div className="mt-0.5 flex items-center gap-2 text-[11px] text-slate-400">
                                  <span className="font-semibold">
                                    #{lead.id.slice(-8)}
                                  </span>

                                  {lead.phone && (
                                    <>
                                      <span>•</span>
                                      <span>{lead.phone}</span>
                                    </>
                                  )}
                                </div>
                              </div>
                            </div>
                          </td>

                          <td className="px-4 py-4">
                            <div className="inline-flex items-center gap-2 rounded-lg bg-slate-50 px-3 py-2 text-xs font-bold text-slate-700">
                              <BriefcaseBusiness
                                size={14}
                                className="text-blue-600"
                              />
                              {lead.loanType || "—"}
                            </div>
                          </td>

                          <td className="px-4 py-4">
                            <span className="text-sm font-black text-slate-900">
                              {money(lead.amount)}
                            </span>
                          </td>

                          <td className="px-4 py-4">
                            <div className="flex items-start gap-1.5 text-xs font-semibold text-slate-600">
                              <MapPin
                                size={14}
                                className="mt-0.5 shrink-0 text-rose-500"
                              />

                              <span>
                                {lead.city || "—"}
                                {lead.state ? (
                                  <span className="block text-[10px] font-medium text-slate-400">
                                    {lead.state}
                                  </span>
                                ) : null}
                              </span>
                            </div>
                          </td>

                          <td className="px-4 py-4">
                            <span
                              className={`inline-flex rounded-full border px-3 py-1.5 text-[10px] font-black uppercase tracking-wide ${statusStyle(
                                lead.status
                              )}`}
                            >
                              {statusLabel(lead.status)}
                            </span>
                          </td>

                          <td className="px-4 py-4">
                            <div className="flex items-center gap-2 text-xs font-semibold text-slate-600">
                              <CalendarDays
                                size={14}
                                className="text-slate-400"
                              />

                              <span>
                                {formatDate(lead.createdAt)}
                                <span className="block text-[10px] font-medium text-slate-400">
                                  {formatTime(lead.createdAt)}
                                </span>
                              </span>
                            </div>
                          </td>

                          <td className="px-5 py-4">
                            <div className="flex justify-end gap-1.5">
                              <button
                                onClick={() => setSelectedLead(lead)}
                                title="View lead"
                                className="flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-600 transition hover:border-blue-200 hover:bg-blue-50 hover:text-blue-700"
                              >
                                <Eye size={15} />
                              </button>

                              {lead.phone && (
                                <a
                                  href={`tel:${lead.phone}`}
                                  title="Call"
                                  className="flex h-9 w-9 items-center justify-center rounded-lg border border-emerald-200 bg-emerald-50 text-emerald-600 transition hover:bg-emerald-100"
                                >
                                  <Phone size={15} />
                                </a>
                              )}

                              {lead.phone && (
                                <a
                                  href={`https://wa.me/91${String(
                                    lead.phone
                                  ).replace(/\D/g, "")}`}
                                  target="_blank"
                                  rel="noreferrer"
                                  title="WhatsApp"
                                  className="flex h-9 w-9 items-center justify-center rounded-lg border border-green-200 bg-green-50 text-green-600 transition hover:bg-green-100"
                                >
                                  <MessageCircle size={15} />
                                </a>
                              )}
                            </div>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>

                {/* MOBILE CARDS */}
                <div className="space-y-3 p-4 lg:hidden">
                  {paginated.map((lead) => (
                    <div
                      key={lead.id}
                      className="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm"
                    >
                      <div className="flex items-start justify-between gap-3">
                        <div className="flex min-w-0 items-center gap-3">
                          <div className="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-blue-600 to-indigo-600 text-xs font-black text-white">
                            {initials(lead.fullName)}
                          </div>

                          <div className="min-w-0">
                            <div className="truncate text-sm font-black text-slate-900">
                              {lead.fullName || "Unnamed Lead"}
                            </div>

                            <div className="mt-1 text-[11px] text-slate-400">
                              {lead.phone || "No phone"}
                            </div>
                          </div>
                        </div>

                        <span
                          className={`shrink-0 rounded-full border px-2.5 py-1 text-[9px] font-black uppercase ${statusStyle(
                            lead.status
                          )}`}
                        >
                          {statusLabel(lead.status)}
                        </span>
                      </div>

                      <div className="mt-4 grid grid-cols-2 gap-3 rounded-xl bg-slate-50 p-3">
                        <div>
                          <div className="text-[9px] font-black uppercase tracking-wide text-slate-400">
                            Loan
                          </div>
                          <div className="mt-1 text-xs font-black text-slate-800">
                            {lead.loanType || "—"}
                          </div>
                        </div>

                        <div>
                          <div className="text-[9px] font-black uppercase tracking-wide text-slate-400">
                            Amount
                          </div>
                          <div className="mt-1 text-xs font-black text-slate-800">
                            {money(lead.amount)}
                          </div>
                        </div>

                        <div>
                          <div className="text-[9px] font-black uppercase tracking-wide text-slate-400">
                            Location
                          </div>
                          <div className="mt-1 text-xs font-black text-slate-800">
                            {lead.city || "—"}
                          </div>
                        </div>

                        <div>
                          <div className="text-[9px] font-black uppercase tracking-wide text-slate-400">
                            Created
                          </div>
                          <div className="mt-1 text-xs font-black text-slate-800">
                            {formatDate(lead.createdAt)}
                          </div>
                        </div>
                      </div>

                      <div className="mt-3 flex gap-2">
                        <button
                          onClick={() => setSelectedLead(lead)}
                          className="flex h-10 flex-1 items-center justify-center gap-2 rounded-xl bg-blue-600 text-xs font-black text-white"
                        >
                          <Eye size={15} />
                          View Lead
                        </button>

                        {lead.phone && (
                          <a
                            href={`tel:${lead.phone}`}
                            className="flex h-10 w-10 items-center justify-center rounded-xl border border-emerald-200 bg-emerald-50 text-emerald-600"
                          >
                            <Phone size={15} />
                          </a>
                        )}

                        {lead.phone && (
                          <a
                            href={`https://wa.me/91${String(
                              lead.phone
                            ).replace(/\D/g, "")}`}
                            target="_blank"
                            rel="noreferrer"
                            className="flex h-10 w-10 items-center justify-center rounded-xl border border-green-200 bg-green-50 text-green-600"
                          >
                            <MessageCircle size={15} />
                          </a>
                        )}
                      </div>
                    </div>
                  ))}
                </div>

                {/* PAGINATION */}
                <div className="flex flex-col justify-between gap-3 border-t border-slate-100 px-5 py-4 sm:flex-row sm:items-center">
                  <div className="text-xs font-semibold text-slate-400">
                    Showing{" "}
                    {filtered.length
                      ? (currentPage - 1) * pageSize + 1
                      : 0}{" "}
                    to{" "}
                    {Math.min(
                      currentPage * pageSize,
                      filtered.length
                    )}{" "}
                    of {filtered.length} leads
                  </div>

                  <div className="flex items-center gap-2">
                    <select
                      value={pageSize}
                      onChange={(e) =>
                        setPageSize(Number(e.target.value))
                      }
                      className="h-9 rounded-lg border border-slate-200 bg-white px-2 text-xs font-bold text-slate-600 outline-none"
                    >
                      <option value={10}>10 / page</option>
                      <option value={20}>20 / page</option>
                      <option value={50}>50 / page</option>
                    </select>

                    <button
                      disabled={currentPage <= 1}
                      onClick={() =>
                        setPage((p) => Math.max(1, p - 1))
                      }
                      className="flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-600 disabled:opacity-40"
                    >
                      <ChevronLeft size={16} />
                    </button>

                    <div className="flex h-9 min-w-9 items-center justify-center rounded-lg bg-blue-600 px-3 text-xs font-black text-white">
                      {currentPage}
                    </div>

                    <button
                      disabled={currentPage >= totalPages}
                      onClick={() =>
                        setPage((p) =>
                          Math.min(totalPages, p + 1)
                        )
                      }
                      className="flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-600 disabled:opacity-40"
                    >
                      <ChevronRight size={16} />
                    </button>
                  </div>
                </div>
              </>
            )}
          </section>

          {/* FOOTER INFO */}
          <div className="mt-5 flex flex-col justify-between gap-3 rounded-2xl border border-blue-100 bg-gradient-to-r from-blue-50 to-indigo-50 p-5 sm:flex-row sm:items-center">
            <div>
              <div className="text-sm font-black text-slate-900">
                Your lead workspace
              </div>
              <div className="mt-1 text-xs text-slate-500">
                Keep your follow-ups organized and your pipeline updated.
              </div>
            </div>

            <div className="flex items-center gap-2 text-xs font-bold text-blue-700">
              <ArrowUpRight size={16} />
              Live DSA data
            </div>
          </div>
        </main>

        {/* DETAILS MODAL */}
        {selectedLead && (
          <div
            className="fixed inset-0 z-[9999] flex items-center justify-center bg-slate-950/70 p-4 backdrop-blur-sm"
            onClick={() => setSelectedLead(null)}
          >
            <div
              className="w-full max-w-xl overflow-hidden rounded-3xl bg-white shadow-2xl"
              onClick={(e) => e.stopPropagation()}
            >
              <div className="bg-gradient-to-r from-blue-700 to-indigo-700 px-6 py-6 text-white">
                <div className="flex items-start justify-between gap-4">
                  <div className="flex items-center gap-3">
                    <div className="flex h-12 w-12 items-center justify-center rounded-2xl bg-white/15 text-sm font-black backdrop-blur">
                      {initials(selectedLead.fullName)}
                    </div>

                    <div>
                      <h3 className="text-xl font-black">
                        {selectedLead.fullName || "Unnamed Lead"}
                      </h3>

                      <p className="mt-1 text-xs text-blue-100">
                        Lead ID: {selectedLead.id}
                      </p>
                    </div>
                  </div>

                  <button
                    onClick={() => setSelectedLead(null)}
                    className="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-white/20"
                  >
                    <X size={18} />
                  </button>
                </div>
              </div>

              <div className="grid gap-3 p-6 sm:grid-cols-2">
                <DetailItem
                  label="Loan Type"
                  value={selectedLead.loanType || "—"}
                />

                <DetailItem
                  label="Loan Amount"
                  value={money(selectedLead.amount)}
                />

                <DetailItem
                  label="Phone"
                  value={selectedLead.phone || "—"}
                />

                <DetailItem
                  label="Email"
                  value={selectedLead.email || "—"}
                />

                <DetailItem
                  label="City"
                  value={selectedLead.city || "—"}
                />

                <DetailItem
                  label="State"
                  value={selectedLead.state || "—"}
                />

                <DetailItem
                  label="Status"
                  value={statusLabel(selectedLead.status)}
                />

                <DetailItem
                  label="Created"
                  value={`${formatDate(
                    selectedLead.createdAt
                  )} ${formatTime(selectedLead.createdAt)}`}
                />

                {selectedLead.purpose && (
                  <div className="sm:col-span-2">
                    <DetailItem
                      label="Purpose"
                      value={selectedLead.purpose}
                    />
                  </div>
                )}
              </div>

              <div className="flex gap-3 border-t border-slate-100 bg-slate-50 px-6 py-4">
                {selectedLead.phone && (
                  <a
                    href={`tel:${selectedLead.phone}`}
                    className="flex h-11 flex-1 items-center justify-center gap-2 rounded-xl bg-emerald-600 text-sm font-black text-white"
                  >
                    <Phone size={16} />
                    Call Customer
                  </a>
                )}

                {selectedLead.phone && (
                  <a
                    href={`https://wa.me/91${String(
                      selectedLead.phone
                    ).replace(/\D/g, "")}`}
                    target="_blank"
                    rel="noreferrer"
                    className="flex h-11 flex-1 items-center justify-center gap-2 rounded-xl bg-green-600 text-sm font-black text-white"
                  >
                    <MessageCircle size={16} />
                    WhatsApp
                  </a>
                )}
              </div>
            </div>
          </div>
        )}
      </div>
    </DsaShell>
  );
}

function StatCard({
  title,
  value,
  icon,
  iconClass,
  accent,
}: {
  title: string;
  value: string;
  icon: React.ReactNode;
  iconClass: string;
  accent: string;
}) {
  return (
    <div
      className={`group rounded-2xl border ${accent} bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-xl`}
    >
      <div className="flex items-start justify-between gap-3">
        <div>
          <p className="text-xs font-bold text-slate-500">
            {title}
          </p>

          <p className="mt-2 truncate text-2xl font-black tracking-tight text-slate-900">
            {value}
          </p>
        </div>

        <div
          className={`flex h-11 w-11 shrink-0 items-center justify-center rounded-xl ${iconClass}`}
        >
          {icon}
        </div>
      </div>
    </div>
  );
}

function SelectBox({
  value,
  onChange,
  options,
  placeholder,
  labels = {},
}: {
  value: string;
  onChange: (value: string) => void;
  options: string[];
  placeholder: string;
  labels?: Record<string, string>;
}) {
  return (
    <div className="relative">
      <select
        value={value}
        onChange={(e) => onChange(e.target.value)}
        className="h-12 w-full appearance-none rounded-xl border border-slate-200 bg-slate-50 px-4 pr-9 text-sm font-bold text-slate-700 outline-none transition focus:border-blue-400 focus:bg-white focus:ring-4 focus:ring-blue-100"
      >
        {!options.includes("ALL") && (
          <option value="ALL">{placeholder}</option>
        )}

        {options.map((option) => (
          <option key={option} value={option}>
            {labels[option] ||
              (option === "ALL" ? placeholder : option)}
          </option>
        ))}
      </select>
    </div>
  );
}

function DetailItem({
  label,
  value,
}: {
  label: string;
  value: string;
}) {
  return (
    <div className="rounded-xl border border-slate-200 bg-slate-50 p-4">
      <div className="text-[10px] font-black uppercase tracking-wider text-slate-400">
        {label}
      </div>

      <div className="mt-1 break-words text-sm font-black text-slate-800">
        {value}
      </div>
    </div>
  );
}
