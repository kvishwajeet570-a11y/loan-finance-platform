  const [submitted, setSubmitted] = useState(false);

  const update = (key: keyof typeof form, value: string) => {
    setForm((prev) => ({ ...prev, [key]: value }));
  };

  const uploadedCount = useMemo(
    () => Object.values(files).filter(Boolean).length,
    [files]
  );

  const personalComplete =
    !!form.fullName &&
    !!form.dob &&
    !!form.gender &&
    !!form.mobile &&
    !!form.pan;

  const bankComplete =
    !!form.bankName &&
    !!form.accountNumber &&
    !!form.ifsc &&
    !!form.accountHolder;

  const documentComplete = uploadedCount >= 4;

  const completedSteps =
    Number(personalComplete) +
    Number(bankComplete) +
    Number(documentComplete);

  const progress = Math.round((completedSteps / 3) * 100);

  const submitKyc = async () => {
  try {
    setSubmitted(false);

    const userId =
      localStorage.getItem("userId") ||
      localStorage.getItem("user_id") ||
      "";

    if (!userId) {
      alert("User session not found. Please login again.");
      return;
    }

    const payload = {
      userId,

      kycType: "DSA",

      fullName:
        (document.querySelector(
          'input[placeholder="Enter full name"]'
        ) as HTMLInputElement | null)?.value || "",

      dob:
        (document.querySelector(
          'input[type="date"]'
        ) as HTMLInputElement | null)?.value || "",

      panNo:
        (document.querySelector(
          'input[placeholder*="PAN"]'
        ) as HTMLInputElement | null)?.value
          ?.toUpperCase() || "",

      identityDocument: "PAN",

      identityDocumentUrl: "",

      addressDocument: "OTHER",

      addressDocumentUrl: "",

      selfieUrl: "",
    };

    if (!payload.fullName || !payload.dob || !payload.panNo) {
      alert(
        "Please complete Full Name, Date of Birth and PAN before submitting KYC."
      );
      return;
    }

    const response = await fetch(`${KYC_API}/kyc/submit`, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify(payload),
    });

    const result = await response.json();

    if (!response.ok || !result?.success) {
      throw new Error(
        result?.message ||
          `KYC submission failed (${response.status})`
      );
    }

    setSubmitted(true);

    alert(
      "KYC submitted successfully. Your KYC is now saved in the database."
    );
  } catch (error: any) {
    console.error("DSA KYC SUBMIT ERROR:", error);

    alert(
      error?.message ||
        "KYC submission failed. Please try again."
    );
