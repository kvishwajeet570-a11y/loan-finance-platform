type UploadBoxProps = {
  title: string;
  subtitle: string;
  required?: boolean;
  accent?: "blue" | "red" | "green" | "purple";
  onFile: (file: File | null) => void;
};

function UploadBox({
  title,
  subtitle,
  required,
  accent = "blue",
  onFile,
}: UploadBoxProps) {
  const inputRef = useRef<HTMLInputElement>(null);
  const [fileName, setFileName] = useState("");

  const accentClass = {
    blue: "border-blue-200 bg-blue-50/40 hover:border-blue-400",
    red: "border-red-200 bg-red-50/30 hover:border-red-400",
    green: "border-emerald-200 bg-emerald-50/30 hover:border-emerald-400",
    purple: "border-purple-200 bg-purple-50/30 hover:border-purple-400",
  }[accent];

  const iconClass = {
    blue: "text-blue-600 bg-blue-50",
    red: "text-red-500 bg-red-50",
    green: "text-emerald-600 bg-emerald-50",
    purple: "text-purple-600 bg-purple-50",
  }[accent];

  const chooseFile = (file: File | null) => {
    if (!file) return;
    setFileName(file.name);
    onFile(file);
  };

  return (
    <div
      className={`rounded-xl border ${accentClass} p-3 transition-all`}
    >
      <div className="mb-2 flex items-center gap-2">
        <div className={`rounded-lg p-2 ${iconClass}`}>
          <FileText size={18} />
        </div>

        <div className="min-w-0">
          <div className="text-sm font-bold text-slate-900">
            {title}{" "}
            {required && <span className="text-red-500">*</span>}
          </div>
          <div className="text-[11px] text-slate-500">{subtitle}</div>
        </div>
      </div>

      <button
        type="button"
        onClick={() => inputRef.current?.click()}
        className="flex w-full flex-col items-center justify-center rounded-lg border border-dashed border-blue-300 bg-white/80 px-3 py-3 text-center transition hover:bg-blue-50"
      >
        <UploadCloud className="mb-1 text-blue-600" size={22} />

        {fileName ? (
          <>
            <span className="max-w-full truncate text-xs font-semibold text-emerald-600">
              {fileName}
            </span>
            <span className="mt-0.5 text-[10px] text-slate-500">
              Click to replace
            </span>
          </>
        ) : (
          <>
            <span className="text-xs font-semibold text-blue-600">
              Click to upload or drag & drop
            </span>
            <span className="mt-0.5 text-[10px] text-slate-500">
              PDF, JPG, PNG (Max 5MB)
            </span>
          </>
        )}
      </button>

      <input
        ref={inputRef}
        type="file"
        accept=".pdf,.jpg,.jpeg,.png"
        className="hidden"
        onChange={(e) => chooseFile(e.target.files?.[0] || null)}
      />
    </div>
  );
}

function FieldLabel({
  children,
  required = false,
}: {
  children: React.ReactNode;
  required?: boolean;
}) {
  return (
    <label className="mb-1 block text-[12px] font-bold text-slate-800">
      {children}{" "}
      {required && <span className="text-red-500">*</span>}
    </label>
  );
}

function InputBox({
  icon,
  placeholder,
  value,
  onChange,
  type = "text",
}: {
  icon: React.ReactNode;
  placeholder: string;
  value: string;
  onChange: (value: string) => void;
  type?: string;
}) {
  return (
    <div className="relative">
      <span className="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-slate-500">
        {icon}
      </span>

      <input
        type={type}
        value={value}
        onChange={(e) => onChange(e.target.value)}
        placeholder={placeholder}
        className="h-9 w-full rounded-lg border border-slate-200 bg-white pl-10 pr-3 text-[12px] text-slate-800 outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-100"
      />
    </div>
  );
}

