                  Array.from({ length: 6 }).map((_, i) => (
                    <tr key={i}>
                      {Array.from({ length: 8 }).map((__, j) => (
                        <td key={j} className="px-5 py-5">
                          <div className="h-4 animate-pulse rounded bg-slate-100" />
                        </td>
                      )))}
                    </tr>
                  ))
                ) : filtered.length === 0 ? (
                  <tr>
                    <td
                      colSpan={8}
                      className="px-5 py-16 text-center"
                    >
                      <div className="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-slate-100 text-slate-400">
                        <FileText size={25} />
                      </div>
                      <p className="mt-3 text-sm font-black text-slate-700">
                        No KYC records found
                      </p>
                      <p className="mt-1 text-xs text-slate-400">
                        Try changing your search or filters.
                      </p>
                    </td>
                  </tr>
                ) : (
                  filtered.map((item, index) => (
                    <tr
                      key={item.id}
                      className="group transition hover:bg-blue-50/40"
                    >
                      <td className="px-5 py-4 text-xs font-bold text-slate-400">
                        {index + 1}
                      </td>

                      <td className="px-5 py-4">
                        <div className="flex items-center gap-3">
                          <div className="flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-blue-100 to-cyan-100 text-xs font-black text-blue-700">
                            {getName(item)
                              .split(" ")
                              .map((x) => x[0])
                              .slice(0, 2)
                              .join("")
                              .toUpperCase()}
                          </div>

                          <div>
                            <p className="text-xs font-black text-slate-900">
                              {getName(item)}
                            </p>
                            <p className="mt-0.5 text-[9px] font-medium text-slate-400">
                              {item.userId || item.id}
                            </p>
                          </div>
                        </div>
                      </td>

                      <td className="px-5 py-4">
                        <p className="text-xs font-black text-slate-700">
                          {item.panNo || item.panNumber || "—"}
                        </p>
                        <p className="mt-1 text-[10px] text-slate-400">
                          {mask(item.aadhaarNo || item.aadhaarNumber)}
                        </p>
                      </td>

                      <td className="px-5 py-4">
                        <p className="text-xs font-bold text-slate-700">
                          {item.phone || "—"}
                        </p>
                        <p className="mt-1 max-w-[170px] truncate text-[10px] text-slate-400">
                          {item.email || "—"}
                        </p>
                      </td>

                      <td className="px-5 py-4">
                        <div className="flex items-center gap-1.5 text-xs font-bold text-slate-600">
                          <MapPin size={13} className="text-blue-500" />
                          {([item.city, item.state]
                            .filter(Boolean)
                            .join(", ") || "—")}
                        </div>
                      </td>

                      <td className="px-5 py-4">
                        <StatusBadge status={item.status} />
                      </td>

                      <td className="px-5 py-4">
                        <p className="text-xs font-bold text-slate-600">
                          {formatDate(item.createdAt)}
                        </p>
                        <p className="mt-1 text-[9px] text-slate-400">
                          {item.createdAt
                            ? new Date(item.createdAt).toLocaleTimeString(
                                "en-IN",
                                {
                                  hour: "2-digit",
                                  minute: "2-digit",
                                }
                              )
                            : ""}
                        </p>
                      </td>

                      <td className="px-5 py-4">
                        <div className="flex items-center gap-2">
                          <button
                            onClick={() => setSelected(item)}
                            className="inline-flex items-center gap-2 rounded-lg border border-blue-200 bg-blue-50 px-4 py-2 text-[10px] font-black text-blue-700 transition hover:bg-blue-600 hover:text-white"
                          >
                            <Eye size={14} />
                            View
                          </button>

                          <button className="flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 text-slate-400 hover:bg-slate-50">
                            <MoreVertical size={15} />
                          </button>
                        </div>
                      </td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>
        </section>

        {/* DETAIL DRAWER */}
        {selected && (
          <div
            className="fixed inset-0 z-[200] flex justify-end bg-slate-950/60 backdrop-blur-sm"
            onClick={() => setSelected(null)}
          >
            <div
              className="h-full w-full max-w-5xl overflow-y-auto bg-[#f6f9ff] shadow-2xl"
              onClick={(e) => e.stopPropagation()}
            >
              <div className="sticky top-0 z-20 bg-gradient-to-r from-blue-800 via-blue-600 to-cyan-500 px-6 py-5 text-white shadow-lg">
                <div className="flex items-start justify-between">
                  <div>
                    <p className="text-[10px] font-black uppercase tracking-[0.2em] text-blue-100">
                      Customer KYC Details
                    </p>
                    <h2 className="mt-1 text-2xl font-black">
                      {getName(selected)}
                    </h2>
                    <p className="mt-1 text-xs text-blue-100">
                      KYC ID: {selected.id}
                    </p>
                  </div>

                  <button
                    onClick={() => setSelected(null)}
                    className="flex h-10 w-10 items-center justify-center rounded-xl bg-white/15 text-xl hover:bg-white/25"
                  >
                    ×
                  </button>
                </div>
              </div>

              <div className="p-5 md:p-7">
                {/* PROFILE */}
                <div className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                  <div className="flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
                    <div className="flex items-center gap-4">
                      <div className="flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-to-br from-blue-100 to-cyan-100 text-lg font-black text-blue-700">
                        {getName(selected)
                          .split(" ")
                          .map((x) => x[0])
                          .slice(0, 2)
                          .join("")
                          .toUpperCase()}
                      </div>

                      <div>
                        <h3 className="text-lg font-black text-slate-950">
                          {getName(selected)}
                        </h3>
                        <p className="text-xs text-slate-400">
                          Customer verification profile
                        </p>

                        <div className="mt-2 flex flex-wrap gap-2">
                          <StatusBadge status={selected.status} />
                          <span className="rounded-lg bg-blue-50 px-3 py-1.5 text-[10px] font-black text-blue-700">
                            KYC ACTIVE
                          </span>
                        </div>
                      </div>
                    </div>

                    <div className="grid grid-cols-2 gap-2">
                      <div className="rounded-xl bg-slate-50 px-4 py-3">
                        <p className="text-[9px] font-bold text-slate-400">
                          Submitted
                        </p>
                        <p className="mt-1 text-xs font-black text-slate-800">
                          {formatDate(selected.createdAt)}
                        </p>
                      </div>

                      <div className="rounded-xl bg-emerald-50 px-4 py-3">
                        <p className="text-[9px] font-bold text-emerald-500">
                          Security
                        </p>
                        <p className="mt-1 text-xs font-black text-emerald-700">
                          Protected
                        </p>
                      </div>
                    </div>
                  </div>
                </div>

                {/* DETAIL GRID */}
                <div className="mt-5 grid gap-5 lg:grid-cols-3">
                  <div className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm lg:col-span-2">
                    <div className="flex items-center gap-2">
                      <UserCheck size={18} className="text-blue-600" />
                      <h3 className="text-sm font-black text-slate-900">
                        Personal Information
                      </h3>
                    </div>

                    <div className="mt-5 grid gap-4 sm:grid-cols-2">
                      {([
                        ["Full Name", getName(selected), Users],
                        ["Phone", selected.phone || "—", Phone],
                        ["Email", selected.email || "—", Mail],
                        ["PAN Number", selected.panNo || selected.panNumber || "—", CreditCard],
                        ["Aadhaar", mask(selected.aadhaarNo || selected.aadhaarNumber), ShieldCheck],
                        [
                          "Location",
                          [selected.city, selected.state]
                            .filter(Boolean)
                            .join(", ") || "—",
                          MapPin,
                        ],
                      ] as const).map(([label, value, Icon]) => (
                        <div
                          key={String(label)}
                          className="rounded-xl border border-slate-100 bg-slate-50 p-4"
                        >
                          <div className="flex items-center gap-2 text-[10px] font-black uppercase tracking-wide text-slate-400">
                            <Icon size={13} />
                            {label}
                          </div>
                          <p className="mt-2 break-all text-sm font-black text-slate-800">
                            {String(value)}
                          </p>
                        </div>
                      )))}
                    </div>
                  </div>

                  {/* AI SCORE */}
                  <div className="rounded-2xl border border-blue-100 bg-gradient-to-br from-blue-700 to-cyan-500 p-5 text-white shadow-xl">
                    <div className="flex items-center gap-2">
                      <Sparkles size={18} />
                      <h3 className="text-sm font-black">
                        AI Verification
                      </h3>
                    </div>

                    <div className="mt-6 flex justify-center">
                      <div className="flex h-36 w-36 items-center justify-center rounded-full border-[12px] border-white/20">
                        <div className="text-center">
                          <p className="text-4xl font-black">85</p>
                          <p className="text-[10px] font-bold text-blue-100">
                            / 100
                          </p>
                        </div>
                      </div>
                    </div>

                    <div className="mt-5 text-center">
                      <p className="text-lg font-black">Low Risk</p>
                      <p className="mt-1 text-[10px] text-blue-100">
                        Profile appears consistent with verification data.
                      </p>
                    </div>

                    <div className="mt-5 space-y-2">
                      {([
                        "Document Authenticity",
                        "Identity Match",
                        "Address Verification",
                        "Fraud Risk Check",
                      ].map((x) => (
                        <div
                          key={x}
                          className="flex items-center justify-between rounded-lg bg-white/10 px-3 py-2"
                        >
                          <span className="text-[10px] font-bold">{x}</span>
                          <CheckCircle2 size={14} />
                        </div>
                      )))}
                    </div>
                  </div>
                </div>

                {/* DOCUMENTS */}
                <div className="mt-5 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                  <div className="flex items-center justify-between">
                    <div className="flex items-center gap-2">
                      <FileCheck2 size={18} className="text-blue-600" />
                      <h3 className="text-sm font-black text-slate-900">
                        Verification Documents
                      </h3>
                    </div>

                    <span className="rounded-lg bg-emerald-50 px-3 py-1.5 text-[10px] font-black text-emerald-700">
                      3 / 3 Verified
                    </span>
                  </div>

                  <div className="mt-4 grid gap-3 md:grid-cols-3">
                    {([
                      [
                        "PAN Card",
                        selected.panNo || selected.panNumber || "Not available",
                        selected.panVerified,
                        CreditCard,
                      ],
                      [
                        "Aadhaar Card",
                        mask(selected.aadhaarNo || selected.aadhaarNumber),
                        selected.aadhaarVerified,
                        ShieldCheck,
                      ],
                      [
                        "Bank Verification",
                        selected.bankVerified ||
                        selected.bankAccountVerified
                          ? "Verified"
                          : "Review required",
                        selected.bankVerified ||
                          selected.bankAccountVerified,
                        Building2,
                      ],
                    ] as const).map(([title, value, verified, Icon]) => (
                      <div
                        key={String(title)}
                        className="rounded-xl border border-slate-100 bg-slate-50 p-4"
                      >
                        <div className="flex items-center justify-between">
                          <div className="flex h-10 w-10 items-center justify-center rounded-xl bg-white text-blue-600 shadow-sm">
                            <Icon size={19} />
                          </div>

                          <span
                            className={`rounded-lg px-2.5 py-1 text-[9px] font-black ${
                              verified
                                ? "bg-emerald-50 text-emerald-700"
                                : "bg-amber-50 text-amber-700"
                            }`}
                          >
                            {verified ? "Verified" : "Pending"}
                          </span>
                        </div>

                        <p className="mt-4 text-xs font-black text-slate-800">
                          {title}
                        </p>

                        <p className="mt-1 truncate text-[10px] text-slate-400">
                          {value}
                        </p>
                      </div>
                    )))}
                  </div>
                </div>

                {/* SECURITY */}
                <div className="mt-5 grid gap-5 md:grid-cols-3">
                  <div className="rounded-2xl border border-emerald-100 bg-emerald-50 p-5">
                    <LockKeyhole className="text-emerald-600" size={21} />
                    <p className="mt-3 text-xs font-black text-emerald-900">
                      Secure Verification
                    </p>
                    <p className="mt-1 text-[10px] text-emerald-700">
                      Customer information is protected.
                    </p>
                  </div>

                  <div className="rounded-2xl border border-blue-100 bg-blue-50 p-5">
                    <FileCheck2 className="text-blue-600" size={21} />
                    <p className="mt-3 text-xs font-black text-blue-900">
                      Document Check
                    </p>
                    <p className="mt-1 text-[10px] text-blue-700">
                      Verification documents available.
                    </p>
                  </div>

                  <div className="rounded-2xl border border-violet-100 bg-violet-50 p-5">
                    <Activity className="text-violet-600" size={21} />
                    <p className="mt-3 text-xs font-black text-violet-900">
                      Verification Activity
                    </p>
                    <p className="mt-1 text-[10px] text-violet-700">
                      Latest backend verification status.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        )}
      </div>
    </DsaShell>
  );
}



