                      </div>

                      <div className="min-w-0 flex-1">
                        <div className="flex items-start justify-between gap-2">
                          <div>
                            <div className="text-[10px] font-black text-slate-800">
                              {step.num}. {step.title}
                            </div>
                            <div className="mt-0.5 text-[8px] font-semibold text-slate-400">
                              {step.sub}
                            </div>
                          </div>

                          <span
                            className={[
                              "rounded-md px-2 py-1 text-[8px] font-black",
                              step.status === "Verified"
                                ? "bg-emerald-50 text-emerald-600"
                                : step.status === "In Progress"
                                ? "bg-orange-50 text-orange-600"
                                : "bg-slate-100 text-slate-500",
                            ].join(" ")}
                          >
                            {step.status}
                          </span>
                        </div>
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          </section>

          {/* ==================================================
              FILTER BAR
          ================================================== */}

          <section className="mt-3 rounded-2xl border border-slate-200 bg-white p-3 shadow-sm">

            <div className="flex flex-col gap-2 xl:flex-row">

              <div className="relative flex-1">
                <Search
                  size={15}
                  className="absolute left-3 top-1/2 -translate-y-1/2 text-blue-600"
                />

                <input
                  value={search}
                  onChange={(event) => setSearch(event.target.value)}
                  placeholder="Search by name, phone, email, PAN, Aadhaar, KYC ID..."
                  className="h-10 w-full rounded-xl border border-slate-200 bg-slate-50 pl-9 pr-3 text-[10px] font-semibold outline-none focus:border-blue-400 focus:bg-white"
                />
              </div>

              <button className="flex h-10 items-center justify-between gap-5 rounded-xl border border-slate-200 px-3 text-[10px] font-black text-slate-600">
                All States
                <ChevronDown size={13} />
              </button>

              <button className="flex h-10 items-center justify-between gap-5 rounded-xl border border-slate-200 px-3 text-[10px] font-black text-slate-600">
                All Status
                <ChevronDown size={13} />
              </button>

              <button className="flex h-10 items-center gap-2 rounded-xl border border-slate-200 px-3 text-[10px] font-black text-slate-600">
                <CalendarDays size={13} />
                Select Date Range
                <ChevronDown size={13} />
              </button>

              <button className="flex h-10 items-center justify-center gap-2 rounded-xl bg-blue-600 px-5 text-[10px] font-black text-white shadow-lg shadow-blue-200">
                <Search size={14} />
                Search
              </button>

              <button className="flex h-10 items-center justify-center gap-2 rounded-xl border border-emerald-200 bg-emerald-50 px-4 text-[10px] font-black text-emerald-600">
                <Download size={14} />
                Export Excel
              </button>

              <button className="flex h-10 items-center justify-center gap-2 rounded-xl border border-red-200 bg-red-50 px-4 text-[10px] font-black text-red-600">
                <Download size={14} />
                Export PDF
              </button>
            </div>

            {/* FILTER PILLS */}
            <div className="mt-3 flex gap-2 overflow-x-auto pb-1">
              {[
                ["All", String(realTotal)],
                ["Pending", String(realPending)],
                ["Under Review", String(realUnderReview)],
                ["Approved", String(realApproved)],
                ["Rejected", String(realRejected)],
              ].map((filter) => (
                <button
                  key={filter[0]}
                  onClick={() => setActiveFilter(filter[0])}
                  className={[
                    "flex shrink-0 items-center gap-2 rounded-lg px-4 py-2 text-[10px] font-black transition",
                    activeFilter === filter[0]
                      ? "bg-blue-600 text-white shadow-md"
                      : "border border-slate-200 bg-white text-slate-600 hover:bg-slate-50",
                  ].join(" ")}
                >
                  {filter[0]}
                  <span
                    className={
                      activeFilter === filter[0]
                        ? "text-blue-100"
                        : "text-slate-400"
                    }
                  >
                    ({filter[1]})
                  </span>
                </button>
              ))}
            </div>
          </section>

          {/* ==================================================
              MAIN CONTENT GRID
          ================================================== */}

          <section className="mt-3 grid gap-3 xl:grid-cols-[1fr_300px]">

            {/* TABLE */}
            <div className="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

              <div className="overflow-x-auto">
                <table className="min-w-[1000px] w-full border-collapse">
                  <thead>
                    <tr className="border-b border-slate-200 bg-slate-50">
                      <th className="w-10 px-3 py-3 text-center">
                        <input
                          type="checkbox"
                          checked={
                            filteredCustomers.length > 0 &&
                            selectedRows.length === filteredCustomers.length
                          }
                          onChange={toggleAll}
                          className="accent-blue-600"
                        />
                      </th>

                      {[
                        "#",
                        "Customer Name",
                        "PAN / Aadhaar",
                        "Phone / Email",
                        "Location",
                        "Status",
                        "Submitted On",
                        "Action",
                      ].map((heading) => (
                        <th
                          key={heading}
                          className="px-3 py-3 text-left text-[9px] font-black uppercase tracking-wide text-slate-500"
                        >
                          {heading}
                        </th>
                      ))}
                    </tr>
                  </thead>

                  <tbody>
                    {loading ? (
                      <tr>
                        <td
                          colSpan={8}
                          className="px-6 py-12 text-center text-sm font-bold text-blue-600"
                        >
                          Loading live KYC data...
                        </td>
                      </tr>
                    ) : apiError ? (
                      <tr>
                        <td
                          colSpan={8}
                          className="px-6 py-12 text-center text-sm font-bold text-red-600"
                        >
                          {apiError}
                        </td>
                      </tr>
                    ) : filteredCustomers.length === 0 ? (
                      <tr>
                        <td
                          colSpan={8}
                          className="px-6 py-12 text-center text-sm font-bold text-slate-500"
                        >
                          No KYC records found.
                        </td>
                      </tr>
                    ) : (
                      filteredCustomers.map((customer) => (
                      <tr
                        key={customer.id}
                        className="border-b border-slate-100 transition hover:bg-blue-50/40"
                      >
                        <td className="px-3 py-3 text-center">
                          <input
                            type="checkbox"
                            checked={selectedRows.includes(customer.id)}
                            onChange={() => toggleRow(customer.id)}
                            className="accent-blue-600"
                          />
                        </td>

                        <td className="px-3 py-3 text-[10px] font-bold text-slate-400">
                          {customer.id}
                        </td>

                        <td className="px-3 py-3">
                          <div className="flex items-center gap-2">
                            <div className="flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-br from-blue-100 to-indigo-100 text-[11px] font-black text-blue-700">
                              {customer.initials}
                            </div>

                            <div>
                              <div className="text-[10px] font-black text-slate-800">
                                {customer.name}
                              </div>

                              <div className="mt-0.5 text-[8px] font-semibold text-slate-400">
                                {customer.email}
                              </div>
                            </div>
                          </div>
                        </td>

                        <td className="px-3 py-3">
                          <div className="text-[10px] font-black text-slate-700">
                            {customer.pan}
                          </div>
                          <div className="mt-1 text-[9px] font-semibold text-slate-400">
                            {customer.aadhaar}
                          </div>
                        </td>

                        <td className="px-3 py-3">
                          <div className="text-[10px] font-black text-slate-700">
                            {customer.phone}
                          </div>
                          <div className="mt-1 max-w-[145px] truncate text-[8px] text-slate-400">
                            {customer.email}
                          </div>
                        </td>

                        <td className="px-3 py-3">
                          <div className="text-[10px] font-black text-slate-700">
                            {customer.location}
                          </div>
                          <div className="mt-1 text-[8px] font-semibold text-slate-400">
                            {customer.city}
                          </div>
                        </td>

                        <td className="px-3 py-3">
                          <StatusBadge status={customer.status} />
                        </td>

                        <td className="px-3 py-3">
                          <div className="text-[10px] font-black text-slate-600">
                            {customer.date}
                          </div>
                          <div className="mt-1 text-[8px] font-semibold text-slate-400">
                            {customer.time}
                          </div>
                        </td>

                        <td className="px-3 py-3">
                          <div className="flex items-center gap-1">
                            <button className="flex items-center gap-1 rounded-lg border border-blue-200 bg-blue-50 px-3 py-2 text-[9px] font-black text-blue-600 hover:bg-blue-100">
                              <Eye size={12} />
                              View
                            </button>

                            <button className="flex h-8 w-8 items-center justify-center rounded-lg border border-slate-200 text-slate-500 hover:bg-slate-50">
                              <MoreVertical size={14} />
                            </button>
                          </div>
                        </td>
                      </tr>
                      ))
                    )}
                  </tbody>
                </table>
              </div>

              {/* PAGINATION */}
              <div className="flex flex-col items-center justify-between gap-3 border-t border-slate-100 px-4 py-3 sm:flex-row">

                <div className="text-[9px] font-semibold text-slate-400">
                  Showing 1 to {Math.min(5, filteredCustomers.length)} of {filteredCustomers.length} results
                </div>

                <div className="flex items-center gap-1">
                  <button className="flex h-7 w-7 items-center justify-center rounded-lg border border-slate-200 text-slate-500">
                    <ChevronLeft size={13} />
                  </button>

                  {[1, 2, 3, 4, 5].map((page) => (
                    <button
                      key={page}
                      className={[
                        "flex h-7 w-7 items-center justify-center rounded-lg text-[9px] font-black",
                        page === 1
                          ? "bg-blue-600 text-white shadow-md"
                          : "border border-slate-200 text-slate-500",
                      ].join(" ")}
                    >
                      {page}
                    </button>
                  ))}

                  <span className="px-1 text-[9px] text-slate-400">...</span>

                  <button className="flex h-7 w-7 items-center justify-center rounded-lg border border-slate-200 text-[9px] font-black text-slate-500">
                    20
                  </button>

                  <button className="flex h-7 w-7 items-center justify-center rounded-lg border border-slate-200 text-slate-500">
                    <ChevronRight size={13} />
                  </button>
                </div>

                <div className="text-[9px] font-bold text-slate-400">
                  Show{" "}
                  <span className="mx-1 rounded border border-slate-200 px-2 py-1 text-slate-700">
                    5
                  </span>{" "}
                  per page
                </div>
              </div>
            </div>

            {/* ==================================================
                RIGHT SIDEBAR
            ================================================== */}

            <div className="space-y-3">

              {/* RECENT */}
              <div className="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
                <div className="flex items-center justify-between">
                  <h2 className="text-sm font-black">Recent Verifications</h2>
                  <button className="text-[9px] font-black text-blue-600">
                    View All
                  </button>
                </div>

                <div className="mt-4 space-y-3">
                  {records
                    .slice()
                    .sort(
                      (a, b) =>
                        new Date(b.createdAt || 0).getTime() -
                        new Date(a.createdAt || 0).getTime()
                    )
                    .slice(0, 5)
                    .map((record) => {
                      const name = record.name || "Unknown User";

                      const status = statusLabel(record.status);

                      return (
                    <div
                      key={record.id}
                      className="flex items-center gap-2"
                    >
                      <div className="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-blue-100 to-slate-100 text-[9px] font-black text-blue-700">
                        {name
                          .split(" ")
                          .map((part: string) => part[0])
                          .join("")
                          .slice(0, 2)}
                      </div>

                      <div className="min-w-0 flex-1">
                        <div className="text-[9px] font-black text-slate-700">
                          {name}
                        </div>

                        <div
                          className={[
                            "mt-1 inline-flex rounded-md px-2 py-1 text-[7px] font-black",
                            normaliseStatus(record.status) === "APPROVED"
                              ? "bg-emerald-50 text-emerald-600"
                              : normaliseStatus(record.status) === "UNDER_REVIEW"
                              ? "bg-purple-50 text-purple-600"
                              : "bg-orange-50 text-orange-600",
                          ].join(" ")}
                        >
                          ● {status}
                        </div>
                      </div>

                      <div className="text-right text-[7px] font-semibold text-slate-400">
                        {formatDate(record.createdAt)}
                      </div>
                    </div>
                      );
                    })}
                </div>
              </div>

              {/* AI CARD */}
              <div className="relative overflow-hidden rounded-2xl bg-gradient-to-br from-[#04194e] via-[#0757bf] to-[#00a8ee] p-5 text-white shadow-xl">

                <div className="absolute -right-10 -top-10 h-32 w-32 rounded-full bg-cyan-300/20 blur-2xl" />

                <div className="relative">
                  <div className="flex h-12 w-12 items-center justify-center rounded-2xl border border-white/20 bg-white/10 shadow-lg backdrop-blur">
                    <Zap size={25} className="text-cyan-200" />
                  </div>

                  <div className="mt-4 text-lg font-black">
                    AI Powered
                  </div>

                  <div className="text-lg font-black text-cyan-200">
                    KYC Verification
                  </div>

                  <p className="mt-2 text-[9px] font-semibold leading-4 text-blue-100">
                    Faster • Safer • More Accurate
                  </p>

                  <button className="mt-4 flex items-center gap-2 rounded-lg bg-white px-4 py-2 text-[9px] font-black text-blue-700 shadow-lg">
                    Learn More
                    <ChevronRight size={12} />
                  </button>
                </div>
              </div>

              {/* QUICK ACTIONS */}
              <div className="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
                <h2 className="text-sm font-black">Quick Actions</h2>

                <div className="mt-3 grid grid-cols-2 gap-2">
                  <button className="flex flex-col items-center gap-2 rounded-xl border border-blue-100 bg-blue-50 p-3 text-[8px] font-black text-blue-600">
                    <UploadCloud size={19} />
                    Upload KYC
                  </button>

                  <button className="flex flex-col items-center gap-2 rounded-xl border border-emerald-100 bg-emerald-50 p-3 text-[8px] font-black text-emerald-600">
                    <UserCheck size={19} />
                    Verify User
                  </button>

                  <button className="flex flex-col items-center gap-2 rounded-xl border border-purple-100 bg-purple-50 p-3 text-[8px] font-black text-purple-600">
                    <Activity size={19} />
                    Analytics
                  </button>

                  <button className="flex flex-col items-center gap-2 rounded-xl border border-orange-100 bg-orange-50 p-3 text-[8px] font-black text-orange-600">
                    <Download size={19} />
                    Export
                  </button>
                </div>
              </div>
            </div>
          </section>

          {/* FOOTER STATUS */}
          <div className="mt-3 flex flex-col items-center justify-between gap-2 rounded-xl border border-slate-200 bg-white px-4 py-3 text-[9px] font-semibold text-slate-400 sm:flex-row">
            <div className="flex items-center gap-2">
              <span className="h-2 w-2 animate-pulse rounded-full bg-emerald-500" />
              KYC system operational
            </div>

            <div className="flex items-center gap-4">
              <span>Last synced: Just now</span>
              <span className="flex items-center gap-1 text-emerald-600">
                <TrendingUp size={11} />
                {realTotal > 0 ? `${realApproved} approved of ${realTotal} total` : "No KYC records"}
              </span>
            </div>
          </div>

        </div>
      </main>
      </div>
    </DsaShell>
  );
}






















