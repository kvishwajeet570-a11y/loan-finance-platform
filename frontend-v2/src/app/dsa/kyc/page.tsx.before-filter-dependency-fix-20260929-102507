============================================================ */

type Status = "PENDING" | "UNDER REVIEW" | "APPROVED" | "REJECTED";

type Customer = {
  id: number;
  name: string;
  email: string;
  initials: string;
  pan: string;
  aadhaar: string;
  phone: string;
  location: string;
  city: string;
  status: Status;
  date: string;
  time: string;
  createdAt: string;
};

/* ============================================================`r`n   STATUS BADGE
============================================================ */

function StatusBadge({ status }: { status: Status }) {
  if (status === "PENDING") {
    return (
      <span className="inline-flex rounded-lg border border-orange-200 bg-orange-50 px-3 py-1.5 text-[10px] font-black text-orange-600">
        PENDING
      </span>
    );
  }

  if (status === "UNDER REVIEW") {
    return (
      <span className="inline-flex rounded-lg border border-blue-200 bg-blue-50 px-3 py-1.5 text-[10px] font-black text-blue-600">
        UNDER REVIEW
      </span>
    );
  }

  if (status === "APPROVED") {
    return (
      <span className="inline-flex rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-[10px] font-black text-emerald-600">
        APPROVED
      </span>
    );
  }

  return (
    <span className="inline-flex rounded-lg border border-red-200 bg-red-50 px-3 py-1.5 text-[10px] font-black text-red-600">
      REJECTED
    </span>
  );
}

