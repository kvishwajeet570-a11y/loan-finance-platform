const API =
  process.env.NEXT_PUBLIC_API_URL || "http://localhost:5000/api";

type KycRecord = {
  id: string;
  userId?: string;
  fullName?: string;
  panNumber?: string;
  dob?: string;
  address?: string;
  city?: string;
  state?: string;
  pincode?: string;

  status?: string;
  rejectionReason?: string;

  createdAt?: string;
  updatedAt?: string;
  approvedAt?: string;
  expiryDate?: string;

  panVerificationStatus?: string;
  aadhaarVerificationStatus?: string;
  bankVerificationStatus?: string;

  panVerifiedAt?: string;
  aadhaarVerifiedAt?: string;
  bankVerifiedAt?: string;
  verificationUpdatedAt?: string;

  user?: {
    id?: string;
    name?: string;
    fullName?: string;
    email?: string;
    phoneNo?: string;
    phone?: string;
  };

  [key: string]: any;
};

function getAuth() {
  if (typeof window === "undefined") {
    return {
      user: null,
      headers: {} as Record<string, string>,
    };
  }

  const raw = localStorage.getItem("loan_finance_user");
  const token = localStorage.getItem("loan_finance_token");

  let user: any = null;

  try {
    user = raw ? JSON.parse(raw) : null;
  } catch {
    user = null;
  }

  const headers: Record<string, string> = {};

  if (token) {
    headers.Authorization = `Bearer ${token}`;
  }

  return { user, headers };
}

function normaliseStatus(status?: string) {
  return String(status || "PENDING")
    .trim()
    .toUpperCase()
    .replace(/[\s-]+/g, "_");
}

function statusLabel(status?: string) {
  const value = normaliseStatus(status);

  const labels: Record<string, string> = {
    PENDING: "Pending",
    UNDER_REVIEW: "Under Review",
    IN_REVIEW: "In Review",
    APPROVED: "Approved",
    VERIFIED: "Verified",
    REJECTED: "Rejected",
  };

  return labels[value] || value.replace(/_/g, " ");
}

function statusStyle(status?: string) {
  const value = normaliseStatus(status);

  if (value === "APPROVED" || value === "VERIFIED") {
    return "border-emerald-200 bg-emerald-50 text-emerald-700";
  }

  if (value === "REJECTED") {
    return "border-rose-200 bg-rose-50 text-rose-700";
  }

  if (value === "UNDER_REVIEW" || value === "IN_REVIEW") {
    return "border-violet-200 bg-violet-50 text-violet-700";
  }

  return "border-amber-200 bg-amber-50 text-amber-700";
}

function verificationStyle(status?: string) {
  const value = normaliseStatus(status);

  if (value === "APPROVED" || value === "VERIFIED") {
    return {
      box: "border-emerald-200 bg-emerald-50",
      icon: "text-emerald-600",
      text: "text-emerald-700",
    };
  }

  if (value === "REJECTED" || value === "FAILED") {
    return {
      box: "border-rose-200 bg-rose-50",
      icon: "text-rose-600",
      text: "text-rose-700",
    };
  }

  return {
    box: "border-amber-200 bg-amber-50",
    icon: "text-amber-600",
    text: "text-amber-700",
  };
}

function isVerified(status?: string) {
  const value = normaliseStatus(status);
  return value === "APPROVED" || value === "VERIFIED";
}

function formatDate(value?: string) {
  if (!value) return "—";

  try {
    return new Intl.DateTimeFormat("en-IN", {
      day: "2-digit",
      month: "short",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    }).format(new Date(value));
  } catch {
    return value;
  }
}

function formatDob(value?: string) {
  if (!value) return "—";

  const raw = String(value).trim();

  if (/^\d{4}-\d{2}-\d{2}$/.test(raw)) {
    const [year, month, day] = raw.split("-");
    return `${day}-${month}-${year}`;
  }

  return raw;
}

function maskPan(value?: string) {
  if (!value) return "Not available";

  const pan = String(value).toUpperCase();

  if (pan.length !== 10) return pan;

  return `${pan.slice(0, 3)}*****${pan.slice(-2)}`;
}

function extractKyc(json: any): KycRecord | null {
  const candidates = [
    json?.data,
    json?.data?.data,
    json?.data?.kyc,
    json?.kyc,
    json?.record,
  ];

  for (const candidate of candidates) {
    if (candidate && !Array.isArray(candidate)) {
      if (candidate.id || candidate.userId || candidate.panNumber) {
        return candidate as KycRecord;
      }
    }
  }

  return null;
}

export default function KycDetailPage() {
