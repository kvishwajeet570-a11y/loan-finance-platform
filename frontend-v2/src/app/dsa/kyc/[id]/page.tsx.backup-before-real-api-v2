  const router = useRouter();

  const id = Array.isArray(params.id)
    ? params.id[0]
    : String(params.id || "");

  const [kyc, setKyc] = useState<KycRecord | null>(null);
  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);
  const [error, setError] = useState("");
  const [actionLoading, setActionLoading] = useState("");
  const [showReject, setShowReject] = useState(false);
  const [rejectReason, setRejectReason] = useState("");

  const loadKyc = useCallback(
    async (showRefresh = false) => {
      if (!id) {
        setError("Invalid KYC ID.");
        setLoading(false);
        return;
      }

      if (showRefresh) {
        setRefreshing(true);
      } else {
        setLoading(true);
      }

      setError("");

      try {
        const { headers } = getAuth();

        const response = await fetch(`${API}/kyc/${encodeURIComponent(id)}`, {
          method: "GET",
          headers,
          cache: "no-store",
        });

        const json = await response.json().catch(() => ({}));

        if (!response.ok) {
          throw new Error(
            json?.message ||
              json?.error ||
              `KYC API returned ${response.status}`
          );
        }

        const record = extractKyc(json);

        if (!record) {
          throw new Error("KYC record was not found in the API response.");
        }

        setKyc(record);
      } catch (err: any) {
        setKyc(null);
        setError(err?.message || "Unable to load KYC details.");
      } finally {
        setLoading(false);
        setRefreshing(false);
      }
    },
    [id]
  );

  useEffect(() => {
    loadKyc();
  }, [loadKyc]);

  const approveKyc = async () => {
    if (!kyc) return;

    setActionLoading("approve");
    setError("");

    try {
      const { user, headers } = getAuth();

      const response = await fetch(
        `${API}/kyc/${encodeURIComponent(kyc.id)}/approve`,
        {
          method: "PATCH",
          headers: {
            ...headers,
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            adminId: user?.id,
          }),
        }
      );

      const json = await response.json().catch(() => ({}));

      if (!response.ok) {
        throw new Error(
          json?.message ||
            json?.error ||
            "Unable to approve KYC."
        );
      }

      await loadKyc(true);
    } catch (err: any) {
      setError(err?.message || "Unable to approve KYC.");
    } finally {
      setActionLoading("");
    }
  };

  const rejectKyc = async () => {
    if (!kyc) return;

    setActionLoading("reject");
    setError("");

    try {
      const { headers } = getAuth();

      const response = await fetch(
        `${API}/kyc/${encodeURIComponent(kyc.id)}/reject`,
        {
          method: "PATCH",
          headers: {
            ...headers,
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            reason:
              rejectReason.trim() ||
              "KYC verification rejected.",
          }),
        }
      );

      const json = await response.json().catch(() => ({}));

      if (!response.ok) {
        throw new Error(
          json?.message ||
            json?.error ||
            "Unable to reject KYC."
        );
      }

      setShowReject(false);
      setRejectReason("");

      await loadKyc(true);
    } catch (err: any) {
      setError(err?.message || "Unable to reject KYC.");
    } finally {
      setActionLoading("");
    }
  };

