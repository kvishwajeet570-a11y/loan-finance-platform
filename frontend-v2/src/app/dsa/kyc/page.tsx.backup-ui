"use client";

import { useEffect, useMemo, useState } from "react";
import DsaShell from "@/components/dsa/DsaShell";
import {
  ShieldCheck,
  Clock3,
  CheckCircle2,
  XCircle,
  Search,
  RefreshCw,
  Eye,
  UserRound,
  CreditCard,
  Building2,
  FileCheck2,
  MapPin,
  Mail,
  Phone,
  CalendarDays,
  Sparkles,
  ChevronRight,
  X,
  BadgeCheck,
  AlertCircle,
  LockKeyhole,
} from "lucide-react";

const API =
  process.env.NEXT_PUBLIC_API_URL || "http://localhost:5000/api";

type KycRecord = {
  id: string;
  userId?: string;
  fullName?: string;
  name?: string;
  email?: string;
  phone?: string;
  panNo?: string;
  panNumber?: string;
  aadhaarNo?: string;
  aadhaarNumber?: string;
  status?: string;
  createdAt?: string;
  updatedAt?: string;
  city?: string;
  state?: string;
  address?: string;
  panVerified?: boolean;
  aadhaarVerified?: boolean;
  bankVerified?: boolean;
  bankAccountVerified?: boolean;
  documentVerified?: boolean;
  [key: string]: any;
};

function auth() {
  if (typeof window === "undefined") {
    return { user: null, headers: {} as Record<string, string> };
  }

  const raw = localStorage.getItem("loan_finance_user");
  const token = localStorage.getItem("loan_finance_token");

  let user: any = null;

  try {
    user = raw ? JSON.parse(raw) : null;
  } catch {
    user = null;
  }

  const headers: Record<string, string> = {};

  if (token) {
    headers.Authorization = `Bearer ${token}`;
  }

  return { user, headers };
}

function statusOf(value?: string) {
  return String(value || "PENDING")
    .trim()
    .toUpperCase()
    .replace(/[\s-]+/g, "_");
}

function statusClass(status?: string) {
  const s = statusOf(status);

  if (s === "APPROVED" || s === "VERIFIED") {
    return "border-emerald-200 bg-emerald-50 text-emerald-700";
  }

  if (s === "REJECTED") {
    return "border-red-200 bg-red-50 text-red-700";
  }

  if (s === "UNDER_REVIEW") {
    return "border-violet-200 bg-violet-50 text-violet-700";
  }

  return "border-amber-200 bg-amber-50 text-amber-700";
}

function dateValue(value?: string) {
  if (!value) return "—";

  const d = new Date(value);

  if (Number.isNaN(d.getTime())) return "—";

  return d.toLocaleDateString("en-IN", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  });
}

function mask(value?: string) {
  if (!value) return "Not available";
  if (value.length <= 4) return value;
  return "•••• " + value.slice(-4);
}

export default function DsaKycPage() {
  const [records, setRecords] = useState<KycRecord[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [search, setSearch] = useState("");
  const [filter, setFilter] = useState("ALL");
  const [selected, setSelected] = useState<KycRecord | null>(null);
  const [activeTab, setActiveTab] = useState("overview");

  async function loadKyc() {
    try {
      setLoading(true);
      setError("");

      const { user, headers } = auth();

      if (!user?.id) {
        throw new Error("DSA login session not found.");
      }

      const endpoints = [
        `${API}/dsa/${user.id}/kyc`,
        `${API}/kyc/dsa/${user.id}`,
        `${API}/kyc`,
      ];

      let response: Response | null = null;

      for (const endpoint of endpoints) {
        try {
          const res = await fetch(endpoint, {
            headers,
            cache: "no-store",
          });

          if (res.ok) {
            response = res;
            break;
          }
        } catch {
          // Try next compatible endpoint.
        }
      }

      if (!response) {
        throw new Error("Unable to load KYC data.");
      }

      const data = await response.json();

      const rows =
        Array.isArray(data)
          ? data
          : Array.isArray(data?.data)
          ? data.data
          : Array.isArray(data?.kyc)
          ? data.kyc
          : Array.isArray(data?.records)
          ? data.records
          : [];

      setRecords(rows);
    } catch (err: any) {
      setError(err?.message || "Unable to load KYC records.");
      setRecords([]);
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    loadKyc();
  }, []);

  const stats = useMemo(() => {
    const pending = records.filter(
      (x) =>
        statusOf(x.status) === "PENDING" ||
        statusOf(x.status) === "UNDER_REVIEW"
    ).length;

    const approved = records.filter(
      (x) =>
        statusOf(x.status) === "APPROVED" ||
        statusOf(x.status) === "VERIFIED"
    ).length;

    const rejected = records.filter(
      (x) => statusOf(x.status) === "REJECTED"
    ).length;

    return {
      total: records.length,
      pending,
      approved,
      rejected,
    };
  }, [records]);

  const filtered = useMemo(() => {
    const q = search.trim().toLowerCase();

    return records.filter((item) => {
      const matchesSearch =
        !q ||
        [
          item.fullName,
          item.name,
          item.email,
          item.phone,
          item.panNo,
          item.panNumber,
          item.city,
          item.state,
        ]
          .filter(Boolean)
          .join(" ")
          .toLowerCase()
          .includes(q);

      const s = statusOf(item.status);

      const matchesFilter =
        filter === "ALL" ||
        (filter === "PENDING" &&
          (s === "PENDING" || s === "UNDER_REVIEW")) ||
        (filter === "APPROVED" &&
          (s === "APPROVED" || s === "VERIFIED")) ||
        (filter === "REJECTED" && s === "REJECTED");

      return matchesSearch && matchesFilter;
    });
  }, [records, search, filter]);

  return (
    <DsaShell>
      <div className="min-h-screen bg-[#f4f7fb] px-4 py-5 md:px-6 lg:px-8">

        {/* PREMIUM HERO */}
        <section className="relative overflow-hidden rounded-[30px] bg-gradient-to-br from-[#071b49] via-[#0b3b91] to-[#087ea4] p-6 text-white shadow-2xl md:p-8">

          <div className="absolute -right-20 -top-24 h-72 w-72 rounded-full bg-cyan-300/20 blur-3xl" />
          <div className="absolute -bottom-28 left-1/3 h-72 w-72 rounded-full bg-blue-300/10 blur-3xl" />

          <div className="relative z-10 grid gap-8 lg:grid-cols-[1.5fr_1fr] lg:items-center">

            <div>
              <div className="mb-4 inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-2 text-xs font-black uppercase tracking-[0.18em] backdrop-blur-xl">
                <Sparkles className="h-4 w-4 text-cyan-200" />
                Smart KYC Verification Center
              </div>

              <h1 className="max-w-3xl text-3xl font-black leading-tight md:text-5xl">
                Customer KYC
                <span className="block text-cyan-200">
                  Verification Dashboard
                </span>
              </h1>

              <p className="mt-4 max-w-2xl text-sm leading-6 text-blue-100 md:text-base">
                Review customer identity information, verification status,
                documents and application-linked KYC data from one secure
                workspace.
              </p>

              <div className="mt-6 flex flex-wrap gap-3">
                <div className="flex items-center gap-2 rounded-2xl border border-white/15 bg-white/10 px-4 py-3 backdrop-blur-xl">
                  <ShieldCheck className="h-5 w-5 text-cyan-200" />
                  <span className="text-sm font-bold">Secure Verification</span>
                </div>

                <div className="flex items-center gap-2 rounded-2xl border border-white/15 bg-white/10 px-4 py-3 backdrop-blur-xl">
                  <LockKeyhole className="h-5 w-5 text-emerald-200" />
                  <span className="text-sm font-bold">Protected Data</span>
                </div>
              </div>
            </div>

            <div className="hidden lg:flex justify-end">
              <div className="relative h-64 w-64 rounded-[40px] border border-white/15 bg-white/10 p-6 shadow-2xl backdrop-blur-xl">
                <div className="flex h-full flex-col items-center justify-center rounded-[30px] border border-white/10 bg-white/10">
                  <div className="flex h-24 w-24 items-center justify-center rounded-full bg-white/15 shadow-xl">
                    <ShieldCheck className="h-14 w-14 text-cyan-100" />
                  </div>
                  <p className="mt-5 text-lg font-black">
                    KYC Secure
                  </p>
                  <p className="mt-1 text-xs text-blue-100">
                    Real-time verification workspace
                  </p>
                </div>
              </div>
            </div>

          </div>
        </section>

        {/* STAT CARDS */}
        <section className="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">

          {[
            {
              label: "Total KYC",
              value: stats.total,
              icon: FileCheck2,
              bg: "from-blue-600 to-cyan-500",
            },
            {
              label: "Pending Review",
              value: stats.pending,
              icon: Clock3,
              bg: "from-amber-500 to-orange-500",
            },
            {
              label: "Verified",
              value: stats.approved,
              icon: CheckCircle2,
              bg: "from-emerald-500 to-teal-500",
            },
            {
              label: "Rejected",
              value: stats.rejected,
              icon: XCircle,
              bg: "from-rose-500 to-red-600",
            },
          ].map((card) => {
            const Icon = card.icon;

            return (
              <div
                key={card.label}
                className="group relative overflow-hidden rounded-3xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-xl"
              >
                <div
                  className={`absolute right-0 top-0 h-24 w-24 rounded-full bg-gradient-to-br ${card.bg} opacity-10 blur-2xl`}
                />

                <div className="relative flex items-center justify-between">
                  <div>
                    <p className="text-xs font-black uppercase tracking-wider text-slate-400">
                      {card.label}
                    </p>
                    <p className="mt-2 text-3xl font-black text-slate-950">
                      {card.value}
                    </p>
                  </div>

                  <div
                    className={`flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-br ${card.bg} text-white shadow-lg`}
                  >
                    <Icon className="h-6 w-6" />
                  </div>
                </div>
              </div>
            );
          })}
        </section>

        {/* SEARCH + FILTER */}
        <section className="mt-6 rounded-3xl border border-slate-200 bg-white p-4 shadow-sm md:p-5">
          <div className="flex flex-col gap-4 xl:flex-row xl:items-center xl:justify-between">

            <div className="relative w-full xl:max-w-xl">
              <Search className="absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-400" />

              <input
                value={search}
                onChange={(e) => setSearch(e.target.value)}
                placeholder="Search customer, phone, email, PAN, city..."
                className="w-full rounded-2xl border border-slate-200 bg-slate-50 py-3.5 pl-12 pr-4 text-sm font-semibold text-slate-800 outline-none transition focus:border-blue-400 focus:bg-white focus:ring-4 focus:ring-blue-100"
              />
            </div>

            <div className="flex flex-wrap gap-2">
              {[
                ["ALL", "All KYC"],
                ["PENDING", "Pending"],
                ["APPROVED", "Verified"],
                ["REJECTED", "Rejected"],
              ].map(([value, label]) => (
                <button
                  key={value}
                  type="button"
                  onClick={() => setFilter(value)}
                  className={`rounded-xl px-4 py-3 text-xs font-black transition ${
                    filter === value
                      ? "bg-blue-600 text-white shadow-lg shadow-blue-600/20"
                      : "border border-slate-200 bg-slate-50 text-slate-600 hover:bg-slate-100"
                  }`}
                >
                  {label}
                </button>
              ))}

              <button
                type="button"
                onClick={loadKyc}
                className="flex items-center gap-2 rounded-xl bg-slate-900 px-4 py-3 text-xs font-black text-white shadow-lg transition hover:bg-blue-700"
              >
                <RefreshCw className="h-4 w-4" />
                Refresh
              </button>
            </div>
          </div>
        </section>

        {/* TABLE */}
        <section className="mt-6 overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">

          <div className="flex flex-col gap-2 border-b border-slate-200 px-5 py-5 md:flex-row md:items-center md:justify-between">
            <div>
              <h2 className="text-xl font-black text-slate-950">
                KYC Verification Records
              </h2>
              <p className="mt-1 text-sm font-medium text-slate-500">
                {filtered.length} customer records available
              </p>
            </div>

            <div className="flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-4 py-2 text-xs font-black text-emerald-700">
              <span className="h-2 w-2 animate-pulse rounded-full bg-emerald-500" />
              LIVE DATA
            </div>
          </div>

          {loading ? (
            <div className="flex min-h-[320px] items-center justify-center">
              <div className="flex items-center gap-3 text-sm font-bold text-slate-500">
                <RefreshCw className="h-5 w-5 animate-spin text-blue-600" />
                Loading KYC records...
              </div>
            </div>
          ) : error ? (
            <div className="m-5 rounded-2xl border border-red-200 bg-red-50 p-5 text-sm font-bold text-red-700">
              {error}
            </div>
          ) : filtered.length === 0 ? (
            <div className="flex min-h-[300px] flex-col items-center justify-center px-6 text-center">
              <div className="flex h-16 w-16 items-center justify-center rounded-2xl bg-slate-100">
                <Search className="h-7 w-7 text-slate-400" />
              </div>
              <h3 className="mt-4 text-lg font-black text-slate-900">
                No KYC records found
              </h3>
              <p className="mt-1 text-sm text-slate-500">
                Try another search or filter.
              </p>
            </div>
          ) : (
            <div className="overflow-x-auto">
              <table className="w-full min-w-[1050px]">
                <thead>
                  <tr className="border-b border-slate-200 bg-slate-50 text-left">
                    <th className="px-5 py-4 text-xs font-black uppercase tracking-wider text-slate-400">
                      Customer
                    </th>
                    <th className="px-5 py-4 text-xs font-black uppercase tracking-wider text-slate-400">
                      Contact
                    </th>
                    <th className="px-5 py-4 text-xs font-black uppercase tracking-wider text-slate-400">
                      PAN
                    </th>
                    <th className="px-5 py-4 text-xs font-black uppercase tracking-wider text-slate-400">
                      Location
                    </th>
                    <th className="px-5 py-4 text-xs font-black uppercase tracking-wider text-slate-400">
                      Status
                    </th>
                    <th className="px-5 py-4 text-xs font-black uppercase tracking-wider text-slate-400">
                      Submitted
                    </th>
                    <th className="px-5 py-4 text-right text-xs font-black uppercase tracking-wider text-slate-400">
                      Action
                    </th>
                  </tr>
                </thead>

                <tbody className="divide-y divide-slate-100">
                  {filtered.map((item) => (
                    <tr
                      key={item.id}
                      className="group transition hover:bg-blue-50/40"
                    >
                      <td className="px-5 py-5">
                        <div className="flex items-center gap-3">
                          <div className="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-blue-600 to-cyan-500 text-white shadow-md">
                            <UserRound className="h-5 w-5" />
                          </div>

                          <div>
                            <p className="font-black text-slate-900">
                              {item.fullName || item.name || "Unnamed Customer"}
                            </p>
                            <p className="mt-0.5 text-xs font-medium text-slate-400">
                              ID: {item.id}
                            </p>
                          </div>
                        </div>
                      </td>

                      <td className="px-5 py-5">
                        <p className="text-sm font-bold text-slate-800">
                          {item.phone || "—"}
                        </p>
                        <p className="mt-1 text-xs font-medium text-slate-400">
                          {item.email || "—"}
                        </p>
                      </td>

                      <td className="px-5 py-5">
                        <span className="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-black text-slate-700">
                          {mask(item.panNo || item.panNumber)}
                        </span>
                      </td>

                      <td className="px-5 py-5">
                        <div className="flex items-center gap-1.5 text-sm font-bold text-slate-700">
                          <MapPin className="h-4 w-4 text-slate-400" />
                          {[item.city, item.state]
                            .filter(Boolean)
                            .join(", ") || "—"}
                        </div>
                      </td>

                      <td className="px-5 py-5">
                        <span
                          className={`inline-flex rounded-full border px-3 py-1.5 text-xs font-black ${statusClass(
                            item.status
                          )}`}
                        >
                          {statusOf(item.status).replace("_", " ")}
                        </span>
                      </td>

                      <td className="px-5 py-5 text-sm font-bold text-slate-600">
                        {dateValue(item.createdAt)}
                      </td>

                      <td className="px-5 py-5 text-right">
                        <button
                          type="button"
                          onClick={() => {
                            setSelected(item);
                            setActiveTab("overview");
                          }}
                          className="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-blue-600 to-cyan-500 px-4 py-2.5 text-xs font-black text-white shadow-lg shadow-blue-500/20 transition hover:-translate-y-0.5 hover:shadow-xl"
                        >
                          <Eye className="h-4 w-4" />
                          View Details
                          <ChevronRight className="h-4 w-4" />
                        </button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>

        {/* ADVANCED DETAIL MODAL */}
        {selected && (
          <div
            className="fixed inset-0 z-[100] flex items-center justify-center bg-slate-950/70 p-3 backdrop-blur-md md:p-6"
            onClick={() => setSelected(null)}
          >
            <div
              className="w-full max-w-6xl overflow-hidden rounded-[30px] border border-white/20 bg-white shadow-2xl"
              onClick={(e) => e.stopPropagation()}
            >
              <div className="relative overflow-hidden bg-gradient-to-br from-[#061a45] via-[#0b4aa2] to-[#08a0c7] p-6 text-white md:p-8">

                <div className="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-cyan-300/20 blur-3xl" />

                <div className="relative flex items-start justify-between gap-4">
                  <div className="flex items-center gap-4">
                    <div className="flex h-16 w-16 items-center justify-center rounded-2xl bg-white/15 backdrop-blur-xl">
                      <ShieldCheck className="h-8 w-8 text-cyan-100" />
                    </div>

                    <div>
                      <p className="text-xs font-black uppercase tracking-[0.2em] text-cyan-100">
                        KYC Verification Profile
                      </p>

                      <h2 className="mt-1 text-2xl font-black md:text-3xl">
                        {selected.fullName ||
                          selected.name ||
                          "Unnamed Customer"}
                      </h2>

                      <p className="mt-1 text-sm text-blue-100">
                        Application ID: {selected.id}
                      </p>
                    </div>
                  </div>

                  <button
                    type="button"
                    onClick={() => setSelected(null)}
                    className="flex h-11 w-11 items-center justify-center rounded-full bg-white/15 transition hover:bg-white/25"
                  >
                    <X className="h-5 w-5" />
                  </button>
                </div>

                <div className="relative mt-6 flex flex-wrap gap-2">
                  {[
                    ["overview", "Overview"],
                    ["identity", "Identity"],
                    ["verification", "Verification"],
                  ].map(([value, label]) => (
                    <button
                      key={value}
                      type="button"
                      onClick={() => setActiveTab(value)}
                      className={`rounded-xl px-5 py-2.5 text-xs font-black uppercase tracking-wide transition ${
                        activeTab === value
                          ? "bg-white text-blue-700 shadow-lg"
                          : "bg-white/10 text-white hover:bg-white/20"
                      }`}
                    >
                      {label}
                    </button>
                  ))}
                </div>
              </div>

              <div className="max-h-[68vh] overflow-y-auto p-5 md:p-8">

                {activeTab === "overview" && (
                  <div className="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
                    {[
                      [
                        "Customer",
                        selected.fullName || selected.name || "—",
                        UserRound,
                      ],
                      ["Phone", selected.phone || "—", Phone],
                      ["Email", selected.email || "—", Mail],
                      [
                        "Location",
                        [selected.city, selected.state]
                          .filter(Boolean)
                          .join(", ") || "—",
                        MapPin,
                      ],
                      [
                        "PAN",
                        mask(selected.panNo || selected.panNumber),
                        CreditCard,
                      ],
                      [
                        "Submitted",
                        dateValue(selected.createdAt),
                        CalendarDays,
                      ],
                    ].map(([label, value, Icon]: any) => (
                      <div
                        key={label}
                        className="rounded-2xl border border-slate-200 bg-slate-50 p-5"
                      >
                        <div className="flex items-center gap-2 text-slate-400">
                          <Icon className="h-4 w-4" />
                          <p className="text-xs font-black uppercase tracking-wider">
                            {label}
                          </p>
                        </div>

                        <p className="mt-3 break-words text-base font-black text-slate-900">
                          {value}
                        </p>
                      </div>
                    ))}

                    <div className="rounded-2xl border border-emerald-200 bg-emerald-50 p-5 md:col-span-2 xl:col-span-3">
                      <div className="flex items-center gap-3">
                        <div className="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-600 text-white">
                          <BadgeCheck className="h-6 w-6" />
                        </div>

                        <div>
                          <p className="text-xs font-black uppercase tracking-wider text-emerald-600">
                            Current KYC Status
                          </p>

                          <p className="mt-1 text-xl font-black text-emerald-900">
                            {statusOf(selected.status).replace("_", " ")}
                          </p>
                        </div>
                      </div>
                    </div>
                  </div>
                )}

                {activeTab === "identity" && (
                  <div className="grid gap-5 md:grid-cols-2">
                    <div className="rounded-3xl border border-blue-100 bg-blue-50/60 p-6">
                      <div className="flex items-center gap-3">
                        <CreditCard className="h-6 w-6 text-blue-600" />
                        <h3 className="font-black text-slate-900">
                          PAN Information
                        </h3>
                      </div>

                      <p className="mt-5 text-xs font-black uppercase tracking-wider text-slate-400">
                        PAN Number
                      </p>

                      <p className="mt-2 text-xl font-black text-slate-900">
                        {mask(selected.panNo || selected.panNumber)}
                      </p>
                    </div>

                    <div className="rounded-3xl border border-violet-100 bg-violet-50/60 p-6">
                      <div className="flex items-center gap-3">
                        <ShieldCheck className="h-6 w-6 text-violet-600" />
                        <h3 className="font-black text-slate-900">
                          Identity Information
                        </h3>
                      </div>

                      <p className="mt-5 text-xs font-black uppercase tracking-wider text-slate-400">
                        Customer Name
                      </p>

                      <p className="mt-2 text-xl font-black text-slate-900">
                        {selected.fullName || selected.name || "—"}
                      </p>
                    </div>

                    <div className="rounded-3xl border border-slate-200 bg-white p-6 md:col-span-2">
                      <p className="text-xs font-black uppercase tracking-wider text-slate-400">
                        Address
                      </p>

                      <p className="mt-3 text-base font-bold text-slate-800">
                        {selected.address ||
                          [selected.city, selected.state]
                            .filter(Boolean)
                            .join(", ") ||
                          "Address not available"}
                      </p>
                    </div>
                  </div>
                )}

                {activeTab === "verification" && (
                  <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    {[
                      [
                        "PAN Verification",
                        selected.panVerified,
                        CreditCard,
                      ],
                      [
                        "Aadhaar Verification",
                        selected.aadhaarVerified,
                        ShieldCheck,
                      ],
                      [
                        "Bank Verification",
                        selected.bankVerified ||
                          selected.bankAccountVerified,
                        Building2,
                      ],
                      [
                        "Document Verification",
                        selected.documentVerified,
                        FileCheck2,
                      ],
                    ].map(([label, verified, Icon]: any) => (
                      <div
                        key={label}
                        className="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm"
                      >
                        <div className="flex items-center justify-between">
                          <div className="flex h-11 w-11 items-center justify-center rounded-xl bg-slate-100">
                            <Icon className="h-5 w-5 text-slate-600" />
                          </div>

                          {verified ? (
                            <CheckCircle2 className="h-6 w-6 text-emerald-500" />
                          ) : (
                            <AlertCircle className="h-6 w-6 text-amber-500" />
                          )}
                        </div>

                        <p className="mt-5 text-sm font-black text-slate-900">
                          {label}
                        </p>

                        <p
                          className={`mt-2 text-xs font-black ${
                            verified
                              ? "text-emerald-600"
                              : "text-amber-600"
                          }`}
                        >
                          {verified ? "VERIFIED" : "PENDING"}
                        </p>
                      </div>
                    ))}
                  </div>
                )}

              </div>
            </div>
          </div>
        )}
      </div>
    </DsaShell>
  );
}
