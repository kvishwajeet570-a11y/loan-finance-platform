"use client";

import { useMemo, useState } from "react";
import {
  Search,
  SlidersHorizontal,
  Eye,
  CheckCircle2,
  XCircle,
  Clock3,
  FileText,
  User,
  MoreHorizontal,
  ChevronDown,
  RefreshCw,
} from "lucide-react";

type KYC = {
  id: string;
  name: string;
  phone: string;
  email: string;
  pan: string;
  type: string;
  submitted: string;
  status: "PENDING" | "UNDER_REVIEW" | "APPROVED" | "REJECTED";
};

const data: KYC[] = [
  {
    id: "KYC-1001",
    name: "Rahul Kumar",
    phone: "+91 98765 43210",
    email: "rahul@example.com",
    pan: "ABCDE1234F",
    type: "Individual",
    submitted: "05 Oct 2026, 10:42 AM",
    status: "PENDING",
  },
  {
    id: "KYC-1002",
    name: "Priya Singh",
    phone: "+91 91234 56789",
    email: "priya@example.com",
    pan: "FGHIJ5678K",
    type: "Individual",
    submitted: "05 Oct 2026, 09:18 AM",
    status: "UNDER_REVIEW",
  },
  {
    id: "KYC-1003",
    name: "Amit Sharma",
    phone: "+91 99887 66554",
    email: "amit@example.com",
    pan: "LMNOP9012Q",
    type: "Individual",
    submitted: "04 Oct 2026, 06:35 PM",
    status: "APPROVED",
  },
  {
    id: "KYC-1004",
    name: "Neha Verma",
    phone: "+91 98711 22334",
    email: "neha@example.com",
    pan: "RSTUV3456W",
    type: "Individual",
    submitted: "04 Oct 2026, 03:21 PM",
    status: "REJECTED",
  },
];

export default function DsaKycPage() {
  const [active, setActive] = useState("ALL");
  const [search, setSearch] = useState("");
  const [selected, setSelected] = useState<KYC | null>(null);

  const counts = useMemo(() => ({
    ALL: data.length,
    PENDING: data.filter(x => x.status === "PENDING").length,
    UNDER_REVIEW: data.filter(x => x.status === "UNDER_REVIEW").length,
    APPROVED: data.filter(x => x.status === "APPROVED").length,
    REJECTED: data.filter(x => x.status === "REJECTED").length,
  }), []);

  const filtered = data.filter(item => {
    const tabMatch = active === "ALL" || item.status === active;
    const q = search.toLowerCase();
    const searchMatch =
      !q ||
      item.name.toLowerCase().includes(q) ||
      item.phone.toLowerCase().includes(q) ||
      item.email.toLowerCase().includes(q) ||
      item.pan.toLowerCase().includes(q) ||
      item.id.toLowerCase().includes(q);

    return tabMatch && searchMatch;
  });

  const statusStyle = (status: KYC["status"]) => {
    if (status === "APPROVED")
      return "bg-emerald-50 text-emerald-700 border-emerald-200";
    if (status === "REJECTED")
      return "bg-red-50 text-red-700 border-red-200";
    if (status === "UNDER_REVIEW")
      return "bg-blue-50 text-blue-700 border-blue-200";
    return "bg-amber-50 text-amber-700 border-amber-200";
  };

  return (
    <main className="min-h-screen bg-[#f6f8fc] text-slate-900">
      <div className="p-4 md:p-6 lg:p-8">

        <div className="mb-7 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
          <div>
            <div className="mb-1 flex items-center gap-2 text-sm text-slate-500">
              <span>DSA</span>
              <span>/</span>
              <span className="text-slate-700">KYC Verification</span>
            </div>

            <h1 className="text-2xl font-bold tracking-tight md:text-3xl">
              KYC Verification
            </h1>

            <p className="mt-1 text-sm text-slate-500">
              Review and manage customer KYC verification requests.
            </p>
          </div>

          <button
            onClick={() => window.location.reload()}
            className="flex h-10 items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 text-sm font-medium shadow-sm hover:bg-slate-50"
          >
            <RefreshCw size={16} />
            Refresh
          </button>
        </div>

        <section className="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
          <div className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div className="flex items-center justify-between">
              <div className="rounded-xl bg-indigo-50 p-3 text-indigo-600">
                <FileText size={21} />
              </div>
              <span className="text-xs font-semibold text-slate-400">TOTAL</span>
            </div>
            <div className="mt-4 text-3xl font-bold">{counts.ALL}</div>
            <div className="mt-1 text-sm text-slate-500">Total KYC</div>
          </div>

          <div className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div className="flex items-center justify-between">
              <div className="rounded-xl bg-amber-50 p-3 text-amber-600">
                <Clock3 size={21} />
              </div>
              <span className="text-xs font-semibold text-amber-600">PENDING</span>
            </div>
            <div className="mt-4 text-3xl font-bold">{counts.PENDING}</div>
            <div className="mt-1 text-sm text-slate-500">Awaiting verification</div>
          </div>

          <div className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div className="flex items-center justify-between">
              <div className="rounded-xl bg-blue-50 p-3 text-blue-600">
                <Eye size={21} />
              </div>
              <span className="text-xs font-semibold text-blue-600">REVIEW</span>
            </div>
            <div className="mt-4 text-3xl font-bold">{counts.UNDER_REVIEW}</div>
            <div className="mt-1 text-sm text-slate-500">Under review</div>
          </div>

          <div className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div className="flex items-center justify-between">
              <div className="rounded-xl bg-emerald-50 p-3 text-emerald-600">
                <CheckCircle2 size={21} />
              </div>
              <span className="text-xs font-semibold text-emerald-600">APPROVED</span>
            </div>
            <div className="mt-4 text-3xl font-bold">{counts.APPROVED}</div>
            <div className="mt-1 text-sm text-slate-500">Successfully verified</div>
          </div>
        </section>

        <section className="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

          <div className="border-b border-slate-200 px-5 pt-5">
            <div className="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">

              <div className="flex gap-1 overflow-x-auto">
                {[
                  ["ALL", "All"],
                  ["PENDING", "Pending"],
                  ["UNDER_REVIEW", "Under Review"],
                  ["APPROVED", "Approved"],
                  ["REJECTED", "Rejected"],
                ].map(([value, label]) => (
                  <button
                    key={value}
                    onClick={() => setActive(value)}
                    className={`whitespace-nowrap rounded-t-xl px-4 py-3 text-sm font-semibold transition ${
                      active === value
                        ? "border-b-2 border-indigo-600 text-indigo-600"
                        : "text-slate-500 hover:text-slate-900"
                    }`}
                  >
                    {label}
                    <span className="ml-2 rounded-full bg-slate-100 px-2 py-0.5 text-xs">
                      {counts[value as keyof typeof counts]}
                    </span>
                  </button>
                ))}
              </div>

              <div className="flex gap-2 pb-4">
                <div className="relative">
                  <Search
                    size={17}
                    className="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"
                  />
                  <input
                    value={search}
                    onChange={e => setSearch(e.target.value)}
                    placeholder="Search KYC..."
                    className="h-10 w-full rounded-xl border border-slate-200 bg-slate-50 pl-10 pr-4 text-sm outline-none focus:border-indigo-500 focus:bg-white sm:w-64"
                  />
                </div>

                <button className="flex h-10 items-center gap-2 rounded-xl border border-slate-200 px-3 text-sm font-medium hover:bg-slate-50">
                  <SlidersHorizontal size={16} />
                  Filter
                  <ChevronDown size={15} />
                </button>
              </div>
            </div>
          </div>

          <div className="overflow-x-auto">
            <table className="w-full min-w-[1000px]">
              <thead>
                <tr className="border-b border-slate-100 bg-slate-50/80 text-left">
                  <th className="px-5 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">
                    Customer
                  </th>
                  <th className="px-5 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">
                    KYC ID
                  </th>
                  <th className="px-5 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">
                    PAN
                  </th>
                  <th className="px-5 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">
                    Type
                  </th>
                  <th className="px-5 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">
                    Submitted
                  </th>
                  <th className="px-5 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">
                    Status
                  </th>
                  <th className="px-5 py-4 text-right text-xs font-bold uppercase tracking-wider text-slate-500">
                    Action
                  </th>
                </tr>
              </thead>

              <tbody>
                {filtered.map(item => (
                  <tr
                    key={item.id}
                    className="border-b border-slate-100 transition hover:bg-slate-50/70"
                  >
                    <td className="px-5 py-4">
                      <div className="flex items-center gap-3">
                        <div className="flex h-10 w-10 items-center justify-center rounded-full bg-indigo-50 text-indigo-600">
                          <User size={18} />
                        </div>
                        <div>
                          <div className="font-semibold">{item.name}</div>
                          <div className="text-xs text-slate-500">
                            {item.phone}
                          </div>
                        </div>
                      </div>
                    </td>

                    <td className="px-5 py-4 text-sm font-medium">
                      {item.id}
                    </td>

                    <td className="px-5 py-4 font-mono text-sm">
                      {item.pan}
                    </td>

                    <td className="px-5 py-4 text-sm text-slate-600">
                      {item.type}
                    </td>

                    <td className="px-5 py-4 text-sm text-slate-600">
                      {item.submitted}
                    </td>

                    <td className="px-5 py-4">
                      <span
                        className={`inline-flex rounded-full border px-3 py-1 text-xs font-bold ${statusStyle(
                          item.status
                        )}`}
                      >
                        {item.status.replace("_", " ")}
                      </span>
                    </td>

                    <td className="px-5 py-4">
                      <div className="flex justify-end gap-2">
                        <button
                          onClick={() => setSelected(item)}
                          className="flex h-9 items-center gap-1.5 rounded-lg border border-slate-200 px-3 text-sm font-semibold hover:bg-slate-50"
                        >
                          <Eye size={15} />
                          View
                        </button>

                        <button className="flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 hover:bg-slate-50">
                          <MoreHorizontal size={17} />
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>

            {filtered.length === 0 && (
              <div className="px-6 py-16 text-center">
                <FileText className="mx-auto text-slate-300" size={42} />
                <p className="mt-3 font-semibold">No KYC records found</p>
                <p className="mt-1 text-sm text-slate-500">
                  Try changing your search or filter.
                </p>
              </div>
            )}
          </div>

          <div className="flex items-center justify-between border-t border-slate-100 px-5 py-4 text-sm text-slate-500">
            <span>
              Showing <b className="text-slate-900">{filtered.length}</b> of{" "}
              <b className="text-slate-900">{data.length}</b> records
            </span>

            <div className="flex gap-2">
              <button className="rounded-lg border border-slate-200 px-3 py-2 hover:bg-slate-50">
                Previous
              </button>
              <button className="rounded-lg bg-indigo-600 px-3 py-2 font-medium text-white">
                1
              </button>
              <button className="rounded-lg border border-slate-200 px-3 py-2 hover:bg-slate-50">
                Next
              </button>
            </div>
          </div>
        </section>
      </div>

      {selected && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/40 p-4 backdrop-blur-sm">
          <div className="w-full max-w-2xl rounded-2xl bg-white shadow-2xl">
            <div className="flex items-center justify-between border-b p-5">
              <div>
                <h2 className="text-xl font-bold">KYC Details</h2>
                <p className="text-sm text-slate-500">{selected.id}</p>
              </div>

              <button
                onClick={() => setSelected(null)}
                className="rounded-lg p-2 hover:bg-slate-100"
              >
                <XCircle size={22} />
              </button>
            </div>

            <div className="grid gap-4 p-5 sm:grid-cols-2">
              <div className="rounded-xl bg-slate-50 p-4">
                <p className="text-xs text-slate-500">Customer</p>
                <p className="mt-1 font-semibold">{selected.name}</p>
              </div>

              <div className="rounded-xl bg-slate-50 p-4">
                <p className="text-xs text-slate-500">Phone</p>
                <p className="mt-1 font-semibold">{selected.phone}</p>
              </div>

              <div className="rounded-xl bg-slate-50 p-4">
                <p className="text-xs text-slate-500">Email</p>
                <p className="mt-1 font-semibold">{selected.email}</p>
              </div>

              <div className="rounded-xl bg-slate-50 p-4">
                <p className="text-xs text-slate-500">PAN</p>
                <p className="mt-1 font-semibold">{selected.pan}</p>
              </div>
            </div>

            <div className="flex justify-end gap-3 border-t p-5">
              <button
                onClick={() => setSelected(null)}
                className="rounded-xl border px-5 py-2.5 font-medium"
              >
                Close
              </button>

              <button className="rounded-xl bg-emerald-600 px-5 py-2.5 font-semibold text-white">
                Approve KYC
              </button>
            </div>
          </div>
        </div>
      )}
    </main>
  );
}
