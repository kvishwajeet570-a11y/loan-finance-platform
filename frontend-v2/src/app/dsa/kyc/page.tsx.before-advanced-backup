              <FileText size={42} className="text-slate-300" />
              <p className="mt-3 font-black text-slate-700">
                No KYC records found
              </p>
              <p className="mt-1 text-sm text-slate-400">
                Try changing your search or status filter.
              </p>
            </div>
          ) : (
            <div className="overflow-x-auto">
              <table className="w-full min-w-[950px]">
                <thead className="bg-slate-50">
                  <tr className="text-left text-[11px] font-black uppercase tracking-wider text-slate-400">
                    <th className="px-5 py-4">Customer</th>
                    <th className="px-5 py-4">Contact</th>
                    <th className="px-5 py-4">PAN</th>
                    <th className="px-5 py-4">Verification</th>
                    <th className="px-5 py-4">Status</th>
                    <th className="px-5 py-4">Created</th>
                    <th className="px-5 py-4 text-right">Action</th>
                  </tr>
                </thead>

                <tbody className="divide-y divide-slate-100">
                  {filtered.map((item) => (
                    <tr
                      key={item.id}
                      className="transition hover:bg-blue-50/40"
                    >
                      <td className="px-5 py-5">
                        <div className="flex items-center gap-3">
                          <div className="flex h-11 w-11 items-center justify-center rounded-2xl bg-gradient-to-br from-blue-600 to-cyan-500 font-black text-white shadow-md">
                            {(item.fullName || item.name || "C").charAt(0).toUpperCase()}
                          </div>

                          <div>
                            <p className="font-black text-slate-900">
                              {item.fullName || item.name || "Unnamed Customer"}
                            </p>
                            <p className="text-xs font-medium text-slate-400">
                              ID: {item.id}
                            </p>
                          </div>
                        </div>
                      </td>

                      <td className="px-5 py-5">
                        <p className="font-bold text-slate-700">
                          {item.phone || "—"}
                        </p>
                        <p className="max-w-[220px] truncate text-xs text-slate-400">
                          {item.email || "—"}
                        </p>
                      </td>

                      <td className="px-5 py-5">
                        <span className="rounded-xl bg-slate-100 px-3 py-2 font-mono text-xs font-black text-slate-700">
                          {mask(item.panNo || item.panNumber)}
                        </span>
                      </td>

                      <td className="px-5 py-5">
                        <div className="flex gap-1.5">
                          <span
                            title="PAN"
                            className={`rounded-lg p-2 ${
                              item.panVerified
                                ? "bg-emerald-100 text-emerald-600"
                                : "bg-slate-100 text-slate-400"
                            }`}
                          >
                            <CreditCard size={15} />
                          </span>

                          <span
                            title="Document"
                            className={`rounded-lg p-2 ${
                              item.documentVerified
                                ? "bg-emerald-100 text-emerald-600"
                                : "bg-slate-100 text-slate-400"
                            }`}
                          >
                            <FileCheck2 size={15} />
                          </span>

                          <span
                            title="Bank"
                            className={`rounded-lg p-2 ${
                              item.bankVerified || item.bankAccountVerified
                                ? "bg-emerald-100 text-emerald-600"
                                : "bg-slate-100 text-slate-400"
                            }`}
                          >
                            <Building2 size={15} />
                          </span>
                        </div>
                      </td>

                      <td className="px-5 py-5">
                        <span className={`inline-flex rounded-full border px-3 py-1.5 text-xs font-black ${statusStyle(item.status)}`}>
                          {statusOf(item.status).replace(/_/g, " ")}
                        </span>
                      </td>

                      <td className="px-5 py-5 text-sm font-bold text-slate-500">
                        {dateFormat(item.createdAt)}
                      </td>

                      <td className="px-5 py-5 text-right">
                        <button
                          type="button"
                          onClick={() => {
                            setSelected(item);
                            setTab("overview");
                          }}
                          className="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-blue-600 to-cyan-500 px-4 py-2.5 text-xs font-black text-white shadow-lg shadow-blue-500/20 transition hover:-translate-y-0.5 hover:shadow-xl"
                        >
                          <Eye size={15} />
                          View KYC
                        </button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>

        {/* DETAIL MODAL */}
        {selected && (
          <div
            className="fixed inset-0 z-[100] flex items-center justify-center bg-slate-950/70 p-3 backdrop-blur-md md:p-6"
            onClick={() => setSelected(null)}
          >
            <div
              className="w-full max-w-6xl max-h-[94vh] overflow-hidden rounded-[32px] border border-white/20 bg-white shadow-2xl"
              onClick={(e) => e.stopPropagation()}
            >
              <div className="bg-gradient-to-br from-[#071b49] via-blue-700 to-cyan-500 p-6 text-white md:p-8">
                <div className="flex items-start justify-between gap-4">
                  <div className="flex items-center gap-4">
                    <div className="flex h-16 w-16 items-center justify-center rounded-2xl bg-white/15 text-2xl font-black backdrop-blur">
                      {(selected.fullName || selected.name || "C").charAt(0).toUpperCase()}
                    </div>

                    <div>
                      <p className="text-xs font-black uppercase tracking-[0.2em] text-cyan-100">
                        KYC Verification Profile
                      </p>
                      <h2 className="mt-1 text-2xl font-black md:text-3xl">
                        {selected.fullName || selected.name || "Unnamed Customer"}
                      </h2>
                      <p className="mt-1 text-sm text-blue-100">
                        Application ID: {selected.id}
                      </p>
                    </div>
                  </div>

                  <button
                    type="button"
                    onClick={() => setSelected(null)}
                    className="flex h-11 w-11 items-center justify-center rounded-full bg-white/15 transition hover:bg-white/25"
                  >
                    <X size={21} />
                  </button>
                </div>

                <div className="mt-6 flex flex-wrap gap-2">
                  {[
                    ["overview", "Overview"],
                    ["identity", "Identity"],
                    ["documents", "Documents"],
                    ["verification", "Verification"],
                  ].map(([key, label]) => (
                    <button
                      key={key}
                      type="button"
                      onClick={() => setTab(key)}
                      className={`rounded-xl px-5 py-2.5 text-xs font-black uppercase tracking-wide transition ${
                        tab === key
                          ? "bg-white text-blue-700 shadow-lg"
                          : "bg-white/15 text-white hover:bg-white/25"
                      }`}
                    >
                      {label}
                    </button>
                  ))}
                </div>
              </div>

              <div className="max-h-[68vh] overflow-y-auto bg-slate-50 p-5 md:p-8">
                {tab === "overview" && (
                  <div className="grid gap-4 md:grid-cols-3">
                    {[
                      ["Status", statusOf(selected.status).replace(/_/g, " "), ShieldCheck],
                      ["Created", dateFormat(selected.createdAt), CalendarDays],
                      ["Location", [selected.city, selected.state].filter(Boolean).join(", ") || "Not available", MapPin],
                    ].map(([label, value, Icon]: any) => (
                      <div key={label} className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                        <Icon size={20} className="text-blue-600" />
                        <p className="mt-4 text-xs font-black uppercase tracking-wider text-slate-400">
                          {label}
                        </p>
                        <p className="mt-2 text-lg font-black text-slate-900">
                          {value}
                        </p>
                      </div>
                    ))}

                    <div className="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm md:col-span-3">
                      <p className="text-xs font-black uppercase tracking-wider text-slate-400">
                        Verification Snapshot
                      </p>

                      <div className="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
                        {[
                          ["PAN", selected.panVerified],
                          ["Aadhaar", selected.aadhaarVerified],
                          ["Bank", selected.bankVerified || selected.bankAccountVerified],
                          ["Documents", selected.documentVerified],
                        ].map(([label, verified]: any) => (
                          <div
                            key={label}
                            className={`rounded-2xl border p-4 ${
                              verified
                                ? "border-emerald-200 bg-emerald-50"
                                : "border-slate-200 bg-slate-50"
                            }`}
                          >
                            <div className="flex items-center justify-between">
                              <span className="font-black text-slate-700">{label}</span>
                              {verified ? (
                                <CheckCircle2 className="text-emerald-600" size={20} />
                              ) : (
                                <Clock3 className="text-slate-400" size={20} />
                              )}
                            </div>
                            <p className={`mt-2 text-xs font-black ${
                              verified ? "text-emerald-600" : "text-slate-400"
                            }`}>
                              {verified ? "VERIFIED" : "PENDING"}
                            </p>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                )}

                {tab === "identity" && (
                  <div className="grid gap-4 md:grid-cols-2">
                    {[
                      ["Full Name", selected.fullName || selected.name, UserRound],
                      ["Email", selected.email, Mail],
                      ["Phone", selected.phone, Phone],
                      ["PAN Number", selected.panNo || selected.panNumber, CreditCard],
                      ["Aadhaar Number", selected.aadhaarNo || selected.aadhaarNumber, Fingerprint],
                      ["Address", selected.address, MapPin],
                    ].map(([label, value, Icon]: any) => (
                      <div key={label} className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                        <div className="flex items-center gap-3">
                          <div className="rounded-xl bg-blue-50 p-2.5 text-blue-600">
                            <Icon size={19} />
                          </div>
                          <p className="text-xs font-black uppercase tracking-wider text-slate-400">
                            {label}
                          </p>
                        </div>
                        <p className="mt-4 break-words font-black text-slate-900">
                          {value || "Not available"}
                        </p>
                      </div>
                    ))}
                  </div>
                )}

                {tab === "documents" && (
                  <div className="grid gap-4 md:grid-cols-2">
                    {[
                      ["PAN Card", selected.panVerified, CreditCard],
                      ["Aadhaar", selected.aadhaarVerified, Fingerprint],
                      ["Bank Verification", selected.bankVerified || selected.bankAccountVerified, Building2],
                      ["Document Verification", selected.documentVerified, FileCheck2],
                    ].map(([label, verified, Icon]: any) => (
                      <div key={label} className="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                        <div className="flex items-center justify-between">
                          <div className="flex items-center gap-3">
                            <div className="rounded-xl bg-blue-50 p-3 text-blue-600">
                              <Icon size={22} />
                            </div>
                            <div>
                              <p className="font-black text-slate-900">{label}</p>
                              <p className="text-xs font-medium text-slate-400">
                                Verification status
                              </p>
                            </div>
                          </div>

                          {verified ? (
                            <CheckCircle2 className="text-emerald-500" />
                          ) : (
                            <Clock3 className="text-amber-500" />
                          )}
                        </div>

                        <div className={`mt-5 rounded-xl px-4 py-3 text-xs font-black ${
                          verified
                            ? "bg-emerald-50 text-emerald-700"
                            : "bg-amber-50 text-amber-700"
                        }`}>
                          {verified ? "DOCUMENT VERIFIED" : "VERIFICATION PENDING"}
                        </div>
                      </div>
                    ))}
                  </div>
                )}

                {tab === "verification" && (
                  <div className="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
                    <div className="flex items-center gap-3">
                      <div className="rounded-2xl bg-gradient-to-br from-blue-600 to-cyan-500 p-3 text-white">
                        <LockKeyhole size={22} />
                      </div>
                      <div>
                        <h3 className="font-black text-slate-900">
                          Verification Timeline
                        </h3>
                        <p className="text-sm text-slate-400">
                          Current KYC verification information
                        </p>
                      </div>
                    </div>

                    <div className="mt-7 space-y-4">
                      {[
                        ["KYC Created", selected.createdAt, true],
                        ["PAN Verification", selected.panVerified ? "Verified" : "Pending", selected.panVerified],
                        ["Identity Documents", selected.documentVerified ? "Verified" : "Pending", selected.documentVerified],
                        ["Bank Verification", (selected.bankVerified || selected.bankAccountVerified) ? "Verified" : "Pending", selected.bankVerified || selected.bankAccountVerified],
                        ["Current Status", statusOf(selected.status).replace(/_/g, " "), true],
                      ].map(([label, value, done]: any) => (
                        <div key={label} className="flex items-center gap-4 rounded-2xl border border-slate-100 bg-slate-50 p-4">
                          <div className={`flex h-10 w-10 items-center justify-center rounded-full ${
                            done ? "bg-emerald-100 text-emerald-600" : "bg-amber-100 text-amber-600"
                          }`}>
                            {done ? <Check size={18} /> : <Clock3 size={18} />}
                          </div>

                          <div className="flex-1">
                            <p className="font-black text-slate-800">{label}</p>
                            <p className="text-sm font-medium text-slate-400">
                              {typeof value === "string" && value.includes("T")
                                ? dateFormat(value)
                                : value || "Pending"}
                            </p>
                          </div>

                          <BadgeCheck
                            size={21}
                            className={done ? "text-emerald-500" : "text-slate-300"}
                          />
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </div>

              <div className="flex items-center justify-between border-t border-slate-200 bg-white px-5 py-4 md:px-8">
                <div className="flex items-center gap-2 text-xs font-bold text-slate-400">
                  <LockKeyhole size={14} />
                  Secure KYC workspace
                </div>

                <button
                  type="button"
                  onClick={() => setSelected(null)}
                  className="rounded-xl border border-slate-200 px-5 py-2.5 text-sm font-black text-slate-700 transition hover:bg-slate-50"
                >
                  Close
                </button>
              </div>
            </div>
          </div>
        )}
      </div>
    </DsaShell>
  );
}
