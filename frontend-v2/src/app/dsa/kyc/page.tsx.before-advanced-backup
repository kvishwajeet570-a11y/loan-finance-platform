"use client";

import { useEffect, useMemo, useState } from "react";
import DsaShell from "@/components/dsa/DsaShell";
import {
  ShieldCheck, Clock3, CheckCircle2, XCircle, Search, RefreshCw,
  Eye, Check, X, FileCheck2, CreditCard, Building2, UserRound,
  CalendarDays, Mail, Phone, MapPin, SlidersHorizontal, Sparkles,
  AlertCircle, LockKeyhole, Fingerprint, BadgeCheck, FileText
} from "lucide-react";

const API = process.env.NEXT_PUBLIC_API_URL || "http://localhost:5000/api";

type KycRecord = {
  id: string;
  userId?: string;
  fullName?: string;
  name?: string;
  email?: string;
  phone?: string;
  panNo?: string;
  panNumber?: string;
  aadhaarNo?: string;
  aadhaarNumber?: string;
  status?: string;
  createdAt?: string;
  updatedAt?: string;
  city?: string;
  state?: string;
  address?: string;
  panVerified?: boolean;
  aadhaarVerified?: boolean;
  bankVerified?: boolean;
  bankAccountVerified?: boolean;
  documentVerified?: boolean;
  [key: string]: any;
};

function getAuth() {
  if (typeof window === "undefined") {
    return { user: null, headers: {} as Record<string, string> };
  }

  const raw = localStorage.getItem("loan_finance_user");
  const token = localStorage.getItem("loan_finance_token");

  let user = null;
  try {
    user = raw ? JSON.parse(raw) : null;
  } catch {}

  const headers: Record<string, string> = {};
  if (token) headers.Authorization = `Bearer ${token}`;

  return { user, headers };
}

function statusOf(value?: string) {
  return String(value || "PENDING").toUpperCase().replace(/[\s-]+/g, "_");
}

function statusStyle(status?: string) {
  const s = statusOf(status);

  if (s === "APPROVED" || s === "VERIFIED") {
    return "border-emerald-200 bg-emerald-50 text-emerald-700";
  }

  if (s === "REJECTED") {
    return "border-red-200 bg-red-50 text-red-700";
  }

  if (s === "UNDER_REVIEW" || s === "IN_REVIEW") {
    return "border-amber-200 bg-amber-50 text-amber-700";
  }

  return "border-blue-200 bg-blue-50 text-blue-700";
}

function dateFormat(value?: string) {
  if (!value) return "—";
  const d = new Date(value);
  if (Number.isNaN(d.getTime())) return "—";

  return d.toLocaleDateString("en-IN", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  });
}

function mask(value?: string) {
  if (!value) return "Not available";
  if (value.length <= 4) return value;
  return `${"•".repeat(Math.max(0, value.length - 4))}${value.slice(-4)}`;
}

export default function DsaKycPage() {
  const [records, setRecords] = useState<KycRecord[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [search, setSearch] = useState("");
  const [status, setStatus] = useState("ALL");
  const [selected, setSelected] = useState<KycRecord | null>(null);
  const [tab, setTab] = useState("overview");

  async function loadKyc() {
    try {
      setLoading(true);
      setError("");

      const { user, headers } = getAuth();

      if (!user?.id) {
        throw new Error("DSA login session not found.");
      }

      const endpoints = [
        `${API}/dsa/${user.id}/kyc`,
        `${API}/kyc/dsa/${user.id}`,
        `${API}/kyc`,
      ];

      let data: any = null;

      for (const url of endpoints) {
        try {
          const res = await fetch(url, {
            headers: { ...headers, "Content-Type": "application/json" },
          });

          if (!res.ok) continue;

          const json = await res.json();
          data = Array.isArray(json) ? json : json?.data || json?.records || json?.kyc || [];
          if (Array.isArray(data)) break;
        } catch {}
      }

      if (!Array.isArray(data)) {
        throw new Error("KYC data could not be loaded.");
      }

      setRecords(data);
    } catch (err: any) {
      setError(err?.message || "Unable to load KYC data.");
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    loadKyc();
  }, []);

  const filtered = useMemo(() => {
    const q = search.trim().toLowerCase();

    return records.filter((item) => {
      const matchesStatus =
        status === "ALL" || statusOf(item.status) === status;

      const text = [
        item.fullName,
        item.name,
        item.email,
        item.phone,
        item.panNo,
        item.panNumber,
        item.city,
        item.state,
      ]
        .filter(Boolean)
        .join(" ")
        .toLowerCase();

      return matchesStatus && (!q || text.includes(q));
    });
  }, [records, search, status]);

  const stats = useMemo(() => {
    return {
      total: records.length,
      pending: records.filter((x) => {
        const s = statusOf(x.status);
        return s === "PENDING" || s === "UNDER_REVIEW" || s === "IN_REVIEW";
      }).length,
      approved: records.filter((x) => {
        const s = statusOf(x.status);
        return s === "APPROVED" || s === "VERIFIED";
      }).length,
      rejected: records.filter((x) => statusOf(x.status) === "REJECTED").length,
    };
  }, [records]);

  return (
    <DsaShell>
      <div className="min-h-screen bg-[#f4f7fb] px-4 py-6 md:px-7">

        {/* HERO */}
        <section className="relative overflow-hidden rounded-[30px] bg-gradient-to-br from-[#071b49] via-[#0b3c91] to-[#00a6c7] p-6 text-white shadow-2xl md:p-9">
          <div className="absolute -right-20 -top-24 h-72 w-72 rounded-full bg-cyan-300/20 blur-3xl" />
          <div className="absolute -bottom-24 left-1/3 h-64 w-64 rounded-full bg-blue-300/20 blur-3xl" />

          <div className="relative z-10 flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
            <div>
              <div className="mb-3 inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-2 text-xs font-black tracking-wider backdrop-blur">
                <Sparkles size={15} />
                ADVANCED KYC CONTROL CENTER
              </div>

              <h1 className="text-3xl font-black md:text-5xl">
                KYC Verification
              </h1>

              <p className="mt-2 max-w-2xl text-sm font-medium text-blue-100 md:text-base">
                Review customer identity, documents and verification status
                from one secure workspace.
              </p>
            </div>

            <button
              onClick={loadKyc}
              className="inline-flex items-center justify-center gap-2 rounded-2xl bg-white px-5 py-3 text-sm font-black text-blue-700 shadow-xl transition hover:-translate-y-0.5"
            >
              <RefreshCw size={17} />
              Refresh Data
            </button>
          </div>
        </section>

        {/* STATS */}
        <section className="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
          {[
            {
              label: "Total KYC",
              value: stats.total,
              icon: ShieldCheck,
              box: "from-blue-600 to-cyan-500",
            },
            {
              label: "Pending Review",
              value: stats.pending,
              icon: Clock3,
              box: "from-amber-500 to-orange-500",
            },
            {
              label: "Approved",
              value: stats.approved,
              icon: CheckCircle2,
              box: "from-emerald-500 to-green-600",
            },
            {
              label: "Rejected",
              value: stats.rejected,
              icon: XCircle,
              box: "from-red-500 to-rose-600",
            },
          ].map((card) => {
            const Icon = card.icon;

            return (
              <div
                key={card.label}
                className="rounded-[24px] border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-xl"
              >
                <div className="flex items-center justify-between">
                  <div>
                    <p className="text-xs font-black uppercase tracking-wider text-slate-400">
                      {card.label}
                    </p>
                    <p className="mt-2 text-3xl font-black text-slate-900">
                      {card.value}
                    </p>
                  </div>

                  <div className={`rounded-2xl bg-gradient-to-br ${card.box} p-3 text-white shadow-lg`}>
                    <Icon size={22} />
                  </div>
                </div>
              </div>
            );
          })}
        </section>

        {/* SEARCH / FILTER */}
        <section className="mt-6 rounded-[26px] border border-slate-200 bg-white p-4 shadow-sm md:p-5">
          <div className="flex flex-col gap-3 xl:flex-row">
            <div className="relative flex-1">
              <Search
                className="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"
                size={19}
              />

              <input
                value={search}
                onChange={(e) => setSearch(e.target.value)}
                placeholder="Search customer, phone, email, PAN, city..."
                className="h-14 w-full rounded-2xl border border-slate-200 bg-slate-50 pl-12 pr-4 text-sm font-semibold outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100"
              />
            </div>

            <div className="flex items-center gap-2">
              <SlidersHorizontal className="text-slate-400" size={18} />

              <select
                value={status}
                onChange={(e) => setStatus(e.target.value)}
                className="h-14 rounded-2xl border border-slate-200 bg-slate-50 px-4 text-sm font-black text-slate-700 outline-none focus:border-blue-500"
              >
                <option value="ALL">All Status</option>
                <option value="PENDING">Pending</option>
                <option value="UNDER_REVIEW">Under Review</option>
                <option value="APPROVED">Approved</option>
                <option value="REJECTED">Rejected</option>
              </select>
            </div>
          </div>
        </section>

        {/* TABLE */}
        <section className="mt-6 overflow-hidden rounded-[28px] border border-slate-200 bg-white shadow-sm">
          <div className="flex flex-col gap-2 border-b border-slate-200 px-5 py-5 md:flex-row md:items-center md:justify-between">
            <div>
              <h2 className="text-xl font-black text-slate-950">
                KYC Applications
              </h2>
              <p className="mt-1 text-sm font-medium text-slate-500">
