"use client";

import { FormEvent, useEffect, useState } from "react";
import Link from "next/link";
import api from "@/lib/api";

const lenderWebsites: Record<string, string> = {
  "Poonawalla Fincorp": "https://poonawallafincorp.com/",
  "Bajaj Finance": "https://www.bajajfinserv.in/",
  "Tata Capital": "https://www.tatacapital.com/",
  "Aditya Birla Capital": "https://www.adityabirlacapital.com/",
  "L&T Finance": "https://www.ltfinance.com/",
  "Cholamandalam Finance": "https://www.cholamandalam.com/",
  "Hero FinCorp": "https://www.herofincorp.com/",
  "Muthoot Finance": "https://www.muthootfinance.com/",
  "Mahindra Finance": "https://www.mahindrafinance.com/",
  "Shriram Finance": "https://www.shriramfinance.in/",
};

const lenderLogos: Record<string, string> = {
  "Poonawalla Fincorp": "P",
  "Bajaj Finance": "B",
  "Tata Capital": "T",
  "Aditya Birla Capital": "AB",
  "L&T Finance": "L&T",
  "Cholamandalam Finance": "C",
  "Hero FinCorp": "H",
  "Muthoot Finance": "M",
  "Mahindra Finance": "MF",
  "Shriram Finance": "S",
};

export default function ApplyLoanPage() {
  const [lender, setLender] = useState("Poonawalla Fincorp");

  const [name, setName] = useState("");
  const [phone, setPhone] = useState("");
  const [pan, setPan] = useState("");
  const [dob, setDob] = useState("");
  const [loanType, setLoanType] = useState("");
  const [employment, setEmployment] = useState("");
  const [income, setIncome] = useState("");
  const [city, setCity] = useState("");
  const [amount, setAmount] = useState("");

  const [consent, setConsent] = useState(false);
  const [submitting, setSubmitting] = useState(false);
  const [submitted, setSubmitted] = useState(false);
  const [applicationId, setApplicationId] = useState("");
  const [error, setError] = useState("");

  useEffect(() => {
    const params = new URLSearchParams(window.location.search);

    const selected =
      params.get("lender") ||
      params.get("company") ||
      "Poonawalla Fincorp";

    setLender(selected);
  }, []);

  const website =
    lenderWebsites[lender] || lenderWebsites["Poonawalla Fincorp"];

  const logo = lenderLogos[lender] || "L";

  const handleSubmit = async (e: FormEvent<HTMLFormElement>) => {
    e.preventDefault();
    setError("");

    const fullName = name.trim();
    const panNo = pan.toUpperCase().trim();
    const mobileNumber = phone.trim();

    if (fullName.length < 3) {
      setError("Please enter your full name.");
      return;
    }

    if (!/^[6-9][0-9]{9}$/.test(mobileNumber)) {
      setError("Please enter a valid 10-digit mobile number.");
      return;
    }

    if (!/^[A-Z]{5}[0-9]{4}[A-Z]$/.test(panNo)) {
      setError("Please enter a valid PAN number.");
      return;
    }

    if (!dob) {
      setError("Please select your date of birth.");
      return;
    }

    if (!loanType) {
      setError("Please select the loan type.");
      return;
    }

    if (!employment) {
      setError("Please select your employment type.");
      return;
    }

    if (!income) {
      setError("Please enter your monthly income.");
      return;
    }

    if (!city.trim()) {
      setError("Please enter your city.");
      return;
    }

    if (!consent) {
      setError("Please accept the Privacy Policy and Terms & Conditions.");
      return;
    }

    try {
      setSubmitting(true);

      const response = await api.post(
        "/loan",
        {
          fullName,
          phone: mobileNumber,
          panNo,
          dob,
          loanType,
          employmentType: employment,
          monthlyIncome: income,
          city: city.trim(),
          requestedAmount: amount || null,
          lender,
        },
        {
          withCredentials: true,
        }
      );

      if (!response.data?.success) {
        throw new Error(
          response.data?.message || "Application submission failed."
        );
      }

      const id = response.data?.data?.id;

      setApplicationId(id ? String(id) : "");
      setSubmitted(true);
    } catch (err: any) {
      setError(
        err?.response?.data?.message ||
          err?.message ||
          "Unable to submit your application. Please try again."
      );
    } finally {
      setSubmitting(false);
    }
  };

  if (submitted) {
    return (
      <main className="min-h-screen bg-slate-100 px-4 py-8 sm:px-6 lg:px-8">
        <div className="mx-auto flex min-h-[90vh] max-w-2xl items-center justify-center">
          <div className="w-full overflow-hidden rounded-[30px] bg-white shadow-2xl">
            <div className="relative overflow-hidden bg-gradient-to-br from-blue-700 via-indigo-700 to-slate-950 px-6 py-12 text-center sm:px-10">
              <div className="absolute -right-20 -top-20 h-56 w-56 rounded-full bg-cyan-400/10" />
              <div className="absolute -bottom-24 -left-16 h-64 w-64 rounded-full bg-white/5" />

              <div className="relative mx-auto flex h-24 w-24 items-center justify-center rounded-full bg-white shadow-2xl">
                <div className="flex h-16 w-16 items-center justify-center rounded-full bg-green-100 text-3xl font-black text-green-600">
                  ✓
                </div>
              </div>

              <h1 className="relative mt-6 text-3xl font-black text-white">
                Application Submitted
              </h1>

              <p className="relative mx-auto mt-3 max-w-md text-sm leading-6 text-blue-100">
                Your loan application has been received successfully. Our
                team will review the information provided.
              </p>
            </div>

            <div className="space-y-5 p-6 sm:p-9">
              <div className="rounded-2xl border border-slate-200 bg-slate-50 p-5">
                <p className="text-xs font-bold uppercase tracking-[0.15em] text-slate-400">
                  Selected Lender
                </p>

                <div className="mt-3 flex items-center gap-3">
                  <div className="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-700 text-sm font-black text-white">
                    {logo}
                  </div>

                  <div>
                    <p className="font-black text-slate-900">{lender}</p>
                    <p className="text-xs text-slate-500">
                      Loan application partner
                    </p>
                  </div>
                </div>
              </div>

              {applicationId && (
                <div className="rounded-2xl border border-green-200 bg-green-50 p-5">
                  <p className="text-xs font-bold uppercase tracking-[0.15em] text-green-600">
                    Application ID
                  </p>

                  <p className="mt-2 break-all text-xl font-black text-green-800">
                    {applicationId}
                  </p>
                </div>
              )}

              <div className="rounded-2xl border border-blue-100 bg-blue-50 p-5">
                <p className="font-bold text-blue-900">
                  What happens next?
                </p>

                <div className="mt-4 space-y-3 text-sm text-blue-800">
                  <div className="flex gap-3">
                    <span className="font-black">01</span>
                    <span>Application details are reviewed.</span>
                  </div>

                  <div className="flex gap-3">
                    <span className="font-black">02</span>
                    <span>Eligibility and verification may be performed.</span>
                  </div>

                  <div className="flex gap-3">
                    <span className="font-black">03</span>
                    <span>The lender may contact you for further processing.</span>
                  </div>
                </div>
              </div>

              <div className="flex flex-col gap-3 sm:flex-row">
                <Link
                  href="/"
                  className="flex h-12 flex-1 items-center justify-center rounded-xl border border-slate-200 bg-white text-sm font-black text-slate-700 transition hover:bg-slate-50"
                >
                  Back to Home
                </Link>

                <a
                  href={website}
                  target="_blank"
                  rel="noopener noreferrer"
                  className="flex h-12 flex-1 items-center justify-center rounded-xl bg-blue-700 text-sm font-black text-white shadow-lg shadow-blue-700/20 transition hover:bg-blue-800"
                >
                  Visit Lender Website
                </a>
              </div>
            </div>
          </div>
        </div>
      </main>
    );
  }

  return (
    <main className="min-h-screen bg-slate-100">
      <header className="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur">
        <div className="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
          <Link href="/" className="flex items-center gap-3">
            <div className="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-blue-700 to-cyan-500 text-sm font-black text-white shadow-lg">
              IL
            </div>

            <div className="hidden leading-tight sm:block">
              <div className="text-base font-black text-[#10265c]">
                India Loan Finance
              </div>
              <div className="text-[9px] font-bold uppercase tracking-[0.15em] text-slate-400">
                Your Growth Our Support
              </div>
            </div>
          </Link>

          <div className="flex items-center gap-2 text-xs font-bold text-slate-500">
            <span className="hidden sm:inline">Secure Application</span>
            <span className="flex h-8 w-8 items-center justify-center rounded-full bg-green-100 text-green-600">
              ✓
            </span>
          </div>
        </div>
      </header>

      <section className="relative overflow-hidden bg-gradient-to-br from-blue-800 via-indigo-800 to-slate-950 px-4 py-10 text-white sm:px-6 lg:px-8 lg:py-14">
        <div className="absolute -right-20 -top-24 h-72 w-72 rounded-full bg-cyan-400/10" />
        <div className="absolute -bottom-32 left-1/3 h-80 w-80 rounded-full bg-blue-400/10" />

        <div className="relative mx-auto max-w-7xl">
          <div className="grid gap-8 lg:grid-cols-[1fr_360px] lg:items-center">
            <div>
              <div className="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-4 py-2 text-xs font-black uppercase tracking-wider">
                <span className="h-2 w-2 rounded-full bg-green-400" />
                Quick & Secure Loan Application
              </div>

              <h1 className="mt-5 max-w-3xl text-3xl font-black tracking-tight sm:text-4xl lg:text-5xl">
                Check Your Loan Eligibility
              </h1>

              <p className="mt-4 max-w-2xl text-sm leading-7 text-blue-100 sm:text-base">
                Complete the form below with your basic details. Your
                information will be used for processing your loan application.
              </p>

              <div className="mt-7 flex flex-wrap gap-3 text-xs font-bold text-blue-100">
                <span className="rounded-full bg-white/10 px-4 py-2">
                  ✓ Secure Form
                </span>
                <span className="rounded-full bg-white/10 px-4 py-2">
                  ✓ PAN Based Verification
                </span>
                <span className="rounded-full bg-white/10 px-4 py-2">
                  ✓ Quick Processing
                </span>
              </div>
            </div>

            <div className="rounded-3xl border border-white/15 bg-white/10 p-5 shadow-2xl backdrop-blur-xl">
              <p className="text-xs font-bold uppercase tracking-[0.15em] text-blue-200">
                Selected Lender
              </p>

              <div className="mt-4 flex items-center gap-4">
                <div className="flex h-16 w-16 items-center justify-center rounded-2xl bg-white text-sm font-black text-blue-800 shadow-lg">
                  {logo}
                </div>

                <div>
                  <p className="text-lg font-black text-white">{lender}</p>
                  <p className="mt-1 text-xs text-blue-200">
                    Loan application
                  </p>
                </div>
              </div>

              <a
                href={website}
                target="_blank"
                rel="noopener noreferrer"
                className="mt-5 block text-center text-xs font-bold text-cyan-200 hover:text-white"
              >
                View official lender website →
              </a>
            </div>
          </div>
        </div>
      </section>

      <section className="px-4 py-8 sm:px-6 lg:px-8 lg:py-12">
        <div className="mx-auto grid max-w-7xl gap-8 lg:grid-cols-[1fr_330px]">
          <div className="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-xl">
            <div className="border-b border-slate-100 px-5 py-5 sm:px-8">
              <div className="flex items-center justify-between gap-4">
                <div>
                  <p className="text-xs font-black uppercase tracking-[0.15em] text-blue-600">
                    Step 1 of 1
                  </p>
                  <h2 className="mt-1 text-2xl font-black text-slate-950">
                    Applicant Details
                  </h2>
                  <p className="mt-1 text-sm text-slate-500">
                    Enter accurate information for faster processing.
                  </p>
                </div>

                <div className="hidden h-12 w-12 items-center justify-center rounded-2xl bg-blue-50 text-xl font-black text-blue-700 sm:flex">
                  01
                </div>
              </div>
            </div>

            <form onSubmit={handleSubmit} className="space-y-7 p-5 sm:p-8">
              <div>
                <h3 className="text-sm font-black uppercase tracking-wider text-slate-800">
                  Personal Information
                </h3>

                <div className="mt-4 grid gap-5 sm:grid-cols-2">
                  <div className="sm:col-span-2">
                    <label className="mb-2 block text-sm font-bold text-slate-700">
                      Full Name *
                    </label>

                    <input
                      value={name}
                      onChange={(e) => setName(e.target.value)}
                      placeholder="Enter your full name"
                      autoComplete="name"
                      className="h-12 w-full rounded-xl border border-slate-200 px-4 text-sm font-semibold text-slate-900 outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10"
                    />
                  </div>

                  <div>
                    <label className="mb-2 block text-sm font-bold text-slate-700">
                      Mobile Number *
                    </label>

                    <input
                      value={phone}
                      onChange={(e) =>
                        setPhone(
                          e.target.value.replace(/\D/g, "").slice(0, 10)
                        )
                      }
                      placeholder="10-digit mobile number"
                      inputMode="numeric"
                      maxLength={10}
                      className="h-12 w-full rounded-xl border border-slate-200 px-4 text-sm font-semibold text-slate-900 outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10"
                    />
                  </div>

                  <div>
                    <label className="mb-2 block text-sm font-bold text-slate-700">
                      Date of Birth *
                    </label>

                    <input
                      type="date"
                      value={dob}
                      onChange={(e) => setDob(e.target.value)}
                      className="h-12 w-full rounded-xl border border-slate-200 px-4 text-sm font-semibold text-slate-900 outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10"
                    />
                  </div>

                  <div className="sm:col-span-2">
                    <label className="mb-2 block text-sm font-bold text-slate-700">
                      PAN Card Number *
                    </label>

                    <input
                      value={pan}
                      onChange={(e) =>
                        setPan(
                          e.target.value
                            .toUpperCase()
                            .replace(/[^A-Z0-9]/g, "")
                            .slice(0, 10)
                        )
                      }
                      placeholder="ABCDE1234F"
                      maxLength={10}
                      autoComplete="off"
                      className="h-12 w-full rounded-xl border border-slate-200 px-4 text-sm font-black uppercase tracking-wider text-slate-900 outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10"
                    />
                    <p className="mt-2 text-xs text-slate-400">
                      Enter your 10-character PAN number.
                    </p>
                  </div>
                </div>
              </div>

              <div className="border-t border-slate-100 pt-7">
                <h3 className="text-sm font-black uppercase tracking-wider text-slate-800">
                  Loan Requirements
                </h3>

                <div className="mt-4 grid gap-5 sm:grid-cols-2">
                  <div>
                    <label className="mb-2 block text-sm font-bold text-slate-700">
                      Loan Type *
                    </label>

                    <select
                      value={loanType}
                      onChange={(e) => setLoanType(e.target.value)}
                      className="h-12 w-full rounded-xl border border-slate-200 bg-white px-4 text-sm font-semibold text-slate-900 outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10"
                    >
                      <option value="">Select loan type</option>
                      <option value="PERSONAL_LOAN">Personal Loan</option>
                      <option value="BUSINESS_LOAN">Business Loan</option>
                      <option value="HOME_LOAN">Home Loan</option>
                      <option value="EDUCATION_LOAN">Education Loan</option>
                      <option value="VEHICLE_LOAN">Vehicle Loan</option>
                      <option value="LOAN_AGAINST_PROPERTY">
                        Loan Against Property
                      </option>
                    </select>
                  </div>

                  <div>
                    <label className="mb-2 block text-sm font-bold text-slate-700">
                      Employment Type *
                    </label>

                    <select
                      value={employment}
                      onChange={(e) => setEmployment(e.target.value)}
                      className="h-12 w-full rounded-xl border border-slate-200 bg-white px-4 text-sm font-semibold text-slate-900 outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10"
                    >
                      <option value="">Select employment</option>
                      <option value="SALARIED">Salaried</option>
                      <option value="SELF_EMPLOYED">
                        Self Employed
                      </option>
                      <option value="BUSINESS_OWNER">
                        Business Owner
                      </option>
                      <option value="PROFESSIONAL">Professional</option>
                    </select>
                  </div>

                  <div>
                    <label className="mb-2 block text-sm font-bold text-slate-700">
                      Monthly Income *
                    </label>

                    <input
                      value={income}
                      onChange={(e) =>
                        setIncome(e.target.value.replace(/\D/g, ""))
                      }
                      placeholder="e.g. 50000"
                      inputMode="numeric"
                      className="h-12 w-full rounded-xl border border-slate-200 px-4 text-sm font-semibold text-slate-900 outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10"
                    />
                  </div>

                  <div>
                    <label className="mb-2 block text-sm font-bold text-slate-700">
                      Requested Loan Amount
                    </label>

                    <input
                      value={amount}
                      onChange={(e) =>
                        setAmount(e.target.value.replace(/\D/g, ""))
                      }
                      placeholder="e.g. 500000"
                      inputMode="numeric"
                      className="h-12 w-full rounded-xl border border-slate-200 px-4 text-sm font-semibold text-slate-900 outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10"
                    />
                  </div>

                  <div className="sm:col-span-2">
                    <label className="mb-2 block text-sm font-bold text-slate-700">
                      City *
                    </label>

                    <input
                      value={city}
                      onChange={(e) => setCity(e.target.value)}
                      placeholder="Enter your city"
                      autoComplete="address-level2"
                      className="h-12 w-full rounded-xl border border-slate-200 px-4 text-sm font-semibold text-slate-900 outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10"
                    />
                  </div>
                </div>
              </div>

              {error && (
                <div className="rounded-2xl border border-red-200 bg-red-50 px-4 py-4 text-sm font-bold text-red-700">
                  {error}
                </div>
              )}

              <div className="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <label className="flex cursor-pointer items-start gap-3">
                  <input
                    type="checkbox"
                    checked={consent}
                    onChange={(e) => setConsent(e.target.checked)}
                    className="mt-1 h-4 w-4 accent-blue-700"
                  />

                  <span className="text-xs leading-5 text-slate-600">
                    I confirm that the information provided by me is accurate
                    and I agree to the Privacy Policy and Terms & Conditions.
                  </span>
                </label>
              </div>

              <div className="flex flex-col gap-3 sm:flex-row">
                <button
                  type="button"
                  onClick={() => window.history.back()}
                  className="h-13 flex-1 rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-black text-slate-700 transition hover:bg-slate-50"
                >
                  Cancel
                </button>

                <button
                  type="submit"
                  disabled={submitting}
                  className="h-13 flex-[2] rounded-xl bg-gradient-to-r from-blue-700 to-cyan-500 px-5 py-3 text-sm font-black text-white shadow-xl shadow-blue-700/20 transition hover:from-blue-800 hover:to-cyan-600 disabled:cursor-not-allowed disabled:opacity-60"
                >
                  {submitting ? "Submitting Application..." : "Submit Application →"}
                </button>
              </div>

              <p className="text-center text-xs text-slate-400">
                🔒 Your application is submitted securely.
              </p>
            </form>
          </div>

          <aside className="space-y-5">
            <div className="rounded-3xl bg-slate-950 p-6 text-white shadow-xl">
              <p className="text-xs font-black uppercase tracking-[0.15em] text-cyan-300">
                Application Process
              </p>

              <div className="mt-6 space-y-5">
                <div className="flex gap-4">
                  <div className="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-blue-600 text-xs font-black">
                    01
                  </div>
                  <div>
                    <p className="font-black">Submit Details</p>
                    <p className="mt-1 text-xs leading-5 text-slate-400">
                      Complete the application form.
                    </p>
                  </div>
                </div>

                <div className="flex gap-4">
                  <div className="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-blue-600 text-xs font-black">
                    02
                  </div>
                  <div>
                    <p className="font-black">Verification</p>
                    <p className="mt-1 text-xs leading-5 text-slate-400">
                      Information may be verified.
                    </p>
                  </div>
                </div>

                <div className="flex gap-4">
                  <div className="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-green-500 text-xs font-black">
                    03
                  </div>
                  <div>
                    <p className="font-black">Processing</p>
                    <p className="mt-1 text-xs leading-5 text-slate-400">
                      Eligible applications can proceed further.
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <div className="rounded-3xl border border-slate-200 bg-white p-6 shadow-lg">
              <p className="font-black text-slate-900">
                Why complete the form?
              </p>

              <div className="mt-5 space-y-4 text-sm text-slate-600">
                <div className="flex gap-3">
                  <span className="text-green-600">✓</span>
                  <span>Structured loan application</span>
                </div>

                <div className="flex gap-3">
                  <span className="text-green-600">✓</span>
                  <span>Selected lender retained</span>
                </div>

                <div className="flex gap-3">
                  <span className="text-green-600">✓</span>
                  <span>Application status can be tracked</span>
                </div>
              </div>
            </div>

            <div className="rounded-3xl border border-blue-100 bg-blue-50 p-6">
              <p className="text-xs font-black uppercase tracking-wider text-blue-600">
                Need Help?
              </p>

              <p className="mt-2 text-sm font-bold text-blue-950">
                Contact our support team for application assistance.
              </p>

              <a
                href="tel:+918292908077"
                className="mt-4 block font-black text-blue-700"
              >
                +91 8292908077
              </a>
            </div>
          </aside>
        </div>
      </section>

      <footer className="border-t border-slate-200 bg-white px-4 py-6 text-center text-xs text-slate-400">
        India Loan Finance · Secure Loan Application
      </footer>
    </main>
  );
}
