function InfoCard({
  icon,
  title,
  value,
  status,
  active,
}: {
  icon: React.ReactNode;
  title: string;
  value: string;
  status: string;
  active: boolean;
}) {
  const goToKycSection = (id: string) => {
    window.setTimeout(() => {
      document.getElementById(id)?.scrollIntoView({
        behavior: "smooth",
        block: "center",
      });
    }, 50);
  };
  return (
    <div className="group rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
      <div className="flex items-start justify-between">
        <div className="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
          {icon}
        </div>

        <div
          className={`flex h-8 w-8 items-center justify-center rounded-full ${
            active
              ? "bg-emerald-50 text-emerald-600"
              : "bg-slate-100 text-slate-400"
          }`}
        >
          {active ? (
            <Check size={17} strokeWidth={3} />
          ) : (
            <Clock3 size={17} />
          )}
        </div>
      </div>

      <p className="mt-4 text-sm font-extrabold text-slate-900">
        {title}
      </p>

      <p className="mt-1 truncate text-sm font-semibold text-slate-600">
        {value}
      </p>

      <p
        className={`mt-2 text-sm font-bold ${
          active
            ? "text-emerald-600"
            : "text-slate-400"
        }`}
      >
        {status}
      </p>
    </div>
  );
}

function FormField({
  icon,
  label,
  value,
  onChange,
  placeholder,
  type = "text",
  maxLength,
  inputMode,
}: {
  icon: React.ReactNode;
  label: string;
  value: string;
  onChange: (value: string) => void;
  placeholder?: string;
  type?: string;
  maxLength?: number;
  inputMode?: React.HTMLAttributes<HTMLInputElement>["inputMode"];
}) {
  const goToKycSection = (id: string) => {
    window.setTimeout(() => {
      document.getElementById(id)?.scrollIntoView({
        behavior: "smooth",
        block: "center",
      });
    }, 50);
  };
  return (
    <label className="block">
      <span className="mb-2 flex items-center gap-2 text-sm font-semibold text-slate-400">
        <span className="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-50 text-blue-600">
          {icon}
