      setError("Date of birth is required.");
      return;
    }

    if (form.pincode && !/^\d{6}$/.test(form.pincode.trim())) {
      setError("Pincode must contain exactly 6 digits.");
      return;
    }

    try {
      setSaving(true);

      const token = getToken();

      if (!token) {
        window.location.href = "/login";
        return;
