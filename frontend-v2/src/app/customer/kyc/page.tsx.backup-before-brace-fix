} from "lucide-react";

const API_URL =
  process.env.NEXT_PUBLIC_API_URL || "http://localhost:5000/api";

type KYC = {
  id: string;
  userId: string;
  fullName: string;
  panNumber: string;
  dob: string;
  address?: string | null;
  city?: string | null;
  state?: string | null;
  pincode?: string | null;
  status?: string | null;
  approvedBy?: string | null;
  approvedAt?: string | null;
  rejectionReason?: string | null;
  expiryDate?: string | null;
  createdAt?: string;
  updatedAt?: string;
};

function getToken() {
  if (typeof window === "undefined") return null;
  return localStorage.getItem("loan_finance_token");
}

function getUser() {
  if (typeof window === "undefined") return null;

  try {
    const raw = localStorage.getItem("loan_finance_user");
    return raw ? JSON.parse(raw) : null;
  } catch {
    return null;
  }
}

function getUserId() {
  const user = getUser();
  return user?.id || user?.userId || null;
}

function formatDate(value?: string | null) {
  if (!value) return "â€”";

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) return value;

  return date.toLocaleDateString("en-IN", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  });
}

function formatDateTime(value?: string | null) {
  if (!value) return "â€”";

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) return value;

  return date.toLocaleString("en-IN", {
    day: "2-digit",
    month: "short",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  });
}

function maskPAN(pan?: string | null) {
  if (!pan) return "Not available";

  const value = pan.trim();

  if (value.length <= 4) return "â€¢â€¢â€¢â€¢";

  return `${"â€¢".repeat(value.length - 4)}${value.slice(-4)}`;
}

function getStatus(status?: string | null) {
  const value = String(status || "").toUpperCase().trim();

  if (value === "APPROVED" || value === "VERIFIED") {
    return {
      key: "approved",
      label: "Verified",
      description: "Your KYC has been successfully verified.",
      icon: CheckCircle2,
    };
  }

  if (value === "REJECTED") {
    return {
      key: "rejected",
      label: "Rejected",
      description: "Your KYC requires attention.",
      icon: XCircle,
    };
  }

  if (
    value === "UNDER_REVIEW" ||
    value === "UNDER REVIEW" ||
    value === "PROCESSING"
  ) {
    return {
      key: "review",
      label: "Under Review",
      description: "Our team is reviewing your KYC.",
      icon: Clock3,
    };
  }

  if (value === "PENDING") {
    return {
      key: "pending",
      label: "Pending",
      description: "Your KYC is waiting for verification.",
      icon: Clock3,
    };
  }

  return {
    key: "submitted",
    label: "Submitted",
    description: "Your KYC information has been submitted.",
    icon: ShieldCheck,
  };
}

export default function MyKYCPage() {
  const [kyc, setKyc] = useState<KYC | null>(null);
  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);
  const [error, setError] = useState("");

  const [editing, setEditing] = useState(false);
  const [saving, setSaving] = useState(false);
  const [saveMessage, setSaveMessage] = useState("");

  const [form, setForm] = useState({
    fullName: "",
    panNumber: "",
    dob: "",
    address: "",
    city: "",
    state: "",
    pincode: "",
  });

  const user = getUser();

  async function loadKYC(refresh = false) {
    try {
      setError("");

      if (refresh) {
        setRefreshing(true);
      } else {
        setLoading(true);
      }

      const token = getToken();
      const userId = getUserId();

      if (!token || !userId) {
        window.location.href = "/login";
        return;
      }

      const response = await fetch(
        `${API_URL}/kyc/user/${encodeURIComponent(userId)}`,
        {
          method: "GET",
          headers: {
            Authorization: `Bearer ${token}`,
            Accept: "application/json",
          },
          credentials: "include",
          cache: "no-store",
        }
      );

      if (response.status === 401 || response.status === 403) {
        localStorage.removeItem("loan_finance_token");
        window.location.href = "/login";
        return;
      }

      if (response.status === 404) {
        setKyc(null);
        return;
      }

      if (!response.ok) {
        const errorBody = await response.text();

        throw new Error(
          `KYC request failed (${response.status}): ${errorBody}`
        );
      }

      const result = await response.json();

      const data =
        result?.data?.kyc ??
        result?.data ??
        result?.kyc ??
        result;

      setKyc(data || null);
    } catch (err) {
      console.error("KYC error:", err);

      setError(
        err instanceof Error
          ? err.message
          : "Unable to load KYC information."
      );
    } finally {
      setLoading(false);
      setRefreshing(false);
    }
  }

  useEffect(() => {
    loadKYC();
  }, []);

  useEffect(() => {
    if (!kyc) return;

    setForm({
      fullName: kyc.fullName || "",
      panNumber: kyc.panNumber || "",
      dob: kyc.dob || "",
      address: kyc.address || "",
      city: kyc.city || "",
      state: kyc.state || "",
      pincode: kyc.pincode || "",
    });
  }, [kyc]);

  function updateForm(
    field: keyof typeof form,
    value: string
  ) {
    setForm((current) => ({
      ...current,
      [field]: value,
    }));
  }

  async function submitKYC() {
    if (!kyc) return;

    setError("");
    setSaveMessage("");
    setSaving(true);

    try {
      const token = getToken();

      if (!token) {
        window.location.href = "/login";
        return;
      }

      const response = await fetch(
        `${API_URL}/kyc/${encodeURIComponent(kyc.id)}`,
        {
          method: "PUT",
          headers: {
            Authorization: `Bearer ${token}`,
            "Content-Type": "application/json",
          },
          credentials: "include",
          body: JSON.stringify({
            fullName: form.fullName.trim(),
            panNumber: form.panNumber.trim().toUpperCase(),
            dob: form.dob.trim(),
            address: form.address.trim(),
            city: form.city.trim(),
            state: form.state.trim(),
            pincode: form.pincode.trim(),
            status: "PENDING",
          }),
        }
      );

      const body = await response.json().catch(() => null);

      if (!response.ok) {
        throw new Error(body?.message || "Unable to submit KYC");
      }

      await loadKYC(true);
      setEditing(false);
      setSaveMessage("KYC submitted successfully.");
    } catch (err) {
      console.error("KYC submit error:", err);
      setError(err instanceof Error ? err.message : "Unable to submit KYC.");
    } finally {
      setSaving(false);
    }
  }
  async function saveKYC() {
    if (!kyc) return;

    setError("");
    setSaveMessage("");

