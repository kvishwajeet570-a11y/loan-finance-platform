    try {
      setError("");

      if (refresh) {
        setRefreshing(true);
      } else {
        setLoading(true);
      }

      const token = getToken();
      const userId = getUserId();

      if (!token || !userId) {
        window.location.href = "/login";
        return;
      }

      const response = await fetch(
        `${API_URL}/kyc/user/${encodeURIComponent(userId)}`,
        {
          method: "GET",
          headers: {
            Authorization: `Bearer ${token}`,
            Accept: "application/json",
          },
          credentials: "include",
          cache: "no-store",
        }
      );

      if (response.status === 401 || response.status === 403) {
        localStorage.removeItem("loan_finance_token");
        window.location.href = "/login";
        return;
      }

      if (response.status === 404) {
        setKyc(null);
        return;
      }

      if (!response.ok) {
        const errorBody = await response.text();

        throw new Error(
          `KYC request failed (${response.status}): ${errorBody}`
        );
      }

      const result = await response.json();

      const data =
        result?.data?.kyc ??
        result?.data ??
        result?.kyc ??
        result;

      setKyc(data || null);
    } catch (err) {
      console.error("KYC error:", err);

