const API_URL =
  process.env.NEXT_PUBLIC_API_URL || "http://localhost:5000/api";

type KYC = {
  id: string;
  userId: string;
  fullName: string;
  panNumber: string;
  dob: string;
  address?: string | null;
  city?: string | null;
  state?: string | null;
  pincode?: string | null;
  status?: string | null;
  approvedBy?: string | null;
  approvedAt?: string | null;
  rejectionReason?: string | null;
  expiryDate?: string | null;
  createdAt?: string;
  updatedAt?: string;
};

function getToken() {
  if (typeof window === "undefined") return null;
  return localStorage.getItem("loan_finance_token");
}

function getUser() {
  if (typeof window === "undefined") return null;

  try {
    const raw = localStorage.getItem("loan_finance_user");
    return raw ? JSON.parse(raw) : null;
  } catch {
    return null;
  }
}

function getUserId() {
  const user = getUser();
  return user?.id || user?.userId || null;
}

function formatDate(value?: string | null) {
  if (!value) return "—";

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) return value;

  return date.toLocaleDateString("en-IN", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  });
}

function formatDateTime(value?: string | null) {
  if (!value) return "—";

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) return value;

  return date.toLocaleString("en-IN", {
    day: "2-digit",
    month: "short",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  });
}

function maskPAN(pan?: string | null) {
  if (!pan) return "Not available";

  const value = pan.trim();

  if (value.length <= 4) return "••••";

  return `${"•".repeat(value.length - 4)}${value.slice(-4)}`;
}

function getStatus(status?: string | null) {
  const value = String(status || "").toUpperCase().trim();

  if (value === "APPROVED" || value === "VERIFIED") {
    return {
      key: "approved",
      label: "Verified",
      description: "Your KYC has been successfully verified.",
      icon: CheckCircle2,
    };
  }

  if (value === "REJECTED") {
    return {
      key: "rejected",
      label: "Rejected",
      description: "Your KYC requires attention.",
      icon: XCircle,
    };
  }

  if (
    value === "UNDER_REVIEW" ||
    value === "UNDER REVIEW" ||
    value === "PROCESSING"
  ) {
    return {
      key: "review",
      label: "Under Review",
      description: "Our team is reviewing your KYC.",
      icon: Clock3,
    };
  }

  if (value === "PENDING") {
    return {
      key: "pending",
      label: "Pending",
      description: "Your KYC is waiting for verification.",
      icon: Clock3,
    };
  }

  return {
    key: "submitted",
    label: "Submitted",
    description: "Your KYC information has been submitted.",
    icon: ShieldCheck,
  };
}

