"use client";

import { useEffect, useState } from "react";

const API = process.env.NEXT_PUBLIC_API_URL || "http://localhost:5000/api";

function getToken() {
  if (typeof window === "undefined") return "";
  return localStorage.getItem("loan_finance_token") || "";
}

function getUser() {
  if (typeof window === "undefined") return null;
  try {
    return JSON.parse(localStorage.getItem("loan_finance_user") || "null");
  } catch {
    return null;
  }
}

function fmt(v: unknown) {
  if (!v) return "—";
  const d = new Date(String(v));
  if (Number.isNaN(d.getTime())) return String(v);
  return d.toLocaleDateString("en-IN", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  });
}

function maskPAN(v: unknown) {
  const s = String(v || "");
  if (s.length < 6) return s || "—";
  return `${s.slice(0, 2)}****${s.slice(-2)}`;
}

export default function MyKYCPage() {
  const user = getUser();

  const [kyc, setKyc] = useState<any>(null);
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [editing, setEditing] = useState(false);
  const [error, setError] = useState("");
  const [message, setMessage] = useState("");

  const [form, setForm] = useState({
    fullName: "",
    dob: "",
    gender: "",
    mobile: "",
    email: "",
    panNumber: "",
    address: "",
    city: "",
    state: "",
    pincode: "",
  });

  async function loadKYC() {
    try {
      setLoading(true);
      setError("");

      const userId = user?.id || user?.userId;
      if (!userId) throw new Error("User session not found.");

      const res = await fetch(`${API}/kyc/user/${userId}`, {
        headers: {
          Authorization: `Bearer ${getToken()}`,
        },
        credentials: "include",
      });

      const json = await res.json();

      if (!res.ok || !json.success) {
        throw new Error(json.message || "Unable to load KYC.");
      }

      const data = json.data;
      setKyc(data);

      if (data) {
        setForm({
          fullName: data.fullName || "",
          dob: data.dob ? String(data.dob).slice(0, 10) : "",
          gender: data.gender || "",
          mobile: data.mobile || user?.mobile || "",
          email: data.email || user?.email || "",
          panNumber: data.panNumber || "",
          address: data.address || "",
          city: data.city || "",
          state: data.state || "",
          pincode: data.pincode || "",
        });
      }
    } catch (e: any) {
      setError(e?.message || "Failed to load KYC.");
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    loadKYC();
  }, []);

  function updateField(name: string, value: string) {
    setForm((p) => ({ ...p, [name]: value }));
  }

  async function saveKYC() {
    if (!kyc?.id) {
      setError("KYC record not found.");
      return;
    }

    try {
      setSaving(true);
      setError("");
      setMessage("");

      const res = await fetch(`${API}/kyc/${kyc.id}`, {
        method: "PUT",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${getToken()}`,
        },
        credentials: "include",
        body: JSON.stringify(form),
      });

      const json = await res.json();

      if (!res.ok || json.success === false) {
        throw new Error(json.message || "Failed to save KYC.");
      }

      setKyc(json.data || { ...kyc, ...form });
      setEditing(false);
      setMessage("KYC details saved successfully.");
    } catch (e: any) {
      setError(e?.message || "Failed to save KYC.");
    } finally {
      setSaving(false);
    }
  }

  async function submitKYC() {
    if (!kyc?.id) {
      setError("Please save your KYC details first.");
      return;
    }

    try {
      setSaving(true);
      setError("");
      setMessage("");

      const res = await fetch(`${API}/kyc/${kyc.id}`, {
        method: "PUT",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${getToken()}`,
        },
        credentials: "include",
        body: JSON.stringify({
          ...form,
          status: "PENDING",
        }),
      });

      const json = await res.json();

      if (!res.ok || json.success === false) {
        throw new Error(json.message || "Failed to submit KYC.");
      }

      setKyc(json.data || { ...kyc, ...form, status: "PENDING" });
      setMessage("KYC submitted successfully for verification.");
    } catch (e: any) {
      setError(e?.message || "Failed to submit KYC.");
    } finally {
      setSaving(false);
    }
  }

  const status = String(kyc?.status || "PENDING").toUpperCase();
  const verified = status === "VERIFIED" || status === "APPROVED";
  const rejected = status === "REJECTED" || status === "FAILED";

  const progress = verified ? 100 : rejected ? 25 : kyc ? 45 : 10;

  if (loading) {
    return (
      <div className="flex min-h-[60vh] items-center justify-center bg-slate-50">
        <div className="rounded-2xl border bg-white px-8 py-6 shadow-sm">
          <div className="mx-auto mb-3 h-7 w-7 animate-spin rounded-full border-2 border-blue-600 border-t-transparent" />
          <p className="text-sm font-medium text-slate-600">Loading KYC...</p>
        </div>
      </div>
    );
  }

  return (
    <main className="min-h-screen bg-[#f7faff] pb-32">
      <div className="mx-auto max-w-[1450px] px-4 py-5 sm:px-6 lg:px-8">

        {/* EXISTING KYC BANNER — KEEP AS IS */}
        <section className="relative mb-6 overflow-hidden rounded-3xl border border-blue-100 bg-white shadow-sm">
          <div className="relative aspect-[4/1] min-h-[190px] w-full overflow-hidden">
            <img
              src="/images/kyc/kyc-ai-banner.png"
              alt="KYC Security and Verification"
              className="absolute inset-0 h-full w-full object-cover"
            />
          </div>
        </section>

        {error && (
          <div className="mb-5 rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-sm font-medium text-red-700">
            {error}
          </div>
        )}

        {message && (
          <div className="mb-5 rounded-2xl border border-emerald-200 bg-emerald-50 px-5 py-4 text-sm font-medium text-emerald-700">
            {message}
          </div>
        )}

        {/* CUSTOMER SUMMARY */}
        <section className="mb-6 rounded-3xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7">
          <div className="flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
            <div className="flex items-center gap-4">
              <div className="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-blue-600 to-indigo-600 text-xl font-bold text-white shadow-lg">
                {(kyc?.fullName || user?.name || "C").charAt(0).toUpperCase()}
              </div>

              <div>
                <h1 className="text-xl font-bold text-slate-900 sm:text-2xl">
                  {kyc?.fullName || user?.name || "Customer"}
                </h1>
                <p className="mt-1 text-sm text-slate-500">
                  KYC ID: {kyc?.id || "Not created"}
                </p>
              </div>
            </div>

            <div className="min-w-[260px]">
              <div className="mb-2 flex justify-between text-sm">
                <span className="font-semibold text-slate-700">KYC Completion</span>
                <span className="font-bold text-blue-600">{progress}%</span>
              </div>
              <div className="h-2.5 overflow-hidden rounded-full bg-slate-100">
                <div
                  className="h-full rounded-full bg-gradient-to-r from-blue-600 to-indigo-500 transition-all"
                  style={{ width: `${progress}%` }}
                />
              </div>
              <div className="mt-2 flex items-center gap-2">
                <span
                  className={`rounded-full px-3 py-1 text-xs font-bold ${
                    verified
                      ? "bg-emerald-100 text-emerald-700"
                      : rejected
                      ? "bg-red-100 text-red-700"
                      : "bg-amber-100 text-amber-700"
                  }`}
                >
                  {status}
                </span>
                <span className="text-xs text-slate-400">
                  {verified ? "Verification complete" : "Verification in progress"}
                </span>
              </div>
            </div>
          </div>
        </section>

        {/* STEP TRACKER */}
        <section className="mb-6 rounded-3xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7">
          <div className="mb-6">
            <h2 className="text-lg font-bold text-slate-900">KYC Verification Journey</h2>
            <p className="mt-1 text-sm text-slate-500">
              Complete each step to finish your verification.
            </p>
          </div>

          <div className="grid gap-3 md:grid-cols-5">
            {[
              ["01", "Personal Details", true],
              ["02", "Identity Verification", verified],
              ["03", "Address Verification", verified],
              ["04", "Bank Verification", verified],
              ["05", "Review & Submit", verified],
            ].map(([num, title, done]) => (
              <div
                key={String(num)}
                className="rounded-2xl border border-slate-200 bg-slate-50 p-4"
              >
                <div className="mb-3 flex items-center justify-between">
                  <span className="text-xs font-bold text-slate-400">{num}</span>
                  <span
                    className={`flex h-7 w-7 items-center justify-center rounded-full text-xs font-bold ${
                      done
                        ? "bg-emerald-500 text-white"
                        : "bg-white text-slate-400 ring-1 ring-slate-200"
                    }`}
                  >
                    {done ? "✓" : "•"}
                  </span>
                </div>
                <p className="text-sm font-semibold text-slate-800">{title}</p>
                <p className="mt-1 text-xs text-slate-500">
                  {done ? "Completed" : "Pending"}
                </p>
              </div>
            ))}
          </div>
        </section>

        {/* PERSONAL INFORMATION */}
        <section className="mb-6 rounded-3xl border border-slate-200 bg-white shadow-sm">
          <div className="flex items-center justify-between border-b border-slate-100 px-5 py-5 sm:px-7">
            <div>
              <h2 className="text-lg font-bold text-slate-900">Personal Information</h2>
              <p className="mt-1 text-xs text-slate-500">Your registered personal details</p>
            </div>

            <button
              type="button"
              onClick={() => setEditing((v) => !v)}
              className="rounded-xl border border-blue-200 bg-blue-50 px-4 py-2 text-sm font-semibold text-blue-700 hover:bg-blue-100"
            >
              {editing ? "Cancel" : "Edit"}
            </button>
          </div>

          <div className="grid gap-5 p-5 sm:grid-cols-2 sm:p-7 lg:grid-cols-3">
            {[
              ["Full Name", "fullName"],
              ["Date of Birth", "dob"],
              ["Gender", "gender"],
              ["Mobile Number", "mobile"],
              ["Email Address", "email"],
              ["PAN Number", "panNumber"],
            ].map(([label, key]) => (
              <div key={key}>
                <label className="mb-2 block text-xs font-semibold uppercase tracking-wide text-slate-400">
                  {label}
                </label>

                {editing ? (
                  <input
                    value={String((form as any)[key] || "")}
                    onChange={(e) => updateField(key, e.target.value)}
                    type={key === "dob" ? "date" : "text"}
                    className="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-800 outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-50"
                  />
                ) : (
                  <div className="rounded-xl bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-800">
                    {key === "panNumber"
                      ? maskPAN(form.panNumber)
                      : form[key as keyof typeof form] || "—"}
                  </div>
                )}
              </div>
            ))}
          </div>

          {editing && (
            <div className="flex justify-end border-t border-slate-100 px-5 py-4 sm:px-7">
              <button
                type="button"
                onClick={saveKYC}
                disabled={saving}
                className="rounded-xl bg-blue-600 px-6 py-3 text-sm font-bold text-white shadow-lg shadow-blue-200 hover:bg-blue-700 disabled:opacity-60"
              >
                {saving ? "Saving..." : "Save Personal Details"}
              </button>
            </div>
          )}
        </section>

        {/* IDENTITY + ADDRESS */}
        <div className="mb-6 grid gap-6 lg:grid-cols-2">
          <section className="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7">
            <div className="mb-5 flex items-center justify-between">
              <div>
                <h2 className="text-lg font-bold text-slate-900">Identity Verification</h2>
                <p className="mt-1 text-xs text-slate-500">PAN / Aadhaar verification</p>
              </div>
              <span className="rounded-full bg-amber-50 px-3 py-1 text-xs font-bold text-amber-700">
                {verified ? "Verified" : "Pending"}
              </span>
            </div>

            <div className="space-y-3">
              <div className="flex items-center justify-between rounded-2xl border border-slate-100 p-4">
                <div>
                  <p className="text-sm font-bold text-slate-800">PAN Card</p>
                  <p className="mt-1 text-xs text-slate-500">{maskPAN(form.panNumber)}</p>
                </div>
                <span className="text-xs font-semibold text-slate-400">Verification</span>
              </div>

              <div className="flex items-center justify-between rounded-2xl border border-slate-100 p-4">
                <div>
                  <p className="text-sm font-bold text-slate-800">Aadhaar</p>
                  <p className="mt-1 text-xs text-slate-500">Identity document</p>
                </div>
                <span className="text-xs font-semibold text-amber-600">Pending</span>
              </div>
            </div>
          </section>

          <section className="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7">
            <div className="mb-5 flex items-center justify-between">
              <div>
                <h2 className="text-lg font-bold text-slate-900">Address Information</h2>
                <p className="mt-1 text-xs text-slate-500">Current residential address</p>
              </div>
              <span className="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-600">
                Pending
              </span>
            </div>

            <div className="rounded-2xl bg-slate-50 p-4">
              <p className="text-sm leading-6 text-slate-700">
                {form.address || "Address not provided"}
                {form.city ? `, ${form.city}` : ""}
                {form.state ? `, ${form.state}` : ""}
                {form.pincode ? ` - ${form.pincode}` : ""}
              </p>
            </div>

            <div className="mt-4 grid grid-cols-2 gap-3">
              <input
                placeholder="City"
                value={form.city}
                onChange={(e) => updateField("city", e.target.value)}
                className="rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none focus:border-blue-500"
              />
              <input
                placeholder="Pincode"
                value={form.pincode}
                onChange={(e) => updateField("pincode", e.target.value)}
                className="rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none focus:border-blue-500"
              />
            </div>
          </section>
        </div>

        {/* BANK + DOCUMENTS */}
        <div className="mb-6 grid gap-6 lg:grid-cols-2">
          <section className="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7">
            <div className="mb-5">
              <h2 className="text-lg font-bold text-slate-900">Bank Verification</h2>
              <p className="mt-1 text-xs text-slate-500">
                Verify your bank account for loan processing.
              </p>
            </div>

            <div className="rounded-2xl border border-dashed border-blue-200 bg-blue-50/50 p-6 text-center">
              <div className="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-2xl bg-white text-xl shadow-sm">
                🏦
              </div>
              <p className="text-sm font-bold text-slate-800">Bank account verification</p>
              <p className="mt-1 text-xs text-slate-500">Bank verification is currently pending.</p>
              <button
                type="button"
                className="mt-4 rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-bold text-white hover:bg-slate-800"
              >
                Link Bank Account
              </button>
            </div>
          </section>

          <section className="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7">
            <div className="mb-5">
              <h2 className="text-lg font-bold text-slate-900">Documents</h2>
              <p className="mt-1 text-xs text-slate-500">Required KYC documents</p>
            </div>

            <div className="space-y-3">
              {[
                ["PAN Card", "Identity proof"],
                ["Aadhaar Card", "Identity proof"],
                ["Address Proof", "Residential proof"],
              ].map(([title, sub]) => (
                <div
                  key={title}
                  className="flex items-center justify-between rounded-2xl border border-slate-100 p-4"
                >
                  <div className="flex items-center gap-3">
                    <div className="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                      📄
                    </div>
                    <div>
                      <p className="text-sm font-bold text-slate-800">{title}</p>
                      <p className="text-xs text-slate-500">{sub}</p>
                    </div>
                  </div>
                  <span className="rounded-full bg-amber-50 px-3 py-1 text-xs font-bold text-amber-700">
                    Pending
                  </span>
                </div>
              ))}
            </div>
          </section>
        </div>

        {/* HISTORY + HELP */}
        <div className="grid gap-6 lg:grid-cols-2">
          <section className="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7">
            <h2 className="text-lg font-bold text-slate-900">KYC History</h2>

            <div className="mt-5 rounded-2xl bg-slate-50 p-4">
              <div className="flex items-center justify-between">
                <div>
                  <p className="text-sm font-bold text-slate-800">KYC Application</p>
                  <p className="mt-1 text-xs text-slate-500">
                    Created: {fmt(kyc?.createdAt)}
                  </p>
                </div>
                <span className="rounded-full bg-amber-100 px-3 py-1 text-xs font-bold text-amber-700">
                  {status}
                </span>
              </div>

              {kyc?.updatedAt && (
                <p className="mt-3 text-xs text-slate-400">
                  Last updated: {fmt(kyc.updatedAt)}
                </p>
              )}
            </div>
          </section>

          <section className="rounded-3xl border border-blue-100 bg-gradient-to-br from-blue-50 to-indigo-50 p-5 shadow-sm sm:p-7">
            <h2 className="text-lg font-bold text-slate-900">Need Help?</h2>
            <p className="mt-2 text-sm leading-6 text-slate-600">
              If you are having trouble completing KYC verification, please contact
              customer support.
            </p>
            <div className="mt-5 rounded-2xl bg-white/80 p-4">
              <p className="text-xs font-semibold uppercase tracking-wide text-slate-400">
                Support
              </p>
              <p className="mt-1 text-sm font-bold text-slate-800">
                Our team can help with your verification.
              </p>
            </div>
          </section>
        </div>
      </div>

      {/* FIXED BOTTOM ACTION BAR */}
      <div className="fixed inset-x-0 bottom-0 z-50 border-t border-slate-200 bg-white/95 px-4 py-3 shadow-[0_-8px_30px_rgba(15,23,42,0.08)] backdrop-blur sm:px-6">
        <div className="mx-auto flex max-w-[1450px] items-center justify-between gap-4">
          <div className="hidden sm:block">
            <p className="text-sm font-bold text-slate-800">
              {verified ? "Your KYC is verified" : "Complete your KYC verification"}
            </p>
            <p className="text-xs text-slate-500">
              Save your details before submitting.
            </p>
          </div>

          <div className="ml-auto flex gap-3">
            <button
              type="button"
              onClick={saveKYC}
              disabled={saving || !kyc?.id}
              className="rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-bold text-slate-700 hover:bg-slate-50 disabled:opacity-50"
            >
              {saving ? "Saving..." : "Save Changes"}
            </button>

            <button
              type="button"
              onClick={submitKYC}
              disabled={saving || !kyc?.id || verified}
              className="rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 px-6 py-3 text-sm font-bold text-white shadow-lg shadow-blue-200 hover:from-blue-700 hover:to-indigo-700 disabled:cursor-not-allowed disabled:opacity-50"
            >
              {verified ? "KYC Verified ✓" : saving ? "Submitting..." : "Submit KYC"}
            </button>
          </div>
        </div>
      </div>
    </main>
  );
}
