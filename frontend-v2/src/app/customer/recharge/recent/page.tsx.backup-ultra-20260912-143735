          router.replace("/login");
          return;
        }

        let user: any = null;

        try {
          user = JSON.parse(storedUser);
        } catch {
          user = null;
        }

        const userId = user?.id;

        if (!userId) {
          setError(
            "Customer account information not found."
          );
          return;
