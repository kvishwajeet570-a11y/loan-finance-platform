function unwrap(payload: any): any {
  if (!payload) return null;

  if (Array.isArray(payload)) return payload;

  if (payload.data !== undefined) {
    if (Array.isArray(payload.data)) return payload.data;

    if (payload.data?.recharges) {
      return payload.data.recharges;
    }

    if (payload.data?.items) {
      return payload.data.items;
    }

    if (payload.data?.results) {
      return payload.data.results;
    }

    return payload.data;
  }

  if (payload.recharges) return payload.recharges;
  if (payload.items) return payload.items;
  if (payload.results) return payload.results;

  return payload;
}

function money(value?: number) {
  return `₹${Number(value || 0).toLocaleString("en-IN", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  })}`;
}

function formatDate(value?: string) {
  if (!value) return "—";

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return value;
  }

  return date.toLocaleDateString("en-IN", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  });
}

function formatTime(value?: string) {
  if (!value) return "";

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return "";
  }

  return date.toLocaleTimeString("en-IN", {
    hour: "2-digit",
    minute: "2-digit",
  });
}

function statusMeta(status?: string) {
  const value = String(status || "PENDING").toUpperCase();

  if (
    value.includes("SUCCESS") ||
    value.includes("COMPLETED") ||
    value === "SUCCESSFUL"
  ) {
    return {
      label: "Successful",
      icon: CheckCircle2,
      className:
        "bg-emerald-50 text-emerald-700 border-emerald-100",
      dot: "bg-emerald-500",
    };
  }

  if (
    value.includes("FAIL") ||
    value.includes("REJECT")
  ) {
    return {
      label: "Failed",
      icon: XCircle,
      className:
        "bg-red-50 text-red-700 border-red-100",
      dot: "bg-red-500",
    };
  }

  if (
    value.includes("REFUND")
  ) {
    return {
      label: "Refunded",
      icon: RotateCcw,
      className:
        "bg-purple-50 text-purple-700 border-purple-100",
      dot: "bg-purple-500",
    };
  }

  return {
    label: "Pending",
    icon: Clock3,
    className:
      "bg-amber-50 text-amber-700 border-amber-100",
    dot: "bg-amber-500",
  };
}

function operatorClass(operator?: string) {
  const value = String(operator || "").toUpperCase();

  if (value.includes("JIO")) {
    return "from-blue-600 to-blue-800";
  }

  if (value.includes("AIRTEL")) {
    return "from-red-500 to-red-700";
  }

  if (
    value.includes("VI") ||
    value.includes("VODAFONE")
  ) {
    return "from-red-700 to-purple-800";
  }

  if (value.includes("BSNL")) {
    return "from-orange-500 to-red-600";
  }

  return "from-indigo-500 to-purple-700";
}

function operatorShort(operator?: string) {
  const value = String(operator || "").toUpperCase();

  if (value.includes("JIO")) return "JIO";
  if (value.includes("AIRTEL")) return "AIRTEL";
  if (value.includes("VI")) return "VI";
  if (value.includes("BSNL")) return "BSNL";

  return String(operator || "TELCO").slice(0, 8);
}

function maskMobile(number?: string) {
  if (!number) return "Mobile number unavailable";

  const value = String(number);

  if (value.length >= 10) {
    return `${value.slice(0, 2)}••••••${value.slice(-2)}`;
  }

  return value;
}

