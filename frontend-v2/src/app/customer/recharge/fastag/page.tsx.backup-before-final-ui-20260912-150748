                  {
                    icon: "⚡",
                    title: "Fast & Reliable",
                    text: "Quick recharge processing",
                  },
                  {
                    icon: "🛡",
                    title: "Secure Transactions",
                    text: "Bank-level security",
                  },
                  {
                    icon: "🎁",
                    title: "Exclusive Offers",
                    text: "Save more on recharges",
                  },
                  {
                    icon: "◉",
                    title: "24 × 7 Support",
                    text: "We're always here to help",
                  },
                ].map((item) => (
                  <div
                    key={item.title}
                    className="rounded-xl border border-slate-200 bg-slate-50 p-4 transition hover:border-blue-200 hover:bg-white hover:shadow-sm"
