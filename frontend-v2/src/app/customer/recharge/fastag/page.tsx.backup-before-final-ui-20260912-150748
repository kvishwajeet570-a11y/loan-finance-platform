              <div className="absolute right-8 top-0 h-full w-1/2 bg-[radial-gradient(circle_at_center,rgba(59,130,246,.12),transparent_55%)]" />

              <div className="relative flex flex-col items-start justify-between gap-5 md:flex-row md:items-center">
                <div>
                  <p className="text-[10px] font-black uppercase tracking-wider text-emerald-600">
                    More Miles
                  </p>

                  <h3 className="mt-1 text-2xl font-black">
                    More Smiles
                  </h3>

                  <p className="mt-1 max-w-xl text-[10px] text-slate-500">
                    Keep your FASTag active and enjoy a smoother,
                    faster and greener journey.
                  </p>
                </div>

                <div className="flex items-center gap-3 rounded-xl border border-white bg-white/80 px-5 py-3 shadow-sm">
                  <Truck size={25} className="text-blue-600" />

                  <div>
                    <p className="text-[10px] font-black text-slate-900">
                      Smart Travel
                    </p>

                    <p className="text-[9px] text-slate-400">
                      Cashless India
                    </p>
                  </div>
                </div>
              </div>
            </section>
          </div>

          {/* RIGHT SIDEBAR */}
          <aside>
            <div className="sticky top-5 space-y-5">

              {/* WALLET */}
              <section className="overflow-hidden rounded-2xl border border-blue-100 bg-gradient-to-br from-blue-600 via-blue-600 to-violet-600 p-5 text-white shadow-lg">
                <div className="flex items-start justify-between">
                  <div className="flex items-center gap-3">
                    <div className="flex h-11 w-11 items-center justify-center rounded-xl bg-white/15 ring-1 ring-white/20">
                      <Wallet size={22} />
                    </div>

                    <div>
                      <p className="text-[10px] font-semibold text-blue-100">
                        Wallet Balance
                      </p>

                      <p className="mt-1 text-2xl font-black">
                        {money(balance)}
                      </p>
                    </div>
                  </div>
                </div>

                <div className="mt-4 flex items-center justify-between">
                  <p className="text-[9px] text-blue-100">
                    Ready for your next journey!
                  </p>

                  <Link
                    href="/customer/wallet/balance"
                    className="rounded-lg bg-white px-3 py-2 text-[9px] font-black text-blue-700 hover:bg-blue-50"
