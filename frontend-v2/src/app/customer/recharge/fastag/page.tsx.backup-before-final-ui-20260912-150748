                      </>
                    ) : (
                      <>
                        <span className="text-base">ϟ</span>
                        Recharge FASTag
                        <ArrowRight size={14} />
                      </>
                    )}
                  </button>

                  <div className="mt-4 flex items-center justify-center gap-2 text-[9px] font-bold text-slate-400">
                    <LockKeyhole size={12} />
                    Secure Wallet Payment
                  </div>
                </div>
              </section>

              {/* RECENT */}
              <section className="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
                <div className="flex items-center justify-between">
                  <div>
                    <h3 className="text-sm font-black">
                      Recent FASTag Recharge
                    </h3>

                    <p className="mt-1 text-[9px] text-slate-400">
                      Latest recharge activity
                    </p>
                  </div>

                  <Link
                    href="/customer/recharge/recent"
                    className="text-[9px] font-black text-blue-600"
                  >
                    View All →
                  </Link>
                </div>

                <div className="mt-4 space-y-2">
                  {recent.length ? (
                    recent.map((item) => (
                      <div
                        key={item.id}
                        className="rounded-xl border border-slate-200 bg-slate-50 p-3 transition hover:border-blue-200 hover:bg-white"
                      >
                        <div className="flex items-center gap-3">
                          <div className="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white text-[7px] font-black text-blue-700 shadow-sm">
                            {item.operator || "FASTag"}
                          </div>

                          <div className="min-w-0 flex-1">
                            <p className="truncate text-[10px] font-black">
                              {item.operator || "FASTag"}
                            </p>

                            <p className="mt-0.5 text-[8px] font-semibold text-slate-400">
                              {mask(item.mobileNumber)}
                            </p>

                            <p className="mt-1 text-[7px] text-slate-400">
                              {formatDate(item.createdAt)}
                            </p>
                          </div>

                          <div className="text-right">
                            <p className="text-[10px] font-black">
                              {money(Number(item.amount || 0))}
                            </p>

                            <span className="mt-1 inline-flex rounded-full bg-emerald-50 px-2 py-0.5 text-[7px] font-black text-emerald-700">
                              {String(
                                item.status || "SUCCESS"
                              ).toUpperCase()}
                            </span>
                          </div>
                        </div>
                      </div>
                    ))
                  ) : (
                    <div className="py-7 text-center">
                      <Truck
                        size={25}
                        className="mx-auto text-slate-300"
                      />

                      <p className="mt-2 text-[10px] font-bold text-slate-500">
                        No FASTag recharge yet
                      </p>
                    </div>
                  )}
                </div>
              </section>

              {/* QUICK SERVICES */}
              <section className="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
                <div className="flex items-center justify-between">
                  <h3 className="text-sm font-black">
                    Quick Services
                  </h3>

                  <span className="text-[9px] font-black text-blue-600">
                    View All →
                  </span>
                </div>

                <div className="mt-4 grid grid-cols-4 gap-2">
                  <Link
                    href="/customer/recharge/mobile"
                    className="rounded-xl border border-slate-200 bg-slate-50 p-3 text-center transition hover:border-blue-200 hover:bg-white"
                  >
                    <div className="text-lg">▣</div>
                    <p className="mt-2 text-[8px] font-black">
                      Mobile
                      <br />
                      Recharge
                    </p>
                  </Link>

                  <Link
                    href="/customer/recharge/dth"
                    className="rounded-xl border border-slate-200 bg-slate-50 p-3 text-center transition hover:border-blue-200 hover:bg-white"
                  >
                    <div className="text-lg">▤</div>
                    <p className="mt-2 text-[8px] font-black">
                      DTH
                      <br />
                      Recharge
                    </p>
                  </Link>

                  <Link
                    href="/customer/recharge/recent"
                    className="rounded-xl border border-slate-200 bg-slate-50 p-3 text-center transition hover:border-blue-200 hover:bg-white"
                  >
                    <div className="text-lg">◷</div>
                    <p className="mt-2 text-[8px] font-black">
                      Recharge
                      <br />
                      History
                    </p>
                  </Link>

                  <Link
                    href="/customer/wallet/balance"
                    className="rounded-xl border border-slate-200 bg-slate-50 p-3 text-center transition hover:border-blue-200 hover:bg-white"
                  >
                    <div className="text-lg">▰</div>
                    <p className="mt-2 text-[8px] font-black">
                      Wallet
                      <br />
                      Balance
                    </p>
                  </Link>
                </div>
              </section>

              {/* TRUST STRIP */}
              <div className="grid grid-cols-3 gap-2 rounded-2xl border border-slate-200 bg-white p-3 shadow-sm">
                <div className="text-center">
                  <div className="text-lg">◌</div>
                  <p className="mt-1 text-[7px] font-black text-slate-600">
                    FAST
                    <br />
                    TRAVEL
                  </p>
                </div>

                <div className="border-x border-slate-100 text-center">
                  <div className="text-lg text-blue-600">◷</div>
                  <p className="mt-1 text-[7px] font-black text-slate-600">
                    CASHLESS
                    <br />
                    INDIA
                  </p>
                </div>

                <div className="text-center">
                  <div className="text-lg text-emerald-600">♧</div>
                  <p className="mt-1 text-[7px] font-black text-slate-600">
                    GREENER
                    <br />
                    TOMORROW
                  </p>
                </div>
              </div>
            </div>
          </aside>
        </div>

        {/* FOOTER */}
        <div className="flex flex-wrap items-center justify-center gap-4 py-7 text-[9px] font-medium text-slate-400">
          <span className="flex items-center gap-1.5">
            <LockKeyhole size={11} />
            Secure Payments
          </span>

          <span>•</span>

          <span>Trusted Platform</span>

          <span>•</span>

          <span>Made in India 🇮🇳</span>
        </div>

        {/* MESSAGE */}
        {message && (
          <div className="fixed bottom-5 right-5 z-50 max-w-sm rounded-xl border border-slate-200 bg-white p-4 shadow-2xl">
            <div className="flex items-start gap-3">
              {message.toLowerCase().includes("success") ? (
                <CheckCircle2
                  size={18}
                  className="mt-0.5 shrink-0 text-emerald-600"
                />
              ) : (
                <ShieldCheck
                  size={18}
                  className="mt-0.5 shrink-0 text-amber-600"
                />
              )}

              <p className="flex-1 text-xs font-semibold leading-5 text-slate-700">
                {message}
              </p>

              <button
                onClick={() => setMessage("")}
                className="text-slate-400 hover:text-slate-700"
              >
                <X size={15} />
              </button>
            </div>
          </div>
        )}
      </div>
    </div>
  );
}
