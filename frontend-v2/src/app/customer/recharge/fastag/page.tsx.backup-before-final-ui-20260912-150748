                    <div className="text-2xl">{item.icon}</div>

                    <p className="mt-3 text-[10px] font-black text-slate-900">
                      {item.title}
                    </p>

                    <p className="mt-1 text-[9px] leading-4 text-slate-500">
                      {item.text}
                    </p>
                  </div>
                ))}
              </div>
            </section>

            {/* TRAVEL BANNER */}
