                    <p className="text-[9px] font-black uppercase tracking-wider text-blue-600">
                      Recharge Summary
                    </p>

                    <h2 className="mt-1 text-base font-black">
                      Review & Recharge
                    </h2>
                  </div>

                  <button
                    onClick={() => {
                      setVehicle("");
                      setAmount("500");
                    }}
                    className="text-[9px] font-bold text-blue-600 hover:text-blue-700"
                  >
                    Clear All →
                  </button>
                </div>

                <div className="p-4">
                  <div className="divide-y divide-slate-100 rounded-xl border border-slate-200">
                    <div className="flex items-center justify-between gap-3 px-3 py-3">
                      <span className="text-[10px] text-slate-500">
                        Selected Bank
                      </span>

                      <span className="text-[10px] font-black">
                        {selectedProvider.name}
                      </span>
                    </div>

                    <div className="flex items-center justify-between gap-3 px-3 py-3">
                      <span className="text-[10px] text-slate-500">
                        Vehicle Number
                      </span>

                      <span className="text-[10px] font-black tracking-wider">
                        {cleanVehicle
                          ? mask(cleanVehicle)
                          : "Not entered"}
                      </span>
                    </div>

                    <div className="flex items-center justify-between gap-3 px-3 py-3">
                      <span className="text-[10px] text-slate-500">
                        Recharge Amount
                      </span>

                      <span className="text-sm font-black">
                        {money(numericAmount)}
                      </span>
                    </div>
                  </div>

                  <button
                    onClick={handleRecharge}
                    disabled={processing}
                    className="mt-4 flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-blue-600 to-violet-600 py-3.5 text-xs font-black text-white shadow-md transition hover:-translate-y-0.5 hover:shadow-lg disabled:cursor-not-allowed disabled:opacity-60"
                  >
                    {processing ? (
                      <>
                        <Loader2 size={15} className="animate-spin" />
