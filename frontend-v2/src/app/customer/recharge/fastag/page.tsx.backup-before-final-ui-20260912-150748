                        </button>
                      )}
                    </div>

                    <div className="mt-2 flex flex-wrap gap-x-5 gap-y-2 text-[9px] font-semibold text-slate-500">
                      <span className="flex items-center gap-1">
                        <CheckCircle2 size={12} className="text-blue-600" />
