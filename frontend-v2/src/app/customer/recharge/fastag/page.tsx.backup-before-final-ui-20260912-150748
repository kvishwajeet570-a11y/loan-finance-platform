                      </span>

                      <span className="flex items-center gap-1">
                        <CheckCircle2 size={12} className="text-blue-600" />
                        Letters & numbers only
                      </span>

                      {vehicle && (
                        <span
                          className={`flex items-center gap-1 ${
                            vehicleValid
                              ? "text-emerald-600"
                              : "text-amber-600"
