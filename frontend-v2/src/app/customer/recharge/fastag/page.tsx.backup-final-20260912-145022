                  </span>

                  <span className="flex items-center gap-2">
                    <CheckCircle2
                      size={15}
                      className="text-emerald-600"
                    />
                    Easy recharge
                  </span>

                  <span className="flex items-center gap-2">
                    <CheckCircle2
                      size={15}
                      className="text-emerald-600"
                    />
                    Digital receipt
                  </span>
                </div>
              </div>

              {/* MINIMAL VEHICLE VISUAL */}
              <div className="relative hidden overflow-hidden bg-[#eef4fb] md:block">
                <div className="absolute inset-0 bg-[linear-gradient(135deg,transparent_49%,rgba(37,99,235,.05)_50%,transparent_51%)] bg-[length:28px_28px]" />

                <div className="absolute bottom-9 left-1/2 -translate-x-1/2">
                  <div className="relative h-20 w-40 rounded-[22px_22px_12px_12px] bg-slate-800 shadow-xl">
                    <div className="absolute left-5 top-3 h-7 w-12 rounded-lg bg-sky-200" />
                    <div className="absolute right-5 top-3 h-7 w-12 rounded-lg bg-sky-200" />

                    <div className="absolute -bottom-3 left-4 h-7 w-7 rounded-full bg-slate-900 ring-4 ring-white" />
                    <div className="absolute -bottom-3 right-4 h-7 w-7 rounded-full bg-slate-900 ring-4 ring-white" />

                    <div className="absolute -top-4 left-1/2 -translate-x-1/2 rounded-md bg-blue-600 px-3 py-1 text-[8px] font-bold text-white shadow-md">
                      FASTag
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>

          {/* WALLET CARD */}
          <section className="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            <div className="flex items-center justify-between">
              <div>
                <p className="text-xs font-medium text-slate-500">
                  Available Wallet
                </p>

                <p className="mt-1 text-3xl font-bold text-slate-950">
                  {money(walletBalance)}
                </p>
              </div>

              <div className="rounded-lg bg-blue-50 p-3 text-blue-600">
                <Wallet size={20} />
              </div>
            </div>

            <div className="my-5 border-t border-slate-100" />

            <div className="flex items-center justify-between text-xs">
              <span className="text-slate-500">
                Payment Method
              </span>

              <span className="font-semibold text-slate-800">
                Wallet
              </span>
            </div>

            <Link
              href="/customer/wallet/balance"
              className="mt-5 flex items-center justify-center gap-2 rounded-lg border border-blue-600 px-4 py-3 text-xs font-semibold text-blue-600 transition hover:bg-blue-50"
            >
              Manage Wallet
              <ArrowRight size={14} />
            </Link>
          </section>
        </div>

        {/* PROVIDER */}
        <section className="mt-6 rounded-xl border border-slate-200 bg-white p-5 shadow-sm md:p-6">
          <div className="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
            <div>
              <p className="text-xs font-semibold text-blue-600">
                STEP 1
              </p>

              <h2 className="mt-1 text-lg font-bold text-slate-950">
                Select FASTag Provider
              </h2>

              <p className="mt-1 text-xs text-slate-500">
                Choose the bank that issued your FASTag.
              </p>
            </div>

            <div className="relative">
              <Search
                size={14}
                className="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"
              />

              <input
                value={bankSearch}
                onChange={(e) =>
                  setBankSearch(e.target.value)
                }
                placeholder="Search bank"
                className="w-full rounded-lg border border-slate-200 bg-slate-50 py-2.5 pl-9 pr-3 text-xs outline-none focus:border-blue-500 focus:bg-white md:w-64"
              />
            </div>
          </div>

          <div className="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">
            {filteredBanks.map((bank) => {
              const active = selectedBank === bank.id;

              return (
                <button
                  key={bank.id}
                  onClick={() => {
                    setSelectedBank(bank.id);
                    setMessage("");
                  }}
                  className={`relative rounded-lg border p-4 text-left transition ${
                    active
                      ? "border-blue-600 bg-blue-50 ring-1 ring-blue-600"
                      : "border-slate-200 bg-white hover:border-blue-300 hover:bg-slate-50"
                  }`}
                >
                  {active && (
                    <span className="absolute right-3 top-3 flex h-5 w-5 items-center justify-center rounded-full bg-blue-600 text-white">
                      <Check size={11} />
                    </span>
                  )}

                  <div
                    className={`flex h-10 w-16 items-center justify-center rounded-md border text-[10px] font-bold ${
                      active
                        ? "border-blue-200 bg-white text-blue-700"
                        : "border-slate-200 bg-slate-50 text-slate-700"
                    }`}
                  >
                    {bank.short}
                  </div>

                  <p className="mt-4 text-xs font-bold text-slate-900">
                    {bank.name}
                  </p>

                  <p className="mt-1 text-[10px] text-slate-500">
                    {bank.description}
                  </p>
                </button>
              );
            })}
          </div>
        </section>

        {/* MAIN FORM */}
        <div className="mt-6 grid gap-6 lg:grid-cols-[1fr_370px]">

          {/* LEFT */}
          <div className="space-y-6">

            {/* VEHICLE DETAILS */}
            <section className="rounded-xl border border-slate-200 bg-white p-5 shadow-sm md:p-6">
              <div>
                <p className="text-xs font-semibold text-blue-600">
                  STEP 2
                </p>

                <h2 className="mt-1 text-lg font-bold text-slate-950">
                  Vehicle Details
                </h2>

                <p className="mt-1 text-xs text-slate-500">
                  Enter the registration number linked to your
                  FASTag.
                </p>
              </div>

              <div className="mt-5">
                <label className="mb-2 block text-xs font-semibold text-slate-700">
                  Vehicle Registration Number
                </label>

                <div className="relative">
                  <CreditCard
                    size={17}
                    className="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"
                  />

                  <input
                    value={vehicleNumber}
                    onChange={(e) => {
                      setVehicleNumber(
                        e.target.value
                          .toUpperCase()
                          .replace(/[^A-Z0-9]/g, "")
                          .slice(0, 12)
                      );
                      setMessage("");
                    }}
                    placeholder="BR01AB1234"
                    className={`w-full rounded-lg border bg-white py-3.5 pl-10 pr-12 text-sm font-semibold tracking-wider outline-none transition ${
                      vehicleNumber && vehicleValid
                        ? "border-emerald-500 ring-2 ring-emerald-50"
                        : vehicleNumber
                          ? "border-amber-400"
                          : "border-slate-300 focus:border-blue-600 focus:ring-2 focus:ring-blue-50"
                    }`}
                  />

                  {vehicleNumber && (
                    <button
                      onClick={copyVehicle}
                      className="absolute right-2.5 top-1/2 -translate-y-1/2 rounded-md p-2 text-slate-400 hover:bg-slate-100 hover:text-blue-600"
                      title="Copy vehicle number"
                    >
                      {copied ? (
                        <Check
                          size={15}
                          className="text-emerald-600"
                        />
                      ) : (
                        <Copy size={15} />
                      )}
                    </button>
                  )}
                </div>

                <div className="mt-2 flex items-center justify-between">
                  <p className="text-[10px] text-slate-400">
                    Example: BR01AB1234
                  </p>

                  {vehicleNumber && (
                    <p
                      className={`text-[10px] font-semibold ${
                        vehicleValid
                          ? "text-emerald-600"
                          : "text-amber-600"
                      }`}
                    >
                      {vehicleValid
                        ? "Valid format"
                        : "Please check the format"}
                    </p>
                  )}
                </div>
              </div>
            </section>

            {/* AMOUNT */}
            <section className="rounded-xl border border-slate-200 bg-white p-5 shadow-sm md:p-6">
              <div>
                <p className="text-xs font-semibold text-blue-600">
                  STEP 3
                </p>

                <h2 className="mt-1 text-lg font-bold text-slate-950">
                  Choose Recharge Amount
                </h2>

                <p className="mt-1 text-xs text-slate-500">
                  Select an amount or enter your own value.
                </p>
              </div>

              <div className="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
                {quickAmounts.map((value) => {
                  const active =
                    amount === String(value);

                  return (
                    <button
                      key={value}
                      onClick={() => {
                        setAmount(String(value));
                        setMessage("");
                      }}
                      className={`rounded-lg border px-3 py-4 text-center transition ${
                        active
                          ? "border-blue-600 bg-blue-50 text-blue-700"
                          : "border-slate-200 bg-white text-slate-700 hover:border-blue-300 hover:bg-slate-50"
                      }`}
                    >
                      <p className="text-sm font-bold">
                        {money(value)}
                      </p>

                      {active && (
                        <p className="mt-1 text-[9px] font-semibold">
                          Selected
                        </p>
                      )}
                    </button>
                  );
                })}
              </div>

              <div className="mt-5">
                <label className="mb-2 block text-xs font-semibold text-slate-700">
                  Custom Amount
                </label>

                <div className="relative">
                  <IndianRupee
                    size={16}
                    className="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"
                  />

                  <input
                    value={amount}
                    onChange={(e) => {
                      setAmount(
                        e.target.value.replace(/[^\d.]/g, "")
                      );
                      setMessage("");
                    }}
                    inputMode="decimal"
                    placeholder="Enter amount"
                    className="w-full rounded-lg border border-slate-300 bg-white py-3.5 pl-10 pr-4 text-sm font-semibold outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-50"
                  />
                </div>

                <p className="mt-2 text-[10px] text-slate-400">
                  Minimum recharge amount: ₹10
                </p>
              </div>
            </section>

            {/* RECENT */}
            <section className="rounded-xl border border-slate-200 bg-white p-5 shadow-sm md:p-6">
              <div className="flex items-center justify-between">
                <div>
                  <p className="text-xs font-semibold text-blue-600">
                    ACTIVITY
                  </p>

                  <h2 className="mt-1 text-lg font-bold text-slate-950">
                    Recent FASTag Recharge
                  </h2>
                </div>

                <Link
                  href="/customer/recharge/recent"
                  className="text-xs font-semibold text-blue-600 hover:text-blue-700"
                >
                  View All
                </Link>
              </div>

              <div className="mt-5 divide-y divide-slate-100">
                {recent.length ? (
                  recent.map((item) => (
                    <div
                      key={item.id}
                      className="flex items-center gap-3 py-4 first:pt-0 last:pb-0"
                    >
                      <div className="flex h-10 w-10 items-center justify-center rounded-lg bg-slate-100 text-slate-600">
                        <Truck size={17} />
