"use client";

import { useCallback, useEffect, useMemo, useState } from "react";
import Link from "next/link";
import {
  ArrowRight,
  Check,
  CheckCircle2,
  ChevronRight,
  Clock3,
  Copy,
  CreditCard,
  IndianRupee,
  Loader2,
  LockKeyhole,
  RefreshCw,
  Search,
  ShieldCheck,
  Truck,
  Wallet,
  X,
} from "lucide-react";
import api from "@/lib/api";

type User = {
  id: string;
  name?: string;
  fullName?: string;
};

type Bank = {
  id: string;
  name: string;
  short: string;
  description: string;
};

type Recharge = {
  id: string;
  mobileNumber?: string;
  operator?: string;
  amount?: number;
  rechargeType?: string;
  status?: string;
  createdAt?: string;
  paymentMethod?: string;
};

const banks: Bank[] = [
  {
    id: "ICICI",
    name: "ICICI Bank",
    short: "ICICI",
    description: "ICICI Bank FASTag",
  },
  {
    id: "HDFC",
    name: "HDFC Bank",
    short: "HDFC",
    description: "HDFC Bank FASTag",
  },
  {
    id: "SBI",
    name: "State Bank of India",
    short: "SBI",
    description: "SBI FASTag",
  },
  {
    id: "AXIS",
    name: "Axis Bank",
    short: "AXIS",
    description: "Axis Bank FASTag",
  },
  {
    id: "IDFC",
    name: "IDFC FIRST Bank",
    short: "IDFC",
    description: "IDFC FIRST FASTag",
  },
  {
    id: "BOB",
    name: "Bank of Baroda",
    short: "BOB",
    description: "Bank of Baroda FASTag",
  },
];

const quickAmounts = [100, 200, 500, 1000, 2000, 5000];

const money = (value: number) =>
  `₹${Number(value || 0).toLocaleString("en-IN")}`;

const maskValue = (value = "") => {
  if (value.length <= 4) return value;
  return `${"*".repeat(Math.max(0, value.length - 4))}${value.slice(-4)}`;
};

const formatDate = (value?: string) => {
  if (!value) return "—";

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) return "—";

  return date.toLocaleString("en-IN", {
    day: "2-digit",
    month: "short",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  });
};

export default function FastagRechargePage() {
  const [user, setUser] = useState<User | null>(null);
  const [walletBalance, setWalletBalance] = useState(0);

  const [selectedBank, setSelectedBank] = useState("ICICI");
  const [vehicleNumber, setVehicleNumber] = useState("");
  const [amount, setAmount] = useState("500");

  const [bankSearch, setBankSearch] = useState("");
  const [recent, setRecent] = useState<Recharge[]>([]);

  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);
  const [processing, setProcessing] = useState(false);

  const [message, setMessage] = useState("");
  const [copied, setCopied] = useState(false);

  const loadData = useCallback(async () => {
    try {
      const token = localStorage.getItem("loan_finance_token");
      const storedUser = localStorage.getItem("loan_finance_user");

      if (!token || !storedUser) {
        window.location.href = "/login";
        return;
      }

      const currentUser = JSON.parse(storedUser) as User;
      setUser(currentUser);

      const config = {
        headers: {
          Authorization: `Bearer ${token}`,
        },
        withCredentials: true,
      };

      const [walletResponse, rechargeResponse] =
        await Promise.all([
          api.get("/wallet/balance", config),
          api.get(`/recharge/user/${currentUser.id}`, config),
        ]);

      const walletData =
        walletResponse?.data?.data ||
        walletResponse?.data?.wallet ||
        walletResponse?.data ||
        {};

      setWalletBalance(Number(walletData?.balance || 0));

      const rechargeData =
        rechargeResponse?.data?.data ||
        rechargeResponse?.data?.recharges ||
        [];

      setRecent(
        (Array.isArray(rechargeData) ? rechargeData : [])
          .filter(
            (item: Recharge) =>
              String(item.rechargeType || "").toUpperCase() ===
              "FASTAG"
          )
          .slice(0, 6)
      );
    } catch (error: any) {
      if (error?.response?.status === 401) {
        localStorage.removeItem("loan_finance_token");
        window.location.href = "/login";
        return;
      }

      setMessage(
        error?.response?.data?.message ||
          "Unable to load FASTag information."
      );
    } finally {
      setLoading(false);
      setRefreshing(false);
    }
  }, []);

  useEffect(() => {
    loadData();
  }, [loadData]);

  const cleanVehicle = useMemo(
    () =>
      vehicleNumber
        .toUpperCase()
        .replace(/[^A-Z0-9]/g, ""),
    [vehicleNumber]
  );

  const vehicleValid = useMemo(
    () =>
      /^[A-Z]{2}[0-9]{1,2}[A-Z]{1,3}[0-9]{3,4}$/.test(
        cleanVehicle
      ),
    [cleanVehicle]
  );

  const filteredBanks = useMemo(() => {
    const query = bankSearch.trim().toLowerCase();

    if (!query) return banks;

    return banks.filter(
      (bank) =>
        bank.name.toLowerCase().includes(query) ||
        bank.short.toLowerCase().includes(query) ||
        bank.description.toLowerCase().includes(query)
    );
  }, [bankSearch]);

  const selectedBankData =
    banks.find((bank) => bank.id === selectedBank) || banks[0];

  const rechargeAmount = Number(amount || 0);

  const recharge = async () => {
    if (!cleanVehicle) {
      setMessage("Please enter your vehicle registration number.");
      return;
    }

    if (!vehicleValid) {
      setMessage(
        "Please enter a valid vehicle number, for example BR01AB1234."
      );
      return;
    }

    if (!rechargeAmount || rechargeAmount < 10) {
      setMessage("Minimum recharge amount is ₹10.");
      return;
    }

    if (rechargeAmount > walletBalance) {
      setMessage("Insufficient wallet balance.");
      return;
    }

    if (!user?.id) {
      setMessage("User session expired. Please login again.");
      return;
    }

    try {
      setProcessing(true);
      setMessage("");

      const token = localStorage.getItem("loan_finance_token");

      const response = await api.post(
        "/recharge",
        {
          userId: user.id,
          mobileNumber: cleanVehicle,
          operator: selectedBank,
          amount: rechargeAmount,
          rechargeType: "FASTAG",
          paymentMethod: "Wallet",
        },
        {
          headers: {
            Authorization: `Bearer ${token}`,
          },
          withCredentials: true,
        }
      );

      if (!response?.data?.success) {
        throw new Error(
          response?.data?.message ||
            "FASTag recharge failed."
        );
      }

      setMessage(
        `FASTag recharge of ${money(
          rechargeAmount
        )} completed successfully.`
      );

      await loadData();
    } catch (error: any) {
      if (error?.response?.status === 401) {
        localStorage.removeItem("loan_finance_token");
        window.location.href = "/login";
        return;
      }

      setMessage(
        error?.response?.data?.message ||
          error?.message ||
          "FASTag recharge failed."
      );
    } finally {
      setProcessing(false);
    }
  };

  const copyVehicle = async () => {
    if (!cleanVehicle) return;

    try {
      await navigator.clipboard.writeText(cleanVehicle);
      setCopied(true);

      setTimeout(() => {
        setCopied(false);
      }, 1500);
    } catch {}
  };

  if (loading) {
    return (
      <div className="flex min-h-[70vh] items-center justify-center bg-[#f5f7fa]">
        <div className="flex items-center gap-3 rounded-lg border border-slate-200 bg-white px-5 py-4 shadow-sm">
          <Loader2
            size={20}
            className="animate-spin text-blue-600"
          />
          <span className="text-sm font-semibold text-slate-700">
            Loading FASTag...
          </span>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-[#f5f7fa] text-slate-900">
      <div className="mx-auto max-w-[1500px] px-4 py-5 md:px-6">

        {/* PAGE HEADER */}
        <div className="flex flex-col gap-4 border-b border-slate-200 pb-5 md:flex-row md:items-center md:justify-between">
          <div>
            <div className="flex items-center gap-2 text-xs text-slate-500">
              <Link
                href="/customer/dashboard"
                className="hover:text-blue-600"
              >
                Dashboard
              </Link>

              <ChevronRight size={13} />

              <span>Recharge</span>

              <ChevronRight size={13} />

              <span className="font-semibold text-slate-800">
                FASTag
              </span>
            </div>

            <h1 className="mt-2 text-2xl font-bold tracking-tight text-slate-950">
              FASTag Recharge
            </h1>

            <p className="mt-1 text-sm text-slate-500">
              Recharge your FASTag using your wallet balance.
            </p>
          </div>

          <div className="flex items-center gap-3">
            <div className="hidden rounded-lg border border-slate-200 bg-white px-4 py-2.5 sm:block">
              <p className="text-[10px] font-medium uppercase tracking-wide text-slate-400">
                Wallet Balance
              </p>

              <p className="mt-0.5 text-sm font-bold text-slate-900">
                {money(walletBalance)}
              </p>
            </div>

            <button
              onClick={() => {
                setRefreshing(true);
                loadData();
              }}
              disabled={refreshing}
              className="flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-xs font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-600 disabled:opacity-60"
            >
              <RefreshCw
                size={14}
                className={
                  refreshing ? "animate-spin" : ""
                }
              />
              Refresh
            </button>
          </div>
        </div>

        {/* SIMPLE PROFESSIONAL INTRO */}
        <div className="mt-6 grid gap-5 lg:grid-cols-[1fr_330px]">

          <section className="relative overflow-hidden rounded-xl border border-slate-200 bg-white">
            <div className="grid min-h-[230px] md:grid-cols-[1fr_300px]">

              <div className="p-7 md:p-9">
                <div className="flex items-center gap-2 text-xs font-semibold text-blue-600">
                  <span className="flex h-7 w-7 items-center justify-center rounded-md bg-blue-50">
                    <Truck size={15} />
                  </span>

                  FASTag Services
                </div>

                <h2 className="mt-5 max-w-xl text-3xl font-bold leading-tight text-slate-950 md:text-4xl">
                  Keep your journey moving
                </h2>

                <p className="mt-3 max-w-xl text-sm leading-6 text-slate-500">
                  Recharge your FASTag quickly with a secure wallet
                  payment and keep your toll payments uninterrupted.
                </p>

                <div className="mt-6 flex flex-wrap gap-5 text-xs font-medium text-slate-600">
                  <span className="flex items-center gap-2">
                    <CheckCircle2
                      size={15}
                      className="text-emerald-600"
