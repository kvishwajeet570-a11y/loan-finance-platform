                  <h2 className="mt-1 text-lg font-bold text-slate-950">
                    FASTag Recharge
                  </h2>
                </div>

                <div className="p-5">
                  <div className="flex items-center justify-between">
                    <span className="text-xs text-slate-500">
                      FASTag Provider
                    </span>

                    <span className="text-xs font-bold text-slate-900">
                      {selectedBankData.name}
                    </span>
                  </div>

                  <div className="mt-4 flex items-center justify-between">
                    <span className="text-xs text-slate-500">
                      Vehicle Number
                    </span>

                    <span className="text-xs font-bold tracking-wider text-slate-900">
                      {cleanVehicle
                        ? maskValue(cleanVehicle)
                        : "Not entered"}
                    </span>
                  </div>

                  <div className="mt-4 flex items-center justify-between">
                    <span className="text-xs text-slate-500">
                      Payment Method
                    </span>

                    <span className="text-xs font-bold text-slate-900">
                      Wallet
                    </span>
                  </div>

                  <div className="my-5 border-t border-slate-100" />

                  <div className="flex items-end justify-between">
                    <span className="text-sm font-semibold text-slate-700">
                      Recharge Amount
                    </span>

                    <span className="text-2xl font-bold text-slate-950">
                      {money(rechargeAmount)}
                    </span>
                  </div>

                  <div className="mt-4 flex items-center justify-between rounded-lg bg-slate-50 px-3 py-3">
                    <span className="text-[10px] text-slate-500">
                      Wallet available
                    </span>

                    <span
                      className={`text-xs font-bold ${
                        rechargeAmount > walletBalance
                          ? "text-red-600"
                          : "text-emerald-600"
                      }`}
                    >
                      {money(walletBalance)}
                    </span>
                  </div>

                  <button
                    onClick={recharge}
                    disabled={processing}
                    className="mt-5 flex w-full items-center justify-center gap-2 rounded-lg bg-blue-600 px-4 py-3.5 text-xs font-bold text-white shadow-sm transition hover:bg-blue-700 disabled:cursor-not-allowed disabled:opacity-60"
                  >
                    {processing ? (
                      <>
                        <Loader2
                          size={15}
                          className="animate-spin"
                        />
                        Processing...
                      </>
                    ) : (
                      <>
                        Recharge FASTag
                        <ArrowRight size={15} />
                      </>
                    )}
                  </button>

                  <div className="mt-4 flex items-center justify-center gap-2 text-[10px] text-slate-400">
                    <LockKeyhole size={12} />
                    Secure wallet payment
                  </div>
                </div>
              </section>

              {/* SUPPORT CARD */}
              <section className="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
                <div className="flex items-start gap-3">
                  <div className="rounded-lg bg-emerald-50 p-2.5 text-emerald-600">
                    <ShieldCheck size={18} />
                  </div>

                  <div>
                    <p className="text-xs font-bold text-slate-900">
                      Secure & Transparent
                    </p>

                    <p className="mt-1 text-[10px] leading-5 text-slate-500">
                      Recharge details and wallet transactions are
                      recorded in your account history.
                    </p>
                  </div>
                </div>
              </section>

              {/* WALLET SHORTCUTS */}
              <section className="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
                <p className="text-xs font-bold text-slate-900">
                  Wallet Shortcuts
                </p>

                <div className="mt-4 space-y-2">
                  <Link
                    href="/customer/wallet/balance"
                    className="flex items-center justify-between rounded-lg border border-slate-200 px-3 py-3 text-xs font-semibold text-slate-700 hover:border-blue-300 hover:text-blue-600"
                  >
                    Wallet Balance
                    <ArrowRight size={13} />
                  </Link>

                  <Link
                    href="/customer/wallet/transactions"
                    className="flex items-center justify-between rounded-lg border border-slate-200 px-3 py-3 text-xs font-semibold text-slate-700 hover:border-blue-300 hover:text-blue-600"
                  >
                    Transactions
                    <ArrowRight size={13} />
                  </Link>

                  <Link
                    href="/customer/wallet/statement"
                    className="flex items-center justify-between rounded-lg border border-slate-200 px-3 py-3 text-xs font-semibold text-slate-700 hover:border-blue-300 hover:text-blue-600"
                  >
                    Account Statement
                    <ArrowRight size={13} />
                  </Link>
                </div>
              </section>
            </div>
          </aside>
        </div>

        {/* TRUST STRIP */}
        <div className="mt-6 grid gap-3 sm:grid-cols-3">
          <div className="flex items-center gap-3 rounded-lg border border-slate-200 bg-white p-4">
            <div className="rounded-lg bg-blue-50 p-2.5 text-blue-600">
              <ShieldCheck size={17} />
            </div>

            <div>
              <p className="text-xs font-bold text-slate-900">
                Secure Payment
              </p>

              <p className="mt-1 text-[10px] text-slate-400">
                Wallet based transaction
              </p>
            </div>
          </div>

          <div className="flex items-center gap-3 rounded-lg border border-slate-200 bg-white p-4">
            <div className="rounded-lg bg-emerald-50 p-2.5 text-emerald-600">
              <CheckCircle2 size={17} />
            </div>

            <div>
              <p className="text-xs font-bold text-slate-900">
                Account History
              </p>

              <p className="mt-1 text-[10px] text-slate-400">
                Recharge activity is recorded
              </p>
            </div>
          </div>

          <div className="flex items-center gap-3 rounded-lg border border-slate-200 bg-white p-4">
            <div className="rounded-lg bg-slate-100 p-2.5 text-slate-600">
              <Truck size={17} />
            </div>

            <div>
              <p className="text-xs font-bold text-slate-900">
                Easy FASTag Recharge
              </p>

              <p className="mt-1 text-[10px] text-slate-400">
                Simple vehicle based flow
              </p>
            </div>
          </div>
        </div>

        {/* MESSAGE */}
        {message && (
          <div className="fixed bottom-5 right-5 z-50 max-w-sm rounded-lg border border-slate-200 bg-white p-4 shadow-xl">
            <div className="flex items-start gap-3">
              {message.toLowerCase().includes("success") ? (
                <CheckCircle2
                  size={18}
                  className="mt-0.5 shrink-0 text-emerald-600"
                />
              ) : (
                <ShieldCheck
                  size={18}
                  className="mt-0.5 shrink-0 text-amber-600"
                />
              )}

              <p className="flex-1 text-xs font-semibold leading-5 text-slate-700">
                {message}
              </p>

              <button
                onClick={() => setMessage("")}
                className="text-slate-400 hover:text-slate-700"
              >
                <X size={15} />
              </button>
            </div>
          </div>
        )}

        {/* FOOTER */}
        <div className="flex flex-wrap items-center justify-center gap-5 py-7 text-[9px] font-medium text-slate-400">
          <span className="flex items-center gap-1.5">
            <LockKeyhole size={11} />
            Secure Payment
          </span>

          <span>•</span>

          <span>FASTag Recharge</span>

          <span>•</span>

          <span>LoanFinance Customer Portal</span>
        </div>
      </div>
    </div>
  );
}
