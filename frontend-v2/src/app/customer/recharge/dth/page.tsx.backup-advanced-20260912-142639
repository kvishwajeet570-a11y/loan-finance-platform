                      </div>
                    )}

                    <button className="absolute right-3 top-3 text-slate-300 hover:text-indigo-600">
                      <Star size={17} />
                    </button>

                    <div className="mt-8">
                      <div className="flex h-9 items-center text-sm font-black text-indigo-600">
                        {currentOperator.logo}
                      </div>

                      <h3 className="mt-2 text-lg font-black text-slate-900">
                        {plan.name}
                      </h3>

                      <p className="mt-1 text-xs text-slate-500">
                        {plan.channels} Channels • {plan.hd} HD
                      </p>
                    </div>

                    <div className="mt-4 flex items-end justify-between">
                      <div>
                        <p className="text-2xl font-black text-slate-950">
                          {money(plan.price)}
                        </p>

                        <p className="text-[11px] text-slate-400">
                          {plan.validity}
                        </p>
                      </div>

                      <span className="rounded-lg bg-slate-100 px-2.5 py-1 text-[10px] font-bold text-slate-600">
                        {plan.language}
                      </span>
                    </div>

                    <p className="mt-3 min-h-[35px] text-xs leading-5 text-slate-500">
                      {plan.description}
                    </p>

                    <button
                      onClick={() => choosePlan(plan)}
                      className="mt-4 flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-blue-600 to-violet-600 py-3 text-xs font-black text-white shadow-lg shadow-indigo-100 transition hover:from-indigo-600 hover:to-purple-700"
                    >
                      Select Plan
                      <ArrowRight size={14} />
                    </button>
                  </div>
                ))}

                {!filteredPlans.length && (
                  <div className="col-span-full rounded-2xl border border-dashed border-slate-300 p-10 text-center">
                    <Tv size={35} className="mx-auto text-slate-300" />
                    <p className="mt-3 font-black text-slate-700">
                      No plans found
                    </p>
                    <p className="mt-1 text-xs text-slate-400">
                      Try another category or search term.
                    </p>
                  </div>
                )}
              </div>
            </section>
          </div>

          {/* RIGHT */}
          <aside className="space-y-5">

            {/* WALLET */}
            <section className="sticky top-5 overflow-hidden rounded-[28px] bg-gradient-to-br from-[#1726b8] via-[#4430d9] to-[#7424db] p-5 text-white shadow-2xl">
              <div className="flex items-start justify-between">
                <div>
                  <p className="text-xs font-bold text-indigo-100">
                    Wallet Balance
                  </p>

                  <p className="mt-2 text-3xl font-black">
                    {money(wallet)}
                  </p>
                </div>

                <div className="rounded-2xl bg-white/15 p-3">
                  <Wallet size={23} />
                </div>
              </div>

              <Link
                href="/customer/wallet/statement"
                className="mt-4 block text-xs font-bold text-indigo-100 hover:text-white"
              >
                View Statement →
              </Link>

              <div className="mt-5 grid grid-cols-2 gap-2">
                <Link
                  href="/customer/wallet/balance"
                  className="rounded-xl bg-white/10 px-3 py-2 text-center text-[10px] font-black hover:bg-white/20"
                >
                  Wallet
                </Link>

                <Link
                  href="/customer/wallet/transactions"
                  className="rounded-xl bg-white/10 px-3 py-2 text-center text-[10px] font-black hover:bg-white/20"
                >
                  Transactions
                </Link>
              </div>

              <div className="my-5 h-px bg-white/15" />

              <p className="text-xs font-black text-indigo-100">
                Complete Recharge
              </p>

              <p className="mt-1 font-black">
                {currentOperator.name}
              </p>

              <div className="mt-4">
                <label className="mb-2 block text-[11px] font-bold text-indigo-100">
                  Recharge Amount
                </label>

                <div className="relative">
                  <IndianRupee
                    size={17}
                    className="absolute left-3.5 top-1/2 -translate-y-1/2 text-indigo-300"
                  />

                  <input
                    value={amount}
                    onChange={(e) => {
                      setAmount(
                        e.target.value.replace(/[^\d.]/g, "")
                      );
                      setSelectedPlan(null);
                      setMessage("");
                    }}
                    placeholder="Enter amount"
                    inputMode="decimal"
                    className="w-full rounded-xl border border-white/15 bg-white/10 py-4 pl-10 pr-3 text-xl font-black text-white outline-none placeholder:text-indigo-200 focus:bg-white/15"
                  />
                </div>
              </div>

              <div className="mt-3 grid grid-cols-4 gap-2">
                {[100, 200, 300, 500].map((value) => (
                  <button
                    key={value}
                    onClick={() => {
                      setAmount(String(value));
                      setSelectedPlan(null);
                    }}
                    className="rounded-xl border border-white/10 bg-white/10 py-2 text-[11px] font-black hover:bg-white/20"
                  >
                    ₹{value}
                  </button>
                ))}
              </div>

              {selectedPlan && (
                <div className="mt-4 rounded-2xl bg-white/10 p-3">
                  <div className="flex items-center gap-3">
                    <div className="rounded-xl bg-white/15 p-2">
                      <Crown size={17} />
                    </div>

                    <div className="min-w-0 flex-1">
                      <p className="truncate text-xs font-black">
                        {selectedPlan.name}
                      </p>

                      <p className="text-[10px] text-indigo-100">
                        {selectedPlan.channels} Channels •{" "}
                        {selectedPlan.validity}
                      </p>
                    </div>

                    <p className="font-black">
                      {money(selectedPlan.price)}
                    </p>
                  </div>
                </div>
              )}

              <button
                onClick={recharge}
                disabled={processing}
                className="mt-5 flex w-full items-center justify-center gap-2 rounded-xl bg-white py-4 text-sm font-black text-indigo-700 shadow-xl transition hover:bg-indigo-50 disabled:opacity-60"
              >
                {processing ? (
                  <>
                    <Loader2 size={17} className="animate-spin" />
                    Processing...
                  </>
                ) : (
                  <>
                    <Zap size={17} />
                    Recharge Now
                  </>
                )}
              </button>

              <div className="mt-4 flex items-center justify-center gap-2 text-[10px] font-semibold text-indigo-100">
                <LockKeyhole size={13} />
                Secure wallet payment
              </div>
            </section>

            {/* OFFER */}
            <div className="relative overflow-hidden rounded-[24px] bg-gradient-to-r from-pink-500 via-orange-500 to-yellow-400 p-5 text-white shadow-lg">
              <div className="absolute -right-6 -top-6 text-7xl opacity-20">
                %
              </div>

              <div className="relative">
                <p className="text-xs font-black">SPECIAL OFFER</p>

                <h3 className="mt-1 text-xl font-black">
                  Get up to 5% Cashback
                </h3>

                <p className="mt-1 text-xs text-white/80">
                  On selected DTH recharge plans
                </p>

                <button className="mt-4 rounded-xl bg-white px-4 py-2 text-xs font-black text-pink-600">
                  View Offers →
                </button>
              </div>
            </div>

            {/* RECENT */}
            <section className="rounded-[26px] border border-slate-200 bg-white p-5 shadow-sm">
              <div className="flex items-center justify-between">
                <h3 className="font-black text-slate-950">
                  Recent DTH Recharge
                </h3>

                <Link
                  href="/customer/recharge/recent"
                  className="text-xs font-black text-indigo-600"
                >
                  View All →
                </Link>
              </div>

              <div className="mt-4 space-y-3">
                {recent.length ? (
                  recent.map((item) => (
                    <div
                      key={item.id}
                      className="flex items-center gap-3 rounded-xl bg-slate-50 p-3"
                    >
                      <div className="flex h-9 w-9 items-center justify-center rounded-xl bg-indigo-100 text-xs font-black text-indigo-600">
                        TV
                      </div>

                      <div className="min-w-0 flex-1">
                        <p className="truncate text-xs font-black text-slate-900">
                          {item.operator || "DTH"}
                        </p>

                        <p className="text-[9px] text-slate-400">
                          ID: {mask(item.mobileNumber)}
                        </p>
                      </div>

                      <div className="text-right">
                        <p className="text-xs font-black text-slate-900">
                          {money(Number(item.amount || 0))}
                        </p>

                        <span
                          className={`mt-1 inline-block rounded-full border px-2 py-0.5 text-[8px] font-black ${statusStyle(
                            item.status
                          )}`}
                        >
                          {String(item.status || "PENDING")}
                        </span>
                      </div>
                    </div>
                  ))
                ) : (
                  <div className="py-8 text-center">
                    <Clock3
                      size={28}
                      className="mx-auto text-slate-300"
                    />
                    <p className="mt-2 text-xs font-bold text-slate-500">
                      No DTH recharge yet
                    </p>
                  </div>
                )}
              </div>
            </section>

            {/* QUICK SERVICES */}
            <section className="rounded-[26px] border border-slate-200 bg-white p-5 shadow-sm">
              <div className="flex items-center justify-between">
                <h3 className="font-black text-slate-950">
                  Quick Services
                </h3>

                <span className="text-xs font-black text-indigo-600">
                  Services
                </span>
              </div>

              <div className="mt-4 grid grid-cols-3 gap-2">
                <Link
                  href="/customer/recharge/mobile"
                  className="rounded-xl bg-blue-50 p-3 text-center hover:bg-blue-100"
                >
                  <div className="text-lg">M</div>
                  <p className="mt-1 text-[10px] font-black text-slate-700">
                    Mobile
                  </p>
                </Link>

                <Link
                  href="/customer/recharge/fastag"
                  className="rounded-xl bg-orange-50 p-3 text-center hover:bg-orange-100"
                >
                  <div className="text-lg">F</div>
                  <p className="mt-1 text-[10px] font-black text-slate-700">
                    FASTag
                  </p>
                </Link>

                <Link
                  href="/customer/recharge/recent"
                  className="rounded-xl bg-violet-50 p-3 text-center hover:bg-violet-100"
                >
                  <div className="text-lg">R</div>
                  <p className="mt-1 text-[10px] font-black text-slate-700">
                    History
                  </p>
                </Link>
              </div>
            </section>
          </aside>
        </div>

        {/* BENEFITS */}
        <section className="mt-6 rounded-[24px] border border-slate-200 bg-white p-4 shadow-sm md:p-5">
          <div className="grid gap-4 md:grid-cols-4">
            {[
              {
                icon: <Zap size={20} />,
                title: "Instant Recharge",
                text: "Fast recharge experience",
              },
              {
                icon: <ShieldCheck size={20} />,
                title: "Safe & Secure",
                text: "Protected wallet payment",
              },
              {
                icon: <Tv size={20} />,
                title: "Multiple Operators",
                text: "5 major DTH providers",
              },
              {
                icon: <Sparkles size={20} />,
                title: "Premium Experience",
                text: "Simple, fast & reliable",
              },
            ].map((item) => (
              <div
                key={item.title}
                className="flex items-center gap-3 border-b border-slate-100 pb-3 last:border-0 md:border-b-0 md:border-r md:pb-0 md:last:border-0"
              >
                <div className="rounded-full bg-indigo-50 p-3 text-indigo-600">
                  {item.icon}
                </div>

                <div>
                  <p className="text-xs font-black text-slate-900">
                    {item.title}
                  </p>

                  <p className="mt-1 text-[10px] text-slate-400">
                    {item.text}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </section>
      </div>
    </div>
  );
}
