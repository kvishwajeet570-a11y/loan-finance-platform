generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(cuid())
  name                  String
  email                 String                 @unique
  phoneNo               String                 @unique
  password              String
  otp                   String?
  otpExpiry             DateTime?
  isVerified            Boolean                @default(false)
  role                  String                 @default("user")
  profileImage          String?
  isBlocked             Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  aadharCardImage       String?
  accountLockedUntil    DateTime?
  address               String?
  city                  String?
  createdBy             String?
  deletedAt             DateTime?
  dob                   String?
  failedLoginAttempts   Int                    @default(0)
  isActive              Boolean                @default(true)
  isDeleted             Boolean                @default(false)
  lastLogin             DateTime?
  lastLoginDevice       String?
  lastLoginIp           String?
  lastSeen              DateTime?
  loginCount            Int                    @default(0)
  panCardImage          String?
  passwordChangedAt     DateTime?
  pincode               String?
  referralCode          String?                @unique
  refreshToken          String?
  roleId                String?
  selfieImage           String?
  state                 String?
  twoFactorEnabled      Boolean                @default(false)
  updatedBy             String?
  activityLogs          ActivityLog[]
  bankAccounts          BankAccount[]
  commissions           Commission[]
  creditScores          CreditScore[]
  creditScoreHistory    CreditScoreHistory[]
  devices               Device[]
  documents             Document[]
  electricityBills      ElectricityBill[]
  fastagRecharges       FastagRecharge[]
  insuranceApplications InsuranceApplication[]
  kyc                   KYC?
  loans                 LoanApplication[]
  LoginHistory          LoginHistory[]
  notifications         Notification[]
  payments              Payment[]
  recharges             Recharge[]
  refreshTokens         RefreshToken[]
  revenues              Revenue[]
  securityLogs          SecurityLog[]
  sessions              Session[]
  supportReplies        SupportReply[]
  assignedTickets       SupportTicket[]        @relation("AssignedAdminTickets")
  supportTickets        SupportTicket[]
  roleRef               Role?                  @relation(fields: [roleId], references: [id])
  activities            UserActivity[]
  userInvestments       UserInvestment[]
  userPermissions       UserPermission[]
  wallet                Wallet?
  RechargeHistory       RechargeHistory[]
  historyReferrals      ReferralHistory[]      @relation("HistoryReferredUser")
  receivedReferrals     Referral?              @relation("ReferralReferredUser")
  referredReferrals     Referral[]             @relation("ReferralReferrer")
  referral              Referral?              @relation("ReferralOwner")
  transactions          Transaction[]
  uploads               Upload[]
}

model LoanApplication {
  id              String       @id @default(cuid())
  fullName        String
  email           String
  phone           String
  loanType        String
  interestRate    Float?
  tenureMonths    Int?
  monthlyEMI      Float?
  purpose         String?
  address         String?
  city            String?
  state           String?
  zipCode         String?
  aadhaarNo       String?
  panNo           String?
  remarks         String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  userId          String?
  amount          Float
  approvedAt      DateTime?
  approvedBy      String?
  assignedTo      String?
  dob             String?
  employmentType  String?
  monthlyIncome   Float?
  partnerId       String?
  rejectionReason String?
  status          LoanStatus   @default(PENDING)
  commissions     Commission[]
  emiPayments     EMIPayment[]
  partner         Partner?     @relation(fields: [partnerId], references: [id])
  user            User?        @relation(fields: [userId], references: [id])
  payments        Payment[]
  revenues        Revenue[]
}

model fAQ {
  id           String   @id @default(cuid())
  question     String
  answer       String
  category     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  views        Int      @default(0)
}

model fastTag {
  id        String   @id @default(cuid())
  vehicleNo String
  provider  String
  amount    Float
  status    String   @default("success")
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)
  slug      String?  @unique
}

model insurance {
  id             String                 @id @default(cuid())
  name           String?
  title          String
  description    String?
  type           String
  minAmount      Float
  premiumCode    String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  coverageAmount Float?
  isActive       Boolean                @default(true)
  maxAmount      Float?
  policyNumber   String                 @unique
  premiumRate    Float?
  tenureMonths   Int?
  applications   InsuranceApplication[]
  claims         InsuranceClaim[]
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  subject   String?
  message   String
  createdAt DateTime @default(now())
}

model Achievement {
  id          String   @id @default(cuid())
  title       String
  description String
  reward      Float    @default(0)
  userId      String?
  createdAt   DateTime @default(now())
}

model Commission {
  id               String           @id @default(cuid())
  amount           Float
  userId           String
  loanId           String?
  createdAt        DateTime         @default(now())
  commissionAmount Float            @default(0)
  partnerId        String?
  source           String?
  status           String           @default("PENDING")
  approvedAt       DateTime?
  loanAmount       Float            @default(0)
  rejectionReason  String?
  loan             LoanApplication? @relation(fields: [loanId], references: [id])
  partner          Partner?         @relation(fields: [partnerId], references: [id])
  user             User             @relation(fields: [userId], references: [id])
}

model Wallet {
  id            String          @id @default(cuid())
  balance       Float           @default(0)
  cashback      Float           @default(0)
  rewardBalance Float           @default(0)
  totalEarnings Float           @default(0)
  userId        String          @unique
  isFrozen      Boolean         @default(false)
  isBlocked     Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User            @relation(fields: [userId], references: [id])
  walletHistory WalletHistory[]
  transactions  Transaction[]
}

model Transaction {
  id             String    @id @default(cuid())
  transactionId  String    @unique
  referenceId    String?   @unique
  gatewayTxnId   String?
  orderId        String?
  userId         String?
  customerId     String?
  dsaId          String?
  partnerId      String?
  walletId       String?
  type           String
  category       String
  paymentMethod  String?
  paymentGateway String?
  amount         Float
  fee            Float     @default(0)
  gst            Float     @default(0)
  commission     Float     @default(0)
  cashback       Float     @default(0)
  tax            Float     @default(0)
  netAmount      Float?
  currency       String    @default("INR")
  loanId         String?
  rechargeId     String?
  insuranceId    String?
  investmentId   String?
  referralId     String?
  commissionId   String?
  status         String    @default("pending")
  isVerified     Boolean   @default(false)
  isApproved     Boolean   @default(false)
  isRefunded     Boolean   @default(false)
  approvedBy     String?
  approvedAt     DateTime?
  rejectedBy     String?
  rejectedAt     DateTime?
  rejectReason   String?
  verifiedBy     String?
  verifiedAt     DateTime?
  refundAmount   Float?
  refundReason   String?
  refundedBy     String?
  refundedAt     DateTime?
  description    String?
  remark         String?
  notes          String?
  ipAddress      String?
  deviceInfo     String?
  platform       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User?     @relation(fields: [userId], references: [id])
  wallet         Wallet?   @relation(fields: [walletId], references: [id])

  @@index([transactionId])
  @@index([referenceId])
  @@index([userId])
  @@index([customerId])
  @@index([dsaId])
  @@index([partnerId])
  @@index([status])
  @@index([type])
  @@index([category])
  @@index([createdAt])
  @@map("transactions")
}

model Coupon {
  id          String   @id @default(cuid())
  code        String   @unique
  discount    Float
  minAmount   Float?
  maxDiscount Float?
  maxUsage    Int      @default(100)
  usedCount   Int      @default(0)
  isActive    Boolean  @default(true)
  expiryDate  DateTime
  createdAt   DateTime @default(now())
}

model Referral {
  id                  String            @id @default(cuid())
  userId              String            @unique
  referralCode        String            @unique
  referralLink        String?
  status              ReferralStatus    @default(PENDING)
  totalReferrals      Int               @default(0)
  successfulReferrals Int               @default(0)
  pendingReferrals    Int               @default(0)
  rejectedReferrals   Int               @default(0)
  rewardAmount        Float             @default(0)
  rewardPaidAmount    Float             @default(0)
  totalEarnings       Float             @default(0)
  rewardTransactionId String?
  referrerId          String?
  referredUserId      String?           @unique
  source              String?
  campaign            String?
  approvedBy          String?
  approvedAt          DateTime?
  rejectedBy          String?
  rejectedAt          DateTime?
  rejectionReason     String?
  paidAt              DateTime?
  expiresAt           DateTime?
  isFraud             Boolean           @default(false)
  fraudReason         String?
  ipAddress           String?
  deviceInfo          String?
  createdBy           String?
  updatedBy           String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  referralHistory     ReferralHistory[]
  referredUser        User?             @relation("ReferralReferredUser", fields: [referredUserId], references: [id])
  referrer            User?             @relation("ReferralReferrer", fields: [referrerId], references: [id])
  user                User              @relation("ReferralOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([referralCode])
  @@index([campaign])
  @@index([source])
  @@index([isFraud])
  @@index([createdAt])
  @@index([approvedAt])
  @@index([paidAt])
  @@map("referrals")
}

model Recharge {
  id               String            @id @default(cuid())
  mobileNumber     String
  operator         String
  amount           Float
  planDetails      String?
  transactionRef   String?           @unique
  userId           String
  createdAt        DateTime          @default(now())
  failureReason    String?
  operatorTxnId    String?
  completedAt      DateTime?
  serviceType      String?
  commissionAmount Float             @default(0)
  deviceInfo       String?
  ipAddress        String?
  processedAt      DateTime?
  refundedAt       DateTime?
  refundedBy       String?
  remarks          String?
  updatedAt        DateTime          @updatedAt
  rechargeType     RechargeType
  status           RechargeStatus    @default(PENDING)
  user             User              @relation(fields: [userId], references: [id])
  RechargeHistory  RechargeHistory[]

  @@index([userId])
  @@index([status])
  @@index([mobileNumber])
  @@index([transactionRef])
  @@index([rechargeType])
}

model Notification {
  id         String    @id @default(cuid())
  title      String
  message    String
  type       String?   @default("general")
  userId     String
  isRead     Boolean   @default(false)
  createdAt  DateTime  @default(now())
  readAt     DateTime?
  archivedAt DateTime?
  channel    String?   @default("app")
  isArchived Boolean   @default(false)
  priority   String?   @default("medium")
  user       User      @relation(fields: [userId], references: [id])
}

model SupportTicket {
  id            String         @id @default(cuid())
  ticketNumber  String         @unique
  subject       String
  message       String
  priority      String         @default("medium")
  status        String         @default("open")
  adminReply    String?
  userId        String
  createdAt     DateTime       @default(now())
  assignedTo    String?
  description   String?
  resolvedAt    DateTime?
  category      String?
  replies       SupportReply[]
  assignedAdmin User?          @relation("AssignedAdminTickets", fields: [assignedTo], references: [id])
  user          User           @relation(fields: [userId], references: [id])
}

model EMIPayment {
  id            String          @id @default(cuid())
  amount        Float
  paymentDate   DateTime        @default(now())
  paymentMethod String?
  status        String          @default("paid")
  loanId        String
  loan          LoanApplication @relation(fields: [loanId], references: [id])
}

model FastagRecharge {
  id        String   @id @default(cuid())
  vehicleNo String
  provider  String
  amount    Float
  status    String   @default("success")
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model ElectricityBill {
  id         String   @id @default(cuid())
  consumerNo String
  provider   String
  amount     Float
  status     String   @default("paid")
  userId     String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model JobApplication {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  phone     String
  position  String?
  resumeUrl String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model RevenueAnalytics {
  id                String   @id @default(cuid())
  totalRevenue      Float
  totalUsers        Int
  totalLoans        Int
  totalTransactions Int
  createdAt         DateTime @default(now())
}

model Leaderboard {
  id          String   @id @default(cuid())
  userName    String
  totalPoints Int      @default(0)
  totalSales  Float    @default(0)
  createdAt   DateTime @default(now())
}

model UserActivity {
  id        String   @id @default(cuid())
  activity  String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model SecurityLog {
  id          String   @id @default(cuid())
  action      String
  severity    String?  @default("LOW")
  status      String?  @default("SUCCESS")
  module      String?
  description String?
  ipAddress   String?
  deviceInfo  String?
  userAgent   String?
  metadata    Json?
  userId      String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model RechargePlan {
  id        String   @id @default(cuid())
  operator  String
  amount    Float
  validity  String
  benefits  String
  createdAt DateTime @default(now())
}

model ReferralHistory {
  id             String   @id @default(cuid())
  referralId     String
  referredUserId String
  rewardAmount   Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  referral       Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  referredUser   User     @relation("HistoryReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([referralId])
  @@index([referredUserId])
  @@map("referral_histories")
}

model WalletHistory {
  id        String   @id @default(cuid())
  balance   Float
  walletId  String
  createdAt DateTime @default(now())
  wallet    Wallet   @relation(fields: [walletId], references: [id])
}

model NotificationSettings {
  id          String   @id @default(cuid())
  emailAlerts Boolean  @default(true)
  smsAlerts   Boolean  @default(true)
  pushAlerts  Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Role {
  id           String           @id @default(cuid())
  name         String
  code         String           @unique
  slug         String?          @unique
  description  String?
  isActive     Boolean          @default(true)
  isSystem     Boolean          @default(false)
  category     RoleCategory?
  parentRoleId String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  parentRole   Role?            @relation("RoleHierarchy", fields: [parentRoleId], references: [id])
  childRoles   Role[]           @relation("RoleHierarchy")
  permissions  RolePermission[]
  users        User[]
}

model Permission {
  id              String           @id @default(cuid())
  name            String
  code            String           @unique
  module          String
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  slug            String?          @unique
  action          String
  status          String           @default("ACTIVE")
  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@index([module])
  @@index([code])
  @@index([status])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  Role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserPermission {
  id           String     @id @default(cuid())
  userId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
}

model Partner {
  id              String            @id @default(cuid())
  companyName     String            @default("")
  contactPerson   String?
  email           String            @unique
  phone           String?
  partnerCode     String?           @unique
  status          String            @default("PENDING")
  remarks         String?
  approvedBy      String?
  approvedAt      DateTime?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  city            String?
  isBlocked       Boolean           @default(false)
  name            String?
  referralCode    String?
  rejectionReason String?
  state           String?
  commissions     Commission[]
  leads           LoanApplication[]
  revenues        Revenue[]
}

model Payment {
  id                String           @id @default(cuid())
  userId            String
  amount            Float
  paymentMethod     String?
  purpose           String
  referenceId       String?
  status            String           @default("PENDING")
  transactionId     String?
  failureReason     String?
  refundAmount      Float?
  paidAt            DateTime?
  refundedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  gateway           String?
  gatewayPaymentId  String?
  gatewayResponse   Json?
  loanApplicationId String?
  paymentId         String           @unique
  remarks           String?
  verifiedAt        DateTime?
  verifiedBy        String?
  loanApplication   LoanApplication? @relation(fields: [loanApplicationId], references: [id])
  user              User             @relation(fields: [userId], references: [id])
  revenues          Revenue[]

  @@index([userId])
  @@index([loanApplicationId])
  @@index([status])
  @@index([transactionId])
  @@index([paymentId])
}

model KYC {
  id                        String            @id @default(cuid())
  userId                    String            @unique
  fullName                  String
  panNumber                 String
  dob                       String
  address                   String?
  city                      String?
  state                     String?
  pincode                   String?
  status                    String            @default("PENDING")
  approvedBy                String?
  approvedAt                DateTime?
  rejectionReason           String?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  expiryDate                DateTime?
  panVerificationStatus     String            @default("PENDING")
  aadhaarVerificationStatus String            @default("PENDING")
  bankVerificationStatus    String            @default("PENDING")
  panVerifiedAt             DateTime?
  aadhaarVerifiedAt         DateTime?
  bankVerifiedAt            DateTime?
  verificationUpdatedAt     DateTime?
  user                      User              @relation(fields: [userId], references: [id])
  KYCVerification           KYCVerification[]
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  category    String
  group       String?
  description String?
  dataType    String   @default("string")
  isActive    Boolean  @default(true)
  isPublic    Boolean  @default(false)
  isEditable  Boolean  @default(true)
  isEncrypted Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@index([category])
  @@index([group])
  @@index([isActive])
}

model SupportReply {
  id        String        @id @default(cuid())
  ticketId  String
  message   String
  userId    String?
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id])
  user      User?         @relation(fields: [userId], references: [id])
}

model Upload {
  id              String    @id @default(cuid())
  fileName        String
  originalName    String?
  fileUrl         String
  filePath        String?
  fileKey         String?
  fileType        String?
  mimeType        String?
  extension       String?
  fileSize        Int?
  category        String?
  documentType    String?
  uploadedBy      String?
  userId          String?
  customerId      String?
  dsaId           String?
  partnerId       String?
  status          String    @default("PENDING")
  isVerified      Boolean   @default(false)
  isApproved      Boolean   @default(false)
  isDeleted       Boolean   @default(false)
  isExpired       Boolean   @default(false)
  approvedBy      String?
  approvedAt      DateTime?
  rejectedBy      String?
  rejectedAt      DateTime?
  rejectReason    String?
  verifiedBy      String?
  verifiedAt      DateTime?
  documentNumber  String?
  expiryDate      DateTime?
  storageProvider String?
  bucketName      String?
  storagePath     String?
  downloadUrl     String?
  previewUrl      String?
  checksum        String?
  uploadedIp      String?
  deviceInfo      String?
  platform        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  user            User?     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([customerId])
  @@index([dsaId])
  @@index([partnerId])
  @@index([status])
  @@index([category])
  @@index([documentType])
  @@index([createdAt])
  @@map("uploads")
}

model AuditLog {
  id          String        @id @default(cuid())
  action      String
  entityId    String?
  performedBy String?
  metadata    Json?
  createdAt   DateTime      @default(now())
  ipAddress   String?
  module      String
  newData     Json?
  oldData     Json?
  requestId   String?
  role        String?
  severity    AuditSeverity @default(INFO)
  userAgent   String?

  @@index([performedBy])
  @@index([module])
  @@index([action])
  @@index([createdAt])
}

model Investment {
  id              String           @id @default(cuid())
  title           String
  description     String?
  type            String
  minAmount       Float
  interestRate    Float
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  category        String?
  minimumAmount   Float            @default(0)
  activatedAt     DateTime?
  approvedAt      DateTime?
  closedAt        DateTime?
  isActive        Boolean          @default(true)
  rejectedAt      DateTime?
  status          InvestmentStatus @default(PENDING)
  totalInvested   Float            @default(0)
  totalInvestors  Int              @default(0)
  totalReturns    Float            @default(0)
  riskLevel       RiskLevel?
  userInvestments UserInvestment[]

  @@index([status])
  @@index([type])
  @@index([category])
  @@index([isActive])
}

model UserInvestment {
  id           String     @id @default(cuid())
  amount       Float
  status       String     @default("PENDING")
  userId       String
  investmentId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  approvedAt   DateTime?
  closedAt     DateTime?
  investment   Investment @relation(fields: [investmentId], references: [id])
  user         User       @relation(fields: [userId], references: [id])
}

model InsuranceApplication {
  id               String           @id @default(cuid())
  insuranceType    String
  amount           Float
  status           String           @default("PENDING")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  agentId          String?
  approvedAt       DateTime?
  insuranceId      String?
  rejectionReason  String?
  userId           String?
  applicationNo    String           @unique
  commissionAmount Float?           @default(0)
  expiryDate       DateTime?
  rejectedAt       DateTime?
  startDate        DateTime?
  insuranceRef     insurance?       @relation(fields: [insuranceId], references: [id])
