/* ========================================
   ANALYTICS
======================================== */

export const paymentAnalytics = async (
  req: Request,
  res: Response
): Promise<void> => {
  try {
    const totalPayments = await prisma.payment.count();

    res.json({
      success: true,
      totalPayments,
    });
  } catch (error) {
    res.status(500).json({ success: false, error });
  }
};

export const getPaymentAnalytics = paymentAnalytics;
export const getPaymentDashboard = paymentAnalytics;

export const getDailyPayments = paymentAnalytics;
export const getMonthlyPayments = paymentAnalytics;

