/* ==========================================================
   HIGHEST BALANCES
========================================================== */
export const getHighestBalances = async (
  req: Request,
  res: Response
) => {
  try {
    const wallets = await prisma.wallet.findMany({
      orderBy: {
        balance: "desc",
      },
      take: 20,
    });

    return res.status(200).json({
      success: true,
      data: wallets,
    });
  } catch (error) {
    console.error(error);

    return res.status(500).json({
      success: false,
      message: "Failed to fetch balances",
    });
  }
};

/* ==========================================================
   DAILY REPORT
========================================================== */
export const getDailyWalletReport = async (
  req: Request,
  res: Response
) => {
  try {
    const today = new Date();

    today.setHours(0, 0, 0, 0);

    const report = await prisma.transaction.findMany({
      where: {
        createdAt: {
          gte: today,
        },
      },
      orderBy: {
        createdAt: "desc",
      },
    });

    return res.status(200).json({
      success: true,
      total: report.length,
      data: report,
    });
  } catch (error) {
    console.error(error);

    return res.status(500).json({
      success: false,
      message: "Failed to fetch report",
    });
  }
};

/* ==========================================================
   MONTHLY REPORT
========================================================== */
export const getMonthlyWalletReport = async (
  req: Request,
  res: Response
) => {
  try {
    const date = new Date();

    const firstDay = new Date(
      date.getFullYear(),
      date.getMonth(),
      1
    );

    const report = await prisma.transaction.findMany({
      where: {
        createdAt: {
          gte: firstDay,
        },
      },
      orderBy: {
        createdAt: "desc",
      },
    });

    return res.status(200).json({
      success: true,
      total: report.length,
      data: report,
    });
  } catch (error) {
    console.error(error);

    return res.status(500).json({
      success: false,
      message: "Failed to fetch monthly report",
    });
  }
};

/* ==========================================================
   WALLET REVENUE
========================================================== */
export const getWalletRevenue = async (
  req: Request,
  res: Response
) => {
  try {
    const revenue = await prisma.wallet.aggregate({
      _sum: {
        totalEarnings: true,
