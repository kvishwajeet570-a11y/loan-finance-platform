/* ==========================================================
   BULK CREDIT
========================================================== */
export const bulkCreditWallets = async (
  req: Request,
  res: Response
) => {
  try {
    const { walletIds, amount } = req.body;

    await prisma.wallet.updateMany({
      where: {
        id: {
          in: walletIds,
        },
      },
      data: {
        balance: {
          increment: Number(amount),
        },
      },
    });

    return res.status(200).json({
      success: true,
      message: "Bulk credit completed",
    });
  } catch (error) {
    console.error(error);

    return res.status(500).json({
      success: false,
      message: "Bulk credit failed",
    });
  }
};

/* ==========================================================
   BULK DEBIT
========================================================== */
export const bulkDebitWallets = async (
  req: Request,
  res: Response
) => {
  try {
    const { walletIds, amount } = req.body;

    await prisma.wallet.updateMany({
      where: {
