/* ==========================================================
   WITHDRAW MONEY
========================================================== */
export const withdrawMoney = async (
  req: Request,
  res: Response
) => {
  try {
    const { userId, amount } = req.body;

    if (!userId || !amount) {
      return res.status(400).json({
