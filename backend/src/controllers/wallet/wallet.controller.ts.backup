        amount: Number(amount),
        type: "DEBIT",
        status: "SUCCESS",
        description: "Money Withdrawn",
      },
    });

    return res.status(200).json({
      success: true,
      message: "Money withdrawn successfully",
      data: updatedWallet,
    });
  } catch (error) {
    console.error(error);

    return res.status(500).json({
      success: false,
