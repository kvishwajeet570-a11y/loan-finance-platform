/* ==========================================================
   LIVE WALLET ACTIVITIES
========================================================== */
export const getLiveWalletActivities = async (
  req: Request,
  res: Response
) => {
  try {
    const activities =
      await prisma.transaction.findMany({
        orderBy: {
          createdAt: "desc",
        },
        take: 50,
        include: {
          wallet: {
            include: {
              user: true,
            },
          },
        },
      });

    return res.status(200).json({
      success: true,
      total: activities.length,
      data: activities,
    });
  } catch (error) {
    console.error(error);

    return res.status(500).json({
      success: false,
      message: "Failed to fetch live activities",
    });
  }
};




