    });

    return res.status(200).json({
      success: true,
      revenue: revenue._sum.totalEarnings || 0,
    });
  } catch (error) {
    console.error(error);

    return res.status(500).json({
      success: false,
      message: "Failed to fetch revenue",
    });
  }
};

