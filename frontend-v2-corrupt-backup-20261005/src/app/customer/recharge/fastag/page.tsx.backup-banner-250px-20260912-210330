              </div>
            </section>

            {/* VEHICLE */}
            <section className="relative overflow-hidden rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
              <div className="absolute right-0 top-0 h-full w-[42%] bg-[radial-gradient(circle_at_center,rgba(59,130,246,.13),transparent_58%)]" />

              <div className="relative">
