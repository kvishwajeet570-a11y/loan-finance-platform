                </p>
                <p className="text-[10px] font-black italic text-blue-700">
                  A Smoother Tomorrow.”
                </p>
              </div>

            </div>

          </div>
        </section>

        {/* MAIN GRID */}
        <div className="mt-4 grid gap-4 xl:grid-cols-[minmax(0,1fr)_330px]">

          <main className="space-y-4">

            {/* BANK SELECT */}
            <section className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
              <div className="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
                <div>
                  <h2 className="text-lg font-black">
                    Select Your FASTag Bank
                  </h2>

                  <p className="mt-1 text-[11px] text-slate-500">
                    Choose from leading banks and FASTag providers.
                  </p>
                </div>

                <div className="relative">
                  <Search
                    size={14}
                    className="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"
                  />

                  <input
                    value={bankSearch}
                    onChange={(e) => setBankSearch(e.target.value)}
                    placeholder="Search bank..."
                    className="w-full rounded-lg border border-slate-200 bg-slate-50 py-2.5 pl-9 pr-3 text-xs outline-none focus:border-blue-500 focus:bg-white md:w-52"
