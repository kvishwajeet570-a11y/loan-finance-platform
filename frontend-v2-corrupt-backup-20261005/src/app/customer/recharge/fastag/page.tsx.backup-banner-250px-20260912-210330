const rechargeAmounts = [
  { value: 100, label: "Basic" },
  { value: 200, label: "Standard" },
  { value: 500, label: "Great Value", popular: true },
  { value: 1000, label: "Recommended" },
  { value: 2000, label: "High Value" },
  { value: 5000, label: "Maximum" },
];

const money = (value: number) =>
  `₹${Number(value || 0).toLocaleString("en-IN")}`;

const maskVehicle = (value = "") =>
  value.length > 4
    ? `${"*".repeat(Math.max(0, value.length - 4))}${value.slice(-4)}`
    : value;

const dateText = (value?: string) => {
  if (!value) return "—";

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) return "—";

  return date.toLocaleString("en-IN", {
    day: "2-digit",
    month: "short",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  });
};

export default function FastagRechargePage() {
  const [user, setUser] = useState<User | null>(null);
  const [balance, setBalance] = useState(0);

  const [provider, setProvider] = useState("ICICI");
  const [vehicle, setVehicle] = useState("");
  const [amount, setAmount] = useState("500");
  const [bankSearch, setBankSearch] = useState("");

  const [recent, setRecent] = useState<Recharge[]>([]);
  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);
  const [processing, setProcessing] = useState(false);
  const [message, setMessage] = useState("");
  const [copied, setCopied] = useState(false);

  const loadData = useCallback(async () => {
    try {
      const token = localStorage.getItem("loan_finance_token");
      const stored = localStorage.getItem("loan_finance_user");

      if (!token || !stored) {
        window.location.href = "/login";
        return;
      }

      const currentUser = JSON.parse(stored) as User;
      setUser(currentUser);

      const config = {
        headers: {
          Authorization: `Bearer ${token}`,
        },
        withCredentials: true,
      };

      const [walletRes, rechargeRes] = await Promise.all([
        api.get("/wallet/balance", config),
        api.get(`/recharge/user/${currentUser.id}`, config),
      ]);

      const wallet =
        walletRes?.data?.data ||
        walletRes?.data?.wallet ||
        walletRes?.data ||
        {};

      setBalance(Number(wallet?.balance || 0));

      const data =
        rechargeRes?.data?.data ||
        rechargeRes?.data?.recharges ||
        [];

      setRecent(
        (Array.isArray(data) ? data : [])
          .filter(
            (item: Recharge) =>
              String(item.rechargeType || "").toUpperCase() === "FASTAG"
          )
          .slice(0, 3)
      );
    } catch (error: any) {
      if (error?.response?.status === 401) {
        localStorage.removeItem("loan_finance_token");
        window.location.href = "/login";
        return;
      }

      setMessage(
        error?.response?.data?.message ||
          "Unable to load FASTag information."
      );
    } finally {
      setLoading(false);
      setRefreshing(false);
    }
  }, []);

  useEffect(() => {
    loadData();
  }, [loadData]);

  const filteredProviders = useMemo(() => {
    const q = bankSearch.trim().toLowerCase();

    if (!q) return providers;

    return providers.filter(
      (item) =>
        item.name.toLowerCase().includes(q) ||
        item.short.toLowerCase().includes(q)
    );
  }, [bankSearch]);

  const selectedProvider =
    providers.find((item) => item.id === provider) || providers[0];

  const cleanVehicle = useMemo(
    () =>
      vehicle
        .toUpperCase()
        .replace(/[^A-Z0-9]/g, "")
        .slice(0, 12),
    [vehicle]
  );

  const validVehicle = useMemo(
    () =>
      /^[A-Z]{2}[0-9]{1,2}[A-Z]{1,3}[0-9]{3,4}$/.test(cleanVehicle),
    [cleanVehicle]
  );

  const numericAmount = Number(amount || 0);

  const recharge = async () => {
    if (!cleanVehicle) {
      setMessage("Please enter your vehicle registration number.");
      return;
    }

    if (!validVehicle) {
      setMessage("Please enter a valid vehicle number, e.g. BR01AB1234.");
      return;
    }

    if (!numericAmount || numericAmount < 10) {
      setMessage("Minimum recharge amount is ₹10.");
      return;
    }

    if (numericAmount > balance) {
      setMessage("Insufficient wallet balance.");
      return;
    }

    if (!user?.id) {
      setMessage("Session expired. Please login again.");
      return;
    }

    try {
      setProcessing(true);
      setMessage("");

      const token = localStorage.getItem("loan_finance_token");

      const response = await api.post(
        "/recharge",
        {
          userId: user.id,
          mobileNumber: cleanVehicle,
          operator: provider,
          amount: numericAmount,
          rechargeType: "FASTAG",
          paymentMethod: "Wallet",
        },
        {
          headers: {
            Authorization: `Bearer ${token}`,
          },
          withCredentials: true,
        }
      );

      if (!response?.data?.success) {
        throw new Error(
          response?.data?.message || "FASTag recharge failed."
        );
      }

      setMessage(
        `FASTag recharge of ${money(
          numericAmount
        )} completed successfully.`
      );

      await loadData();
    } catch (error: any) {
      if (error?.response?.status === 401) {
        localStorage.removeItem("loan_finance_token");
        window.location.href = "/login";
        return;
      }

      setMessage(
        error?.response?.data?.message ||
          error?.message ||
          "FASTag recharge failed."
      );
    } finally {
      setProcessing(false);
    }
  };

  const copyVehicle = async () => {
    if (!cleanVehicle) return;

    try {
      await navigator.clipboard.writeText(cleanVehicle);
      setCopied(true);

      setTimeout(() => setCopied(false), 1500);
    } catch {}
  };

  if (loading) {
    return (
      <div className="flex min-h-[75vh] items-center justify-center bg-[#f6f9ff]">
        <div className="flex items-center gap-3 rounded-2xl border border-blue-100 bg-white px-7 py-5 shadow-sm">
          <Loader2 size={21} className="animate-spin text-blue-600" />
          <span className="text-sm font-bold text-slate-700">
            Loading FASTag...
          </span>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-[#f6f9ff] text-[#07184a]">
      <div className="mx-auto max-w-[1540px] px-4 py-4 md:px-6">

        {/* BREADCRUMB + WALLET */}
        <div className="flex flex-col gap-4 border-b border-blue-100 pb-4 lg:flex-row lg:items-center lg:justify-between">
          <div>
            <div className="flex items-center gap-2 text-[11px] text-slate-500">
              <Link
                href="/customer/dashboard"
                className="hover:text-blue-600"
              >
                Dashboard
              </Link>
              <ChevronRight size={13} />
              <span>Recharge</span>
              <ChevronRight size={13} />
              <span className="font-bold text-blue-600">
                FASTag Recharge
              </span>
            </div>
          </div>

          <div className="flex items-center gap-3">
            <span className="hidden items-center gap-1.5 text-[10px] font-bold text-emerald-700 md:flex">
              <ShieldCheck size={14} />
              India&apos;s Most Trusted Recharge Platform
            </span>

            <div className="flex items-center gap-3 rounded-xl border border-blue-100 bg-white px-4 py-2.5 shadow-sm">
              <Wallet size={17} className="text-blue-600" />
              <div>
                <p className="text-[8px] font-bold uppercase tracking-widest text-slate-400">
