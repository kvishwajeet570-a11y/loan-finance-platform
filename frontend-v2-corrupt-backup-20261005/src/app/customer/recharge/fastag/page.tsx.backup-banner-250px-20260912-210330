                </p>
                <p className="text-sm font-black">
                  {money(balance)}
                </p>
              </div>
            </div>

            <button
              onClick={() => {
                setRefreshing(true);
                loadData();
              }}
              disabled={refreshing}
              className="rounded-xl border border-slate-200 bg-white p-3 text-slate-600 shadow-sm hover:border-blue-300 hover:text-blue-600"
            >
              <RefreshCw
                size={15}
                className={refreshing ? "animate-spin" : ""}
              />
            </button>
          </div>
        </div>

        {/* =========================================================
            HERO — SAME LIGHT FASTAG VISUAL STYLE
        ========================================================= */}
                {/* =========================================================
            FASTAG HERO — REAL IMAGE BANNER
        ========================================================= */}
                {/* =========================================================
            FASTAG PREMIUM HERO — ORIGINAL IMAGE / NO WASH
        ========================================================= */}
        <section className="relative mt-4 h-[225px] overflow-hidden rounded-2xl border border-blue-200 bg-white shadow-[0_8px_30px_rgba(30,64,175,0.10)]">

          {/* ORIGINAL FASTAG IMAGE */}
          <img
