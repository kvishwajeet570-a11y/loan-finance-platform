                      </p>
                    </div>
                  </div>

                  <span className="flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1.5 text-[8px] font-black text-emerald-700">
                    <ShieldCheck size={12} />
                    SECURE
                  </span>
                </div>

                <div className="mt-5 grid gap-3 lg:grid-cols-[1fr_230px]">
                  <div>
                    <div className="relative">
                      <Truck
