            className="absolute inset-0 h-full w-full object-fill object-center"
          />

          {/* ONLY SUBTLE LEFT READABILITY PANEL — RIGHT IMAGE STAYS ORIGINAL */}
          <div className="absolute inset-y-0 left-0 w-[43%] bg-gradient-to-r from-white/82 via-white/28 to-transparent" />

          <div className="relative z-10 flex h-full items-center px-7 md:px-9">

            <div className="max-w-[545px]">

              <div className="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-white px-3 py-1.5 text-[9px] font-black text-blue-700 shadow-md">
                <Truck size={12} />
                FASTAG
                <span className="text-slate-300">•</span>
                Smart Travel. Smarter Payments.
              </div>

              <h2 className="mt-4 text-[32px] font-black leading-[0.98] tracking-[-1.5px] text-[#07184a] drop-shadow-[0_1px_2px_rgba(255,255,255,0.9)] md:text-[40px]">
                Drive Ahead
                <br />
                <span className="text-blue-600">
