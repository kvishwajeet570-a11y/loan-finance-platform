              </div>

              <div className="mt-4 grid grid-cols-2 gap-2.5 md:grid-cols-3 xl:grid-cols-6">
                {filteredProviders.map((item) => {
                  const active = provider === item.id;

                  return (
                    <button
                      key={item.id}
                      onClick={() => setProvider(item.id)}
                      className={`relative rounded-xl border bg-white p-3 transition-all ${
                        active
                          ? "border-blue-600 bg-blue-50/50 shadow-md ring-1 ring-blue-600"
                          : "border-slate-200 hover:-translate-y-0.5 hover:border-blue-300 hover:shadow-md"
