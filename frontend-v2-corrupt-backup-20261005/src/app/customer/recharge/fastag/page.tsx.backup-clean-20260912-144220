                <div className="flex items-center gap-2 text-[9px] font-black text-cyan-200">
                  <Sparkles size={12} />
                  SMART TRAVEL
                </div>

                <h3 className="mt-3 text-2xl font-black">
                  Travel Made Better
                </h3>

                <div className="mt-4 space-y-2">
                  {[
                    "No long queues",
                    "Cashless payments",
                    "Save time & fuel",
                    "Multiple FASTag banks",
                  ].map((text) => (
                    <div
                      key={text}
                      className="flex items-center gap-2 text-[9px] font-bold text-indigo-100"
                    >
                      <CheckCircle2
                        size={13}
                        className="text-emerald-300"
                      />
                      {text}
                    </div>
                  ))}
                </div>
              </div>
            </section>

            {/* RECENT */}
            <section className="rounded-[28px] border border-blue-900/70 bg-[#081637] p-5 shadow-2xl">
              <div className="flex items-center justify-between">
                <div>
                  <p className="text-[9px] font-black uppercase tracking-wider text-cyan-400">
                    Activity
                  </p>

                  <h3 className="mt-1 font-black">
                    Recent FASTag Recharge
                  </h3>
                </div>

                <Link
                  href="/customer/recharge/recent"
                  className="text-[9px] font-black text-cyan-400"
                >
                  View All →
                </Link>
              </div>

              <div className="mt-4 space-y-3">
                {recent.length ? (
                  recent.map((item) => (
                    <div
                      key={item.id}
                      className="flex items-center gap-3 rounded-2xl border border-blue-900 bg-[#0b1c3d] p-3"
                    >
                      <div className="flex h-10 w-10 items-center justify-center rounded-xl bg-orange-500/15 text-orange-400">
                        <Truck size={17} />
                      </div>

                      <div className="min-w-0 flex-1">
                        <p className="truncate text-[10px] font-black">
                          {item.operator || "FASTag"}
                        </p>

                        <p className="mt-1 text-[8px] text-slate-500">
                          {maskVehicle(item.mobileNumber)}
                        </p>
                      </div>

                      <div className="text-right">
                        <p className="text-[10px] font-black">
                          {money(Number(item.amount || 0))}
                        </p>

                        <p className="mt-1 text-[8px] font-black text-emerald-400">
                          {String(item.status || "PENDING")}
                        </p>
                      </div>
                    </div>
                  ))
                ) : (
                  <div className="py-8 text-center">
                    <Clock3
                      size={27}
                      className="mx-auto text-slate-700"
                    />

                    <p className="mt-2 text-[10px] font-black text-slate-500">
                      No FASTag recharge yet
                    </p>
                  </div>
                )}
              </div>
            </section>

            {/* QUICK SERVICES */}
            <section className="rounded-[28px] border border-blue-900/70 bg-[#081637] p-5 shadow-2xl">
              <div className="flex items-center justify-between">
                <h3 className="font-black">
                  Quick Services
                </h3>

                <Link
                  href="/customer/recharge/recent"
                  className="text-[9px] font-black text-cyan-400"
                >
                  View All →
                </Link>
              </div>

              <div className="mt-4 grid grid-cols-4 gap-2">
                <Link
                  href="/customer/recharge/mobile"
                  className="rounded-2xl border border-blue-900 bg-[#0b1c3d] p-3 text-center hover:border-cyan-500"
                >
                  <div className="text-lg text-cyan-400">📱</div>
                  <p className="mt-1 text-[8px] font-black">
                    Mobile
                  </p>
                </Link>

                <Link
                  href="/customer/recharge/dth"
                  className="rounded-2xl border border-blue-900 bg-[#0b1c3d] p-3 text-center hover:border-cyan-500"
                >
                  <div className="text-lg text-violet-400">📺</div>
                  <p className="mt-1 text-[8px] font-black">
                    DTH
                  </p>
                </Link>

                <Link
                  href="/customer/recharge/recent"
                  className="rounded-2xl border border-blue-900 bg-[#0b1c3d] p-3 text-center hover:border-cyan-500"
                >
                  <div className="text-lg text-orange-400">◷</div>
                  <p className="mt-1 text-[8px] font-black">
                    History
                  </p>
                </Link>

                <Link
                  href="/customer/wallet/balance"
                  className="rounded-2xl border border-blue-900 bg-[#0b1c3d] p-3 text-center hover:border-cyan-500"
                >
                  <div className="text-lg text-emerald-400">₹</div>
                  <p className="mt-1 text-[8px] font-black">
                    Wallet
                  </p>
                </Link>
              </div>
            </section>
          </aside>
        </div>

        {/* FOOTER TRUST */}
        <div className="mt-7 flex flex-wrap items-center justify-center gap-5 border-t border-blue-900/60 py-6 text-[8px] font-bold text-slate-600">
          <span className="flex items-center gap-1.5">
            <Zap size={12} className="text-cyan-500" />
            FAST TRAVEL
          </span>

          <span className="flex items-center gap-1.5">
            <ShieldCheck size={12} className="text-emerald-500" />
            SECURE PAYMENTS
          </span>

          <span className="flex items-center gap-1.5">
            <Wallet size={12} className="text-violet-500" />
            WALLET PROTECTED
          </span>

          <span className="flex items-center gap-1.5">
            <Truck size={12} className="text-cyan-500" />
            CASHLESS INDIA
          </span>

          <span>MADE FOR BETTER JOURNEYS</span>
        </div>
      </div>
    </div>
  );
