              <div className="relative flex flex-col items-center justify-between gap-4 md:flex-row">
                <div>
                  <p className="text-[10px] font-black uppercase tracking-wider text-emerald-300">
                    More Miles • More Smiles
                  </p>

                  <h3 className="mt-1 text-2xl font-black">
                    Keep Your FASTag Active
                  </h3>

                  <p className="mt-1 text-[10px] text-slate-400">
                    Enjoy a smoother, faster and greener journey.
                  </p>
                </div>

                <div className="rounded-2xl border border-white/10 bg-white/5 px-5 py-3 text-center backdrop-blur">
                  <p className="text-xl">🚗</p>
                  <p className="text-[8px] font-black text-cyan-300">
                    CASHLESS INDIA
                  </p>
                </div>
              </div>
            </section>
          </div>

          {/* RIGHT SIDEBAR */}
          <aside className="space-y-5">

            {/* WALLET */}
            <section className="relative overflow-hidden rounded-[28px] border border-cyan-400/20 bg-gradient-to-br from-[#1731cf] via-[#4b27d6] to-[#7623d8] p-5 shadow-[0_20px_60px_rgba(79,70,229,.3)]">
              <div className="absolute -right-12 -top-12 h-36 w-36 rounded-full bg-cyan-400/20 blur-2xl" />

              <div className="relative flex items-start justify-between">
                <div>
                  <p className="text-[9px] font-black uppercase tracking-wider text-indigo-100">
                    Wallet Balance
                  </p>

                  <p className="mt-2 text-4xl font-black">
                    {money(wallet)}
                  </p>

                  <p className="mt-1 text-[9px] text-indigo-100">
                    Ready for your next journey!
                  </p>
                </div>

                <div className="rounded-2xl bg-white/15 p-3 backdrop-blur">
                  <Wallet size={22} />
                </div>
              </div>

              <Link
                href="/customer/wallet/balance"
                className="relative mt-5 flex items-center justify-center gap-2 rounded-xl bg-white py-3 text-[10px] font-black text-indigo-700 hover:bg-cyan-50"
              >
                Add Money
                <ArrowRight size={13} />
              </Link>
            </section>

            {/* SUMMARY */}
            <section className="rounded-[28px] border border-slate-200 bg-white p-5 text-slate-900 shadow-2xl">
              <div className="flex items-center justify-between">
                <h3 className="font-black">Recharge Summary</h3>

                <button
                  onClick={() => {
                    setVehicleNumber("");
                    setAmount("500");
                    setMessage("");
                  }}
                  className="text-[9px] font-black text-indigo-600"
                >
                  Clear All →
                </button>
              </div>

              <div className="mt-4 space-y-2">
                <div className="flex items-center justify-between rounded-xl bg-slate-50 px-3 py-3">
                  <span className="text-[9px] font-bold text-slate-500">
                    Selected Bank
                  </span>

                  <span className="text-[10px] font-black">
                    {currentBank.name}
                  </span>
                </div>

                <div className="flex items-center justify-between rounded-xl bg-slate-50 px-3 py-3">
                  <span className="text-[9px] font-bold text-slate-500">
                    Vehicle Number
                  </span>

                  <span className="text-[10px] font-black tracking-wider">
                    {vehicleNumber
                      ? maskVehicle(vehicleNumber)
                      : "—"}
                  </span>
                </div>

                <div className="flex items-center justify-between rounded-xl bg-slate-50 px-3 py-3">
                  <span className="text-[9px] font-bold text-slate-500">
                    Recharge Amount
                  </span>

                  <span className="text-base font-black text-indigo-700">
                    {money(Number(amount || 0))}
                  </span>
                </div>
              </div>

              <button
                onClick={recharge}
                disabled={processing}
                className="mt-5 flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-indigo-600 to-violet-600 py-4 text-xs font-black text-white shadow-lg shadow-indigo-200 hover:from-violet-600 hover:to-purple-700 disabled:opacity-60"
              >
                {processing ? (
                  <>
                    <Loader2 size={16} className="animate-spin" />
                    Processing...
                  </>
                ) : (
                  <>
                    <Zap size={16} />
                    Recharge FASTag
                  </>
                )}
              </button>

              <div className="mt-4 flex items-center justify-center gap-2 text-[9px] font-bold text-slate-400">
                <LockKeyhole size={12} />
                Secure Wallet Payment
              </div>
            </section>

            {/* OFFER */}
